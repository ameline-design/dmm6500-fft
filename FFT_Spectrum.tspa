loadscript FFT_Spectrum
-- $Title: FFT Spectrum Analyser
-- $Product: DMM6500, DAQ6510, DMM7510
-- $Tag: FFT, Spectrum, Digitize, Audio
-- $Description: On-instrument FFT spectrum analyser: digitize mode + FFT with a live graph, top-6 peaks, and a touch options form (start/stop frequency, input range).
-- $Version: 5.1
-- $Requires: 1.7.0
-- $Icon: fft_icon

-- ================= tsp/fft_core.tsp =================
-- fft_core.tsp -- real-input FFT for the DMM6500's TSP (Lua 5.0.2)
--
-- fftsa.fft_init() builds everything loop-invariant once: window, bit-reversal swaps,
-- butterfly and untangle twiddles, peak-interpolation tables. The real input packs into
-- N/2 complex points z[k] = x[2k-1] + i*x[2k], an N/2-point transform runs on those, and
-- one untangle pass recovers the N/2 bins as power, volts-squared peak. Anything wanting
-- volts takes the square root at the point of use.
--
-- Lua 5.0.2: no '#' operator (table.getn), no hex literals, no bitwise operators.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.fft_n      = 0      -- number of samples N (power of two)
fftsa.fft_m      = 0      -- N/2: the complex transform size, and the number of bins
fftsa.fft_x      = nil    -- raw samples 1..N, staged between the two load passes
fftsa.fft_re     = nil    -- packed complex working array, real parts, 1..M
fftsa.fft_im     = nil    -- imaginary parts, 1..M
fftsa.fft_win    = nil    -- analysis window, 1..N
fftsa.fft_pwr    = nil    -- power output, 1..M, volts-squared (peak)
fftsa.fft_swp_a  = nil    -- bit-reversal swap pairs over 1..M
fftsa.fft_swp_b  = nil
fftsa.fft_nswp   = 0
fftsa.fft_twr    = nil    -- flattened butterfly twiddles, stage-major
fftsa.fft_twi    = nil
fftsa.fft_utr    = nil    -- untangle twiddles e^(-2*pi*i*k/N), k = 0..M-1
fftsa.fft_uti    = nil
-- Coherent gain, the mean window sample. A window identity worth pinning, and
-- tools/test_tsp.lua and tools/make_refs.lua do; no shipped module reads it. The
-- amplitude calibration is fftsa.fft_ksq, from the window sum.
fftsa.fft_cg     = 0.5
fftsa.fft_ksq    = 0      -- power scale applied to the untangled |2X|^2

-- ============================ analysis windows ============================
-- Every entry is a generalised cosine sum except Kaiser, whose beta trades main-lobe
-- width against sidelobe level and so spans the named windows and goes past them.
--
-- Rectangular is absent: its transform has a null one bin from the peak, which leaves the
-- three-bin interpolation ill-conditioned, so peak readings would be wrong in a way the
-- trace does not show. Hamming is absent because it exits the app on the instrument;
-- Kaiser at beta 6 covers it to within a dB of sidelobe level.
fftsa.win_names = {"Hann", "Blackman", "Blk-Harris", "Kaiser"}
-- Index-parallel to fftsa.win_names, coefficients a0 - a1*cos + a2*cos2 - a3*cos3.
-- Kaiser has no entry, which is how fftsa.win_build() tells it apart.
fftsa.win_cos = {
  {0.5, 0.5},
  {0.42, 0.5, 0.08},
  {0.35875, 0.48829, 0.14128, 0.01168},
}
fftsa.win_i = 1             -- index into fftsa.win_names

-- A fixed list rather than a typed number: every value here is verified for peak
-- frequency and amplitude in the suite, and a typed beta would admit unmeasured shapes.
-- The floor is 4 because the first null sits at sqrt(1 + (beta/pi)^2) bins and has to
-- stay outside 1.5 bins for the interpolation to read main lobe rather than sidelobe,
-- which puts the boundary at 3.5. Labels carry the peak sidelobe level beta buys.
fftsa.kbetas       = {4, 6, 9, 12, 15, 18}
fftsa.kbeta_labels = {"4  -30dB", "6  -44dB", "9  -66dB",
                      "12  -90dB", "15  -114dB", "18  -139dB"}
fftsa.kbeta_i      = 4      -- index into fftsa.kbetas

function fftsa.kbeta(bi)
  local b = fftsa.kbetas[bi or fftsa.kbeta_i]
  if b == nil then b = fftsa.kbetas[1] end
  return b
end

function fftsa.win_name(wi)
  wi = wi or fftsa.win_i
  return fftsa.win_names[wi] or fftsa.win_names[1]
end

-- Window name for a readback line, with beta where beta applies.
-- Defaults to the applied window; the options preview passes the field values so the
-- whole line describes one state rather than two.
function fftsa.win_label(wi, bi)
  wi = wi or fftsa.win_i
  if fftsa.win_cos[wi] ~= nil then return fftsa.win_name(wi) end
  return fftsa.win_name(wi) .. " b=" .. tostring(fftsa.kbeta(bi))
end

-- I0 by its power series, sum of ((x/2)^k / k!)^2. The term ratio is (x/2)^2/k^2, so
-- beta 18 converges inside 40 terms. Evaluated N/2 times per fftsa.fft_init() and
-- never per frame.
function fftsa.bessel_i0(x)
  local hh = (x / 2) * (x / 2)
  local t, s = 1, 1
  for k = 1, 40 do
    t = t * hh / (k * k)
    s = s + t
    if t < s * 1e-17 then return s end
  end
  return s
end

-- Build fftsa.fft_win and the amplitude scale from it. Symmetric, so only half the
-- samples are computed. The scale comes from the window sum, and assuming N/2 for
-- Hann rather than summing it reads every amplitude 0.2 % low at N = 512.
function fftsa.win_build(N)
  local cos, sqrt, floor, pi = math.cos, math.sqrt, math.floor, math.pi
  local w    = {}
  local c    = fftsa.win_cos[fftsa.win_i]
  local half = floor((N + 1) / 2)
  if c ~= nil then
    local a0, a1, a2, a3 = c[1], c[2] or 0, c[3] or 0, c[4] or 0
    local step = 2 * pi / (N - 1)
    for i = 1, half do
      local t = step * (i - 1)
      local v = a0 - a1*cos(t) + a2*cos(2*t) - a3*cos(3*t)
      w[i] = v
      w[N + 1 - i] = v
    end
  else
    local b   = fftsa.kbeta()
    local i0b = fftsa.bessel_i0(b)
    for i = 1, half do
      local u = 2*(i-1)/(N-1) - 1
      local s = 1 - u*u
      if s < 0 then s = 0 end
      local v = fftsa.bessel_i0(b * sqrt(s)) / i0b
      w[i] = v
      w[N + 1 - i] = v
    end
  end
  fftsa.fft_win = w
  local wsum = 0
  for i = 1, N do wsum = wsum + w[i] end
  fftsa.fft_wsum = wsum           -- fftsa.fft_load() divides by it to weight the mean
  fftsa.fft_cg = wsum / N
  -- Volts would be 2/(N*cg); the untangle leaves every bin doubled, so 1/(N*cg),
  -- squared because the output is power.
  local k = 1 / wsum
  fftsa.fft_ksq = k * k
  return w
end

-- ===================== peak interpolation, per window =====================
-- A tone at bin k+d puts the three bins around the peak at -d, 1-d and 1+d on the
-- window's own transform, so with
--   G(x) = |sum w[i]*cos(2*pi*x*(i-c)/N)| / sum w[i],    c = (N+1)/2
-- the normalised main lobe, the ratio r = (R-L)/(L+2C+R) is a fixed odd function of d and
-- the scalloping loss is exactly G(d). fft_gtab samples G out to 1.5 bins and fft_dtab
-- inverts it to r -> d. Both come from the window samples in use, so a window change
-- needs no new constants; the grids put d, 1-d and 1+d on gtab nodes.
fftsa.fft_ghx  = 0.025    -- gtab step, in bins
fftsa.fft_gn   = 60       -- gtab spans 0 .. fft_gn*fft_ghx = 1.5 bins
fftsa.fft_dn   = 40       -- dtab nodes, spaced uniformly in r
fftsa.fft_gtab = nil
fftsa.fft_dtab = nil
fftsa.fft_dhr  = 0        -- dtab step in r; 0 means there is no usable table
fftsa.win_mono = false    -- r(d) rose all the way to half a bin

-- Bins above DC that the mean removal in fftsa.fft_load() makes unreportable, and
-- the amplitude error that decides which they are. Set by fftsa.win_tables(), read
-- by fftsa.find_peaks(). 0 before the first fftsa.fft_init().
fftsa.fft_dctol = 0.05    -- 5 % of amplitude, 0.45 dB
fftsa.fft_kdc   = 0
fftsa.fft_kdcn  = 6       -- bins scanned; covers Kaiser b=18's 5.82-bin main lobe

-- Costs (fft_gn+1)*N/2 cosines at init and nothing per frame.
function fftsa.win_tables(N)
  local cos, floor = math.cos, math.floor
  local w   = fftsa.fft_win
  local M2  = floor(N / 2)            -- N is a power of two, so every sample pairs
  local ctr = (N + 1) / 2
  local hx  = fftsa.fft_ghx
  local nx  = fftsa.fft_gn
  local wsum = 0
  for i = 1, M2 do wsum = wsum + w[i] end
  wsum = 2 * wsum

  local g = {}
  local twopi_N = 2 * math.pi / N
  for j = 0, nx do
    local a = twopi_N * j * hx
    local s = 0
    for i = 1, M2 do s = s + w[i] * cos(a * (i - ctr)) end
    s = 2 * s / wsum
    if s < 0 then s = -s end
    g[j+1] = s
  end
  fftsa.fft_gtab = g

  -- r at every d node. one and nd are node counts, not lengths: 1 bin and half a bin.
  local one = floor(1/hx + 0.5)
  local nd  = floor(0.5/hx + 0.5)
  -- The grid has to reach 1 + 0.5 bins, and at the shipped values it reaches exactly
  -- that. Shrinking fft_gn without raising fft_ghx would read past the end of gtab
  -- and do arithmetic on a nil, so it fails here instead.
  if one + nd > nx then
    error("fft_gn " .. nx .. " is too small for fft_ghx " .. hx
          .. ": the gain table must reach 1.5 bins", 0)
  end
  local rt  = {}
  for jd = 0, nd do
    local C, R, L = g[jd+1], g[one-jd+1], g[one+jd+1]
    rt[jd+1] = (R - L) / (L + 2*C + R)
  end

  -- Invert onto a grid uniform in r, so a lookup is an index rather than a search.
  local mono = true
  for jd = 1, nd do
    if rt[jd+1] <= rt[jd] then mono = false end
  end
  fftsa.win_mono = mono
  local nr   = fftsa.fft_dn
  local rmax = rt[nd+1]
  local dt   = {}
  if mono and rmax > 0 then
    local hr = rmax / nr
    local jd = 0
    for m = 0, nr do
      local target = m * hr
      while jd < nd - 1 and rt[jd+2] < target do jd = jd + 1 end
      local r0, r1 = rt[jd+1], rt[jd+2]
      local f = 0
      if r1 > r0 then f = (target - r0) / (r1 - r0) end
      dt[m+1] = (jd + f) * hx
    end
    dt[nr+1] = nd * hx                -- the top of the table is exactly half a bin
    fftsa.fft_dhr = hr
  else
    fftsa.fft_dhr = 0
  end
  fftsa.fft_dtab = dt

  -- How far up from DC fftsa.fft_load()'s mean removal reaches, which is where
  -- fftsa.find_peaks() stops reporting. Removing a weighted mean of
  -- D + A*G(b)*cos(phase) takes 2*A*G(b)^2 out of the tone's own bin: at bin 1 a
  -- 1.000 V tone reads 0.589 V under Hann. The largest b, not the first, since G is
  -- not monotonic.
  local kdc = 0
  for b = 1, fftsa.fft_kdcn do
    local a = twopi_N * b
    local s = 0
    for i = 1, M2 do s = s + w[i] * cos(a * (i - ctr)) end
    s = 2 * s / wsum
    if 2 * s * s > fftsa.fft_dctol then kdc = b end
  end
  fftsa.fft_kdc = kdc
  return g, dt
end

-- Scalloping loss at offset d: the factor a tone's amplitude is read low by.
function fftsa.win_gain(d)
  local g = fftsa.fft_gtab
  if g == nil then return 1 end
  if d < 0 then d = -d end
  local t = d / fftsa.fft_ghx
  local m = math.floor(t)
  if m >= fftsa.fft_gn then return g[fftsa.fft_gn + 1] end
  local a = g[m+1]
  return a + (t - m) * (g[m+2] - a)
end

-- Sub-bin offset from the three-bin ratio r, by table inversion. Past the end of the
-- table the three bins are not one tone, and the offset saturates at half a bin.
function fftsa.win_offset(r)
  local hr = fftsa.fft_dhr
  if hr == nil or hr <= 0 then return nil end
  local neg = false
  if r < 0 then r = -r; neg = true end
  local nr = fftsa.fft_dn
  local d
  local t = r / hr
  local m = math.floor(t)
  if m >= nr then
    d = fftsa.fft_dtab[nr+1]
  else
    local a = fftsa.fft_dtab[m+1]
    d = a + (t - m) * (fftsa.fft_dtab[m+2] - a)
  end
  if neg then return -d end
  return d
end

-- Everything built here is a function of N and the window alone -- no rate, no span -- so a
-- call changing neither has nothing to do. That is the whole of the pause after an adopted
-- gesture: 0.163 ms a sample, which is 83 ms at 512 and a measured 2.667 s at 16384.
-- Keyed on the window INDICES, all win_build() reads; win_tables() also reads the five
-- interpolation constants, left out because nothing in the tree assigns them and a grid too
-- short raises. Cleared on the way in, so a raise part way is not taken for a finished build.
fftsa.fft_built_n = nil

function fftsa.fft_init(N)
  if fftsa.fft_built_n == N and fftsa.fft_built_win == fftsa.win_i
     and fftsa.fft_built_beta == fftsa.kbeta_i then
    return
  end
  fftsa.fft_built_n = nil
  local floor, sin, cos, pi = math.floor, math.sin, math.cos, math.pi
  local M = floor(N / 2)
  fftsa.fft_n   = N
  fftsa.fft_m   = M
  fftsa.fft_x   = {}
  fftsa.fft_re  = {}
  fftsa.fft_im  = {}
  fftsa.fft_pwr = {}

  fftsa.win_build(N)
  fftsa.win_tables(N)

  -- Bit-reversal as a swap list; only the pairs that move are kept.
  fftsa.fft_swp_a = {}
  fftsa.fft_swp_b = {}
  local n = 0
  local j = 0
  for i = 0, M-2 do
    if i < j then
      n = n + 1
      fftsa.fft_swp_a[n] = i + 1
      fftsa.fft_swp_b[n] = j + 1
    end
    local kk = floor(M/2)
    while kk <= j do j = j - kk; kk = floor(kk/2) end
    j = j + kk
  end
  fftsa.fft_nswp = n

  -- Butterfly twiddles for every stage, flattened: the stage with half-length h
  -- occupies the next h entries.
  fftsa.fft_twr = {}
  fftsa.fft_twi = {}
  local idx = 0
  local len = 4                  -- stage 1 (len=2) needs no twiddles
  while len <= M do
    local half = floor(len/2)
    local ang  = -2*pi/len
    for m = 0, half-1 do
      idx = idx + 1
      fftsa.fft_twr[idx] = cos(ang*m)
      fftsa.fft_twi[idx] = sin(ang*m)
    end
    len = len * 2
  end

  fftsa.fft_utr = {}
  fftsa.fft_uti = {}
  local ang = -2*pi/N
  for jj = 1, M do
    fftsa.fft_utr[jj] = cos(ang*(jj-1))
    fftsa.fft_uti[jj] = sin(ang*(jj-1))
  end
  -- Last, so that only a complete build is remembered.
  fftsa.fft_built_n = N
  fftsa.fft_built_win, fftsa.fft_built_beta = fftsa.win_i, fftsa.kbeta_i
end

-- Load N samples from a reading buffer, remove DC, window, and pack sample pairs into
-- the M complex points. Two passes, because the mean must be known before it is
-- subtracted; samples are staged in fftsa.fft_x, a buffer element costing far more to
-- read than a table entry. Returns the mean.
--
-- The mean is window-weighted, sum(w*x)/sum(w). What has to vanish is the DC of the
-- sequence the transform sees, sum(w*(x-m)) = sum(w*x) - m*sum(w), and only the weighted
-- mean makes it. The arithmetic mean zeroes the true DC instead and leaves the window's
-- own DC response spread over the first few bins: a 1.000 V tone at bin 10.5 then leaves
-- a -27 dBc line at bin 1 under every window, against -147 here.
--
-- The price is that near DC the estimate is the tone, so win_tables() measures how far
-- that reaches and find_peaks() stops reporting there.
-- The display task shares this core with the interpreter and runs only while Lua is
-- blocked, so a stretch with no delay() in it cannot dispatch a touch -- and at 16384
-- samples fft_load and fft_run are 0.5 s and 0.8 s of arithmetic. Hence many yield points
-- rather than one long one, placed where the enclosing loop is cheap so the per-sample
-- inner loops are untouched. Both gates are sized so 512 samples reaches neither.
fftsa.fft_yield     = 0.005   -- seconds blocked at a yield point
fftsa.fft_yield_n   = 2048    -- fft_load samples between yields
fftsa.fft_yield_m   = 1024    -- fft_run yields per stage only above this half-length

function fftsa.fft_load(buf)
  return fftsa.fft_load_rd(buf.readings)
end

-- The load from a plain array of readings. fftsa.fft_load above is the buffer-taking
-- wrapper; this is where the weighted-mean removal and the windowing live, in one copy.
function fftsa.fft_load_rd(rd)
  local N   = fftsa.fft_n
  local M   = fftsa.fft_m
  local x   = fftsa.fft_x
  local re  = fftsa.fft_re
  local im  = fftsa.fft_im
  local win = fftsa.fft_win

  local wsx = 0
  -- Chunked so the yield is per chunk, not per sample: a test inside this loop would
  -- cost more than the yields save. One chunk means no yield, which is the 512 case.
  local chunk = fftsa.fft_yield_n
  local lo = 1
  while lo <= N do
    local hi = lo + chunk - 1
    if hi > N then hi = N end
    local i
    for i = lo, hi do
      local v = rd[i]
      -- A sparse buffer must not put nils into the arithmetic; fftsa.frame_body()
      -- rejects a short capture before it gets here.
      if v == nil then v = 0 end
      x[i] = v
      wsx = wsx + v * win[i]
    end
    lo = hi + 1
    if lo <= N then delay(fftsa.fft_yield) end
  end
  local mean = wsx / fftsa.fft_wsum

  local i = 1
  for k = 1, M do
    re[k] = (x[i] - mean) * win[i]
    im[k] = (x[i+1] - mean) * win[i+1]
    i = i + 2
  end
  return mean
end

function fftsa.fft_run()
  local M     = fftsa.fft_m
  local re    = fftsa.fft_re
  local im    = fftsa.fft_im
  local swp_a = fftsa.fft_swp_a
  local swp_b = fftsa.fft_swp_b
  local twr   = fftsa.fft_twr
  local twi   = fftsa.fft_twi
  local floor = math.floor

  for s = 1, fftsa.fft_nswp do
    local a, b = swp_a[s], swp_b[s]
    re[a], re[b] = re[b], re[a]
    im[a], im[b] = im[b], im[a]
  end

  -- Stage 1: len = 2, twiddle == 1+0i, so pure add/sub.
  for i = 1, M, 2 do
    local ar, ai, br, bi = re[i], im[i], re[i+1], im[i+1]
    re[i]   = ar + br
    im[i]   = ai + bi
    re[i+1] = ar - br
    im[i+1] = ai - bi
  end

  local len  = 4
  local base = 0
  while len <= M do
    local half = floor(len/2)
    for i = 0, M-1, len do
      local ti = base
      for m = 1, half do
        ti = ti + 1
        local a  = i + m
        local b  = a + half
        local wr, wi = twr[ti], twi[ti]
        local xr, xi = re[b], im[b]
        local vr = xr*wr - xi*wi
        local vi = xr*wi + xi*wr
        local ar, ai = re[a], im[a]
        re[b] = ar - vr
        im[b] = ai - vi
        re[a] = ar + vr
        im[a] = ai + vi
      end
    end
    base = base + half
    len  = len * 2
    if M > fftsa.fft_yield_m then delay(fftsa.fft_yield) end
  end
end

-- Untangle the half-size transform into the N/2 real-input bins and write their power,
-- volts-squared peak, into fftsa.fft_pwr[1..M]. Bin j is the frequency (j-1)*fs/N.
--
-- With Z the M-point transform of the packed input and Zc the conjugate of Z at the
-- mirror index (M-k) mod M,
--   X[k] = (Z + Zc)/2 + e^(-2*pi*i*k/N) * (Z - Zc)/(2i)
-- Bins k and M-k share the same four loads, so the pass walks mirror pairs; bin 0 and
-- bin M/2 are their own mirrors.
function fftsa.fft_power()
  local M    = fftsa.fft_m
  local re   = fftsa.fft_re
  local im   = fftsa.fft_im
  local pwr  = fftsa.fft_pwr
  local utr  = fftsa.fft_utr
  local uti  = fftsa.fft_uti
  local ksq  = fftsa.fft_ksq
  local half = M / 2
  -- j = 1 is bin 0: X = Re Z[0] + Im Z[0], real
  local a, b = re[1], im[1]
  local s = 2 * (a + b)
  pwr[1] = s * s * ksq
  -- j = half+1 is bin M/2: its own mirror with twiddle -i, X = Re Z - i Im Z
  a, b = re[half+1], im[half+1]
  pwr[half+1] = 4 * (a*a + b*b) * ksq
  local pj = M + 1                 -- mirror of j is M - j + 2
  for j = 2, half do
    pj = pj - 1
    local a, b = re[j], im[j]
    local c, d = re[pj], im[pj]
    local wr, wi = utr[j], uti[j]
    local s1, s2, d1, d2 = a + c, b + d, a - c, b - d
    local t1 = wr*s2 + wi*d1
    local t2 = wi*s2 - wr*d1
    local xr, xi = s1 + t1, d2 + t2
    pwr[j] = (xr*xr + xi*xi) * ksq
    xr, xi = s1 - t1, t2 - d2
    pwr[pj] = (xr*xr + xi*xi) * ksq
  end
  return M
end

-- Sub-bin peak estimate from the peak bin and its two neighbours. From the peak bin
-- alone a tone between centres is off by up to half a bin and low by the scalloping loss,
-- 1.42 dB with Hann; both come back from the window's own main lobe. Returns d in
-- -0.5..0.5 and volts, or 0 and nil at a spectrum edge, where callers use the bin.
function fftsa.peak_interp(k, nb)
  local pwr = fftsa.fft_pwr
  if k == nil or k < 2 then return 0, nil end
  if nb ~= nil and k >= nb then return 0, nil end
  local pc = pwr[k]
  local pl = pwr[k-1]
  local pr = pwr[k+1]
  if pc == nil or pl == nil or pr == nil or pc <= 0 then return 0, nil end
  local sqrt = math.sqrt
  local C, L, R = sqrt(pc), sqrt(pl), sqrt(pr)
  local den = L + 2*C + R
  if den <= 0 then return 0, nil end
  local d = fftsa.win_offset((R - L) / den)
  if d == nil then return 0, nil end           -- no table: no estimate
  local g = fftsa.win_gain(d)
  if g <= 0 then return d, C end
  return d, C / g
end


-- ================= tsp/spectrum_ui.tsp =================
-- spectrum_ui.tsp -- the loading cover and the peak finder.

fftsa = fftsa or {}   -- the single global this app exposes

-- ---------- loading cover ----------
-- A screen holding nothing but a line of text, kept in front while the real screens are
-- built and while Apply rebuilds the window tables. Creating a screen makes it active, so
-- every screen build raises this again before its first child, or the operator watches a
-- screen assemble itself one create at a time. Made once, deleted once by stop(); raising
-- it is a changescreen and nothing else, since a create/delete per raise would churn the
-- 463-object pool.
if fftsa.load_handles_inited == nil then
  fftsa.loadscr = nil
  fftsa.loadtxt = nil
  fftsa.load_handles_inited = true
end
-- x for the string below on FONT_MEDIUM, measured on the panel.
fftsa.load_x = 261
fftsa.load_y = 214

function fftsa.loading_build()
  if fftsa.loadscr ~= nil then return fftsa.loadscr end
  fftsa.loadscr = display.create(display.ROOT, display.OBJ_SCREEN, "FFT SPECTRUM ANALYSER")
  if fftsa.loadscr == nil then return nil end     -- pool exhausted; a visible build is the cost
  fftsa.loadtxt = display.create(fftsa.loadscr, display.OBJ_TEXT, fftsa.load_x, fftsa.load_y,
                                 "Loading, please wait...", 16777215, display.FONT_MEDIUM)
  -- End App is hooked here too: the firmware may deliver EVENT_ENDAPP only to the
  -- visible screen, and this is the visible one while Apply rebuilds the tables.
  display.setevent(fftsa.loadscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  return fftsa.loadscr
end

function fftsa.loading_front()
  if fftsa.loadscr == nil then return false end
  display.changescreen(fftsa.loadscr)
  return true
end

-- Put a real screen in front, then take the cover away. Switch first, delete
-- second: deleting the screen on show leaves the panel black.
function fftsa.loading_destroy(showscr)
  if showscr == nil then showscr = display.SCREEN_HOME end
  display.changescreen(showscr)
  if fftsa.loadscr == nil then return false end
  fftsa.del_obj(fftsa.loadtxt)
  fftsa.del_obj(fftsa.loadscr)
  fftsa.loadtxt, fftsa.loadscr = nil, nil
  return true
end

-- ---------- peak finder ----------

-- Top `count` local maxima of fftsa.fft_pwr, strongest first, as bin indices and power.
-- kmin/kmax restrict the search to the bins the graph shows, so the table never reports a
-- tone absent from the trace. Index 1 and the fftsa.fft_kdc bins above it carry the mean
-- removal's own error rather than signal, so neither is a candidate whatever kmin says.
function fftsa.find_peaks(nbins, count, kmin, kmax)
  local pwr = fftsa.fft_pwr
  -- Reused, not rebuilt: two tables a frame was the only allocation left in the frame
  -- path, and the house rule is to allocate once. Callers read them immediately.
  if fftsa.pk_bi == nil then fftsa.pk_bi, fftsa.pk_bv = {}, {} end
  local bi, bv = fftsa.pk_bi, fftsa.pk_bv
  for s = 1, count do bi[s] = 0; bv[s] = -1 end
  local k0 = 2 + (fftsa.fft_kdc or 0)
  if kmin == nil or kmin < k0 then kmin = k0 end
  if kmax == nil or kmax > nbins then kmax = nbins end
  for k = kmin, kmax do
    local m = pwr[k]
    -- A partial fftsa.fft_pwr (after a short read) can hold nils, and comparing
    -- a nil raises.
    if m ~= nil then
      local ml = pwr[k-1]
      local mr = pwr[k+1]
      -- A missing neighbour is the end of the spectrum and counts as lower. Inside
      -- a zoom window the neighbours are real bins even when off-screen, so the
      -- flank of an out-of-window tone does not read as a peak.
      if ml == nil then ml = -1 end
      if mr == nil then mr = -1 end
      -- m == m and mr == mr ARE THE NaN TESTS. This firmware implements a >= b as
      -- not (a < b), so m >= mr is TRUE when mr is a NaN and a bin beside one would be
      -- reported as a peak. Strict > needs no guard; >= does.
      if m == m and mr == mr and m > ml and m >= mr then
        -- A tone inside the DC region leaks enough into the first reportable bin to
        -- make it a local maximum, which then reports the tone a whole bin and 16 dB
        -- out. The estimator saturates at -0.5 there, saying the three bins are not one
        -- tone centred here -- so refuse a peak estimating a quarter bin or more below
        -- the lowest reportable bin. A genuine tone there estimates within 0.017 bins,
        -- against the leak's 0.500, so the margin sits in the middle of the gap.
        local keep = true
        if k == k0 then
          local d = fftsa.peak_interp(k, nbins)
          if (k - 1) + d < (k0 - 1) - 0.25 then keep = false end
        end
        if keep and m > bv[count] then
          local s = count
          while s > 1 and m > bv[s-1] do
            bv[s] = bv[s-1]; bi[s] = bi[s-1]; s = s - 1
          end
          bv[s] = m; bi[s] = k
        end
      end
    end
  end
  return bi, bv
end

-- A harmonic is h times an INTERPOLATED fundamental, so it misses the bin centre and the
-- window spreads it: halfw is the search radius.
fftsa.thd_halfw = 2

-- Bins either side of a line that hold the WINDOW's main lobe rather than noise. Counting
-- them as noise puts a floor under every figure: a fixed 3 capped reportable S/N at 38.5 dB
-- on Kaiser 18, against the 124.9 dB the window itself allows, measured on a pure tone at
-- 16384 samples. The first null in bins is 2 for Hann, 3 for Blackman, 4 for Blk-Harris
-- and sqrt(1 + (beta/pi)^2) for Kaiser -- 5.82 at beta 18 -- plus one bin of guard.
--
-- Sidelobes are NOT covered and cannot be: Kaiser 4's are 30 dB down and integrate to a
-- 36.7 dB ceiling whatever the skirt does. That is the window, not a measurement error.
fftsa.thd_lobes = {2, 3, 4}      -- Hann, Blackman, Blk-Harris

function fftsa.thd_skirt()
  local wi = fftsa.win_i
  local l = fftsa.thd_lobes[wi]
  if l == nil then
    -- Kaiser, the one window whose lobe moves with a setting.
    local b = fftsa.kbetas[fftsa.kbeta_i]
    if b == nil then b = 0 end
    l = math.ceil(math.sqrt(1 + (b / math.pi) * (b / math.pi)))
    if l < 2 then l = 2 end
  end
  return l + 1
end
fftsa.thd_hmax  = 20      -- ceiling on harmonics; the window top usually stops it first

-- The fundamental must clear the per-bin noise mean by this ratio before THD and S/N mean
-- anything: 45 dB. Measured at 16384 samples -- a shorted input's strongest bin stood
-- 17.1 dB over the mean, a FLOATING input's best surviving candidate stood 38.8 (a mains
-- harmonic at 1019 Hz, past the cutoff below), and an 8 Vp-p tone stood 117.9. The margin
-- goes between the floating case and the tone, which is where the useful gap is.
--
-- The cost is that a tone under 45 dB over the per-bin floor reads NoSig -- about 0.9 mV at
-- 16384 samples -- and its distortion would have been noise anyway. Raising the mains
-- cutoff instead has no natural stopping point, the harmonic series being endless, and
-- would discount legitimate quiet tones landing on multiples of 50.
fftsa.thd_minratio = 31623

-- A noise bin above this multiple of the running mean is an outlier, not noise. The plain
-- mean of a windowed spectrum is set by whichever few bins carry a line's leakage skirt:
-- measured at 16384 samples with the tone off a bin centre, Hann's skirt put the reported
-- floor at -80.2 dBV over a trace sitting at -100, and swung it 62 dB purely on where the
-- tone fell between bins. Widening the skirt cannot reach it -- Hann is still 45 dB down
-- four bins out -- but clipping can, since those bins are orders of magnitude up.
--
-- Each pass tightens the threshold and the loop stops when one removes nothing. On noise
-- with no outliers the clip trims the top few per cent and costs 0.5 dB.
-- Mains pickup is not the signal under test. A floating input reads 60 Hz at -25.4 dBV
-- with harmonics out to 540, which made the hum the fundamental and reported its own
-- distortion as the instrument's: 11.04% measured, over a -105.2 dBV floor. A candidate at
-- a multiple of 50 or 60 Hz, below thd_mains_fmax and at or under -22 dBV, is passed over
-- so the search moves on -- and with nothing else there the margin then answers NoSig.
--
-- The harmonics have to go too, or discounting 60 Hz alone promotes 120 at -46.3 dBV,
-- which still clears the margin by 59 dB.
fftsa.thd_mains      = {50, 60}
fftsa.thd_mains_pwr  = 0.0063096   -- -22 dBV expressed as power
fftsa.thd_mains_fmax = 1000        -- above this a tone on a mains multiple is a tone

-- Bins the noise figures sample. They do not need all of them: the standard error of a
-- mean over 2048 bins is 0.1 dB, well inside the 0.5 dB the clip already costs, and the
-- clip wants several passes. Measured on the instrument, all 8192 bins at 16384 samples
-- cost 0.498 s a call and took the frame from 1.67 s to 2.17 s -- 30% of it, for a figure
-- that updates once a second. Striding holds it to a few per cent.
fftsa.thd_nsample = 1024

fftsa.thd_clip  = 4
fftsa.thd_clips = 6

-- Is this candidate mains pickup rather than the signal? Level first, because it is the
-- cheap test and the common answer. Called only when a candidate beats the running
-- maximum, which happens a handful of times over a spectrum, not once a bin.
function fftsa.thd_is_mains(fhz, p, binhz)
  if not (p <= fftsa.thd_mains_pwr) then return false end
  if not (fhz < fftsa.thd_mains_fmax) then return false end
  local tol = binhz
  if not (tol > 2) then tol = 2 end
  local i
  for i = 1, 2 do
    local f = fftsa.thd_mains[i]
    local n = math.floor(fhz / f + 0.5)
    if n >= 1 then
      local d = fhz - n * f
      if d < 0 then d = -d end
      if d <= tol then return true end
    end
  end
  return false
end

-- Sum and count the bins that are neither a line nor a skirt and do not exceed ceil. The
-- exclusion list is walked alongside the bins: one comparison a bin, not one a line a bin,
-- which at 8192 bins and twenty harmonics is what keeps this affordable. Module level, not
-- a local closure, because the house rule is to allocate once.
function fftsa.thd_noise_pass(pwr, kmin, kmax, ex, nex, skirt, ceil, stride)
  local sum, cnt, e, k = 0, 0, 1, nil
  for k = kmin, kmax, stride do
    while e <= nex and ex[e] + skirt < k do e = e + 1 end
    if e > nex or k < ex[e] - skirt then
      local p = pwr[k]
      -- p == p IS THE NaN TEST. Measured on this firmware, nan >= 0 and nan <= 1/0 are
      -- both TRUE -- it implements a >= b as not (a < b), which inverts the unordered
      -- case -- so neither ordered guard rejects one. Strict > and < are correct, which
      -- is why the searches above can rely on them. Unguarded, one NaN bin makes the sum
      -- NaN and the whole readout degrades to NoSig; one infinity reads "inf dBV".
      if p ~= nil and p == p and p >= 0 and p <= ceil then
        sum = sum + p
        cnt = cnt + 1
      end
    end
  end
  return sum, cnt
end

-- THD and the noise floor over the plotted bins, as a percentage and dBV.
--
-- Amplitudes come from fftsa.peak_interp, not bin maxima, which read up to 3.9 dB low on a
-- tone between bins. The noise floor is the MEAN POWER of every bin that is not a line or
-- its skirt: averaging decibels instead lets one deep null drag it down several dB.
--
-- Both nil with nothing to measure. THD alone is nil when no harmonic fits in the window,
-- which is not a clean signal and must not read as 0.00%.
-- flo and fhi are the analysis window, defaulting to the display module's fields where the
-- shipped callers keep them; dsp.* passes its own, because reading the display's span from
-- inside the signal path is the seam crossed backwards and holds only while both halves are
-- Lua. No dB floor goes in: see the noise figure below.
function fftsa.thd_noise(nb, binhz, flo, fhi)
  local pwr = fftsa.fft_pwr
  if pwr == nil or nb == nil or nb < 8 then return nil, nil, 0 end
  if binhz == nil or not (binhz > 0) then return nil, nil, 0 end
  local sqrt, floor, log10 = math.sqrt, math.floor, math.log10
  local k0 = 2 + (fftsa.fft_kdc or 0)
  local kmin, kmax = fftsa.sg_window_bins(nb, binhz, flo, fhi)
  if kmin < k0 then kmin = k0 end
  if kmax > nb then kmax = nb end
  if kmax - kmin < 4 then return nil, nil, 0 end

  local k, kf, pf = nil, nil, 0
  for k = kmin, kmax do
    local p = pwr[k]
    -- A partial fftsa.fft_pwr after a short read holds nils, and comparing one raises.
    -- Strict > rejects a NaN correctly on this firmware where >= does not.
    if p ~= nil and p > pf then
      -- A LOCAL MAXIMUM, or the shoulder of a louder line qualifies. Measured with the
      -- inputs floating: the 60 Hz line sat in bin 11 and was discounted as mains, but
      -- bin 12 at 67.1 Hz -- its own skirt, 8 dB down -- missed the mains tolerance by
      -- 1 Hz and became the fundamental, giving 21.4% distortion on no signal at all.
      -- A monotonic skirt has no local maximum; a real tone is one.
      local l, r = pwr[k - 1], pwr[k + 1]
      if (l == nil or p > l) and (r == nil or (r == r and p >= r))
         and not fftsa.thd_is_mains((k - 1) * binhz, p, binhz) then
        kf, pf = k, p
      end
    end
  end
  -- No fundamental is NOT the end of it: the floor is the useful number with the inputs
  -- disconnected, and a flat spectrum has no local maximum at all. vf nil carries that
  -- through to the noise pass with nothing excluded.
  local df, vf = 0, nil
  if kf ~= nil and pf > 0 then
    df, vf = fftsa.peak_interp(kf, nb)
    if vf == nil then df, vf = 0, sqrt(pf) end
    if not (vf > 0) then vf = nil end
  end

  -- Line centres, ascending by construction. Reused: the house rule is to allocate once.
  local ex = fftsa.thd_ex
  if ex == nil then ex = {}; fftsa.thd_ex = ex end
  local nex, hsum, nh = 0, 0, 0
  if vf ~= nil then
    ex[1] = kf
    nex = 1
  end
  local halfw, skirt = fftsa.thd_halfw, fftsa.thd_skirt()
  local fb = 0
  if vf ~= nil then fb = kf - 1 + df end  -- the fundamental, in bins from DC
  local h
  for h = 2, fftsa.thd_hmax do
    if vf == nil then break end
    local c = fb * h + 1                  -- the h'th harmonic's predicted 1-based bin
    if c + halfw > kmax then break end
    local a, b = floor(c - halfw + 0.5), floor(c + halfw + 0.5)
    if a < kmin then a = kmin end
    local bk, bp = nil, -1
    for k = a, b do
      local p = pwr[k]
      if p ~= nil and p > bp then bk, bp = k, p end
    end
    if bk ~= nil and bp > 0 and bk > ex[nex] + skirt then
      local hd, hv = fftsa.peak_interp(bk, nb)
      if hv == nil then hv = sqrt(bp) end
      hsum = hsum + hv * hv
      nh, nex = nh + 1, nex + 1
      ex[nex] = bk
    end
  end

  -- One in every stride bins, which is what keeps the clip affordable. See thd_nsample.
  local stride = math.floor((kmax - kmin + 1) / fftsa.thd_nsample)
  if stride < 1 then stride = 1 end
  -- A finite ceiling, not 1/0: inf <= 1/0 is true and inf <= 1e308 is not, so this is
  -- what keeps an infinite bin out of the first pass.
  local sum, cnt = fftsa.thd_noise_pass(pwr, kmin, kmax, ex, nex, skirt, 1e308, stride)
  -- Again with the outliers clipped. See fftsa.thd_clip for why the plain mean is not the
  -- floor the trace shows.
  for h = 1, fftsa.thd_clips do
    if not (cnt > 0 and sum > 0) then break end
    local csum, ccnt = fftsa.thd_noise_pass(pwr, kmin, kmax, ex, nex, skirt,
                                            (sum / cnt) * fftsa.thd_clip, stride)
    -- Converged: a pass that removed nothing means the next would too.
    if ccnt == cnt or ccnt < 1 or not (csum > 0) then break end
    sum, cnt = csum, ccnt
  end

  local ndb, snr = nil, nil
  if cnt > 0 and sum > 0 then
    local mean = sum / cnt
    -- Not clamped to the plot's floor. The floor is a measurement, not a plotted point, and
    -- clamping it to the axis reports the axis. Measured here at -110 to -111 dBV, averaging
    -- about -110.6 and best -111.2, at 16,384 samples on Hann -- all four inputs shorted,
    -- weeks of continuous uptime, 22 C +/- 1 and 40 to 45 % RH. The conditions qualify it: a
    -- shorting block makes this the instrument's own noise rather than pickup, and a cold
    -- start reads worse, so a figure taken any other way is not this one. A DMM7510 reads
    -- -134 dBV on its 0.1 V range and -129 on 1 V, under what a -120 axis can show, which is
    -- what fftsa.sg_dbmin_for() moves the floor to -140 for.
    --
    -- log10 is safe without a guard: this branch needs cnt > 0 and sum > 0 above.
    ndb = 10 * log10(mean)
    -- NO FUNDAMENTAL, NO RATIOS. With the inputs shorted the strongest bin is a noise
    -- peak, and both ratios built on it are arithmetic about nothing -- 31.8% and -22 dB.
    -- The floor still reports: shorted, it is the instrument's own and the useful number.
    if vf ~= nil and vf * vf > mean * fftsa.thd_minratio then
      -- Against the INTEGRATED noise, not the per-bin mean, so it holds still when the
      -- sample count changes. Harmonics are out of the sum, so this is not THD restated.
      -- The halves of both mean squares cancel in the ratio.
      -- sum * stride is the integrated noise: the sampled sum scaled back up, which is
      -- unbiased. The mean is sum/cnt, where the stride cancels.
      snr = 10 * log10(vf * vf / (sum * stride))
    else
      nh = 0
    end
  end
  local thd = nil
  if nh > 0 then thd = 100 * sqrt(hsum) / vf end
  return thd, ndb, nh, snr
end


-- ================= tsp/spectrum_graph.tsp =================
-- spectrum_graph.tsp -- spectrum display built on the instrument's own graph object
--
-- X binds to the reading's extra field rather than its timestamp, which makes this the
-- firmware's numeric x-y plot: the axis takes real hertz and labels itself. Y is dBV
-- under a two-character custom buffer unit, which is what labels that axis in dB. A child
-- inside the graph's rectangle is painted over by the repaint, so nothing can be drawn
-- over the firmware's axis row.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.sg_nbins   = 256
fftsa.sg_npeak   = 6       -- number of peaks reported (shown in a 2x3 grid)

-- Points a frame writes: the only number that sets the widget's work, so it is fixed
-- rather than sized to the span. One per pixel would be 680 and costs 77 ms a fill
-- against 28 ms here. Each carries its column's maximum, which reads the noise floor 6 dB
-- high. Settable up to sg_maxpts while running: FILL_ONCE and cleared, so n follows.
fftsa.sg_ncol    = 255

-- PEAK MARKERS, off by default. A second trace of one point a peak, carrying the
-- interpolated frequency and amplitude the peak table reports -- so a marker sits where
-- the peak really is, which is up to half a bin off the column the trace draws there.
-- Switching it on rebinds the graph, which repaints the axes, so it only happens on Apply.
fftsa.sg_markers = false
-- Needles, not dots: drawstyle is per graph, so markers on the peak trace would put one
-- on all 255 spectrum points too. Three points a peak -- floor, peak, floor, a pixel
-- either side -- draws a vertical needle with the run between them along the bottom rule.
fftsa.sg_mk_per  = 3       -- points a needle: floor, peak, floor
-- Firmware floor on a reading buffer, event 4920. Ask for less and buffer.make returns
-- nil rather than refusing, so every later call on the handle is a 1138.
fftsa.sg_bufmin  = 10
fftsa.sg_maxpts  = 680

-- Firmware handles, initialised only on the first load: opening the App again
-- re-runs this body and `fftsa = fftsa or {}` keeps the table, so nil-ing a live
-- handle here would strand the previous launch's objects. fftsa.sg_destroy()
-- reclaims them on the next start.
if fftsa.sg_handles_inited == nil then
  fftsa.sg_buf   = nil     -- WRITABLE_FULL buffer holding the spectrum
  fftsa.sg_scr   = nil     -- custom screen
  fftsa.sg_graph = nil     -- OBJ_GRAPH object
  fftsa.sg_pk_f  = nil     -- per-peak frequency text (own field, fixed x)
  fftsa.sg_pk_v  = nil     -- per-peak voltage text  (own field, fixed x)
  fftsa.sg_pk_d  = nil     -- per-peak dB text       (own field, fixed x)
  fftsa.sg_xunit = nil     -- settings line under the peak rows
  fftsa.sg_stat  = nil
  fftsa.sg_mk    = nil
  fftsa.sg_handles_inited = true
end

-- Touch pans and zooms the graph and the widget cannot be told not to: display.setstate
-- answers event 1717 for STATE_DISABLE and STATE_READONLY on a Graph. So a gesture is
-- settled after the fact, and this says how the frequency axis settles -- locked, back onto
-- the span in force; unlocked, the span follows the axis. dB is restored either way. Not a
-- handle, so a relaunch resets it.
fftsa.sg_lock = true

-- Visible frequency window (Hz): fftsa.dsp_window() hands it to the primitive, which plots
-- only the bins inside it, and fftsa.sg_pin_x() pins the axis to it.
fftsa.sg_flo_hz  = 0
fftsa.sg_fhi_hz  = 1e9

-- The pinned window is the only stable choice. XSCALE_ALL derives the range from the
-- buffer's own timestamps, which move while a frame refills, so a paint landing mid-fill
-- ranges on a partial trace and the axis walks -- on the glass, the trace sliding about as
-- though the point count were changing. Any auto-ranging method also fights the view lock,
-- which then writes an axis a second for as long as both are on.
fftsa.sg_xmethod = display.XSCALE_OFF
-- The clear is the only notify compatible with FILL_ONCE. select, scaletrace, drawstyle
-- and re-asserting scalex all do make the task re-read a bound buffer, but each needs it
-- overwritten in place, which needs FILL_CONTINUOUS, which draws the wrap line.


-- Geometry on the 800x480 panel, in object coordinates: those start below the 49-pixel
-- title bar, so a child at y=350 lands on panel row 399. The graph takes the full height
-- above the peak table and the firmware labels the axis inside it, so no row is reserved.
fftsa.sg_gx      = 8
fftsa.sg_gy      = 0
fftsa.sg_gw      = 784
fftsa.sg_gh      = 312

-- The dB axis floor: -120 dBV, and -140 on a DMM7510's 1 V and 0.1 V ranges. Measured floors,
-- which is what picks both numbers -- a DMM7510 reads -134 dBV on 0.1 V and -129 on 1 V, so
-- -120 leaves its two quiet ranges off the bottom of the plot and -140 clears them by 6 dB. A
-- DMM6500 reads -123 and -121 on the same ranges and stays at -120 everywhere, its floor
-- being within a few dB of the axis rather than under it. sg_dbmin is the floor in force and
-- fftsa.sg_dbmin_set() is the only thing that moves it, from the range apply() commits.
fftsa.sg_dbmin_std       = -120
fftsa.sg_dbmin_7510      = -140
fftsa.sg_dbmin_7510_vmax = 1     -- the largest range the deeper floor covers
fftsa.sg_dbmin           = fftsa.sg_dbmin_std   -- the floor in force
fftsa.sg_dbmax           = 20
fftsa.sg_vfloor          = 1e-9

fftsa.model_str = nil        -- localnode.model, read once by fftsa.model_name()

-- Past this, in volts, a reading is not a voltage. The digitizer answers 9.9e+37 for a reading
-- beyond the selected range, where the front panel shows "Overflow", and a handful of those in
-- a record makes the spectrum an impulse: flat against the ceiling at every frequency, with
-- the real tone buried under its own clipped samples. 15 V clears the largest range this app
-- offers, 10 V, and its headroom, while sitting 36 decades under the sentinel -- so the test
-- cannot catch a real reading and cannot miss a sentinel.
fftsa.sg_vmax_real = 15
fftsa.overrange    = false   -- the frame's verdict; the peak table and the THD line read it
fftsa.sg_pk_over   = false   -- whether the dashed table is the one on screen

-- Plotted width in pixels, measured off a panel capture: the vertical grid rules land at
-- x = 100, 168 ... 780, eleven of them 68 px apart. Used to decide when an axis limit can
-- be moved without it showing.
fftsa.sg_plotpx  = 680

-- fftsa.sg_fhi_hz starts at a sentinel meaning "every bin". A span wider than this is
-- not a plottable axis, so sg_pin_x() makes no call until fftsa.apply() narrows it.
fftsa.sg_fmax_real = 1e6

-- Peak table: 6 rows as two columns of three. freq/volt/dB are separate objects at
-- fixed x, so the volt and dB columns do not jitter as the proportional-font
-- frequency text changes width. The Options button sits in the right margin beside the
-- first row.
fftsa.sg_pky     = 350     -- first peak row baseline
fftsa.sg_pkdy    = 20      -- row pitch
fftsa.sg_pk_colx_f = {8,   360}   -- frequency field x, per column
fftsa.sg_pk_colx_v = {118, 470}   -- voltage field x,   per column
fftsa.sg_pk_colx_d = {200, 552}   -- dB field x,        per column
fftsa.sg_pk_cf   = 14745568  -- freq colour (pale green)
fftsa.sg_pk_cv   = 13166335  -- volt colour (pale blue)
fftsa.sg_pk_cd   = 16769184  -- dB colour   (pale amber)
fftsa.sg_xunit_x = 8
fftsa.sg_xunit_y = 410       -- settings line, below the peak rows
fftsa.sg_xunit_c = 56575     -- cyan 00DCFF, the colour of the Options preview line
-- Saturated red FF0000 for the over-range banner, against the pale palette the rest of the
-- panel uses: this is the one line that is a warning rather than a reading. Decimal, which
-- the display API requires -- "0x00rrggbb ... must be given as decimal".
fftsa.sg_over_c  = 16711680
fftsa.sg_xunit_c_now = nil   -- the colour the line is actually carrying

-- Distortion and noise, between the graph (ends at sg_gy + sg_gh = 312) and the first
-- peak row (sg_pky = 350). Pale amber, the dB column's colour, since both are levels.
fftsa.sg_thd_x = 8
fftsa.sg_thd_y = 328
fftsa.sg_thd_c = 16769184
fftsa.sg_thd_last = nil      -- the text on screen, so an unchanged line is not rewritten

-- Decimals follow the record length: two below 8,192 samples, three from 8,192 and four from
-- 16,384. 0.016 % and 0.019 % both read 0.02 % at two, and a digit is only worth printing once
-- the record is long enough to hold a harmonic in one bin -- each doubling halves the bin
-- width and so the power leaking into its neighbours. Gated on the committed sample count, so
-- the line cannot offer a precision the plan in force did not deliver.
fftsa.sg_thd_n3 = 8192     -- samples the third decimal needs
fftsa.sg_thd_n4 = 16384    -- and the fourth

-- The nil test is the point: display.create answers nil on an exhausted pool, and the app
-- module deletes handles it may never have built. No pcall -- a refused delete posts an
-- event and returns, so a wrapper can never be false; the suite's live-object counts
-- around a teardown are what catch one.
function fftsa.del_obj(h)
  if h == nil then return true end
  display.delete(h)
  return true
end

function fftsa.del_buf(b)
  if b == nil then return true end
  buffer.delete(b)
  return true
end

-- The X limits the axis should hold, nil for a span that is not plottable. Shared by
-- sg_pin_x and sg_restore so the moved-or-not test cannot disagree with the pin. Start
-- moves to DC where that is under one pixel, because the firmware steps ticks from the
-- lower limit and a 10 Hz Start on a 50 kHz span would label them +00.01kHz; conditional,
-- or a real zoom loses its own limits.
function fftsa.sg_xwant()
  local lo, hi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if hi > fftsa.sg_fmax_real or hi <= lo then return nil, nil end
  if lo > 0 and lo * fftsa.sg_plotpx < (hi - lo) then lo = 0 end
  return lo, hi
end

-- Pin the X axis to the window: auto-range rounds outward to tidy tick values, so
-- the pixel of a given frequency would be unknowable and the firmware's labels would not
-- describe the span.
function fftsa.sg_pin_x()
  if fftsa.sg_graph == nil then return false end
  local lo, hi = fftsa.sg_xwant()
  if lo == nil then return false end
  local m = fftsa.sg_xmethod
  if m == nil then m = display.XSCALE_OFF end
  -- IN HERTZ, not scaled. The trace is bound as a numeric x-y plot, X from the reading's
  -- extra field, which carries the bin's real frequency -- so the axis limits are the
  -- real span and the firmware labels them itself, with an SI prefix: +00.00kHz and so
  -- on. No pcall: the call does not raise, it posts an event, so a wrapper buys nothing
  -- and costs a closure and a frame per call.
  display.graph.scalex(fftsa.sg_graph, m, display.AXIS_NORMAL, lo, hi)
  return true
end

-- The settings line: what Options holds that the axes do not already show, so neither the
-- span nor the dB range is repeated. Written twice per Apply, before the capture and again
-- after, so the rate and bin width it ends up showing are the measured ones.
function fftsa.sg_xunit_text()
  -- Over-range replaces the line rather than appending to it: there is no room for both, and
  -- a record the range could not represent makes the point count and the bin width beside the
  -- point. The trace is left as it is -- flat against the ceiling, which is what the capture
  -- actually was.
  if fftsa.overrange then return fftsa.sg_overrange_text(fftsa.range) end
  -- Total for the same reason opt_info_text is: apply() builds this line after the
  -- hardware is already configured, so a nil count or a range index the labels do not
  -- hold has to read as a gap rather than abort the Apply.
  local t = string.format("%d pts   %s   %s", fftsa.n or 0,
                          tostring(fftsa.opt_info_text(fftsa.fs, fftsa.n)),
                          tostring(fftsa.range_labels[fftsa.range_to_idx(fftsa.range)]))
  -- Start 1999 / Stop 2000 is a legal pair and one plotted point at 195.3 Hz bins: the
  -- trace is a dot, five peak rows read ---, and this count is the only thing that says
  -- why. The width is already in the line, so the count alone is enough.
  local b = fftsa.binhz
  if b ~= nil and b > 0 then
    local k0, k1 = fftsa.sg_window_bins(fftsa.sg_nbins, b)
    local n = k1 - k0 + 1
    if n < 3 then
      local plural = "s"
      if n == 1 then plural = "" end
      t = t .. string.format("   only %d bin%s in the span", n, plural)
    end
  end
  -- Last on the line, and always present: the selection is only useful if its absence
  -- cannot be read as FRONT.
  return t .. "   " .. fftsa.terminal_text()
end

-- The trace buffer: WRITABLE_FULL carries value, extra and timestamp per point, the value
-- dB under a custom unit and the extra the bin's frequency in hertz. Made once at the
-- sg_maxpts ceiling rather than the current sg_ncol, so nothing reallocates while frames
-- run, and freed only by sg_destroy().
--
-- The clear is the notify: the display task holds its own copy of the readings and
-- re-reads only when handed a buffer, so overwriting one in place changes nothing.
function fftsa.sg_make_buffer(nbins, npoints)
  fftsa.sg_nbins = nbins
  local want = npoints or fftsa.sg_maxpts
  -- Already built at the right size: keep it, and write nothing but sg_nbins. sg_build()
  -- is the only caller and start() the only caller of that, so this is the one place the
  -- no-reallocation rule is stated in code rather than left implicit in the call graph.
  if fftsa.sg_buf ~= nil and fftsa.sg_mk ~= nil and fftsa.sg_buf.capacity == want then
    return fftsa.sg_buf
  end
  -- Detach before deleting: the firmware refuses to delete a buffer still bound to a
  -- graph, so remaking one while attached leaves the old buffer alive and still bound,
  -- and the widget draws both -- a second trace overlaid at the old resolution.
  if fftsa.sg_graph ~= nil then
    display.graph.removeall(fftsa.sg_graph)
  end
  if fftsa.sg_buf ~= nil then
    fftsa.del_buf(fftsa.sg_buf)
    fftsa.sg_buf = nil
  end
  fftsa.sg_buf = fftsa.sg_mkbuf(want)
  -- The marker trace, one point a peak. Made here with the trace buffer and freed with it,
  -- whether or not markers are switched on: allocating it when the option is set would be
  -- an allocation while frames are running.
  if fftsa.sg_mk ~= nil then
    fftsa.del_buf(fftsa.sg_mk)
    fftsa.sg_mk = nil
  end
  local mkcap = fftsa.sg_npeak * fftsa.sg_mk_per
  if mkcap < fftsa.sg_bufmin then mkcap = fftsa.sg_bufmin end
  fftsa.sg_mk = fftsa.sg_mkbuf(mkcap)
  -- The marker sort's own slots, one more than the peak count because the insertion
  -- writes j+1 before n has grown.
  fftsa.sg_mk_db, fftsa.sg_mk_hz = {}, {}
  local j
  for j = 1, fftsa.sg_npeak + 1 do
    fftsa.sg_mk_db[j], fftsa.sg_mk_hz[j] = fftsa.sg_dbmin, 0
  end
  return fftsa.sg_buf
end

-- One trace buffer: FILL_ONCE, formatted, seeded full. Capacity is sg_maxpts, so a frame
-- writing sg_ncol points always fits, and fftsa.dsp_live() clamps a raised sg_ncol to it
-- -- one write past capacity is event 4915. Seeded because an empty buffer binds no trace at
-- all, and sg_build() binds this before the first frame has run.
function fftsa.sg_mkbuf(want)
  local b = buffer.make(want, buffer.STYLE_WRITABLE_FULL)
  -- FILL_ONCE: FILL_CONTINUOUS works as documented and still draws a line from the
  -- newest point to the oldest.
  --
  -- A custom unit is how the axis gets to say decibels; without it the labels read
  -- "+020.0V" on numbers that are not volts. Not buffer.UNIT_DECIBEL, which panics the
  -- instrument during build. The firmware truncates a custom label to two characters
  -- (event 4933), which is exactly "dB".
  buffer.unit(buffer.UNIT_CUSTOM1, "dB")
  buffer.write.format(b, buffer.UNIT_CUSTOM1, buffer.DIGITS_4_5,
                         buffer.UNIT_HERTZ,   buffer.DIGITS_6_5)
  local k
  for k = 1, want do
    fftsa.sg_write_point(b, fftsa.sg_dbmin, (k - 1) * 1.0, k)
  end
  return b
end

-- One point: value dB, extra the bin's frequency in Hz, timestamp a plain counter. The
-- timestamp carries nothing -- X is bound to the extra field -- but buffer.write.reading
-- documents chronological order, so it still has to be supplied and to increase. The slot
-- number serves, and as an integer cannot reach the fractional-seconds refusal at
-- 0.9999999 (event 1131, a modal dialog per point).
function fftsa.sg_write_point(buf, db, f, slot)
  if slot == nil then slot = 1 end
  buffer.write.reading(buf, db, f, slot, 0)
end


-- Build the screen once, at launch: graph, peak table, settings line. The frame loop only
-- refills the buffer and updates text.
function fftsa.sg_build(title, nbins, npoints)
  fftsa.sg_destroy()

  fftsa.sg_make_buffer(nbins, npoints)
  local create = display.create
  local small  = display.FONT_SMALL
  fftsa.sg_scr = create(display.ROOT, display.OBJ_SCREEN, title)
  -- create() returns nil when the pool is exhausted, posting one event and not raising.
  -- Without this test every child is built against a nil parent, which DOES raise -- in
  -- our code, not the firmware's. Answering nil and a reason is the same protection
  -- without raising: fftsa.build() passes it to fftsa.start(), which reports it.
  if fftsa.sg_scr == nil then
    fftsa.lasterr = "display object pool exhausted building the spectrum screen -- "
                    .. "power cycle the instrument."
    return nil, fftsa.lasterr
  end
  -- Creating a screen makes it active, so the cover goes back in front before the
  -- first child: otherwise the operator watches the screen assemble itself.
  fftsa.loading_front()

  fftsa.sg_graph = create(fftsa.sg_scr, display.OBJ_GRAPH, fftsa.sg_gx, fftsa.sg_gy, fftsa.sg_gw, fftsa.sg_gh)
  -- X is ELEMENT_EXTRA (the bin's frequency in Hz); Y is ELEMENT_DATA (dB).
  fftsa.sg_bind()

  fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d = {}, {}, {}
  for p = 1, fftsa.sg_npeak do
    local col, row = 1, p - 1
    if p > 3 then col = 2; row = p - 4 end
    local y = fftsa.sg_pky + row * fftsa.sg_pkdy
    if y > 418 then y = 418 end
    fftsa.sg_pk_f[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_f[col], y,
                        string.format("%d  ---", p), fftsa.sg_pk_cf, small, display.JUST_LEFT)
    fftsa.sg_pk_v[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_v[col], y, "", fftsa.sg_pk_cv, small, display.JUST_LEFT)
    fftsa.sg_pk_d[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_d[col], y, "", fftsa.sg_pk_cd, small, display.JUST_LEFT)
  end

  fftsa.sg_thd_last = nil
  fftsa.sg_thd = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_thd_x, fftsa.sg_thd_y,
                        fftsa.sg_thd_text(nil, nil, nil), fftsa.sg_thd_c, small, display.JUST_LEFT)

  fftsa.sg_xunit = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_xunit_x, fftsa.sg_xunit_y,
                          fftsa.sg_xunit_text(), fftsa.sg_xunit_c, small, display.JUST_LEFT)

  fftsa.sg_stat = nil     -- no on-screen status object
  return fftsa.sg_scr
end

-- Tear down in dependency order: detach the trace, drop the screen and its
-- children, then free the buffer the trace referenced. Nils every handle.
function fftsa.sg_destroy()
  if fftsa.sg_graph ~= nil then
    display.graph.removeall(fftsa.sg_graph)
  end
  if fftsa.sg_scr ~= nil then
    display.changescreen(display.SCREEN_HOME)
    fftsa.del_obj(fftsa.sg_scr)
  end
  fftsa.sg_scr, fftsa.sg_graph, fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d,
    fftsa.sg_xunit, fftsa.sg_stat, fftsa.sg_thd = nil, nil, nil, nil, nil, nil, nil, nil
  -- Deleted, not just dropped: a buffer whose handle is dropped is stranded and still
  -- counts against the instrument's capacity.
  if fftsa.sg_buf ~= nil then
    fftsa.del_buf(fftsa.sg_buf)
  end
  if fftsa.sg_mk ~= nil then
    fftsa.del_buf(fftsa.sg_mk)
  end
  fftsa.sg_buf, fftsa.sg_mk = nil, nil
  collectgarbage()
end


-- Bin index range covering the visible window, clamped into 1..nbins. Shared by
-- the plot and the peak search, so the table describes what is on screen.
--
-- THE SINGLE OWNER of the ceil/floor convention. Both halves of the app need it -- the peak
-- search, the noise pass, and the "only N bins in the span" line that is the only thing
-- saying why a one-dot trace has five empty peak rows -- and a second copy is free to round
-- the other way, which is one bin of disagreement in exactly that message. flo/fhi default
-- to the window the display has stored; dsp.* passes its own span instead, so the
-- primitives never write a display field to make this read the right one.
function fftsa.sg_window_bins(nbins, binhz, flo, fhi)
  if binhz == nil or binhz <= 0 then return 1, nbins end
  if flo == nil then flo = fftsa.sg_flo_hz end
  if fhi == nil then fhi = fftsa.sg_fhi_hz end
  local floor, ceil = math.floor, math.ceil
  -- ceil, not floor, for the low edge: floor() maps every start below one bin
  -- width (195 Hz at 100 kS/s) back to bin 1, the DC bin.
  local kmin = ceil(flo / binhz) + 1
  local kmax = floor(fhi / binhz) + 1
  if kmin < 1 then kmin = 1 end
  if kmin > nbins then kmin = nbins end
  if kmax > nbins then kmax = nbins end
  if kmax < kmin then kmax = kmin end
  return kmin, kmax
end

-- The window and the settings line, without the pin. Split out for the one caller that must
-- not pin: an adopted gesture about to re-plan has fftsa.apply() pinning from the same pair
-- a moment later, and an axis write is 60 ms.
-- The settings line, written so a raise cannot escape. Everything the line describes is
-- committed before it is built, and both writers sit inside apply() after the hardware is
-- configured, so a failure here is a stale line that says so in fftsa.lasterr rather than
-- an Apply that reports failure over cosmetics. The one place that writes it, so the two
-- callers cannot disagree about that. Not on the frame path: twice an Apply and once a
-- gesture, which is where a closure per call is affordable.
function fftsa.sg_write_xunit()
  if fftsa.sg_xunit == nil then return false end
  local ok, err = pcall(function()
    -- The colour belongs with the text, in the one place that writes the line: over-range is
    -- a warning and should read as one. Written only when it changes, like the text -- this
    -- is called twice an Apply and once a gesture, but the over-range transition brings it
    -- here from the tick, and a setcolor a second for an unchanged colour is waste.
    local c = fftsa.sg_xunit_c
    if fftsa.overrange then c = fftsa.sg_over_c end
    if c ~= fftsa.sg_xunit_c_now then
      fftsa.sg_xunit_c_now = c
      display.setcolor(fftsa.sg_xunit, c)
    end
    display.settext(fftsa.sg_xunit, fftsa.sg_xunit_text())
  end)
  if not ok then
    -- EVERY INPUT, not just the message. A "bad argument #2 to format (string expected,
    -- got nil)" was seen here once and could not be reproduced or explained: the call it
    -- names cannot return nil for any value this records. If it recurs, the values come
    -- with it rather than needing another afternoon.
    fftsa.lasterr = string.format(
      "settings line: %s [n=%s fs=%s fs_acq=%s range=%s rangetxt=%s win=%s "
      .. "binhz=%s nbins=%s term=%s]", tostring(err), tostring(fftsa.n), tostring(fftsa.fs),
      tostring(fftsa.fs_acq), tostring(fftsa.range),
      tostring(fftsa.range_labels[fftsa.range_to_idx(fftsa.range)]), tostring(fftsa.win_i),
      tostring(fftsa.binhz), tostring(fftsa.sg_nbins), tostring(fftsa.terminal_text()))
  end
  return ok
end

function fftsa.sg_store_xrange(flo_hz, fhi_hz)
  fftsa.sg_flo_hz = flo_hz
  fftsa.sg_fhi_hz = fhi_hz
  fftsa.sg_write_xunit()
end

-- "---", not a number, for anything unmeasured: 0.00% reads as a clean signal where no
-- harmonic in the window means no figure at all. dBV, as the peak table's dB column. n is
-- the sample count, and it chooses the THD decimal count and nothing else.
function fftsa.sg_thd_text(thd, snr, ndb, n, over)
  local t, s
  -- Over-range first, and dashed rather than named: every figure here would be arithmetic
  -- about 9.9e+37 instead of about volts. NoSig is the opposite diagnosis -- a quiet input --
  -- so using it would point an operator the wrong way. The floor goes too, being the one
  -- figure that is otherwise printed unclamped.
  if over then
    t, s, ndb = "THD: ---", "S/N: ---", nil
  -- Neither ratio means there is no fundamental to take them against, which is what a
  -- shorted input looks like. Named, not dashed, and the labels stay so the fields hold
  -- their places.
  elseif thd == nil and snr == nil then
    t, s = "THD: NoSig", "S/N: NoSig"
  else
    if thd == nil then t = "THD: ---"
    -- thd == thd is the NaN test: this firmware's >= is true for a NaN, so the branches
    -- below would print "nan%" rather than the dashes that mean "not measured".
    elseif thd ~= thd then t = "THD: ---"
    -- Past 100% -- a clipped input -- any decimal is a digit of noise.
    elseif thd >= 100 then t = string.format("THD: %.0f%%", thd)
    -- Longest record first. A missing count takes the short form: it is the one that cannot
    -- overstate the plan.
    elseif n ~= nil and n >= fftsa.sg_thd_n4 then t = string.format("THD: %.4f%%", thd)
    elseif n ~= nil and n >= fftsa.sg_thd_n3 then t = string.format("THD: %.3f%%", thd)
    else t = string.format("THD: %.2f%%", thd) end
    if snr == nil or snr ~= snr then s = "S/N: --- dB"
    else s = string.format("S/N: %.1f dB", snr) end
  end
  if ndb == nil or ndb ~= ndb then return t .. "    " .. s .. "    Noise Floor: --- dBV" end
  return t .. "    " .. s .. string.format("    Noise Floor: %.1f dBV", ndb)
end

-- Written only when the text changes, like the terminal selection. On the peak table's
-- clock, not the frame.
--
-- The figures come from the primitive, over the bins it reduced, and it reports thd as a
-- fraction where this line prints a percentage. The sample count is read off the primitive
-- too, dsp.fft.samples and not fftsa.n: the plan in force is the primitive's own, and a
-- second opinion on it is how the line and the trace end up describing different frames.
function fftsa.sg_show_thd()
  if fftsa.sg_thd == nil then return false end
  local thd, snr, ndb = dsp.distortion()
  if thd ~= nil then thd = thd * 100 end
  local t = fftsa.sg_thd_text(thd, snr, ndb, dsp.fft.samples, fftsa.overrange)
  if t == fftsa.sg_thd_last then return false end
  fftsa.sg_thd_last = t
  display.settext(fftsa.sg_thd, t)
  return true
end

-- The one place a zoom touches: it stores the window, rewrites the settings line and
-- re-pins the axis, which is what makes the firmware relabel.
function fftsa.sg_set_xrange(flo_hz, fhi_hz)
  fftsa.sg_store_xrange(flo_hz, fhi_hz)
  fftsa.sg_pin_x()
end

-- Bind the traces: the spectrum always, the markers when they are switched on. The one
-- place that decides, so the build and a rebind cannot disagree about what is bound.
--
-- removeall() first, or add() stacks a duplicate trace.
function fftsa.sg_bind()
  local g = fftsa.sg_graph
  if g == nil then return false end
  display.graph.removeall(g)
  display.graph.add(g, fftsa.sg_buf, display.ELEMENT_DATA,
                    fftsa.sg_buf, display.ELEMENT_EXTRA)
  if fftsa.sg_markers and fftsa.sg_mk ~= nil then
    display.graph.add(g, fftsa.sg_mk, display.ELEMENT_DATA,
                      fftsa.sg_mk, display.ELEMENT_EXTRA)
    -- ONE SCALE FOR EVERY TRACE. A custom graph starts at TRACE_ACTIVE, where a scale
    -- call reaches only the selected trace -- so the second trace keeps auto-scaling and
    -- its points are stretched across the whole plot, landing nowhere near the spectrum.
    -- TRACE_ALL syncs them: "as scale settings for X and Y change they will get applied
    -- to all traces". Documented to work only on a custom-created graph, which this is.
    display.graph.scaletrace(g, display.TRACE_ALL)
  end
  -- Always a line. See sg_mk_per: markers are per graph, so the peak trace draws needles
  -- rather than asking for a marker the spectrum would get too.
  display.graph.drawstyle(g, display.STYLE_LINE)
  fftsa.sg_pin_y(g)
  fftsa.sg_pin_x()
  -- Re-asserted for the same reason as the pins above: removeall and add may reset what
  -- the object carries, and the read-back needs the registration to answer at all.
  -- sg_rebind() reaches here from the failed-frame path, so without this one raised frame
  -- could leave a closed padlock over a view that still pans. Idempotent.
  fftsa.sg_hook_scale()
  return true
end

-- Did the capture hold a reading the range cannot represent? From the statistics the firmware
-- maintains AS THE BUFFER FILLS -- "the instrument automatically updates reading buffer
-- statistics as data is added" -- so getstats hands back an already-current table and this is
-- one call a frame with no reading examined in Lua. A pass of our own would be 16,384
-- comparisons for the same answer.
--
-- Both ends tested: a clipped sine saturates symmetrically and -9.9e+37 is as much a sentinel
-- as +9.9e+37, so a test on the maximum alone would miss a negative-only clip.
--
-- n == 0 leaves every other field nil, which is an empty buffer rather than an over-range one.
function fftsa.cap_overrange(buf)
  if buf == nil then return false end
  -- Guarded because this runs inside the frame: a firmware without getstats would raise here
  -- on every frame and the twenty-failure halt would take the app down over a warning it
  -- could simply not offer. Answering false loses the detection and nothing else.
  if buffer.getstats == nil then return false end
  local st = buffer.getstats(buf)
  if st == nil or st.n == nil or st.n == 0 then return false end
  local lim = fftsa.sg_vmax_real
  if st.max ~= nil and st.max.reading ~= nil and st.max.reading > lim then return true end
  if st.min ~= nil and st.min.reading ~= nil and st.min.reading < -lim then return true end
  return false
end

-- What the settings line says instead when the capture held an unrepresentable reading. The
-- wording is deliberate: "values in the signal", because only the peaks of a signal a little
-- past the range are clipped and the rest of the record is real -- so this is not "no signal"
-- and not "the signal is 9.9e+37". One owner for the text, as the panel numbers are.
function fftsa.sg_overrange_text(range)
  local i = fftsa.range_to_idx(range)
  local lab = tostring(fftsa.range_labels[i])
  -- The advice has to be possible: on the largest range there is nothing to raise to, and
  -- telling an operator to raise it there sends them to a form that cannot help.
  local fix = "raise the range"
  if i >= table.getn(fftsa.ranges) then fix = "reduce the input" end
  return "OVERRANGE: values in the signal exceed the " .. lab .. " range -- " .. fix
end

-- The peak table under over-range: every row dashed, and written once per transition rather
-- than per frame. Every figure would be arithmetic about 9.9e+37, and a plausible-looking
-- number is worse than a dash. sg_show_peaks clears the latch on the way back, so returning
-- to range redraws the real block.
function fftsa.sg_show_peaks_over()
  if fftsa.sg_pk_over then return false end
  if fftsa.sg_pk_f == nil then return false end
  fftsa.sg_pk_over = true
  local p
  for p = 1, table.getn(fftsa.sg_pk_f) do
    if fftsa.sg_pk_f[p] ~= nil then
      display.settext(fftsa.sg_pk_f[p], string.format("%d  ---", p))
      display.settext(fftsa.sg_pk_v[p], "")
      display.settext(fftsa.sg_pk_d[p], "")
    end
  end
  return true
end

-- The model, read once and kept: it cannot change while the app runs, and the floor rule
-- below asks on every Apply. An instrument that will not say reads as "", which matches no
-- model, so an absent attribute takes the DMM6500 floor rather than raising.
function fftsa.model_name()
  if fftsa.model_str == nil then
    local m = nil
    if localnode ~= nil then m = localnode.model end
    if m == nil then m = "" end
    fftsa.model_str = tostring(m)
  end
  return fftsa.model_str
end

-- The digits anywhere in the string, not the whole of it: the reference documents the
-- attribute as the bare model number, and matching on the part that names the front end
-- leaves a prefixed or suffixed form answering the same. Plain find, the fourth argument --
-- the pattern metacharacters have no business in a model number. string.match would be the
-- 5.1 spelling and is absent on this firmware; find is what 5.0.2 has.
function fftsa.is_7510()
  return string.find(fftsa.model_name(), "7510", 1, true) ~= nil
end

-- The floor a range wants, in dBV. The deeper one is the DMM7510's 1 V and 0.1 V ranges and
-- nothing else: a range off the list and an unidentified instrument both take -120, which is
-- the floor that cannot hide a trace.
function fftsa.sg_dbmin_for(range)
  if range ~= nil and range <= fftsa.sg_dbmin_7510_vmax and fftsa.is_7510() then
    return fftsa.sg_dbmin_7510
  end
  return fftsa.sg_dbmin_std
end

-- Move the floor to what the range wants, answering whether it moved. One assignment is the
-- whole move: every reader takes fftsa.sg_dbmin live -- the trace fill, the peak column, the
-- marker needles, the restore's span and dsp.out.dbfloor through dsp_live(). The answer is
-- what apply() pins the axis on, an axis write costing 60 ms and a full repaint, so an
-- unchanged limit is never written.
function fftsa.sg_dbmin_set(range)
  local want = fftsa.sg_dbmin_for(range)
  if want == fftsa.sg_dbmin then return false end
  fftsa.sg_dbmin = want
  return true
end

-- The dB axis, pinned. Its own function because sg_bind() has to call it once per trace.
function fftsa.sg_pin_y(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  display.graph.scaley(g, display.YSCALE_OFF, display.AXIS_NORMAL,
                       fftsa.sg_dbmin, fftsa.sg_dbmax)
  return true
end

-- Settling a gesture. Writing an axis limit costs 60 ms and repaints the whole widget, so
-- re-asserting both every frame is most of an 81 ms frame at 512 samples -- a slower,
-- flickering trace. Reading one back costs 0.0094 ms, so a settle reads before it writes.
--
-- The read-back's "return values are only valid when the objects event generation is set
-- to ALL", and non-button objects have none by default -- so on a graph with no event
-- registered, scalex and scaley answer nil and post nothing. sg_hook_scale is therefore
-- not an optimisation: nothing here works without it. It reports the gesture too, which
-- lets a tick that saw no fire skip even the reads.
--
-- Our own write also fires EVENT_SCALE, asynchronously, and needs no special case: the
-- echo reads back as the limits just written. EVENT_CURSOR never fires.
--
-- A handler containing %xmin does not run -- measured, and it takes a counter in the same
-- string down with it, so the failure looks like the event never firing. Substitution is
-- documented for command strings and icon_button relies on none of it, so why this one
-- fails is unestablished; do not re-reach for it without checking that first.
fftsa.sg_ev = 0        -- EVENT_SCALE fires since the tick last looked

-- A limit counts as moved past this fraction of sg_moved's scale, which is the larger of
-- the span and the endpoint. Taking the endpoint is what keeps a narrow window far from
-- DC from writing on every tick: at Start 499000, Stop 499010 -- reachable from the form
-- -- the span is smaller than the rounding on its own endpoints.
--
-- The price is a dead zone in exactly that window. Scaled to the endpoint, the tolerance
-- there is 0.499 Hz against a pixel of pan at 0.0147, so about thirty pixels of drag go
-- unrestored while the padlock still reads closed. Accepted because the alternative is a
-- 60 ms write every tick for ever, and because a 10 Hz span at 499 kHz holds no bins at
-- all -- the trace is empty before the lock is the problem. What would settle it is the
-- read-back's actual precision, which is unmeasured: if it round-trips a fractional limit
-- exactly, the scale can be the span alone and the dead zone goes.
fftsa.sg_tol = 1e-6

-- The limits the previous gesture check read, or nil when nothing is in flight. What tells
-- a finger still moving from one that has stopped, in sg_settle_x.
fftsa.sg_seen_lo = nil
fftsa.sg_seen_hi = nil

-- Turn the graph's pan-and-zoom reporting on. Unconditional, not tied to the lock: the dB
-- axis is restored either way and an unlocked frequency gesture has to be read before it
-- can be adopted. Measured at 512 samples it costs nothing per frame -- 74.7 ms of work
-- minimum with it on and off -- so there is nothing to switch off. Without the report
-- nothing settles, and the symptom is a view that pans while the padlock reads closed.
function fftsa.sg_hook_scale()
  local g = fftsa.sg_graph
  if g == nil then return false end
  if display.EVENT_SCALE == nil then
    fftsa.lasterr = "no EVENT_SCALE on this firmware: the view lock cannot work"
    fftsa.say(fftsa.lasterr)
    return false
  end
  display.setevent(g, display.EVENT_SCALE,
                   "if fftsa ~= nil then fftsa.sg_ev = (fftsa.sg_ev or 0) + 1 end")
  fftsa.sg_ev = 0
  return true
end

function fftsa.sg_moved(got, want, span)
  if got == nil then return false end
  local scale = span
  local a = want
  if a < 0 then a = -a end
  if a > scale then scale = a end
  -- Nothing to measure against: an axis of no height, which only a socket can set. A
  -- zero scale makes every difference exceed the tolerance, so this would otherwise be a
  -- 60 ms write on every reported gesture for the life of the app.
  if scale <= 0 then return false end
  return (got - want) > scale * fftsa.sg_tol
      or (want - got) > scale * fftsa.sg_tol
end

-- The dB axis, put back whenever a gesture moved it, lock or no lock. Nothing stands behind
-- this axis for a gesture to be asking for -- its limits are constants and Options does not
-- offer them -- so a dragged dB scale is only a worse view of the same data.
function fftsa.sg_restore_y(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  local span = fftsa.sg_dbmax - fftsa.sg_dbmin
  local y1, y2 = display.graph.scaley(g)
  -- Either limit nil means the read-back told us nothing useful -- both returns are
  -- documented optional -- and a gesture was reported, so the axis is presumed moved: a
  -- pin costs a frame, a dead restore costs the feature.
  if y1 == nil or y2 == nil
     or fftsa.sg_moved(y1, fftsa.sg_dbmin, span)
     or fftsa.sg_moved(y2, fftsa.sg_dbmax, span) then
    fftsa.sg_pin_y(g)
    return true
  end
  return false
end

-- Adopt the frequency axis a gesture left behind: unlocked, a drag or a pinch retunes the
-- analyser to what it asked to see. A pan is not told from a pinch -- whatever the two
-- limits read, snapped into the legal range, is the new span. The pin that follows puts the
-- axis on the CLAMPED pair, so a drag past a limit visibly stops at it.
function fftsa.sg_adopt_x(lo, hi)
  -- Refused, not repaired: a NaN limit survives every comparison in span_clamp, so it would
  -- reach the axis write, pick_fs and both Options fields. Tested against itself, NaN being
  -- the one value that is not equal to itself. The span then stays as it is and the next
  -- gesture settles it.
  if lo ~= lo or hi ~= hi then return false end
  -- Rounded, because an axis limit is a float and an Options field is not: unrounded, the
  -- form could neither show nor re-apply the span the gesture had just set. It is also what
  -- makes this a one-step fixed point -- the pin writes integers, so the read-back that
  -- follows rounds to itself.
  local nlo, nhi = fftsa.span_clamp(math.floor(lo + 0.5), math.floor(hi + 0.5))
  -- Asked before fftsa.fhi moves, since the question is whether the plan in force covers
  -- the new stop.
  local replan = fftsa.plan_changed(nhi)
  fftsa.flo, fftsa.fhi = nlo, nhi
  if replan then
    -- No pin here: fftsa.apply() pins from this same pair, so one would be a second 60 ms
    -- write of identical limits. The axis keeps the gesture's own limits until then, which
    -- is where the finger left it. A new plan cannot be installed from inside a frame --
    -- apply() reconfigures the digitizer and captures -- so fftsa.frame() runs it between.
    fftsa.sg_store_xrange(nlo, nhi)
    fftsa.retune_pending = true
  else
    fftsa.sg_set_xrange(nlo, nhi)
  end
  return true
end

-- The frequency axis after a reported gesture, settled whichever way the lock says. Only
-- limits are compared, not the scale method the pin also re-asserts -- an axis switched to
-- auto-ranging moves its own limits, so the next tick catches it and the pin restores
-- XSCALE_OFF along with them.
function fftsa.sg_settle_x(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  local wlo, whi = fftsa.sg_xwant()
  if wlo == nil then return false end      -- span not plottable: nothing to compare
  local x1, x2 = display.graph.scalex(g)
  -- A nil read-back names no range, so there is nothing to adopt and the only coherent
  -- move is back onto the span. Guarding the lower limit alone would leave a left-anchored
  -- zoom -- which moves the upper one by itself -- invisible.
  if x1 == nil or x2 == nil then
    fftsa.sg_pin_x()
    return true
  end
  if not (fftsa.sg_moved(x1, wlo, whi - wlo)
          or fftsa.sg_moved(x2, whi, whi - wlo)) then
    fftsa.sg_seen_lo, fftsa.sg_seen_hi = nil, nil
    return false
  end
  if fftsa.sg_lock then
    fftsa.sg_seen_lo, fftsa.sg_seen_hi = nil, nil
    fftsa.sg_pin_x()
    return true
  end
  -- Unlocked, adopt only once the gesture has STOPPED moving. A pair that differs from the
  -- last check is a finger still on the glass: it is remembered and left alone, and the
  -- next check with the same pair adopts it. That is what pays for checking often -- one
  -- drag costs one retune rather than one per check, and a retune is a whole capture.
  if fftsa.sg_seen_lo == nil
     or fftsa.sg_moved(x1, fftsa.sg_seen_lo, whi - wlo)
     or fftsa.sg_moved(x2, fftsa.sg_seen_hi, whi - wlo) then
    fftsa.sg_seen_lo, fftsa.sg_seen_hi = x1, x2
    return false
  end
  fftsa.sg_seen_lo, fftsa.sg_seen_hi = nil, nil
  return fftsa.sg_adopt_x(x1, x2)
end

-- Both axes, each touched only if it moved, because every write repaints the widget.
function fftsa.sg_settle()
  local g = fftsa.sg_graph
  if g == nil then return false end
  -- Cleared before the writes, not after. A write takes 60 ms an axis and fires
  -- EVENT_SCALE itself, so clearing afterwards discards every fire from that window --
  -- including a finger still dragging through it.
  fftsa.sg_ev = 0
  -- dB first, because it is the half that cannot raise: the X half reaches into the app
  -- module for the clamp and the plan, and a frame carries that on a pcall.
  local wy = fftsa.sg_restore_y(g)
  local wx = fftsa.sg_settle_x(g)
  return wy or wx
end

function fftsa.sg_scale_check()
  if (fftsa.sg_ev or 0) == 0 then return false end
  return fftsa.sg_settle()
end

-- Two jobs on two clocks. The icons only have to be re-asserted often enough that a focus
-- repaint does not sit there, which is the peak table's period. A gesture has to be
-- answered while the finger is still near where it stopped, and a second of that period on
-- top of a frame is what makes a drag at 2048 samples feel ignored -- 1.3 s before the app
-- even looks. A check with no gesture reported costs one os.clock() and no graph call --
-- measured at 16384 samples, 1.6723 s a frame with this period against 1.686 s recorded
-- for the one-second period -- so the shorter period is free whenever nothing is moving.
--
-- Driven from the frame, so the frame period is the floor: 0.3 s at 2048 samples, 0.08 s
-- at 512. A halted app settles only on a Lock press.
fftsa.sg_scale_period = 0.15    -- seconds between gesture checks
fftsa.sg_tick_last  = nil
fftsa.sg_scale_last = nil
fftsa.sg_term_last  = nil       -- the terminal selection the line currently names

-- The HELP key, answered by recognising the dialog it raises.
--
-- Nothing delivers the key to a script. display.setevent refuses a disp_key outright --
-- "Parameter 1, expected type 'number', but found type 'key'" -- and display.setkeyenable
-- takes only display.ON and display.OFF, where OFF substitutes a "help key is disabled"
-- dialog rather than silence. The dialog itself is invisible to every event path: it fires
-- no EVENT_HIDE on the screen it covers, never appears in ki.display.dump, and posts no
-- event. Pixels are the only thing that sees it.
--
-- So the recogniser is a checksum over a patch of the dialog's own title text, which reads
-- "You selected help on:" in yellow. Our objects always resolve to "No Topic" -- help topics
-- key on an identity display.create does not grant -- so those pixels are constant, and the
-- value below repeated exactly across presses on the instrument.
--
-- 80x16 rather than the whole title row, because the cost is area over a fixed call
-- overhead: 1.394 ms for 600x27, 0.310 ms for 80x12, 0.184 ms for 4x4. So this is about a
-- quarter the price of the row, and smaller still buys nothing. 1,280 pixels is specific
-- enough that none of the app's own screens collide with it -- checked against the
-- spectrum, options, about and help screens -- so the check needs no knowledge of which
-- screen is up, and routing comes from which timer ran instead.
-- A LIST, not one value. The patch is pixels of English text, so a panel in another language
-- has its own checksum -- no front-panel localisation is documented for this instrument and
-- the only language attribute in the API is sysinfo.lang, which selects TSP or SCPI rather
-- than the UI, but a firmware revision that redraws the dialog and a DMM7510 whose metrics
-- differ land in the same place. Adding one is adding a number here. Membership is a few
-- integer compares against one checksum call, so the length costs nothing measurable.
fftsa.help_x1,  fftsa.help_y1 = 28, 50
fftsa.help_x2,  fftsa.help_y2 = 108, 66
fftsa.help_sigs  = {1575696368} -- English, DMM6500 1.7.17a at 800x480
fftsa.help_shown = 0            -- times the key has been answered
fftsa.help_ok    = false        -- whether the ki names the recogniser needs are present

function fftsa.help_is_dialog(c)
  if c == nil then return false end
  local i
  for i = 1, table.getn(fftsa.help_sigs) do
    if fftsa.help_sigs[i] == c then return true end
  end
  return false
end

-- Resolved once, by fftsa.start(). ki is undocumented and absent from the display API
-- reference, so every name is checked rather than assumed -- but checked here and not in the
-- tick, which then costs one checksum call instead of six nil tests a second. A firmware
-- without these loses the feature and nothing else.
function fftsa.help_probe()
  fftsa.help_ok = false
  if fftsa.help_sigs == nil or table.getn(fftsa.help_sigs) == 0 then return false end
  if ki == nil or ki.display == nil then return false end
  local k = ki.display
  if k.getchecksum == nil or k.generate == nil then return false end
  if k.ACTION_PRESS_ENTER == nil or k.ACTION_RELEASE_ENTER == nil then return false end
  fftsa.help_ok = true
  return true
end

-- Both halves of the action, because press alone leaves the dialog up: the release is what
-- activates its OK button. ki.display.generate takes a disp_action, which makes it the one
-- consumer of the ki.display.ACTION_* enum.
function fftsa.help_dismiss()
  ki.display.generate(ki.display.ACTION_PRESS_ENTER)
  ki.display.generate(ki.display.ACTION_RELEASE_ENTER)
end

-- target names the help screen to raise, or nil to dismiss the firmware's dialog and stay
-- put -- which is what a screen with no help of its own wants, so a stray press does not
-- leave a modal nobody can clear.
--
-- No clock of its own: the caller's cadence IS the rate. The spectrum screen calls this at
-- the end of a graph update, the options form off its 200 ms timer, and the screens with no
-- help of their own off theirs. A display timer fires only while its own screen shows, so
-- none of those periods cost anything on a screen that is not up. The check is one
-- getchecksum, 0.33 ms, against an 0.08 s frame at 512 samples -- 0.4% of the fastest frame
-- the app runs, which is why it needs no floor.
function fftsa.help_check(target)
  if not fftsa.help_ok then return false end
  if not fftsa.help_is_dialog(ki.display.getchecksum(
        fftsa.help_x1, fftsa.help_y1, fftsa.help_x2, fftsa.help_y2)) then
    return false
  end
  fftsa.help_dismiss()
  fftsa.help_shown = (fftsa.help_shown or 0) + 1
  if target ~= nil and fftsa.help_open ~= nil then fftsa.help_open(target) end
  return true
end

-- One per caller, because a display event command names a function and passes it nothing.
function fftsa.help_main() return fftsa.help_check("main") end
function fftsa.help_stay() return fftsa.help_check(nil) end

function fftsa.sg_slow_tick()
  local now = os.clock()
  local did = false
  if fftsa.sg_scale_last == nil
     or (now - fftsa.sg_scale_last) >= fftsa.sg_scale_period then
    fftsa.sg_scale_last = now
    fftsa.sg_scale_check()
    did = true
  end
  if fftsa.sg_tick_last == nil
     or (now - fftsa.sg_tick_last) >= fftsa.sg_pk_period then
    fftsa.sg_tick_last = now
    if fftsa.icons_reassert ~= nil then fftsa.icons_reassert() end
    -- The FRONT/REAR button is pressed on the panel, not through Options, so nothing else
    -- rewrites the line when it moves -- and the pair not selected is an open input. On
    -- this clock rather than the gesture one: the change is a human pressing a button, so
    -- a second of latency costs nothing and it is one attribute read a second instead of
    -- seven. The text write happens only when the answer actually changes.
    local term = fftsa.terminal_text()
    if term ~= fftsa.sg_term_last then
      fftsa.sg_term_last = term
      fftsa.sg_write_xunit()
    end
    -- The over-range banner replaces this same line, so it is written on the transition and
    -- on the way back, by the same rule: only when the answer changes.
    if fftsa.overrange ~= fftsa.sg_over_shown then
      fftsa.sg_over_shown = fftsa.overrange
      fftsa.sg_write_xunit()
    end
    -- Distortion and noise: the noise mean is a pass over every plotted bin, measured at
    -- 4.3 us a bin -- 1.1 ms at 512 samples, 35 ms at 16384, 2.1% of one frame there.
    -- That is why it is on this clock and not the frame's.
    fftsa.sg_show_thd()
    did = true
  end
  return did
end

-- The recovery path after a failed frame, and the same binding as the build.
function fftsa.sg_rebind()
  return fftsa.sg_bind()
end

-- Detach and re-add the trace. Not called by the app; tools/test_tsp.lua exercises it.
function fftsa.sg_bind_min()
  display.graph.removeall(fftsa.sg_graph)
  display.graph.add(fftsa.sg_graph, fftsa.sg_buf, display.ELEMENT_DATA,
                    fftsa.sg_buf, display.ELEMENT_EXTRA)
end

-- Seconds the frame stays blocked after the refill so the display task can paint it; too
-- short and the firmware posts 1706. Small because the timer period already leaves a fifth
-- of every frame idle with Lua blocked, so this only insures against a frame whose work
-- fills its whole period.
fftsa.sg_yield = 0.010

fftsa.sg_pk_period = 1.0        -- seconds between refreshes
fftsa.sg_pk_ftol   = 0.002      -- fractional frequency move worth a redraw
fftsa.sg_pk_vtol   = 0.01       -- fractional amplitude move worth a redraw
fftsa.sg_pk_last   = nil        -- nil means never drawn, so the first call draws
fftsa.sg_pk_lf     = {}
fftsa.sg_pk_lv     = {}

fftsa.sg_peaks_off = false      -- disables the peak table, to attribute display traffic

-- One peak as (frequency in hertz, volts), or nil where there is none.
--
-- pk_hz/pk_v are what the primitive already resolved -- sub-bin corrected in both axes, once
-- per frame inside dsp.spectrum() instead of the eighteen fftsa.peak_interp calls a frame the
-- three display users below used to make between them. Without them it falls back to the bin
-- index and does its own interpolation, which is the form tools/test_tsp.lua drives directly
-- and the one that survives if the primitive ever reports bins rather than frequencies.
function fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
  if pk_hz ~= nil then
    local f = pk_hz[p]
    if f == nil then return nil end
    return f, pk_v[p]
  end
  if bi == nil or bv == nil then return nil end
  local k = bi[p]
  if k == nil or k <= 0 or not (bv[p] > 0) then return nil end
  local dk, iv = fftsa.peak_interp(k, fftsa.sg_nbins)
  if iv == nil then dk, iv = 0, math.sqrt(bv[p]) end
  return (k - 1 + dk) * binhz, iv
end

-- Refill the marker trace: one point a peak, at the frequency the peak table reports
-- rather than the column the trace drew. Sorted by frequency, because the peaks arrive
-- strongest-first and the trace is drawn with a line through it -- in amplitude order that
-- line zigzags across the plot. Filled before the spectrum refill, so the paint at the
-- frame's yield sees both buffers complete.
function fftsa.sg_update_markers(bi, bv, count, binhz, pk_hz, pk_v)
  local mk = fftsa.sg_mk
  if mk == nil or not fftsa.sg_markers then return 0 end
  local log10 = math.log10
  local hz, db = fftsa.sg_mk_hz, fftsa.sg_mk_db
  local n = 0
  local p
  for p = 1, count do
    local f, iv = fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
    if f ~= nil then
      local d = 20 * log10(iv)
      if not (d > fftsa.sg_dbmin) then d = fftsa.sg_dbmin end
      if not (d < fftsa.sg_dbmax) then d = fftsa.sg_dbmax end
      -- Insertion by frequency, so the slots come out increasing in x.
      local j = n
      while j > 0 and hz[j] > f do
        hz[j + 1], db[j + 1] = hz[j], db[j]
        j = j - 1
      end
      hz[j + 1], db[j + 1] = f, d
      n = n + 1
    end
  end
  if n == 0 then return 0 end
  -- A needle a peak: the floor a pixel below the peak frequency, the peak, the floor a
  -- pixel above. The x values have to stay increasing or the line doubles back, so each
  -- foot is held at or above the previous needle's -- two peaks within two pixels then
  -- read as one slightly wider needle, which is what they look like anyway.
  local span = fftsa.sg_fhi_hz - fftsa.sg_flo_hz
  local dx = span / fftsa.sg_plotpx
  if not (dx > 0) then dx = binhz end
  local floordb = fftsa.sg_dbmin
  local wr = buffer.write.reading
  local cap = mk.capacity
  local i, slot, prev = nil, 0, nil
  mk.clear()
  for i = 1, n do
    local f = hz[i]
    local l, r = f - dx, f + dx
    if prev ~= nil and l < prev then l = prev end
    if f < l then f = l end
    if r < f then r = f end
    if slot + fftsa.sg_mk_per <= cap then
      slot = slot + 1; wr(mk, floordb, l, slot, 0)
      slot = slot + 1; wr(mk, db[i],   f, slot, 0)
      slot = slot + 1; wr(mk, floordb, r, slot, 0)
      prev = r
    end
  end
  return slot
end

-- Gated at fftsa.sg_pk_period and skipped when no peak moved beyond the tolerances,
-- so a dithering last digit does not redraw the block on a steady signal.
function fftsa.sg_show_peaks(bi, bv, count, binhz, pk_hz, pk_v)
  if fftsa.sg_peaks_off then return false end
  -- Coming back from over-range the dashed block is on screen and the move gate has no
  -- memory of it, so the gate would hold the dashes until a peak happened to move. Clearing
  -- sg_pk_last forces one redraw of the real figures.
  if fftsa.sg_pk_over then
    fftsa.sg_pk_over, fftsa.sg_pk_last = false, nil
  end
  local now = os.clock()
  if fftsa.sg_pk_last ~= nil
     and (now - fftsa.sg_pk_last) < fftsa.sg_pk_period then
    return false
  end
  local abs = math.abs
  local moved = false
  for p = 1, count do
    local f, v = fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
    if f == nil then f, v = -1, -1 end
    local lf, lv = fftsa.sg_pk_lf[p], fftsa.sg_pk_lv[p]
    if lf == nil then
      moved = true
    elseif (f < 0) ~= (lf < 0) then
      moved = true                      -- a peak appeared or went away
    elseif f >= 0 then
      local df = fftsa.sg_pk_ftol * lf
      if df <= 0 then df = 1 end
      local dv = fftsa.sg_pk_vtol * lv
      if dv <= 0 then dv = 1e-12 end
      if abs(f - lf) > df or abs(v - lv) > dv then moved = true end
    end
    fftsa.sg_pk_lf[p], fftsa.sg_pk_lv[p] = f, v
  end
  if not moved then return false end
  fftsa.sg_pk_last = now
  return fftsa.sg_show_peaks_now(bi, bv, count, binhz, pk_hz, pk_v)
end

-- The unconditional draw; the gate above is the only thing deciding when it runs.
function fftsa.sg_show_peaks_now(bi, bv, count, binhz, pk_hz, pk_v)
  local log10, settext = math.log10, display.settext
  for p = 1, count do
    local f, v = fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
    if f ~= nil then
      local ftxt
      if f ~= f then ftxt = string.format("%d  ---", p)
      elseif f >= 1000 then ftxt = string.format("%d  %.3f kHz", p, f / 1000)
      else ftxt = string.format("%d  %.1f Hz", p, f) end
      -- An amplitude past the largest range is not a voltage, so both columns dash rather
      -- than one of them stating a figure. The volt field is also a WIDTH matter: %.4f of
      -- the 9.9e+37 sentinel is 45 characters where the column holds 8, and at a fixed x it
      -- overwrites the dB column and the whole second column with it. The over-range check
      -- upstream means neither is reached in the case this exists for; it bounds the fields
      -- so that no value can take the layout apart.
      local vtxt, dtxt
      if v ~= v then vtxt, dtxt = "", ""
      elseif v > fftsa.sg_vmax_real then vtxt, dtxt = "---", "--- dBV"
      else
        if v >= 1 then vtxt = string.format("%.4f V", v)
        elseif v >= 1e-3 then vtxt = string.format("%.2f mV", v * 1e3)
        else vtxt = string.format("%.0f uV", v * 1e6) end
        -- Floored at the plot's own floor: a 1e-26 power bin reads -260 dBV against an axis
        -- that stops at -120, which the trace cannot show and the column has no room for.
        local dbv = 20 * log10(v)
        if not (dbv > fftsa.sg_dbmin) then dbv = fftsa.sg_dbmin end
        dtxt = string.format("%.1f dBV", dbv)
      end
      settext(fftsa.sg_pk_f[p], ftxt)
      settext(fftsa.sg_pk_v[p], vtxt)
      settext(fftsa.sg_pk_d[p], dtxt)
    else
      settext(fftsa.sg_pk_f[p], string.format("%d  ---", p))
      settext(fftsa.sg_pk_v[p], "")
      settext(fftsa.sg_pk_d[p], "")
    end
  end
  return true
end

function fftsa.sg_status(txt)
  if fftsa.sg_stat ~= nil then display.settext(fftsa.sg_stat, txt) end
end


-- ================= tsp/native_link.tsp =================
-- native_link.tsp -- load the native DSP binary into heap and make it callable.
--
-- Called once at startup; sets fftsa.nl.ready when the native path is available.
-- Falls back silently on any failure: the app then uses dsp.spectrum as before.
--
-- Version-specific pieces: the trampoline bytes, which encode a call to
-- dcbst_icbi_isync_range at 0x004A9840 (1.7.17a), and the two firmware addresses
-- compiled into dsp_native.c. Everything else is resolved at runtime.
--
-- Lua 5.0.2: no '#', no hex literals, no multi-return string.byte, math.mod not fmod.

fftsa = fftsa or {}
fftsa.nl = {
  ready     = false,  -- true once the binary is loaded, relocated and the plan is built
  fn        = {},     -- firmware math addresses resolved by FNF
  tramp     = 0,      -- heap address of the 164-byte cache-flush trampoline
  entry     = 0,      -- heap address of dsp_native_run, which is image offset 0
  code_base = 0,      -- heap address the image is loaded at
  params    = 0,      -- heap address of the dsp_native_params struct
  code_buf  = nil,    -- buffer whose chunk storage holds the image, trampoline, params
  plan_buf  = nil,    -- buffer whose chunk storage holds the plan, arena and scratch
  peek8_cls = 0,      -- ki.peek8 closure address
  peek8_f   = 0,      -- original ki.peek8 f pointer, for restore
  nmax      = 0,      -- largest n the arena found at startup can hold
  last_rc   = nil,    -- status from the most recent native call
}

-- Status codes dsp_native.c pushes back. Non-negative is a result.
fftsa.nl.RC = {
  EMAGIC = -1, EBOUNDS = -2, EPLAN = -3, EGEOM = -4, ECAPTURE = -5,
  EOUTPUT = -6, EDESC = -7, EARENA = -8, ESCRATCH = -9, ERUN = -10, EMATH = -11,
}

fftsa.nl.MODE_INIT  = 1
fftsa.nl.MODE_RUN   = 2
fftsa.nl.MODE_BYTES = 3
fftsa.nl.MODE_SEGS  = 4

fftsa.nl.MAGIC = 1146310705   -- 0x44535031, 'DSP1'

-- DSP_FFT_* from csrc/dsp.h. Four-step is the default there and the only one measured on
-- the instrument; radix-2 is kept because the equivalence tests run both.
fftsa.nl.FFT_RADIX2   = 0
fftsa.nl.FFT_FOURSTEP = 1

-- Chunk payload is a fixed 32,768 bytes; 1024 elements follows from 32768/32.
fftsa.nl.CHUNK_BYTES = 32768
fftsa.nl.PARAM_WORDS = 32

-- Overwritten by the generated dsp_native_reloc.lua, which reads them out of the linked
-- image. Not literals to rely on: the target is 32-bit big-endian PowerPC with 4-byte
-- pointers, so sizeof(dsp_plan) is 1024 there against 1120 on a 64-bit host.
fftsa.nl.SIZEOF_PLAN   = 0
fftsa.nl.SIZEOF_PARAMS = 0
fftsa.nl.SIZEOF_REAL   = 0

-- Heap bounds, also overwritten from the image. Zero here so an un-generated module
-- refuses every address rather than accepting every address.
fftsa.nl.HEAP_LO = 0
fftsa.nl.HEAP_HI = 0

-- Picker index to DSP_WINDOW_*, the enum in csrc/dsp.h. A SEPARATE MAP FROM
-- fftsa.win_dsp, which goes to Keithley's dsp.WINDOW_*. The two enums coincide today and
-- nothing holds them together: spectrum_app.tsp:49 spells out what a mismatch costs --
-- the wrong window selected with nothing on the glass to say so, every amplitude out by a
-- scalloping factor. Our side of the seam gets its own map for the same reason theirs
-- does, and the window_enum gate compares this table against dsp.h so a renumbering is a
-- build failure rather than a measurement error. Index-parallel to fftsa.win_names.
fftsa.nl.WIN = {}
fftsa.nl.WIN[1] = 1    -- DSP_WINDOW_HANN
fftsa.nl.WIN[2] = 2    -- DSP_WINDOW_BLACKMAN
fftsa.nl.WIN[3] = 3    -- DSP_WINDOW_BLACKMAN_HARRIS
fftsa.nl.WIN[4] = 4    -- DSP_WINDOW_KAISER

-- Falls back to Hann on an index with no mapping, which is what fftsa.win_to_dsp does on
-- the other side. A silent fallback is wrong but bounded; an unmapped nil reaches the
-- params struct as a zero and selects DSP_WINDOW_RECT, which is no window at all.
function fftsa.nl.win_to_native(wi)
  local k = fftsa.nl.WIN[wi]
  if k == nil then k = fftsa.nl.WIN[1] end
  return k
end

-- The 164-byte cache-flush trampoline for 1.7.17a. Reads two hex strings from the Lua
-- stack (address, count) and calls dcbst_icbi_isync_range. Position-independent: it has
-- no data references and reaches the firmware through lis/ori/mtctr/bctrl.
-- Rebuild with probe_codexec.py for other firmware versions.
fftsa.nl._TRAMP = '\148\033\255\208\124\008\002\166\144\001\000\052\147\225\000\044\147\193\000\040\124\127\027\120\056\128\000\001\061\128\000\033\097\140\232\104\125\137\003\166\078\128\004\033\056\129\000\008\061\128\000\075\097\140\254\156\125\137\003\166\078\128\004\033\124\126\027\120\127\227\251\120\056\128\000\002\061\128\000\033\097\140\232\104\125\137\003\166\078\128\004\033\056\129\000\008\061\128\000\075\097\140\254\156\125\137\003\166\078\128\004\033\124\100\027\120\127\195\243\120\061\128\000\074\097\140\152\064\125\137\003\166\078\128\004\033\056\096\000\000\128\001\000\052\124\008\003\166\131\225\000\044\131\193\000\040\056\033\000\048\078\128\000\032'

-- The compiled image and its relocation table, both generated by
-- csrc/tools/emit_reloc.py. Nil means no binary yet: nl.init still resolves addresses
-- and installs the trampoline, but leaves nl.ready false.
fftsa.nl._DSP_CODE = nil
fftsa.nl._DSP_RELOC = nil
fftsa.nl._DSP_RELOC_BSS_LO = 0
fftsa.nl._DSP_RELOC_BSS_HI = 0

-- ---------------------------------------------------------------------------
-- Byte packing helpers.
-- ---------------------------------------------------------------------------

local function u32_pack(v)
  v = math.mod(v, 4294967296)
  local b4 = math.mod(v, 256); v = math.floor(v / 256)
  local b3 = math.mod(v, 256); v = math.floor(v / 256)
  local b2 = math.mod(v, 256)
  local b1 = math.mod(math.floor(v / 256), 256)
  return string.char(b1, b2, b3, b4)
end

local function u32_at(s, p)
  local b1 = string.byte(s, p)
  local b2 = string.byte(s, p + 1)
  local b3 = string.byte(s, p + 2)
  local b4 = string.byte(s, p + 3)
  return ((b1 * 256 + b2) * 256 + b3) * 256 + b4
end

local function hx(v) return string.format('%X', v) end

-- Firmware .text, where a lua_CFunction pointer must land. Anything else written into a
-- closure's f is a jump into data on the next call.
fftsa.nl.TEXT_LO = 16384      -- 0x00004000
fftsa.nl.TEXT_HI = 5402624    -- 0x00527000

function fftsa.nl._text_ok(a)
  return type(a) == 'number' and a >= fftsa.nl.TEXT_LO and a < fftsa.nl.TEXT_HI
end

local function align8(v) return v + math.mod(8 - math.mod(v, 8), 8) end

-- Progress breadcrumbs for nl.init, off unless fftsa.nl.trace is set.
--
-- nl.init is one Lua call that installs code and then branches into it, so when it
-- bluescreens the Lua state goes with the instrument and there is nothing left to ask.
-- A PC on the glass in the heap says only that something executed garbage, and init has
-- three places that branch to a heap address. print() in TSP reaches the socket as the
-- statement runs, so a trace crosses the wire BEFORE the crash and the last line received
-- names the step. That is the only diagnostic available here short of splitting init into
-- separately-callable stages, which is worth doing for nl.reinit but would not have been
-- worth doing blind.
local function trace(tag, a, b)
  if not fftsa.nl.trace then return end
  local s = 'NLT|' .. tostring(tag)
  if a ~= nil then s = s .. '|' .. tostring(a) end
  if b ~= nil then s = s .. '|' .. tostring(b) end
  print(s)
end

-- Read a word from the instrument, or nil. Reads are DRAM-only by construction here:
-- every address passed in comes from the heap scan window or a descriptor inside it.
local function W(addr)
  return tonumber(ki.peek32(hx(addr)), 16)
end

-- ---------------------------------------------------------------------------
-- FNF: find the firmware function behind a Lua math wrapper.
--
-- Scans a Form E closure's .text handler for the first bl targeting >= 0x00400000;
-- that is the GHS C function, double in f1 to double in f1. Works across builds as
-- long as the wrapper structure is preserved.
-- ---------------------------------------------------------------------------
function fftsa.nl.FNF(fn)
  local s = tostring(fn)
  local _, e = string.find(s, ': ')
  if not e then return nil end
  local c = tonumber(string.sub(s, e + 1), 16)
  if not c then return nil end
  local w = W(c + 12)
  if not w then return nil end
  local i
  for i = 0, 255 do
    local pc = w + i * 4
    local n = W(pc)
    if n == nil then return nil end
    if math.floor(n / 67108864) == 18 and math.mod(n, 2) == 1 then
      local r = math.mod(math.floor(n / 4), 16777216)
      if r >= 8388608 then r = r - 16777216 end
      local t = math.mod(pc + r * 4, 4294967296)
      if t >= 4194304 then return t end   -- 0x00400000
    end
  end
  return nil
end

-- Resolve the six functions dsp.c calls. Returns the count found.
function fftsa.nl.resolve_math()
  local fn = fftsa.nl.fn
  local names = { 'sin', 'cos', 'sqrt', 'log10', 'floor', 'ceil' }
  local found = 0
  local k
  for k = 1, table.getn(names) do
    local nm = names[k]
    fn[nm] = fftsa.nl.FNF(math[nm])
    if fn[nm] then found = found + 1 end
  end
  -- lua_pushnumber is not behind a math wrapper, so it is the one address FNF cannot
  -- reach. Confirmed by disassembly: li r0,3; stfd f1,8(r11).
  fn.lua_pushnumber = 2223908   -- 0x0021EF24 on 1.7.17a
  return found
end

-- ---------------------------------------------------------------------------
-- Relocation.
--
-- On PPC32 every data reference is `lis rX,hi` plus a `lo(rX)` access, an absolute
-- address fixed at link time, and clang's PPC backend has no small-data addressing to
-- avoid that. The image is linked at zero, so each relocation target doubles as an
-- offset into it, and patching is target plus load address.
--
-- The patch is applied to the Lua string before it is written, so the instrument sees
-- one ki.memwrite rather than one per relocation. Verified against hand-computed
-- answers in csrc/tools/test_relocate.lua, including the ha carry boundary.
-- ---------------------------------------------------------------------------
function fftsa.nl.relocate(image, reloc, code_base, bss_hi)
  local out  = {}
  local n    = 0
  local pos  = 1
  local ilen = string.len(image)
  local rlen = string.len(reloc)
  local r    = 1
  while r + 8 <= rlen + 1 do
    local kind   = string.byte(reloc, r)
    local field  = u32_at(reloc, r + 1)
    local target = u32_at(reloc, r + 5)
    local final  = math.mod(code_base + target, 4294967296)
    local repl, width
    if kind == 1 then
      repl  = u32_pack(final)
      width = 4
    else
      local half
      if kind == 2 then
        half = math.mod(final, 65536)
      else
        half = math.mod(math.floor((final + 32768) / 65536), 65536)
      end
      repl  = string.char(math.floor(half / 256), math.mod(half, 256))
      width = 2
    end
    if field < 0 or field + width > ilen then return nil, 'field out of range' end
    if field + 1 < pos then return nil, 'relocations overlap or are unsorted' end
    n = n + 1; out[n] = string.sub(image, pos, field)
    n = n + 1; out[n] = repl
    pos = field + width + 1
    r = r + 9
  end
  if r ~= rlen + 1 then return nil, 'relocation table is not whole entries' end
  n = n + 1; out[n] = string.sub(image, pos)
  local patched = table.concat(out)
  -- .bss has no file contents; the loader is what zeroes it.
  if bss_hi ~= nil and bss_hi > string.len(patched) then
    local z = {}
    local i
    for i = 1, bss_hi - string.len(patched) do z[i] = '\000' end
    patched = patched .. table.concat(z)
  end
  return patched
end

-- ---------------------------------------------------------------------------
-- Content scan over a heap range. A normal function rather than a loadstring, so the
-- packager's luac gate checks it like any other code.
-- ---------------------------------------------------------------------------
function fftsa.nl.FINDS(lo, hi, pat)
  local a   = lo
  local out = {}
  local n   = 0
  local pl  = string.len(pat)
  while a < hi do
    local step = 32768
    if a + step > hi then step = hi - a end
    local s = ki.memread(hx(a), hx(step))
    if s ~= nil then
      local i = 1
      while true do
        local j = string.find(s, pat, i, true)
        if j == nil then break end
        n = n + 1; out[n] = a + j - 1
        i = j + 1
      end
    end
    -- Terminate on the tail rather than on the step, or the overlap subtraction
    -- leaves the address unchanged and the loop never ends.
    if a + step >= hi then break end
    a = a + step - (pl - 1)
  end
  return out
end

-- Element storage of a freshly written buffer, by content scan.
-- Needs three sentinel readings already written. Returns the slot 0 address, or nil.
--
-- Two passes: the arena recent allocations land in first, then the wider heap. The
-- narrow pass is 32 MB rather than 126 MB and has found it every time so far.
function fftsa.nl._find_storage(buf)
  local needle = '\065\046\132\130\000\000\000\000'   -- 1000001.0, big-endian double
  local windows = {
    { 50331648, 83886080 },     -- 0x03000000 - 0x05000000
    { 17825792, 150994944 },    -- 0x01100000 - 0x09000000, both inside .heap
  }
  local wi
  for wi = 1, table.getn(windows) do
    local hits = fftsa.nl.FINDS(windows[wi][1], windows[wi][2], needle)
    local k
    for k = 1, table.getn(hits) do
      local h = hits[k]
      -- Confirm stride 32 against readings 2 and 3 before trusting the hit.
      -- The expected words come from tonumber rather than decimal literals: these were
      -- mistyped once as 0x412F8484, which made this function silently never match.
      local v2  = W(h + 32)
      local v2l = W(h + 36)
      local v3  = W(h + 64)
      if v2 == tonumber('412E8484', 16) and v2l == 0 and
         v3 == tonumber('412E8486', 16) then
        return h
      end
    end
  end
  return nil
end

-- The column descriptor for a buffer, from its element storage address.
-- Steps 3 to 5 of the recipe in fwmem-BUFFER.md: find the storage address as a word,
-- the descriptor starts 0x48 below it, then confirm with the two self-pointers and the
-- chunk geometry. Returns descriptor base, elemsize, perchunk, chunk vector.
function fftsa.nl._find_desc(elem0)
  local needle = u32_pack(elem0)
  local windows = {
    { 50331648, 83886080 },
    { 17825792, 150994944 },
  }
  local wi
  for wi = 1, table.getn(windows) do
    local hits = fftsa.nl.FINDS(windows[wi][1], windows[wi][2], needle)
    local k
    for k = 1, table.getn(hits) do
      local base = hits[k] - 72       -- 0x48
      local s1 = W(base + 84)         -- 0x54, owner self-pointer
      local s2 = W(base + 100)        -- 0x64, second self-pointer
      if s1 == base and s2 == base then
        local elemsize = W(base + 8)
        local perchunk = W(base + 12)
        local nchunks  = W(base + 16)   -- 0x10, chunk count
        if elemsize ~= nil and perchunk ~= nil and nchunks ~= nil and
           nchunks > 0 and nchunks < 4096 and
           elemsize * perchunk == fftsa.nl.CHUNK_BYTES then
          -- 0x44 is the chunk vector. The count comes back with it because a caller
          -- indexing the vector has no other way to know where it ends: reading one
          -- entry too far returns whatever follows it in the heap, and an address that
          -- happens to land in the heap would pass the backstop and be written to.
          return base, elemsize, perchunk, W(base + 68), nchunks
        end
      end
    end
  end
  return nil
end

-- ---------------------------------------------------------------------------
-- Params struct. Field order must match dsp_native_params in dsp_native.c exactly.
-- ---------------------------------------------------------------------------
function fftsa.nl.write_params(t)
  local fn = fftsa.nl.fn
  local w = {
    fftsa.nl.MAGIC,
    t.mode or 0,
    t.wr_lo or 0, t.wr_hi or 0,
    t.rd_lo or 0, t.rd_hi or 0,
    t.out_lo or 0, t.out_hi or 0,
    t.seg_bytes or 0, t.nsegs or 0, t.segs_addr or 0,
    t.plan_addr or 0,
    t.src_flat or 0,
    t.cap_chunk1 or 0, t.cap_chunk2 or 0, t.cap_n or 0, t.cap_perchunk or 0,
    t.out_chunk1 or 0, t.out_chunk2 or 0, t.out_perchunk or 0, t.out_desc or 0,
    fn.lua_pushnumber or 0,
    fn.sin or 0, fn.cos or 0, fn.sqrt or 0,
    fn.log10 or 0, fn.floor or 0, fn.ceil or 0,
    t.init_kind or 0, t.init_beta_milli or 0,
    t.init_decim or 1, t.init_method or 0,
  }
  if table.getn(w) ~= fftsa.nl.PARAM_WORDS then return false end
  local parts = {}
  local i
  for i = 1, table.getn(w) do parts[i] = u32_pack(w[i]) end
  ki.memwrite(hx(fftsa.nl.params), table.concat(parts))
  return true
end

-- ---------------------------------------------------------------------------
-- Redirect ki.peek8 to a heap address, call it, and restore in both exits.
--
-- The restore writes back the pointer captured before the redirect, never a recomputed
-- one, so a failure inside the call cannot leave ki.peek8 pointing at our code.
-- ---------------------------------------------------------------------------
local function via_peek8(addr, a1, a2)
  local nl = fftsa.nl
  if nl.peek8_cls == 0 then return nil, 'no closure' end
  -- Checked on the way in, not just at capture: the restore below is unconditional, so
  -- if this is wrong the redirect must not happen at all.
  if not nl._text_ok(nl.peek8_f) then return nil, 'restore value not in .text' end
  local slot = hx(nl.peek8_cls + 12)
  local orig = string.format('%08X', nl.peek8_f)
  ki.poke32(slot, string.format('%08X', addr))
  local ok, r
  if a2 ~= nil then
    ok, r = pcall(ki.peek8, a1, a2)
  else
    ok, r = pcall(ki.peek8, a1)
  end
  ki.poke32(slot, orig)
  -- nl.last_call records whether the branch returned normally, because the return value
  -- cannot. The trampoline ends in `li r3,0`, so a successful flush yields zero Lua values
  -- and r is nil -- which is precisely what a raised error produces here too. Three runs
  -- of probe_native.py reported the self-flush "clean" on the strength of a nil that
  -- proved nothing, and it went into the notes as an established result. Callers that care
  -- whether the code actually ran must read nl.last_call, not the return value.
  fftsa.nl.last_call = ok
  if not ok then
    fftsa.nl.last_err = tostring(r)
    return nil, r
  end
  fftsa.nl.last_err = nil
  return r
end
fftsa.nl._via_peek8 = via_peek8

-- Flush written code out of the D-cache and invalidate the I-cache for it.
local function flush(addr, len)
  local nl = fftsa.nl
  if nl.tramp == nil or nl.tramp == 0 then return false end
  if addr == nil or len == nil or len <= 0 then return false end
  -- REFUSE TO FLUSH THE TRAMPOLINE'S OWN RANGE. icbi on a line the CPU is executing from,
  -- followed by isync, forces a re-fetch mid-function; that is the fault behind two
  -- bluescreens. The caller has no business asking for it -- the barrier alone bootstraps
  -- a fresh line -- so this is a refusal rather than a special case.
  local tlo = nl.tramp
  local thi = nl.tramp + string.len(nl._TRAMP)
  if addr < thi and addr + len > tlo then return false end
  via_peek8(nl.tramp, hx(addr), hx(len))
  -- last_call, not the return value: the trampoline returns zero Lua values on success, so
  -- nil cannot distinguish a clean flush from a raised error.
  return nl.last_call == true
end
fftsa.nl.flush = flush

-- Put ki.peek8 back. Refuses rather than writing a value that is not a .text address:
-- a restore that writes garbage is worse than no restore, because the closure still
-- works until something calls it.
function fftsa.nl.restore_peek8()
  local nl = fftsa.nl
  if nl.peek8_cls == 0 then return false end
  if not nl._text_ok(nl.peek8_f) then return false end
  ki.poke32(hx(nl.peek8_cls + 12), string.format('%08X', nl.peek8_f))
  return true
end

-- Every failure exit from nl.init comes through here. Deleting the buffers is not enough:
-- nl.entry, nl.tramp and nl.params point into chunk storage that the delete frees, so a
-- later via_peek8 through a stale nl.entry would branch into whatever the allocator hands
-- out next. call_dsp is gated on nl.ready and that stays false, but a dangling function
-- pointer sitting in a module table is a trap, not a guard. peek8_cls and peek8_f are kept
-- deliberately: restore_peek8 needs them, and they are firmware addresses, not heap.
function fftsa.nl._abort(cb, pb)
  local nl = fftsa.nl
  if pb ~= nil then pcall(function() buffer.delete(pb) end) end
  if cb ~= nil then pcall(function() buffer.delete(cb) end) end
  nl.ready     = false
  nl.entry     = nil
  nl.tramp     = nil
  nl.params    = nil
  nl.code_buf  = nil
  nl.code_base = nil
  nl.plan_buf  = nil
  nl.plan_addr = nil
  nl.segs_addr = nil
  nl.src_flat  = nil
  return false
end

-- ---------------------------------------------------------------------------
-- Init. Called once per boot, at startup, before any frame. Once per boot and not merely
-- once per app start: the IPC barrier drains the store buffer to DRAM but does not
-- invalidate the I-cache, and the trampoline cannot flush a replacement for itself, so a
-- second install at a fresh address wedges the interpreter. Reinstalling needs a power
-- cycle until the invalidate can be bootstrapped out of firmware .text.
--
-- barrier_buf is accepted and validated but not used as the barrier. init fills its own
-- code buffer with three readings and uses that, because buffer.getstats is the barrier
-- only when it makes the service-task call and on an empty buffer it need not -- and the
-- caller's buffer is empty more often than not.
--
-- Returns true with nl.ready set, or false with every heap-derived field nil'd.
-- ---------------------------------------------------------------------------
function fftsa.nl.init(barrier_buf, want_n, kind, beta, decim, method)
  local nl = fftsa.nl

  -- ONE INSTALL PER BOOT, AND A MODULE FIELD CANNOT ENFORCE IT. fftsa.start() calls this
  -- on every app start, and a stop/restart with no power cycle reloads the script, so any
  -- flag kept in nl is gone while the heap code and its I-cache lines are not. A second
  -- install at a fresh address wedges the interpreter: the IPC barrier drains the store
  -- buffer to DRAM but does not invalidate the I-cache, and the trampoline cannot flush a
  -- replacement for itself. A Lua global is the only storage scoped to the boot rather
  -- than to the script, so that is what holds it.
  --
  -- Refusing leaves the app on dsp.spectrum -- degraded, and the alternative is an
  -- instrument that answers ping and nothing else. NLBOOT is shared with the probes on
  -- purpose: both install heap code, so either blocks the other.
  --
  -- THIS IS THE FIRST STATEMENT, ahead of nl.ready = false, so a refusal cannot damage an
  -- install that is already working. Within one script session a second call would
  -- otherwise clear ready on a good install and drop the app to the fallback for no
  -- reason.
  if NLBOOT ~= nil then
    nl.boot_spent = true
    return false
  end
  nl.boot_spent = false

  nl.ready = false
  want_n = want_n or 512

  if nl._DSP_CODE == nil or string.len(nl._DSP_CODE) == 0 then return false end
  if nl._DSP_RELOC == nil then return false end

  -- 1. Firmware math addresses. All six are needed; dsp.c calls every one.
  trace('math')
  if nl.resolve_math() < 6 then return false end
  trace('math.ok')

  -- 2. The ki.peek8 closure, and its original f pointer.
  local s = tostring(ki.peek8)
  local _, e = string.find(s, ': ')
  if not e then return false end
  local cls = tonumber(string.sub(s, e + 1), 16)
  if not cls then return false end
  -- This value is written back into a live lua_CFunction pointer by every redirect, so
  -- it is the most dangerous number in the module and it is validated before it is kept.
  -- A single transport read is not enough: a desynchronised socket once returned a heap
  -- address here, the restore wrote it into the dispatch path, and the next call executed
  -- a deleted buffer's stale readings -- bc at +0 fell through to an illegal 0x00000000
  -- at +4, PC 0x03518424. Two agreeing reads, both inside firmware .text, or refuse.
  local orig_f = W(cls + 12)
  if orig_f == nil then return false end
  if not fftsa.nl._text_ok(orig_f) then return false end
  if W(cls + 12) ~= orig_f then return false end
  nl.peek8_cls = cls
  nl.peek8_f   = orig_f

  -- 3. Code buffer. Capacity 1024 is exactly one chunk, so the span below is known to
  --    be one allocation rather than relying on how a short buffer is sized.
  local cb = buffer.make(1024, buffer.STYLE_WRITABLE_FULL)
  buffer.write.format(cb, buffer.UNIT_VOLT, buffer.DIGITS_6_5,
                      buffer.UNIT_VOLT, buffer.DIGITS_6_5)
  local k
  for k = 1, 3 do
    buffer.write.reading(cb, 1000000 + k, 3000000 + k, k, 0)
  end

  -- THE BARRIER USES cb, THE BUFFER THIS FUNCTION JUST FILLED, NOT THE CALLER'S.
  -- buffer.getstats is the barrier only when it actually makes the service-task call,
  -- and on an empty buffer it need not. Passing defbuffer1, empty after a power cycle,
  -- bluescreened the instrument once: the trampoline had not reached DRAM, the I-cache
  -- filled from stale heap and the CPU executed a deleted buffer's readings. The caller
  -- cannot be trusted to hand over a live buffer -- fftsa.start() passes fftsa.cap,
  -- which is empty until the first capture completes -- so init no longer depends on it.
  -- barrier_buf is still accepted, and validated rather than used, so a caller that
  -- passes something unusable is told rather than crashed.
  if barrier_buf ~= nil and barrier_buf.n == nil then return fftsa.nl._abort(cb) end
  local bar = cb
  if bar.n == nil or bar.n < 1 then return fftsa.nl._abort(cb) end
  buffer.getstats(bar)

  trace('scan.code')
  local code_base = nl._find_storage(cb)
  if not code_base then return fftsa.nl._abort(cb) end
  trace('code_base', hx(code_base))
  nl.code_buf  = cb
  nl.code_base = code_base

  -- 4. Layout, derived from the image rather than fixed: the image is tens of
  --    kilobytes, so a trampoline at a fixed +256 sits inside it.
  local img_span   = align8(nl._DSP_RELOC_BSS_HI)
  if img_span < align8(string.len(nl._DSP_CODE)) then
    img_span = align8(string.len(nl._DSP_CODE))
  end
  local tramp_at   = code_base + img_span
  local params_at  = tramp_at + align8(string.len(nl._TRAMP))
  local span       = (params_at - code_base) + nl.PARAM_WORDS * 4
  if span > nl.CHUNK_BYTES then return fftsa.nl._abort(cb) end
  nl.params = params_at
  trace('layout', hx(tramp_at), hx(params_at))

  -- 5. Trampoline first, so later writes can be flushed properly. Its own first
  --    execution rides on the IPC barrier alone.
  --
  -- The boot is claimed here, in its own statement, before the first write rather than
  -- after the last. A failure or a wedge from this point on has still consumed the one
  -- install the boot allows, so refusing a retry that might have been safe is the right
  -- way round: that costs a power cycle, and allowing one that is not costs a wedge and a
  -- power cycle. Nothing clears NLBOOT, including _abort.
  NLBOOT = tramp_at
  trace('tramp.write', hx(tramp_at), string.len(nl._TRAMP))
  ki.memwrite(hx(tramp_at), nl._TRAMP)
  buffer.getstats(bar)

  -- Confirm the bytes are where we think before branching to them. A read goes through the
  -- D-cache so this cannot prove DRAM visibility -- that is the barrier's job -- but it does
  -- catch a write that landed somewhere else entirely, which otherwise costs a bluescreen
  -- and a power cycle to discover.
  local back = ki.memread(hx(tramp_at), hx(string.len(nl._TRAMP)))
  if back ~= nl._TRAMP then
    trace('tramp.readback.BAD', (back == nil) and 'nil' or string.len(back))
    return fftsa.nl._abort(cb)
  end
  trace('tramp.readback.ok')

  nl.tramp = tramp_at
  -- NO SELF-FLUSH. The trampoline used to be asked to flush its own range as its first
  -- act, and that is what bluescreened twice: dcbst_icbi_isync_range runs icbi on the
  -- cache lines the CPU is executing from and then isync, which forces a re-fetch of the
  -- instruction stream in the middle of the function. PC 0x035DA468 was trampoline+64, an
  -- `mr r30,r3` that cannot fault as a data access but can certainly fail to be fetched.
  --
  -- It was never needed either. probe_tramp.py ran a 184-byte stub at a heap address with
  -- the barrier alone and no flush of any kind, and it returned correct values -- the first
  -- instruction fetch of a line that has not been fetched since boot snoops the D-cache,
  -- so the barrier is sufficient to bootstrap. The trampoline earns its keep flushing
  -- OTHER ranges, which is what the image needs; it must never be pointed at itself.
  trace('tramp.ok')

  -- 6. The image, patched for this load address.
  local img, err = nl.relocate(nl._DSP_CODE, nl._DSP_RELOC, code_base,
                               nl._DSP_RELOC_BSS_HI)
  if img == nil then return fftsa.nl._abort(cb) end
  trace('img.reloc', string.len(img))
  ki.memwrite(hx(code_base), img)
  buffer.getstats(bar)
  -- The image is a different range from the trampoline, so this is the trampoline's
  -- legitimate use. The result is checked: a silent failure here leaves the I-cache able
  -- to serve stale lines for the image, which is a wrong answer rather than a fault.
  --
  -- A failure is not fatal on a first install, because the image's lines have not been
  -- fetched since boot either and the barrier covers them -- which is why this worked
  -- before the flush result was ever examined. It is recorded rather than ignored.
  trace('img.flush')
  nl.flushed = flush(code_base, string.len(img))
  trace('img.flush.ok', tostring(nl.flushed))
  nl.entry = code_base
  trace('img.ok')

  -- 7. How many chunks the arena needs, asked of the binary rather than guessed.
  --    The arrays are laid out one per chunk by dsp_plan_init_segs, so the arena does
  --    not need contiguous memory -- which it could not have, since chunk payloads are
  --    placed independently by the allocator.
  nl.write_params({ mode = nl.MODE_SEGS, cap_n = want_n,
                    seg_bytes = nl.CHUNK_BYTES,
                    init_decim = decim or 1, init_method = method or 0 })
  trace('call.segs', hx(code_base), hx(nl.params))
  local nseg = via_peek8(code_base, hx(nl.params))
  trace('call.segs.ret', tostring(nseg))
  if type(nseg) ~= 'number' or nseg <= 0 then
    -- Zero means no chunk can hold one of the arrays: the window is n * 8 bytes, so
    -- this is the bound on n rather than a failure of the mechanism.
    nl.nmax = 0
    return fftsa.nl._abort(cb)
  end

  -- 8. Plan buffer: one chunk per segment, plus one for the plan struct and the
  --    de-strided scratch, which must not sit inside the arena.
  local chunks_wanted = nseg + 1
  local pb = buffer.make(chunks_wanted * 1024, buffer.STYLE_WRITABLE_FULL)
  buffer.write.format(pb, buffer.UNIT_VOLT, buffer.DIGITS_6_5,
                      buffer.UNIT_VOLT, buffer.DIGITS_6_5)
  for k = 1, 3 do
    buffer.write.reading(pb, 1000000 + k, 3000000 + k, k, 0)
  end
  buffer.getstats(bar)

  trace('scan.plan')
  local pdesc = nl.describe(pb)
  if pdesc == nil or pdesc.vec == nil then return fftsa.nl._abort(cb, pb) end
  trace('plan.desc', hx(pdesc.chunk1), tostring(pdesc.nchunks))

  -- The vector has to actually hold the entries about to be read out of it. The chunk
  -- count is the descriptor's own field at +0x10, so this is the allocator's answer and
  -- not an inference from the capacity asked for. Without it, one entry past the end
  -- returns whatever follows the vector in the heap, and a value that happened to look
  -- like a heap address would pass the native backstop and be written through -- into
  -- somebody else's allocation.
  if pdesc.nchunks == nil or pdesc.nchunks < chunks_wanted then
    return fftsa.nl._abort(cb, pb)
  end
  nl.plan_buf = pb

  -- Chunk payload addresses from the vector. They are not in address order and not
  -- adjacent; dsp_plan_init_segs does not care, and nothing here may assume otherwise.
  -- Each is checked against the heap here as well as by the native entry point, so a
  -- bad vector is a refusal from Lua rather than a status code from a call that has
  -- already been handed the address.
  local payload = {}
  local i
  for i = 1, chunks_wanted do
    local a = W(pdesc.vec + (i - 1) * 4)
    if a == nil or a == 0 then
      return fftsa.nl._abort(cb, pb)
    end
    if a < nl.HEAP_LO or a + nl.CHUNK_BYTES > nl.HEAP_HI then
      return fftsa.nl._abort(cb, pb)
    end
    payload[i] = a
  end

  -- The last chunk holds the plan struct and the scratch; the first nseg are the arena.
  local host      = payload[chunks_wanted]
  local plan_addr = host
  local src_flat  = host + align8(nl.SIZEOF_PLAN)
  if (src_flat - host) + want_n * 8 > nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, pb)
  end

  -- The segment vector itself, in the code buffer above the params struct.
  local segs_addr = nl.params + align8(nl.PARAM_WORDS * 4)
  if (segs_addr - code_base) + nseg * 4 > nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, pb)
  end
  local sv = {}
  for i = 1, nseg do sv[i] = u32_pack(payload[i]) end
  trace('segs.write', hx(segs_addr), nseg)
  ki.memwrite(hx(segs_addr), table.concat(sv))

  -- The writable window has to cover every chunk of this buffer, and the chunks are
  -- scattered, so it spans from the lowest to the highest.
  local lo, hi = payload[1], payload[1]
  for i = 2, chunks_wanted do
    if payload[i] < lo then lo = payload[i] end
    if payload[i] > hi then hi = payload[i] end
  end
  nl.wr_lo = lo
  nl.wr_hi = hi + nl.CHUNK_BYTES

  -- 9. Build the plan across the chunks.
  nl.write_params({
    mode = nl.MODE_INIT,
    wr_lo = nl.wr_lo, wr_hi = nl.wr_hi,
    rd_lo = nl.wr_lo, rd_hi = nl.wr_hi,
    out_lo = nl.wr_lo, out_hi = nl.wr_hi,
    seg_bytes = nl.CHUNK_BYTES, nsegs = nseg, segs_addr = segs_addr,
    plan_addr = plan_addr, src_flat = src_flat, cap_n = want_n,
    init_kind = kind or 1,
    init_beta_milli = math.floor((beta or 0) * 1000),
    init_decim = decim or 1, init_method = method or 0,
  })
  trace('call.init')
  local rc = via_peek8(code_base, hx(nl.params))
  trace('call.init.ret', tostring(rc))
  nl.last_rc = rc
  if rc ~= 0 then
    return fftsa.nl._abort(cb, pb)
  end

  nl.plan_addr = plan_addr
  nl.seg_bytes = nl.CHUNK_BYTES
  nl.nsegs     = nseg
  nl.segs_addr = segs_addr
  nl.src_flat  = src_flat
  nl.n         = want_n
  nl.nmax      = want_n
  nl.ready     = true
  trace('done')
  return true
end

-- ---------------------------------------------------------------------------
-- Run one frame. Returns the bin count, or nil with nl.last_rc set.
--
-- cap and out each describe one buffer's chunk storage:
--   chunk1, chunk2   payload addresses, chunk2 zero when one chunk holds it all
--   perchunk         elements per chunk, from the descriptor
--   lo, hi           the span the native code may touch in that buffer
--   out.desc         the column descriptor base, for the cursor rewind
--
-- Chunk payloads are placed independently by the allocator: 0x8010 is the block size, not
-- a pitch, and the second payload can sit below the first. So lo and hi span from the
-- lowest payload to the highest plus CHUNK_BYTES, and the native side additionally requires
-- each strided access to stay inside the chunk it starts in -- the span alone would permit
-- whatever else lives between two scattered payloads.
-- ---------------------------------------------------------------------------
function fftsa.nl.call_dsp(cap, out)
  local nl = fftsa.nl
  if not nl.ready then return nil end

  local ok = nl.write_params({
    mode = nl.MODE_RUN,
    wr_lo = nl.wr_lo, wr_hi = nl.wr_hi,
    rd_lo = cap.lo, rd_hi = cap.hi,
    out_lo = out.lo, out_hi = out.hi,
    seg_bytes = nl.seg_bytes, nsegs = nl.nsegs, segs_addr = nl.segs_addr,
    plan_addr = nl.plan_addr, src_flat = nl.src_flat,
    cap_chunk1 = cap.chunk1, cap_chunk2 = cap.chunk2,
    cap_n = nl.n, cap_perchunk = cap.perchunk,
    out_chunk1 = out.chunk1, out_chunk2 = out.chunk2,
    out_perchunk = out.perchunk, out_desc = out.desc,
  })
  if not ok then return nil end

  local r = via_peek8(nl.entry, hx(nl.params))
  nl.last_rc = r
  if type(r) ~= 'number' or r < 0 then return nil end
  return r
end

-- Describe a buffer's storage for call_dsp, from the content scan and descriptor walk.
-- Returns nil if either step fails, so a caller cannot build a half-filled table.
function fftsa.nl.describe(buf)
  local elem0 = fftsa.nl._find_storage(buf)
  if not elem0 then return nil end
  local desc, elemsize, perchunk, vec, nchunks = fftsa.nl._find_desc(elem0)
  if not desc then return nil end
  -- The window must cover both payloads, and they are scattered: the second is often
  -- BELOW the first, measured at 0x360D600 and 0x36055F0. Taking hi from the second
  -- unconditionally gave hi < lo, which dsp_native_run rejects as EBOUNDS, so the native
  -- path would have failed closed on every frame and fallen back to dsp.spectrum. Span
  -- from the lowest to the highest, the same way nl.init does it.
  local ch2 = 0
  local lo  = elem0
  local hi  = elem0 + fftsa.nl.CHUNK_BYTES
  if vec ~= nil then
    local second = W(vec + 4)
    if second ~= nil and second ~= 0 then
      ch2 = second
      if second < lo then lo = second end
      if second + fftsa.nl.CHUNK_BYTES > hi then hi = second + fftsa.nl.CHUNK_BYTES end
    end
  end
  return { chunk1 = elem0, chunk2 = ch2, perchunk = perchunk,
           elemsize = elemsize, desc = desc, vec = vec, nchunks = nchunks,
           lo = lo, hi = hi }
end


-- ================= tsp/native_code.tsp =================
-- native_code.tsp -- generated by tools/embed_native.py; do not edit.
--
-- The compiled PowerPC image and the relocation table that places it at its load
-- address. Concatenated after native_link.tsp, which creates fftsa.nl, and before
-- spectrum_app.tsp, which reads nl.ready.
--
-- 25880 bytes of image, 3717 relocation bytes (413 entries).

