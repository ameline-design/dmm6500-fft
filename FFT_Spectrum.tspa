loadscript FFT_Spectrum
-- $Title: FFT Spectrum Analyser
-- $Product: DMM6500, DAQ6510, DMM7510
-- $Tag: FFT, Spectrum, Digitize, Audio
-- $Description: On-instrument FFT spectrum analyser: digitize mode + FFT with a live graph, top-6 peaks, and a touch options form (start/stop frequency, input range).
-- $Version: 8.69
-- $Requires: 1.7.0
-- $Icon: fft_icon

-- ================= tsp/fft_core.tsp =================
-- fft_core.tsp -- the window enums and the labels, and nothing that computes.
--
-- What every path needs whatever computes the spectrum: the window names, the Kaiser betas
-- and the two accessors. fftsa.kbeta() feeds nl.init and win_label() feeds the settings
-- line, so neither belongs with the math -- which is in tsp/fft_interp.tsp, loaded by
-- tools/test_tsp.lua and left out of the archive.

-- ============================ analysis windows ============================
-- Every entry is a generalised cosine sum except Kaiser, whose beta trades main-lobe width
-- against sidelobe level and so spans the named windows and goes past them.
--
-- Rectangular is absent: its transform has a null one bin from the peak, which leaves the
-- three-bin interpolation ill-conditioned, so peak readings are wrong in a way the trace
-- does not show. Hamming is absent because it exits the app on the instrument, and Kaiser at
-- beta 6 covers it to within a dB of sidelobe level.
fftsa = fftsa or {}   -- the single global this app exposes

fftsa.win_names = {"Hann", "Blackman", "Blk-Harris", "Kaiser"}
-- Index-parallel to fftsa.win_names, coefficients a0 - a1*cos + a2*cos2 - a3*cos3.
-- Kaiser has no entry, which is how fftsa.win_build() tells it apart.
fftsa.win_cos = {
  {0.5, 0.5},
  {0.42, 0.5, 0.08},
  {0.35875, 0.48829, 0.14128, 0.01168},
}
fftsa.win_i = 1             -- index into fftsa.win_names

-- A fixed list rather than a typed number: every value here is verified for peak frequency
-- and amplitude in the suite, where a typed beta would admit unmeasured shapes. The floor is
-- 4 because the first null sits at sqrt(1 + (beta/pi)^2) bins and has to stay outside 1.5
-- bins for the interpolation to read main lobe rather than sidelobe.
fftsa.kbetas       = {4, 6, 9, 12, 15, 18}
fftsa.kbeta_labels = {"4  -30dB", "6  -44dB", "9  -66dB",
                      "12  -90dB", "15  -114dB", "18  -139dB"}
fftsa.kbeta_i      = 4      -- index into fftsa.kbetas

function fftsa.kbeta(bi)
  local b = fftsa.kbetas[bi or fftsa.kbeta_i]
  if b == nil then b = fftsa.kbetas[1] end
  return b
end

function fftsa.win_name(wi)
  wi = wi or fftsa.win_i
  return fftsa.win_names[wi] or fftsa.win_names[1]
end

-- Window name for a readback line, with beta where beta applies. Defaults to the applied
-- window; the options preview passes its field values so the whole line describes one state.
function fftsa.win_label(wi, bi)
  wi = wi or fftsa.win_i
  if fftsa.win_cos[wi] ~= nil then return fftsa.win_name(wi) end
  return fftsa.win_name(wi) .. " b=" .. tostring(fftsa.kbeta(bi))
end


-- ================= tsp/spectrum_ui.tsp =================
-- spectrum_ui.tsp -- the loading cover.
--
-- A screen holding nothing but a line of text, kept in front while the real screens are
-- built and while Apply reconfigures the hardware. Creating a screen makes it active, so
-- every screen build raises this again before its first child, or the operator watches a
-- screen assemble itself one create at a time. Made once and deleted once by stop(): raising
-- it is a changescreen and nothing else, a create/delete per raise churning the 463-object
-- pool.

fftsa = fftsa or {}   -- the single global this app exposes

if fftsa.load_handles_inited == nil then
  fftsa.loadscr = nil
  fftsa.loadtxt = nil
  fftsa.load_handles_inited = true
end
-- x for the string below on FONT_MEDIUM, measured on the panel.
fftsa.load_x = 261
fftsa.load_y = 214

function fftsa.loading_build()
  if fftsa.loadscr ~= nil then return fftsa.loadscr end
  fftsa.loadscr = display.create(display.ROOT, display.OBJ_SCREEN, "FFT SPECTRUM ANALYSER")
  if fftsa.loadscr == nil then return nil end     -- pool exhausted; a visible build is the cost
  fftsa.loadtxt = display.create(fftsa.loadscr, display.OBJ_TEXT, fftsa.load_x, fftsa.load_y,
                                 "Loading, please wait...", 16777215, display.FONT_MEDIUM)
  -- End App is hooked here too: the firmware may deliver EVENT_ENDAPP only to the
  -- visible screen, and this is the visible one while Apply rebuilds the tables.
  display.setevent(fftsa.loadscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  return fftsa.loadscr
end

function fftsa.loading_front()
  if fftsa.loadscr == nil then return false end
  display.changescreen(fftsa.loadscr)
  return true
end

-- Put a real screen in front, then take the cover away. Switch first, delete
-- second: deleting the screen on show leaves the panel black.
function fftsa.loading_destroy(showscr)
  if showscr == nil then showscr = display.SCREEN_HOME end
  if fftsa.loadscr == nil then
    display.changescreen(showscr)
    return false
  end
  -- The text is a child and not a screen, so it takes no yield of its own; the cover does.
  fftsa.del_obj(fftsa.loadtxt)
  fftsa.del_scr(fftsa.loadscr, showscr)
  fftsa.loadtxt, fftsa.loadscr = nil, nil
  return true
end


-- ================= tsp/spectrum_graph.tsp =================
-- spectrum_graph.tsp -- spectrum display built on the instrument's own graph object
--
-- X binds to the reading's extra field rather than its timestamp, which makes this the
-- firmware's numeric x-y plot: the axis takes real hertz and labels itself. Y is dBV
-- under a two-character custom buffer unit, which is what labels that axis in dB. A child
-- inside the graph's rectangle is painted over by the repaint, so nothing can be drawn
-- over the firmware's axis row.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.sg_nbins   = 256
fftsa.sg_npeak   = 6       -- number of peaks reported (shown in a 2x3 grid)

-- Points a frame writes: the only number that sets the widget's work, so it is fixed
-- rather than sized to the span. One per pixel would be 680 and costs 77 ms a fill
-- against 28 ms here. Each carries its column's maximum, which reads the noise floor 6 dB
-- high. Settable up to sg_maxpts while running: FILL_ONCE and cleared, so n follows.
fftsa.sg_ncol    = 255

-- Peak markers, off by default: a second trace carrying the interpolated frequency and
-- amplitude the peak table reports, so a marker sits where the peak really is, up to half a
-- bin off the column the trace draws. Switching it on rebinds the graph, which repaints the
-- axes, so it only happens on Apply.
fftsa.sg_markers = false
-- Needles, not dots: drawstyle is per graph, so markers on the peak trace would put one
-- on all 255 spectrum points too. Three points a peak -- floor, peak, floor, a pixel
-- either side -- draws a vertical needle with the run between them along the bottom rule.
fftsa.sg_mk_per  = 3       -- points a needle: floor, peak, floor
-- Firmware floor on a reading buffer, event 4920. Ask for less and buffer.make returns
-- nil rather than refusing, so every later call on the handle is a 1138.
fftsa.sg_bufmin  = 10
fftsa.sg_maxpts  = 680

-- Firmware handles, initialised only on the first load: opening the App again re-runs this
-- body and `fftsa = fftsa or {}` keeps the table, so nil-ing a live handle here would strand
-- the previous launch's objects. fftsa.sg_destroy() reclaims them on the next start.
if fftsa.sg_handles_inited == nil then
  fftsa.sg_buf   = nil     -- WRITABLE_FULL buffer holding the spectrum
  fftsa.sg_scr   = nil     -- custom screen
  fftsa.sg_graph = nil     -- OBJ_GRAPH object
  fftsa.sg_pk_f  = nil     -- per-peak frequency text (own field, fixed x)
  fftsa.sg_pk_v  = nil     -- per-peak voltage text  (own field, fixed x)
  fftsa.sg_pk_d  = nil     -- per-peak dB text       (own field, fixed x)
  fftsa.sg_xunit = nil     -- settings line under the peak rows
  fftsa.sg_mk    = nil
  -- The two trace buffers' own global names, which the display task's subscription
  -- resolves against. sg_name_buffers() says why they exist.
  FFTSA_TRACE    = nil
  FFTSA_MARK     = nil
  -- The previous launch's pair, waiting to be released once this launch has its own.
  FFTSA_OLDTRACE = nil
  FFTSA_OLDMARK  = nil
  fftsa.sg_handles_inited = true
end

-- Touch pans and zooms the graph and the widget cannot be told not to: display.setstate
-- answers event 1717 for STATE_DISABLE and STATE_READONLY on a Graph. So a gesture is
-- settled after the fact, and this says how the frequency axis settles -- locked, back onto
-- the span in force, unlocked, the span follows the axis, dB restored either way.
fftsa.sg_lock = true

-- Visible frequency window (Hz): fftsa.dsp_window() hands it to the primitive, which plots
-- only the bins inside it, and fftsa.sg_pin_x() pins the axis to it.
fftsa.sg_flo_hz  = 0
fftsa.sg_fhi_hz  = 1e9

-- The pinned window is the only stable choice: XSCALE_ALL derives the range from the
-- buffer's own timestamps, which move while a frame refills, so a paint landing mid-fill
-- ranges on a partial trace and the axis walks. Any auto-ranging method also fights the view
-- lock, which then writes an axis a second for as long as both are on.
fftsa.sg_xmethod = display.XSCALE_OFF
-- The clear is the only notify compatible with FILL_ONCE. select, scaletrace, drawstyle and
-- re-asserting scalex do all make the task re-read a bound buffer, but each needs it
-- overwritten in place, which needs FILL_CONTINUOUS, which draws the wrap line.


-- Geometry on the 800x480 panel, in object coordinates: those start below the 49-pixel
-- title bar, so a child at y=350 lands on panel row 399. The graph takes the full height
-- above the peak table and the firmware labels the axis inside it, so no row is reserved.
fftsa.sg_gx      = 8
fftsa.sg_gy      = 0
fftsa.sg_gw      = 784
fftsa.sg_gh      = 312

-- The dB axis floor: -120 dBV, and -140 on the 1 V and 0.1 V ranges where the noise goes
-- under it. Measured floors pick both numbers -- a DMM7510 reads -134 dBV on 0.1 V and -129
-- on 1 V, a DMM6500 -123 and -121, which is a trace lying on the bottom edge, and a narrower
-- bin takes the noise down with it, 6 dB at 16384 against 2048 and 9 dB at 32768.
-- fftsa.sg_dbmin_set() is the only thing that moves the floor in force.
fftsa.sg_dbmin_std       = -120
fftsa.sg_dbmin_deep      = -140
fftsa.sg_dbmin_deep_vmax = 1     -- the largest range the deeper floor covers
fftsa.sg_dbmin_deep_n    = 16384 -- the smallest count whose bin needs it on a DMM6500
fftsa.sg_dbmin           = fftsa.sg_dbmin_std   -- the floor in force
fftsa.sg_dbmax           = 20
fftsa.sg_vfloor          = 1e-9

fftsa.model_str = nil        -- localnode.model, read once by fftsa.model_name()

-- Past this, in volts, a reading is not a voltage: the digitizer answers 9.9e+37 beyond the
-- selected range, where the panel shows "Overflow", and a handful of those makes the
-- spectrum an impulse -- flat against the ceiling at every frequency with the real tone
-- buried under its own clipped samples. 15 V clears the largest range this app offers and
-- its headroom while sitting 36 decades under the sentinel, so the test can neither catch a
-- real reading nor miss a sentinel.
fftsa.sg_vmax_real = 15
fftsa.overrange    = false   -- the frame's verdict; the peak table and the THD line read it
fftsa.sg_pk_over   = false   -- whether the dashed table is the one on screen

-- Plotted width in pixels, measured off a panel capture: the vertical grid rules land at
-- x = 100, 168 ... 780, eleven of them 68 px apart. Used to decide when an axis limit can
-- be moved without it showing.
fftsa.sg_plotpx  = 680

-- fftsa.sg_fhi_hz starts at a sentinel meaning "every bin". A span wider than this is
-- not a plottable axis, so sg_pin_x() makes no call until fftsa.apply() narrows it.
fftsa.sg_fmax_real = 1e6

-- Peak table: 6 rows as two columns of three. freq/volt/dB are separate objects at fixed x,
-- so the volt and dB columns do not jitter as the proportional-font frequency text changes
-- width.
fftsa.sg_pky     = 350     -- first peak row baseline
fftsa.sg_pkdy    = 20      -- row pitch
fftsa.sg_pk_colx_f = {8,   360}   -- frequency field x, per column
fftsa.sg_pk_colx_v = {118, 470}   -- voltage field x,   per column
fftsa.sg_pk_colx_d = {200, 552}   -- dB field x,        per column
fftsa.sg_pk_cf   = 14745568  -- freq colour (pale green)
fftsa.sg_pk_cv   = 13166335  -- volt colour (pale blue)
fftsa.sg_pk_cd   = 16769184  -- dB colour   (pale amber)
fftsa.sg_xunit_x = 8
fftsa.sg_xunit_y = 410       -- settings line, below the peak rows
fftsa.sg_xunit_c = 56575     -- cyan 00DCFF, the colour of the Options preview line
-- Saturated red FF0000 for the over-range banner, against the panel's pale palette: the one
-- line that is a warning rather than a reading. Decimal, which the display API requires.
fftsa.sg_over_c  = 16711680
fftsa.sg_xunit_c_now = nil   -- the colour the line is actually carrying

-- Distortion and noise, between the graph (ends at sg_gy + sg_gh = 312) and the first
-- peak row (sg_pky = 350). Pale amber, the dB column's colour, since both are levels.
fftsa.sg_thd_x = 8
fftsa.sg_thd_y = 328
fftsa.sg_thd_c = 16769184
fftsa.sg_thd_last = nil      -- the text on screen, so an unchanged line is not rewritten

-- Decimals follow the record length, because a digit is only worth printing once the record
-- is long enough to hold a harmonic in one bin: each doubling halves the bin width and so
-- the power leaking into its neighbours. Gated on the committed sample count, so the line
-- cannot offer a precision the plan in force did not deliver.
fftsa.sg_thd_n3 = 8192     -- samples the third decimal needs
fftsa.sg_thd_n4 = 16384    -- and the fourth

-- The nil test is the point: display.create answers nil on an exhausted pool, and the app
-- module deletes handles it may never have built. No pcall, a refused delete posting an
-- event and returning, so a wrapper can never be false; the suite's live-object counts
-- around a teardown are what catch one.
function fftsa.del_obj(h)
  if h == nil then return true end
  display.delete(h)
  return true
end

function fftsa.del_buf(b)
  if b == nil then return true end
  buffer.delete(b)
  return true
end

-- Delete a screen: switch away, let the switch land, then delete. The single owner of that
-- rule, every part of it being necessary.
--
-- display.delete on the screen that is on show bluescreens the instrument at pc=00318FC0,
-- which takes the whole box down -- no ping, no port 80, no port 5025, and a manual power
-- cycle. Switching away is not sufficient on its own, changescreen not waiting, so the
-- delete can still reach a screen the panel is showing. The yield is what makes the switch
-- real, and it is the only part the app controls.
function fftsa.del_scr(h, showscr)
  if h == nil then return true end
  if showscr == nil then showscr = display.SCREEN_HOME end
  display.changescreen(showscr)
  delay(fftsa.sg_scr_yield)
  display.delete(h)
  return true
end

-- The X limits the axis should hold, nil for a span that is not plottable. Shared by
-- sg_pin_x and sg_restore so the moved-or-not test cannot disagree with the pin. Start moves
-- to DC where that is under one pixel, because the firmware steps ticks from the lower limit
-- and a 10 Hz Start on a 50 kHz span would label them +00.01kHz. Conditional, or a real zoom
-- loses its own limits.
function fftsa.sg_xwant()
  local lo, hi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if hi > fftsa.sg_fmax_real or hi <= lo then return nil, nil end
  if lo > 0 and lo * fftsa.sg_plotpx < (hi - lo) then lo = 0 end
  return lo, hi
end

-- Pin the X axis to the window: auto-range rounds outward to tidy tick values, so
-- the pixel of a given frequency would be unknowable and the firmware's labels would not
-- describe the span.
function fftsa.sg_pin_x()
  if fftsa.sg_graph == nil then return false end
  local lo, hi = fftsa.sg_xwant()
  if lo == nil then return false end
  local m = fftsa.sg_xmethod
  if m == nil then m = display.XSCALE_OFF end
  -- In hertz and not scaled: the trace is bound as a numeric x-y plot, X from the reading's
  -- extra field, which carries the bin's real frequency, so the limits are the real span and
  -- the firmware labels them itself with an SI prefix. No pcall, the call posting rather
  -- than raising.
  display.graph.scalex(fftsa.sg_graph, m, display.AXIS_NORMAL, lo, hi)
  return true
end

-- The settings line: what Options holds that the axes do not already show, so neither the
-- span nor the dB range is repeated. Written twice per Apply, before the capture and again
-- after, so the rate and bin width it ends up showing are the measured ones.
function fftsa.sg_xunit_text()
  -- Over-range replaces the line rather than appending to it: there is no room for both, and
  -- beside a record the range could not represent the point count and bin width are beside
  -- the point. The trace is left flat against the ceiling, which is what the capture was.
  if fftsa.overrange then return fftsa.sg_overrange_text(fftsa.range) end
  -- Total for the same reason opt_info_text is: apply() builds this line after the hardware
  -- is configured, so a nil count or an unknown range index reads as a gap rather than
  -- aborting the Apply.
  local t = string.format("%d pts   %s   %s", fftsa.n or 0,
                          tostring(fftsa.opt_info_text(fftsa.fs, fftsa.n)),
                          tostring(fftsa.range_labels[fftsa.range_to_idx(fftsa.range)]))
  -- Start 1999 / Stop 2000 is a legal pair and one plotted point at any bin width: the trace
  -- is a dot, five peak rows read ---, and this count is the only thing that says why.
  local b = fftsa.binhz
  if b ~= nil and b > 0 then
    local k0, k1 = fftsa.sg_window_bins(fftsa.sg_nbins, b)
    local n = k1 - k0 + 1
    if n < 3 then
      local plural = "s"
      if n == 1 then plural = "" end
      t = t .. string.format("   only %d bin%s in the span", n, plural)
    end
  end
  -- Last on the line, and always present: the selection is only useful if its absence
  -- cannot be read as FRONT.
  return t .. fftsa.sg_fps_text() .. "   " .. fftsa.terminal_text()
end

-- The measured rate, or nothing until a window has closed: absent rather than zero, because
-- 0.0 fps on a running analyser reads as a fault. Ahead of the terminal selection, which
-- stays last on the line.
function fftsa.sg_fps_text()
  local f = fftsa.fps
  if f == nil or not (f > 0) then return "" end
  if f < 10 then return string.format("  %.1f fps", f) end
  return string.format("  %.0f fps", f)
end

-- The trace buffer: WRITABLE_FULL carries value, extra and timestamp per point, the value dB
-- under a custom unit and the extra the bin's frequency in hertz. Made once at the sg_maxpts
-- ceiling rather than the current sg_ncol, so nothing reallocates while frames run, and
-- freed only by sg_destroy(). The clear is the notify: the display task holds its own copy
-- and re-reads only when handed a buffer, so overwriting one in place changes nothing.
function fftsa.sg_make_buffer(nbins, npoints)
  fftsa.sg_nbins = nbins
  local want = npoints or fftsa.sg_capacity()
  -- Already built at the right size: keep it, and write nothing but sg_nbins. This is the
  -- one place the no-reallocation rule is stated in code rather than left to the call graph.
  if fftsa.sg_buf ~= nil and fftsa.sg_mk ~= nil and fftsa.sg_buf.capacity == want then
    fftsa.sg_name_buffers()
    fftsa.sg_free_old()
    return fftsa.sg_buf
  end
  -- Allocated before the previous pair is released, and that order is the whole of this: a
  -- trace buffer freed and then reallocated at the same size comes back carrying the freed
  -- one's identity, and the dead launch's trace subscription with it. The graph then paints
  -- a ring nothing feeds -- a picture that never changes however the buffer is rewritten,
  -- with the dB axis relabelled in volts -- while every reading in it reads back correct
  -- from Lua. Measured both ways, and no rebind, clear or rewrite recovers it.
  local newbuf = fftsa.sg_mk_trace(want)
  -- The marker trace, made here with the trace buffer and freed with it whether or not
  -- markers are on: allocating it on the option would allocate while frames are running.
  local mkcap = fftsa.sg_npeak * fftsa.sg_mk_per
  if mkcap < fftsa.sg_bufmin then mkcap = fftsa.sg_bufmin end
  local newmk = fftsa.sg_mk_mark(mkcap)
  -- Detach before deleting: the firmware refuses to delete a buffer still bound to a
  -- graph, so remaking one while attached leaves the old buffer alive and still bound,
  -- and the widget draws both -- a second trace overlaid at the old resolution.
  -- Before the traces go, because their rings go with them.
  fftsa.sg_pix_stop('trace buffers reallocated')
  if fftsa.sg_graph ~= nil then
    display.graph.removeall(fftsa.sg_graph)
  end
  local oldbuf, oldmk = fftsa.sg_buf, fftsa.sg_mk
  fftsa.sg_buf, fftsa.sg_mk = newbuf, newmk
  fftsa.sg_name_buffers()
  if oldbuf ~= nil then fftsa.del_buf(oldbuf) end
  if oldmk ~= nil then fftsa.del_buf(oldmk) end
  fftsa.sg_free_old()
  -- The marker sort's own slots, one more than the peak count because the insertion
  -- writes j+1 before n has grown.
  fftsa.sg_mk_db, fftsa.sg_mk_hz = {}, {}
  local j
  for j = 1, fftsa.sg_npeak + 1 do
    fftsa.sg_mk_db[j], fftsa.sg_mk_hz[j] = fftsa.sg_dbmin, 0
  end
  return fftsa.sg_buf
end

-- A second allocation inside one launch breaks the trace, which is why there is no
-- sg_retrace(): a recovery that replaced the trace buffers on a live graph froze the trace
-- at exactly the frame it fired, on four consecutive launches. An Apply from the panel
-- allocates and rebinds through sg_make_buffer(), so it is already the repair if one is
-- ever needed. The mechanism is not established.

-- The previous launch's trace buffers, released only once this launch has allocated its own.
-- sg_make_buffer says what goes wrong when they are freed first, and this is the other half
-- of it: the launch that ends cannot allocate the next launch's buffers, so it cannot free
-- its own in the right order.
--
-- Buffers can be handed across a launch where display handles cannot -- a reading buffer
-- outlives the script that made it, and a display handle answers 1703 -- so a global is the
-- right place for them. An exit never followed by another launch costs 698 readings held
-- until a power cycle.
function fftsa.sg_free_old()
  if FFTSA_OLDTRACE ~= nil then
    fftsa.del_buf(FFTSA_OLDTRACE)
    FFTSA_OLDTRACE = nil
  end
  if FFTSA_OLDMARK ~= nil then
    fftsa.del_buf(FFTSA_OLDMARK)
    FFTSA_OLDMARK = nil
  end
  return true
end

-- A name for each trace buffer, because a table field is not one.
--
-- display.graph.add does not hand the display task a buffer, it subscribes that task to the
-- buffer by name -- graph_trace_add calls bufsub_subscribe(0x407F, graph, name, slot) with
-- two 32-byte name fields -- and a null name means defbuffer1. The axis unit comes from the
-- subscription rather than the add arguments, so a trace that resolved to the wrong buffer
-- is a blank plot with the dB axis relabelled in volts, while the buffer itself still reads
-- back the right points from Lua. A buffer reachable only through fftsa.* does not reliably
-- resolve to itself: a graph bound to a ramp held in fftsa.ZZ painted the app's own spectrum
-- instead. So these two names are part of the display contract.
function fftsa.sg_name_buffers()
  return FFTSA_TRACE == fftsa.sg_buf and FFTSA_MARK == fftsa.sg_mk
end

-- A trace buffer is created into its own bare global, which is not a style choice: a buffer
-- the display task cannot name is subscribed as defbuffer1 instead, the documented null-name
-- default. The graph then draws defbuffer1's contents on defbuffer1's units -- volts on the
-- value axis, kilovolts on an axis that should read kilohertz, nothing recognisable plotted
-- -- while the app's own buffer reads back perfectly from Lua. Two "Reading buffer
-- defbuffer1 is 0% filled" events are all the firmware says about it.
--
-- Every buffer that binds and paints on this instrument is assigned to a bare global, and
-- ones held only in fftsa.sg_buf do not. So these two functions are the only places a trace
-- buffer may be created, the globals are the authority, and fftsa.sg_buf and fftsa.sg_mk are
-- copies for the frame path. Two functions with a literal global each rather than one taking
-- a name, because assigning through _G may not be the same thing to the firmware.
function fftsa.sg_mk_trace(want)
  FFTSA_TRACE = buffer.make(want, buffer.STYLE_WRITABLE_FULL)
  return fftsa.sg_fmt_seed(FFTSA_TRACE, want)
end

function fftsa.sg_mk_mark(want)
  FFTSA_MARK = buffer.make(want, buffer.STYLE_WRITABLE_FULL)
  return fftsa.sg_fmt_seed(FFTSA_MARK, want)
end

-- The format and the seed, shared by the two above. Capacity is sg_maxpts, so a frame
-- writing sg_ncol points always fits and fftsa.dsp_live() clamps a raised sg_ncol to it --
-- one write past capacity is event 4915. Seeded because an empty buffer binds no trace at
-- all, and sg_build() binds this before the first frame has run.
function fftsa.sg_fmt_seed(b, want)
  if b == nil then return nil end
  -- FILL_ONCE unless fftsa.sg_ring is on, where the wrap line is accepted and parked under
  -- the plot by the two sentinels sg_fill writes. Set before the seed so the seed itself
  -- lays down one full lap and leaves the cursor back at slot 1.
  if fftsa.sg_ring then b.fillmode = buffer.FILL_CONTINUOUS end
  --
  -- A custom unit is how the axis gets to say decibels; without it the labels read "+020.0V"
  -- on numbers that are not volts. Not buffer.UNIT_DECIBEL, which panics the instrument
  -- during build. The firmware truncates a custom label to two characters (event 4933).
  buffer.unit(buffer.UNIT_CUSTOM1, "dB")
  buffer.write.format(b, buffer.UNIT_CUSTOM1, buffer.DIGITS_4_5,
                         buffer.UNIT_HERTZ,   buffer.DIGITS_6_5)
  -- The seed has to sit inside the axes the graph is pinned to, being the geometry the widget
  -- draws at the first paint of every launch. X across the plotted span and not 0..want-1,
  -- the X axis being bound to the frequency in the extra field: a counter puts every point
  -- in the leftmost half-percent of the plot with the first ten below the axis minimum. Y a
  -- small ramp rather than one repeated value, or the trace has a bounding box of zero
  -- height; sg_seed_spread is 2 dB, about three pixels on an axis 140 dB tall.
  local k, span = nil, want - 1
  if span < 1 then span = 1 end
  -- sg_flo_hz and sg_fhi_hz are 0 and 1e9 until the first sg_store_xrange, and those are
  -- values rather than nil, so an `or` chain never falls through them. sg_build() runs before
  -- apply() commits the span, so on the first build of a power cycle they are still the
  -- sentinels -- which seeds X across a billion hertz onto an axis pinned to 50 kHz. A stop
  -- above the fastest rate's Nyquist is the tell, no span being able to ask for one.
  local flo, fhi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if flo == nil or fhi == nil or fhi > fftsa.sg_fmax_real then
    flo, fhi = fftsa.flo, fftsa.fhi
  end
  if flo == nil or fhi == nil or not (fhi > flo) then
    flo, fhi = fftsa.flomin, fftsa.fhi_min
  end
  -- No sentinels here, however the ring is set: the seed is the geometry the widget draws
  -- at the first paint of a launch, before sg_bind pins anything, and a point 1000 dB
  -- under the floor makes that first box 1002 dB tall. The first pass writes the real
  -- sentinels a frame later, by which time both axes are pinned.
  for k = 1, want do
    local t = (k - 1) / span
    fftsa.sg_write_point(b, fftsa.sg_dbmin + fftsa.sg_seed_spread * t,
                         flo + (fhi - flo) * t, k)
  end
  return b
end

-- One point: value dB, extra the bin's frequency in Hz, timestamp a plain counter. The
-- timestamp carries nothing, X being bound to the extra field, but buffer.write.reading
-- documents chronological order so it still has to increase. The slot number serves, and as
-- an integer cannot reach the fractional-seconds refusal at 0.9999999 (event 1131, a modal
-- dialog per point).
function fftsa.sg_write_point(buf, db, f, slot)
  if slot == nil then slot = 1 end
  buffer.write.reading(buf, db, f, slot, 0)
end


-- The fill window, and the ring that removes it.
--
-- FILL_ONCE must be cleared before it is refilled, so the bound buffer holds fewer than
-- sg_ncol points for the length of the fill: 20.75 ms of a 105 ms frame at 255 points. An
-- append blocks Lua for ~80 us and that is the only time the display task runs, so the task
-- gets sg_ncol chances to paint inside the window, and a paint landing there draws a
-- truncated trace. That is the flicker, at about fps * window / period.
--
-- The ring is never partially populated, so a mid-pass paint draws this frame mixed with
-- the last -- a tear, not a dropout. Capacity equals the points a pass writes, so the
-- cursor returns to slot 1 every pass and startindex/endindex are stationary. That is the
-- difference from the ring that was tried and abandoned, which wrote 255 to 340 points into
-- a 680 ring and moved the extent every frame.
--
-- The cost would be the wrap seam: the widget joins newest to oldest, which in frequency
-- order is the two ends of the axis -- a line across the whole plot, drawn whenever the
-- cursor is mid-pass, so it flickers at exactly the rate the dropout used to. 8.40 tried
-- parking it below the axis floor and the widget CLAMPS rather than clips: it came out as a
-- green line along the bottom rule, measured on the glass.
--
-- So the pass folds back on itself instead. Ascending flo..fhi, then descending fhi..flo:
-- the join at the fold is the same point twice and so is the wrap, both zero length, and
-- every edge is drawn twice in opposite directions. There is no seam at any cursor
-- position, and the picture is exactly the spectrum. It costs twice the appends.
-- Every count, and a sample count threshold was tried and removed. The arithmetic said the
-- dropout should fade at the long counts, the fill window being 20 ms of a 420 ms frame at
-- 32768 against 20 of 105 at 2048 -- so 8.42 used the ring below 4096 only. On the glass
-- 8192, 16384 and 32768 all still flickered plainly. The rate argument counts dropouts and
-- ignores how long each one is on the glass: a truncated paint stays up until the next
-- paint, which at 1.8 fps is about half a second rather than 70 ms, so a low frame rate
-- makes a dropout more visible and not less. The ring costs 1.8 fps against 2.4 at 32768
-- and that is the price of no flicker anywhere.
--
-- The switch stays because it is the revert: FILL_ONCE is still the shipped behaviour of
-- every build before 8.41, the suite covers both branches, and no other instrument has run
-- the ring yet.
fftsa.sg_ring  = true
fftsa.sg_stamp = 0       -- ring timestamps, monotonic across passes

-- Capacity a ring needs: the spectrum plus one sentinel at each end. Capacity must equal
-- the writes a pass makes or the cursor walks, so this is the one place that decides it and
-- sg_make_buffer asks here rather than using sg_maxpts.
-- One pass writes exactly capacity, so capacity is the points a pass writes.
--
-- WHAT DRAWS A LINE IS THE JOIN BETWEEN CONSECUTIVE PASSES, not the trace closing on itself.
-- The display task keeps its own ring of 720 records and accumulates into it across frames,
-- so a pass that always runs flo -> fhi leaves a fhi -> flo step at every frame boundary
-- inside that ring and the widget draws it. setfill(g, 0) does not affect it, and an
-- unconditional closure would draw every frame rather than alternate ones.
--
-- So each pass has to END where the next one BEGINS. A fold does that by running up the band
-- and back down, at twice the appends; ALTERNATING THE DIRECTION of each pass does it at one
-- lap. A descending pass traverses the same curve backwards, so the picture and the trace
-- extent are unchanged.
--
-- ALTERNATING DIRECTION CANNOT BE USED, and the reason is the one that matters for every
-- future change here: EVERY SLOT MUST ALWAYS HOLD THE SAME FREQUENCY.
--
-- The display task paints during every append, so a paint lands part-way through a pass with
-- some slots holding this pass and the rest the previous one. That is invisible only while
-- slot i carries the same x value in both -- then the two passes differ in dB alone and the
-- picture is a blend of two spectra at the same frequencies. A fold satisfies it: slot i is
-- hz[i] going up and hz[cap+1-i] coming back, every pass alike. Alternating the direction
-- does not: slot i is hz[i] on one pass and hz[room+1-i] on the next, so a mid-pass paint
-- holds two different frequencies per slot and the curve doubles back. Measured on the glass
-- as a double curve on alternate frames, at every sample count.
--
-- This is also why the ring removed the flicker that FILL_ONCE had: not because the buffer is
-- never empty, but because a partial update is indistinguishable from a complete one.
--
-- Do not test any of this with a straight-line spectrum: a ramp's join is collinear with the
-- ramp, so it is invisible and an always-ascending pass looks clean when it is not.
fftsa.sg_fold = true

-- Which way the next one-lap pass runs. Flipped by sg_fill and read nowhere else.
fftsa.sg_up = true

-- The pixel fill, which draws a pass by writing the display task's own records instead of
-- appending to the buffer: 9.6 ms measured for a 510-record block against 39 ms of appends.
-- fftsa.nl.px_try carries all of it and says what it costs.
--
-- THE APPEND PATH STAYS AS THE FALLBACK, and that is the whole shape of this. Nothing is
-- removed: the fill below is what every build before this one shipped and what runs whenever
-- the pixel path has not engaged, has been switched off, or has refused a frame. The pixel
-- path is only ever a replacement for a fill it has already proved it can do.
--
-- Off by default. The ring the writes go into is found at runtime and the one unrecoverable
-- outcome is writing into something that is not it, so the switch exists to be turned on
-- deliberately -- from the socket, from a build that has been through the gates on the glass.
fftsa.sg_pix = false

-- The pixel path's two halves, and why they sit on opposite sides of the fill.
--
-- DRAWING replaces the fill, so it comes first and returns the points drawn. SEEKING needs the
-- ring to hold THIS frame's decibels -- the needle is db[1], and the only thing that puts it
-- into the ring is the append fill -- so it comes last. A search run before the fill would be
-- matching this frame's needle against last frame's records and would never find anything.
--
-- Both are inside pcall. A raise anywhere in the pixel path costs the fallback for the rest of
-- the session and not the frame: sg_fill carries on and appends, as it did before.
function fftsa.sg_pix_draw(db, hz, nseg, tb)
  local nl = fftsa.nl
  if nl == nil or nl.px == nil or nl.px.state ~= 'on' then return nil end
  -- One timestamp, reserved before the append that uses it, for the same reason the fill
  -- reserves its whole range first: a write below a timestamp already in the ring raises event
  -- 4924 as a modal dialog over the app, which also makes the control socket refuse every
  -- statement, so the state that caused it cannot be read back either.
  local t = (fftsa.sg_stamp or 0) + 1
  fftsa.sg_stamp = t
  local ok, n = pcall(nl.px_frame, db, hz, nseg, tb, t)
  if not ok then
    nl.px_off('px_frame raised: ' .. tostring(n))
    return nil
  end
  return n
end

function fftsa.sg_pix_arm(db, hz, nseg, tb)
  local nl = fftsa.nl
  if nl == nil or nl.px == nil then return end
  local st = nl.px.state
  if st == 'on' or st == 'off' then return end
  local t = (fftsa.sg_stamp or 0) + 1
  fftsa.sg_stamp = t
  local ok, err = pcall(nl.px_try, db, hz, nseg, tb, t)
  if not ok then nl.px_off('px_try raised: ' .. tostring(err)) end
end

-- Back to appends, and the one call that must never be missed.
--
-- The ring is the display task's allocation for a TRACE OBJECT. Freeing that object frees the
-- ring, and a frame that then writes 40 KB into it is writing into the heap's free list --
-- which is how 0x318FC0, PegRect::operator& on a freed widget, is reached. So every place that
-- removes a trace or replaces a trace buffer calls this, before it does so.
function fftsa.sg_pix_stop(why)
  local nl = fftsa.nl
  if nl == nil or nl.px == nil or nl.px_restart == nil then return end
  if nl.px.state == 'off' then return end
  nl.px_restart(why)
end

function fftsa.sg_ring_cap(ncol)
  local n = ncol or fftsa.sg_ncol
  if fftsa.sg_fold then return 2 * n end
  return n
end

-- The trace buffer's capacity, and the one thing the ring costs. FILL_ONCE takes the
-- sg_maxpts ceiling, which is what lets sg_ncol be raised and lowered while frames run
-- without reallocating. A ring cannot: capacity has to equal the points a pass writes, so
-- under the ring a changed sg_ncol needs a reallocation, and the only safe place for one
-- is Apply -- replacing the trace buffers on a live graph freezes the trace.
-- The same capacity in both modes. The ring needs capacity to equal the points a pass
-- writes; FILL_ONCE does not care that capacity exceeds what it writes. Keeping them equal
-- is what lets fftsa.sg_ring be flipped without a new buffer -- a reallocation on a live
-- graph freezes the trace at the frame it fires, which is the one thing neither mode may do.
function fftsa.sg_capacity()
  return fftsa.sg_ring_cap()
end



-- The most points a frame may plot, which is half the capacity under the ring: the pass
-- writes each point twice. fftsa.dsp_live() clamps to this, so the primitive is asked for a
-- count the fill can write without clamping it again -- a second clamp is how the trace and
-- the primitive come to disagree.
function fftsa.sg_points_max(buf)
  local b = buf or fftsa.sg_buf
  if b == nil then return fftsa.sg_maxpts end
  -- A folded pass spends half its capacity on the return lap; a one-lap pass spends none.
  if fftsa.sg_ring and fftsa.sg_fold then return math.floor(b.capacity / 2) end
  return b.capacity
end

-- The frame's trace write, both modes. Returns the points written, sentinels excluded.
--
-- THE RING NEEDS THE COMPILED PATH. fftsa.spectrum_interp writes the trace through
-- dsp.spectrum, which clears sg_buf itself before filling it, and a clear resets the ring
-- cursor -- leaving the buffer part full and the seam sweeping. That path cannot produce a
-- spectrum in this archive anyway (no dsp.spectrum, so the frame halts and says so), which
-- is what makes the ring safe here rather than a second thing to get right.
function fftsa.sg_fill(db, hz, nseg)
  local wr = buffer.write.reading
  local tb = fftsa.sg_buf
  local i
  if tb == nil or nseg == nil or nseg < 1 then return 0 end
  if not fftsa.sg_ring then
    tb.clear()
    for i = 1, nseg do
      wr(tb, db[i], hz[i], i, 0)
    end
    return nseg
  end
  -- Timestamps keep climbing across passes, because the slot being overwritten holds an
  -- older one and buffer.write.reading documents chronological order. Integers, so they
  -- cannot reach the 0.9999999 fractional refusal.
  -- Exactly capacity points, always, or the cursor walks and the fold stops landing on
  -- itself. Up the band then back down it, so both joins are a point repeated. A short
  -- spectrum repeats its last point to fill the lap -- duplicates are zero-length edges and
  -- draw nothing -- and a long one is clamped.
  -- The pixel path, when it has engaged: one memwrite and one append in place of the pass
  -- below. nil means it has not engaged, or refused this frame, and the fill runs.
  if fftsa.sg_pix then
    local n = fftsa.sg_pix_draw(db, hz, nseg, tb)
    if n ~= nil then return n end
  end
  local cap = tb.capacity
  local room = cap
  if fftsa.sg_fold then room = math.floor(cap / 2) end
  if nseg > room then nseg = room end
  local t = fftsa.sg_stamp
  -- THE RANGE IS RESERVED BEFORE THE FIRST WRITE, not recorded after the last.
  --
  -- A fill that does not finish otherwise leaves sg_stamp BEHIND timestamps that are already
  -- in the ring, and every frame after it then rewrites a lower one. The firmware answers that
  -- with event 4924, "Time in a 'writable' reading buffer cannot reverse", as a MODAL DIALOG
  -- over the running app -- which also makes the control socket refuse every statement with "a
  -- command from another interface is running", so the state that caused it cannot be read
  -- back either. Measured 2026-11-09 after a socket ABORT cut a fill in half: the app drew
  -- nothing further and needed an injected EXIT press to clear the dialog.
  --
  -- Reserving first costs a gap in the timestamps whenever a fill is cut short. A gap is
  -- harmless -- the widget reads the values, and buffer.write.reading only requires that time
  -- does not go backwards.
  local used = room
  if fftsa.sg_fold then used = 2 * room end
  fftsa.sg_stamp = t + used
  local last = nseg
  -- One lap, alternating direction, so this pass ends where the next one begins and the join
  -- between them is a repeated point rather than a step across the whole band.
  if not fftsa.sg_fold then
    local i
    if fftsa.sg_up then
      for i = 1, room do
        local j = i
        if j > last then j = last end
        wr(tb, db[j], hz[j], t + i, 0)
      end
    else
      for i = 1, room do
        local j = room + 1 - i
        if j > last then j = last end
        wr(tb, db[j], hz[j], t + i, 0)
      end
    end
    fftsa.sg_up = not fftsa.sg_up
    if fftsa.sg_pix then fftsa.sg_pix_arm(db, hz, nseg, tb) end
    return nseg
  end
  for i = 1, room do
    local j = i
    if j > last then j = last end
    wr(tb, db[j], hz[j], t + i, 0)
  end
  for i = 1, room do
    local j = room + 1 - i
    if j > last then j = last end
    wr(tb, db[j], hz[j], t + room + i, 0)
  end
  -- The search, with the records this pass has just written. See sg_pix_arm for why it is here
  -- and not above the fill.
  if fftsa.sg_pix then fftsa.sg_pix_arm(db, hz, nseg, tb) end
  return nseg
end


-- Build the screen once, at launch: graph, peak table, settings line. The frame loop only
-- refills the buffer and updates text.
function fftsa.sg_build(title, nbins, npoints)
  fftsa.sg_destroy()

  fftsa.sg_make_buffer(nbins, npoints)
  local create = display.create
  local small  = display.FONT_SMALL
  fftsa.sg_scr = create(display.ROOT, display.OBJ_SCREEN, title)
  -- create() returns nil when the pool is exhausted, posting one event and not raising.
  -- Without this test every child is built against a nil parent, which does raise, in this
  -- code rather than the firmware's. fftsa.build() passes the reason to fftsa.start().
  if fftsa.sg_scr == nil then
    fftsa.lasterr = "OBJPOOL exhausted building the spectrum screen"
    return nil, fftsa.lasterr
  end
  -- Creating a screen makes it active, so the cover goes back in front before the
  -- first child: otherwise the operator watches the screen assemble itself.
  fftsa.loading_front()

  fftsa.sg_graph = create(fftsa.sg_scr, display.OBJ_GRAPH, fftsa.sg_gx, fftsa.sg_gy, fftsa.sg_gw, fftsa.sg_gh)
  -- X is ELEMENT_EXTRA (the bin's frequency in Hz); Y is ELEMENT_DATA (dB).
  fftsa.sg_bind()

  fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d = {}, {}, {}
  for p = 1, fftsa.sg_npeak do
    local col, row = 1, p - 1
    if p > 3 then col = 2; row = p - 4 end
    local y = fftsa.sg_pky + row * fftsa.sg_pkdy
    if y > 418 then y = 418 end
    fftsa.sg_pk_f[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_f[col], y,
                        string.format("%d  ---", p), fftsa.sg_pk_cf, small, display.JUST_LEFT)
    fftsa.sg_pk_v[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_v[col], y, "", fftsa.sg_pk_cv, small, display.JUST_LEFT)
    fftsa.sg_pk_d[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_d[col], y, "", fftsa.sg_pk_cd, small, display.JUST_LEFT)
  end

  fftsa.sg_thd_last = nil
  fftsa.sg_thd = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_thd_x, fftsa.sg_thd_y,
                        fftsa.sg_thd_text(nil, nil, nil), fftsa.sg_thd_c, small, display.JUST_LEFT)

  fftsa.sg_xunit = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_xunit_x, fftsa.sg_xunit_y,
                          fftsa.sg_xunit_text(), fftsa.sg_xunit_c, small, display.JUST_LEFT)

  return fftsa.sg_scr
end

-- Tear down in dependency order: detach the trace, drop the screen and its
-- children, then free the buffer the trace referenced. Nils every handle.
function fftsa.sg_destroy(release)
  fftsa.sg_pix_stop('screen destroyed')
  if fftsa.sg_graph ~= nil then
    display.graph.removeall(fftsa.sg_graph)
  end
  fftsa.del_scr(fftsa.sg_scr)
  fftsa.sg_scr, fftsa.sg_graph, fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d,
    fftsa.sg_xunit, fftsa.sg_thd = nil, nil, nil, nil, nil, nil, nil
  -- Two callers want opposite things here, so release says which.
  --
  -- Releasing is what an exit does: the buffers go, and defbuffer1 is made current first,
  -- because the front panel adopts a user buffer as its current one -- an app that exits
  -- leaving FFTSA_MARK alive leaves the home screen showing a spectrum level in dB as though
  -- it were a measurement. That restore needs a yield before the delete, for the same reason
  -- fftsa.del_scr does: the panel picks up the new current buffer on its own schedule and
  -- not on the return of dmm.digitize.read, and deleting a buffer it is still reading is
  -- pc=00318FC0.
  --
  -- Not releasing is what sg_build() does on a relaunch: the pair is handed on in
  -- FFTSA_OLDTRACE and FFTSA_OLDMARK for sg_free_old() to take once the new pair exists,
  -- because freeing them first lets the new pair be allocated over them and inherit this
  -- launch's trace subscription. Handed over only when there is something to hand over,
  -- sg_destroy running twice on a relaunch.
  if release then
    fftsa.sg_restore_defbuffer()
    delay(fftsa.sg_scr_yield)
    fftsa.sg_drop_buffers()
  else
    if fftsa.sg_buf ~= nil then FFTSA_OLDTRACE = fftsa.sg_buf end
    if fftsa.sg_mk ~= nil then FFTSA_OLDMARK = fftsa.sg_mk end
    FFTSA_TRACE, FFTSA_MARK = nil, nil
  end
  fftsa.sg_buf, fftsa.sg_mk = nil, nil
  collectgarbage()
end

-- Make defbuffer1 the instrument's current buffer again. One reading into it is what names
-- it: the panel follows the buffer last used, and nothing else in the API points it. One
-- sample, this being a teardown. Guarded, and its failure must not stop the deletes below
-- it -- a panel left on the wrong buffer is untidy, a buffer left allocated is a leak.
--
-- Both guards below are events seen on the glass rather than caution. Measure and digitize
-- are exclusive -- setting the function of one sets the other's to None, and the idle one
-- reads FUNC_NONE -- and the firmware posts rather than raising when that is ignored, so a
-- pcall catches neither:
--
--   2800  the count attribute is not available for the DC voltage function
--   2801  DMM cannot measure when digitize function is set to None
--
-- Both arrive, in that order, on the first launch of a power cycle: fftsa.start() opens with
-- fftsa.stop(), which lands here before any digitize function is set, and a cold instrument
-- sits on measure DC voltage.
function fftsa.sg_restore_defbuffer()
  -- Nothing of this app's can be current if it never made any, which is that cold start.
  -- Skipping leaves the digitizer alone: a teardown on the way into a launch must not be
  -- the thing that configures the instrument.
  if FFTSA_TRACE == nil and FFTSA_MARK == nil and FFTSA_OLDTRACE == nil
     and FFTSA_OLDMARK == nil and fftsa.cap == nil then
    fftsa.sg_defbuf_ok = nil
    return false
  end
  -- Whichever side is live. The app's own exit is the digitize branch; the measure branch is
  -- for an exit after the panel has been moved to a measure function under the app.
  local ok = false
  if dmm.digitize.func ~= dmm.FUNC_NONE then
    ok = pcall(function()
      dmm.digitize.count = 1
      dmm.digitize.read(defbuffer1)
    end)
  elseif dmm.measure.func ~= dmm.FUNC_NONE then
    ok = pcall(function() dmm.measure.read(defbuffer1) end)
  end
  -- Not into fftsa.lasterr: a teardown runs inside fftsa.start_failed(), which has just put
  -- the reason the start failed there and the panel shows it, so a note about the current
  -- buffer would replace the one thing worth reading. Its own field, so a socket can ask.
  fftsa.sg_defbuf_ok = ok
  return ok
end

-- Delete both trace buffers and every global naming them, in the order that leaves nothing
-- dangling. Through the globals, because buffer.delete nils the variable it is handed:
-- deleting through a local or a table field clears that one reference and leaves the others
-- pointing at a buffer that is gone, so a second delete through one of those is a double.
function fftsa.sg_drop_buffers()
  if FFTSA_MARK ~= nil then pcall(function() buffer.delete(FFTSA_MARK) end) end
  if FFTSA_TRACE ~= nil then pcall(function() buffer.delete(FFTSA_TRACE) end) end
  if FFTSA_OLDMARK ~= nil then pcall(function() buffer.delete(FFTSA_OLDMARK) end) end
  if FFTSA_OLDTRACE ~= nil then pcall(function() buffer.delete(FFTSA_OLDTRACE) end) end
  FFTSA_TRACE, FFTSA_MARK = nil, nil
  FFTSA_OLDTRACE, FFTSA_OLDMARK = nil, nil
  return true
end


-- Bin index range covering the visible window, clamped into 1..nbins, and shared by the plot
-- and the peak search so the table describes what is on screen.
--
-- The single owner of the ceil/floor convention: the peak search, the noise pass and the
-- "only N bins in the span" line all need it, and a second copy is free to round the other
-- way -- one bin of disagreement in exactly that message. flo/fhi default to the window the
-- display has stored, and dsp.* passes its own span instead, so the primitives never write
-- a display field to make this read the right one.
function fftsa.sg_window_bins(nbins, binhz, flo, fhi)
  if binhz == nil or binhz <= 0 then return 1, nbins end
  if flo == nil then flo = fftsa.sg_flo_hz end
  if fhi == nil then fhi = fftsa.sg_fhi_hz end
  local floor, ceil = math.floor, math.ceil
  -- ceil, not floor, for the low edge: floor() maps every start below one bin
  -- width (195 Hz at 100 kS/s) back to bin 1, the DC bin.
  local kmin = ceil(flo / binhz) + 1
  local kmax = floor(fhi / binhz) + 1
  if kmin < 1 then kmin = 1 end
  if kmin > nbins then kmin = nbins end
  if kmax > nbins then kmax = nbins end
  if kmax < kmin then kmax = kmin end
  return kmin, kmax
end

-- The settings line, written so a raise cannot escape: everything it describes is committed
-- before it is built, and both writers sit inside apply() after the hardware is configured,
-- so a failure here is a stale line that says so in fftsa.lasterr rather than an Apply that
-- reports failure over cosmetics. The one place that writes the line. Not on the frame path
-- -- twice an Apply and once a gesture -- so a closure per call is affordable.
function fftsa.sg_write_xunit()
  if fftsa.sg_xunit == nil then return false end
  local ok, err = pcall(function()
    -- The colour belongs with the text, in the one place that writes the line, over-range
    -- being a warning. Written only when it changes, like the text: the over-range
    -- transition brings this here from the tick, where a setcolor a second would be waste.
    local c = fftsa.sg_xunit_c
    if fftsa.overrange then c = fftsa.sg_over_c end
    if c ~= fftsa.sg_xunit_c_now then
      fftsa.sg_xunit_c_now = c
      display.setcolor(fftsa.sg_xunit, c)
    end
    display.settext(fftsa.sg_xunit, fftsa.sg_xunit_text())
  end)
  if not ok then
    -- Every input, not just the message: a "bad argument #2 to format (string expected, got
    -- nil)" here has never been reproduced or explained, the call it names being unable to
    -- return nil for any value this records. If it recurs, the values come with it.
    fftsa.lasterr = string.format(
      "settings line: %s [n=%s fs=%s fs_acq=%s range=%s rangetxt=%s win=%s "
      .. "binhz=%s nbins=%s term=%s]", tostring(err), tostring(fftsa.n), tostring(fftsa.fs),
      tostring(fftsa.fs_acq), tostring(fftsa.range),
      tostring(fftsa.range_labels[fftsa.range_to_idx(fftsa.range)]), tostring(fftsa.win_i),
      tostring(fftsa.binhz), tostring(fftsa.sg_nbins), tostring(fftsa.terminal_text()))
  end
  return ok
end

-- The window and the settings line, without the pin. Split out for the one caller that must
-- not pin: an adopted gesture about to re-plan has fftsa.apply() pinning from the same pair
-- a moment later, and an axis write is 60 ms.
function fftsa.sg_store_xrange(flo_hz, fhi_hz)
  fftsa.sg_flo_hz = flo_hz
  fftsa.sg_fhi_hz = fhi_hz
  fftsa.sg_write_xunit()
end

-- "---", not a number, for anything unmeasured: 0.00% reads as a clean signal where no
-- harmonic in the window means no figure at all. dBV, as the peak table's dB column. n is
-- the sample count, and it chooses the THD decimal count and nothing else.
function fftsa.sg_thd_text(thd, snr, ndb, n, over)
  local t, s
  -- Over-range first, and dashed rather than named: every figure here would be arithmetic
  -- about 9.9e+37 instead of about volts, and NoSig is the opposite diagnosis. The floor
  -- goes too, being the one figure otherwise printed unclamped.
  if over then
    t, s, ndb = "THD: ---", "S/N: ---", nil
  -- Neither ratio means there is no fundamental to take them against, which is what a
  -- shorted input looks like. Named rather than dashed, and the labels stay.
  elseif thd == nil and snr == nil then
    t, s = "THD: NoSig", "S/N: NoSig"
  else
    if thd == nil then t = "THD: ---"
    -- thd == thd is the NaN test: this firmware's >= is true for a NaN, so the branches
    -- below would print "nan%" rather than the dashes that mean "not measured".
    elseif thd ~= thd then t = "THD: ---"
    -- Past 100% -- a clipped input -- any decimal is a digit of noise.
    elseif thd >= 100 then t = string.format("THD: %.0f%%", thd)
    -- Longest record first. A missing count takes the short form: it is the one that cannot
    -- overstate the plan.
    elseif n ~= nil and n >= fftsa.sg_thd_n4 then t = string.format("THD: %.4f%%", thd)
    elseif n ~= nil and n >= fftsa.sg_thd_n3 then t = string.format("THD: %.3f%%", thd)
    else t = string.format("THD: %.2f%%", thd) end
    if snr == nil or snr ~= snr then s = "S/N: --- dB"
    else s = string.format("S/N: %.1f dB", snr) end
  end
  if ndb == nil or ndb ~= ndb then return t .. "    " .. s .. "    Noise Floor: --- dBV" end
  return t .. "    " .. s .. string.format("    Noise Floor: %.1f dBV", ndb)
end

-- Written only when the text changes, like the terminal selection, and on the peak table's
-- clock rather than the frame. The figures come from the primitive that produced the
-- spectrum on screen, over the bins it reduced, and it reports thd as a fraction where this
-- line prints a percentage. Through fftsa.distortion() and fftsa.plan_n(), which pick the
-- live path: asking dsp.* directly would describe a transform the native path never ran.
function fftsa.sg_show_thd()
  if fftsa.sg_thd == nil then return false end
  local thd, snr, ndb = fftsa.distortion()
  if thd ~= nil then thd = thd * 100 end
  local t = fftsa.sg_thd_text(thd, snr, ndb, fftsa.plan_n(), fftsa.overrange)
  if t == fftsa.sg_thd_last then return false end
  fftsa.sg_thd_last = t
  display.settext(fftsa.sg_thd, t)
  return true
end

-- The one place a zoom touches: it stores the window, rewrites the settings line and
-- re-pins the axis, which is what makes the firmware relabel.
function fftsa.sg_set_xrange(flo_hz, fhi_hz)
  fftsa.sg_store_xrange(flo_hz, fhi_hz)
  fftsa.sg_pin_x()
end

-- Bind the traces: the spectrum always, the markers when they are switched on. The one
-- place that decides, so the build and a rebind cannot disagree about what is bound.
--
-- removeall() first, or add() stacks a duplicate trace.
function fftsa.sg_bind()
  local g = fftsa.sg_graph
  if g == nil then return false end
  -- removeall frees the trace objects, and the display task's record ring with them. Anything
  -- still holding that address would be writing 40 KB into the free list.
  fftsa.sg_pix_stop('traces rebound')
  display.graph.removeall(g)
  display.graph.add(g, fftsa.sg_buf, display.ELEMENT_DATA,
                    fftsa.sg_buf, display.ELEMENT_EXTRA)
  if fftsa.sg_markers and fftsa.sg_mk ~= nil then
    display.graph.add(g, fftsa.sg_mk, display.ELEMENT_DATA,
                      fftsa.sg_mk, display.ELEMENT_EXTRA)
    -- One scale for every trace. A custom graph starts at TRACE_ACTIVE, where a scale
    -- call reaches only the selected trace -- so the second trace keeps auto-scaling and
    -- its points are stretched across the whole plot, landing nowhere near the spectrum.
    -- TRACE_ALL syncs them: "as scale settings for X and Y change they will get applied
    -- to all traces". Documented to work only on a custom-created graph, which this is.
    display.graph.scaletrace(g, display.TRACE_ALL)
  end
  -- Always a line. See sg_mk_per: markers are per graph, so the peak trace draws needles
  -- rather than asking for a marker the spectrum would get too.
  display.graph.drawstyle(g, display.STYLE_LINE)
  fftsa.sg_pin_y(g)
  fftsa.sg_pin_x()
  -- Re-asserted for the same reason as the pins above: removeall and add may reset what
  -- the object carries, and the read-back needs the registration to answer at all.
  -- sg_rebind() reaches here from the failed-frame path, so without this one raised frame
  -- could leave a closed padlock over a view that still pans. Idempotent.
  fftsa.sg_hook_scale()
  return true
end

-- Did the capture hold a reading the range cannot represent? From the statistics the firmware
-- maintains as the buffer fills, so getstats hands back an already-current table and this is
-- one call a frame rather than 16,384 comparisons in Lua. Both ends tested, because a clipped
-- sine saturates symmetrically and -9.9e+37 is as much a sentinel as +9.9e+37. n == 0 leaves
-- every other field nil, which is an empty buffer and not an over-range one.
function fftsa.cap_overrange(buf)
  if buf == nil then return false end
  -- Guarded because this runs inside the frame: a firmware without getstats would raise on
  -- every frame and the twenty-failure halt would take the app down over a warning it cannot
  -- offer. Answering false loses the detection and nothing else.
  if buffer.getstats == nil then return false end
  local st = buffer.getstats(buf)
  if st == nil or st.n == nil or st.n == 0 then return false end
  local lim = fftsa.sg_vmax_real
  if st.max ~= nil and st.max.reading ~= nil and st.max.reading > lim then return true end
  if st.min ~= nil and st.min.reading ~= nil and st.min.reading < -lim then return true end
  return false
end

-- What the settings line says instead when the capture held an unrepresentable reading. The
-- wording is deliberate: only the peaks of a signal a little past the range are clipped and
-- the rest of the record is real, so this is neither "no signal" nor "the signal is 9.9e+37".
function fftsa.sg_overrange_text(range)
  local i = fftsa.range_to_idx(range)
  local lab = tostring(fftsa.range_labels[i])
  -- The advice has to be possible: on the largest range there is nothing to raise to, and
  -- telling an operator to raise it there sends them to a form that cannot help.
  local fix = "raise the range"
  if i >= table.getn(fftsa.ranges) then fix = "reduce the input" end
  return "OVERRANGE: values in the signal exceed the " .. lab .. " range -- " .. fix
end

-- The peak table under over-range: every row dashed, written once per transition rather than
-- per frame, because every figure would be arithmetic about 9.9e+37 and a plausible-looking
-- number is worse than a dash. sg_show_peaks clears the latch on the way back.
function fftsa.sg_show_peaks_over()
  if fftsa.sg_pk_over then return false end
  if fftsa.sg_pk_f == nil then return false end
  fftsa.sg_pk_over = true
  local p
  for p = 1, table.getn(fftsa.sg_pk_f) do
    if fftsa.sg_pk_f[p] ~= nil then
      display.settext(fftsa.sg_pk_f[p], string.format("%d  ---", p))
      display.settext(fftsa.sg_pk_v[p], "")
      display.settext(fftsa.sg_pk_d[p], "")
    end
  end
  return true
end

-- The model, read once and kept: it cannot change while the app runs, and the floor rule
-- below asks on every Apply. An instrument that will not say reads as "", which matches no
-- model, so an absent attribute takes the shallower floor rather than raising.
function fftsa.model_name()
  if fftsa.model_str == nil then
    local m = nil
    if localnode ~= nil then m = localnode.model end
    if m == nil then m = "" end
    fftsa.model_str = tostring(m)
  end
  return fftsa.model_str
end

-- The digits anywhere in the string, not the whole of it, so a prefixed or suffixed form
-- answers the same. Plain find, the fourth argument, pattern metacharacters having no
-- business in a model number. string.match is the 5.1 spelling and is absent here.
function fftsa.is_7510()
  return string.find(fftsa.model_name(), "7510", 1, true) ~= nil
end

-- The floor a range and count want, in dBV. The deeper one needs the 1 V or 0.1 V range and
-- then either a DMM7510, whose floor is under -120 at every count, or a count whose bin is
-- narrow enough to take a DMM6500 under it. A range off the list, a wide-bin count and an
-- unidentified instrument all take -120, the floor that cannot hide a trace.
function fftsa.sg_dbmin_for(range, n)
  if range ~= nil and range <= fftsa.sg_dbmin_deep_vmax then
    if fftsa.is_7510() then return fftsa.sg_dbmin_deep end
    if n ~= nil and n >= fftsa.sg_dbmin_deep_n then return fftsa.sg_dbmin_deep end
  end
  return fftsa.sg_dbmin_std
end

-- Move the floor to what the range wants, answering whether it moved. One assignment is the
-- whole move, every reader taking fftsa.sg_dbmin live: the trace fill, the peak column, the
-- marker needles, the restore's span and dsp.out.dbfloor through dsp_live_push(). The answer
-- is what apply() pins the axis on, and an axis write costs 60 ms and a full repaint.
function fftsa.sg_dbmin_set(range, n)
  -- Defaulted here rather than at the call: a caller that passed only the range would
  -- silently lose the deeper floor at the two counts that need it.
  if n == nil then n = fftsa.n end
  local want = fftsa.sg_dbmin_for(range, n)
  if want == fftsa.sg_dbmin then return false end
  fftsa.sg_dbmin = want
  return true
end

-- The dB axis, pinned. Its own function because sg_bind() has to call it once per trace.
function fftsa.sg_pin_y(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  display.graph.scaley(g, display.YSCALE_OFF, display.AXIS_NORMAL,
                       fftsa.sg_dbmin, fftsa.sg_dbmax)
  return true
end

-- Settling a gesture. Writing an axis limit costs 60 ms and repaints the whole widget, so
-- re-asserting both every frame is most of a short frame -- a slower, flickering trace.
-- Reading one back costs 0.0094 ms, so a settle reads before it writes.
--
-- The read-back's "return values are only valid when the objects event generation is set to
-- ALL", and non-button objects have none by default, so on a graph with no event registered
-- scalex and scaley answer nil and post nothing. sg_hook_scale is not an optimisation:
-- nothing here works without it. It reports the gesture too, which lets a tick that saw no
-- fire skip even the reads. The app's own write also fires EVENT_SCALE, asynchronously, and
-- needs no special case -- the echo reads back as the limits just written. EVENT_CURSOR
-- never fires.
--
-- A handler containing %xmin does not run, and it takes a counter in the same string down
-- with it, so the failure looks like the event never firing. Substitution is documented for
-- command strings, so why this one fails is unestablished: check that before reaching for it.
fftsa.sg_ev = 0        -- EVENT_SCALE fires since the tick last looked

-- A limit counts as moved past this fraction of sg_moved's scale, which is the larger of the
-- span and the endpoint. Taking the endpoint is what stops a narrow window far from DC
-- writing on every tick: at Start 499000, Stop 499010, reachable from the form, the span is
-- smaller than the rounding on its own endpoints. The price is a dead zone in exactly that
-- window -- about thirty pixels of drag go unrestored while the padlock reads closed --
-- accepted because the alternative is a 60 ms write every tick for ever, and a 10 Hz span at
-- 499 kHz holds no bins anyway. What would settle it is the read-back's own precision, which
-- is unmeasured: round-trip a fractional limit exactly and the scale can be the span alone.
fftsa.sg_tol = 1e-6

-- The limits the previous gesture check read, or nil when nothing is in flight. What tells
-- a finger still moving from one that has stopped, in sg_settle_x.
fftsa.sg_seen_lo = nil
fftsa.sg_seen_hi = nil

-- Turn the graph's pan-and-zoom reporting on. Unconditional rather than tied to the lock:
-- the dB axis is restored either way and an unlocked frequency gesture has to be read before
-- it can be adopted, and it costs nothing per frame. Without the report nothing settles, and
-- the symptom is a view that pans while the padlock reads closed.
function fftsa.sg_hook_scale()
  local g = fftsa.sg_graph
  if g == nil then return false end
  if display.EVENT_SCALE == nil then
    fftsa.lasterr = "no EVENT_SCALE on this firmware: the view lock cannot work"
    fftsa.say(fftsa.lasterr)
    return false
  end
  display.setevent(g, display.EVENT_SCALE,
                   "if fftsa ~= nil then fftsa.sg_ev = (fftsa.sg_ev or 0) + 1 end")
  fftsa.sg_ev = 0
  return true
end

function fftsa.sg_moved(got, want, span)
  if got == nil then return false end
  local scale = span
  local a = want
  if a < 0 then a = -a end
  if a > scale then scale = a end
  -- Nothing to measure against: an axis of no height, which only a socket can set. A zero
  -- scale makes every difference exceed the tolerance, so this would be a 60 ms write on
  -- every reported gesture for the life of the app.
  if scale <= 0 then return false end
  return (got - want) > scale * fftsa.sg_tol
      or (want - got) > scale * fftsa.sg_tol
end

-- The dB axis, put back whenever a gesture moved it, lock or no lock: its limits are
-- constants and Options does not offer them, so a dragged dB scale is only a worse view of
-- the same data.
function fftsa.sg_restore_y(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  local span = fftsa.sg_dbmax - fftsa.sg_dbmin
  local y1, y2 = display.graph.scaley(g)
  -- Either limit nil means the read-back told us nothing useful -- both returns are
  -- documented optional -- and a gesture was reported, so the axis is presumed moved: a
  -- pin costs a frame, a dead restore costs the feature.
  if y1 == nil or y2 == nil
     or fftsa.sg_moved(y1, fftsa.sg_dbmin, span)
     or fftsa.sg_moved(y2, fftsa.sg_dbmax, span) then
    fftsa.sg_pin_y(g)
    return true
  end
  return false
end

-- Adopt the frequency axis a gesture left behind: unlocked, a drag or a pinch retunes the
-- analyser to what it asked to see. A pan is not told from a pinch -- whatever the two limits
-- read, snapped into the legal range, is the new span -- and the pin that follows puts the
-- axis on the clamped pair, so a drag past a limit visibly stops at it.
function fftsa.sg_adopt_x(lo, hi)
  -- Refused and not repaired: a NaN limit survives every comparison in span_clamp, so it
  -- would reach the axis write, pick_fs and both Options fields. The span then stays as it
  -- is and the next gesture settles it.
  if lo ~= lo or hi ~= hi then return false end
  -- Rounded, because an axis limit is a float and an Options field is not: unrounded, the
  -- form could neither show nor re-apply the span the gesture just set. It is also what makes
  -- this a one-step fixed point, the pin writing integers that read back as themselves.
  local nlo, nhi = fftsa.span_clamp(math.floor(lo + 0.5), math.floor(hi + 0.5))
  -- Asked before fftsa.fhi moves, since the question is whether the plan in force covers
  -- the new stop.
  local replan = fftsa.plan_changed(nhi)
  fftsa.flo, fftsa.fhi = nlo, nhi
  if replan then
    -- No pin here: fftsa.apply() pins from this same pair, so one would be a second 60 ms
    -- write of identical limits, and the axis keeps the gesture's own limits until then. A
    -- new plan cannot be installed from inside a frame, so fftsa.frame() runs it between.
    fftsa.sg_store_xrange(nlo, nhi)
    fftsa.retune_pending = true
  else
    fftsa.sg_set_xrange(nlo, nhi)
  end
  return true
end

-- The frequency axis after a reported gesture, settled whichever way the lock says. Only
-- limits are compared, not the scale method the pin also re-asserts -- an axis switched to
-- auto-ranging moves its own limits, so the next tick catches it and the pin restores
-- XSCALE_OFF along with them.
function fftsa.sg_settle_x(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  local wlo, whi = fftsa.sg_xwant()
  if wlo == nil then return false end      -- span not plottable: nothing to compare
  local x1, x2 = display.graph.scalex(g)
  -- A nil read-back names no range, so there is nothing to adopt and the only coherent
  -- move is back onto the span. Guarding the lower limit alone would leave a left-anchored
  -- zoom -- which moves the upper one by itself -- invisible.
  if x1 == nil or x2 == nil then
    fftsa.sg_pin_x()
    return true
  end
  if not (fftsa.sg_moved(x1, wlo, whi - wlo)
          or fftsa.sg_moved(x2, whi, whi - wlo)) then
    fftsa.sg_seen_lo, fftsa.sg_seen_hi = nil, nil
    return false
  end
  if fftsa.sg_lock then
    fftsa.sg_seen_lo, fftsa.sg_seen_hi = nil, nil
    fftsa.sg_pin_x()
    return true
  end
  -- Unlocked, adopt only once the gesture has stopped moving: a pair that differs from the
  -- last check is a finger still on the glass, so it is remembered and left alone, and the
  -- next check with the same pair adopts it. One drag then costs one retune, which is a
  -- whole capture, rather than one per check.
  if fftsa.sg_seen_lo == nil
     or fftsa.sg_moved(x1, fftsa.sg_seen_lo, whi - wlo)
     or fftsa.sg_moved(x2, fftsa.sg_seen_hi, whi - wlo) then
    fftsa.sg_seen_lo, fftsa.sg_seen_hi = x1, x2
    return false
  end
  fftsa.sg_seen_lo, fftsa.sg_seen_hi = nil, nil
  return fftsa.sg_adopt_x(x1, x2)
end

-- Both axes, each touched only if it moved, because every write repaints the widget.
function fftsa.sg_settle()
  local g = fftsa.sg_graph
  if g == nil then return false end
  -- Cleared before the writes, not after. A write takes 60 ms an axis and fires
  -- EVENT_SCALE itself, so clearing afterwards discards every fire from that window --
  -- including a finger still dragging through it.
  fftsa.sg_ev = 0
  -- dB first, because it is the half that cannot raise: the X half reaches into the app
  -- module for the clamp and the plan, and a frame carries that on a pcall.
  local wy = fftsa.sg_restore_y(g)
  local wx = fftsa.sg_settle_x(g)
  return wy or wx
end

function fftsa.sg_scale_check()
  if (fftsa.sg_ev or 0) == 0 then return false end
  return fftsa.sg_settle()
end

-- Two jobs on two clocks. The icons need re-asserting only often enough that a focus repaint
-- does not sit there, which is the peak table's period, but a gesture has to be answered
-- while the finger is still near where it stopped. A check with no gesture reported costs one
-- os.clock() and no graph call, so the shorter period is free whenever nothing is moving.
-- Driven from the frame, so the frame period is the floor, and a halted app settles only on
-- a Lock press.
fftsa.sg_scale_period = 0.15    -- seconds between gesture checks
fftsa.sg_tick_last  = nil
fftsa.sg_scale_last = nil
fftsa.sg_term_last  = nil       -- the terminal selection the line currently names

-- The HELP key is the firmware's own: nothing delivers it to a script. display.setevent
-- refuses a disp_key outright, and display.setkeyenable takes only ON and OFF, where OFF
-- substitutes a "help key is disabled" dialog rather than silence. The dialog it raises is
-- invisible to every event path -- no EVENT_HIDE on the screen it covers, nothing in
-- ki.display.dump, no posted event -- so a press leaves that dialog on the glass until EXIT
-- is pressed, and the app neither sees it nor clears it.

function fftsa.sg_slow_tick()
  local now = os.clock()
  local did = false
  local heavy = false
  if fftsa.sg_scale_last == nil
     or (now - fftsa.sg_scale_last) >= fftsa.sg_scale_period then
    fftsa.sg_scale_last = now
    fftsa.sg_scale_check()
    did = true
  end
  if fftsa.sg_tick_last == nil
     or (now - fftsa.sg_tick_last) >= fftsa.sg_pk_period then
    fftsa.sg_tick_last = now
    if fftsa.icons_reassert ~= nil then fftsa.icons_reassert() end
    -- The FRONT/REAR button is pressed on the panel and not through Options, so nothing
    -- else rewrites the line when it moves, and the pair not selected is an open input. On
    -- this clock rather than the gesture one, a human press affording a second of latency,
    -- and the text is written only when the answer changes.
    local term = fftsa.terminal_text()
    if term ~= fftsa.sg_term_last then
      fftsa.sg_term_last = term
      fftsa.sg_write_xunit()
    end
    -- The over-range banner replaces this same line, so it is written on the transition and
    -- on the way back, by the same rule: only when the answer changes.
    if fftsa.overrange ~= fftsa.sg_over_shown then
      fftsa.sg_over_shown = fftsa.overrange
      fftsa.sg_write_xunit()
    end
    -- Distortion and noise: the noise mean is a pass over every plotted bin at 4.3 us a bin,
    -- so 35 ms at 16384, which is why it is on this clock and not the frame's.
    fftsa.sg_show_thd()
    did = true
    heavy = true
  end
  -- Two answers, because the callers want different questions: did says any of this ran, and
  -- the gesture clock sets it every 0.15 s, while heavy says the one-a-second block ran --
  -- the one carrying the noise pass and the icon re-assert. The period rule needs heavy, or
  -- every frame from 4096 up reads as a block frame and the worst plain frame is never
  -- recorded.
  return did, heavy
end

-- The recovery path after a failed frame, and the same binding as the build.
function fftsa.sg_rebind()
  return fftsa.sg_bind()
end


-- Seconds the frame stays blocked after the refill so the display task can paint it; too
-- short and the firmware posts 1706. That task runs only while Lua is blocked, so this and
-- the timer's idle are the whole of its budget.
--
-- Measured at 2048 samples this is neutral from 5 to 20 ms and costs a whole tick at 30. At
-- 5 ms the frame grows by about 50 ms at 16,384, the task not finishing inside the shorter
-- slice and the remainder contending with the next frame's work -- ten times what the yield
-- saved -- and docs/PERFORMANCE.md measures that case at 35.6 Hz in Lua with 194
-- dropped-message events and a trace updating three times a second. Nothing in the app can
-- see it: fftsa.fps counts completed Lua frames against the wall clock, so it reads 35.6
-- while the glass shows 3. Not a figure to shave.
fftsa.sg_yield = 0.010
-- Given to the widget's first draw of a freshly bound trace, before any frame can clear the
-- buffer under it. Paid once a launch, behind a load that already takes seconds.
fftsa.sg_first_paint = 0.25
-- Height, in dB, of the seeded trace: see fftsa.sg_fmt_seed for why it may not be flat.
fftsa.sg_seed_spread = 2
-- Given to the panel between switching away from a screen and deleting it: see
-- fftsa.del_scr for what deleting a screen still on show costs.
fftsa.sg_scr_yield = 0.15

fftsa.sg_pk_period = 1.0        -- seconds between refreshes
fftsa.sg_pk_ftol   = 0.002      -- fractional frequency move worth a redraw
fftsa.sg_pk_vtol   = 0.01       -- fractional amplitude move worth a redraw
fftsa.sg_pk_last   = nil        -- nil means never drawn, so the first call draws
fftsa.sg_pk_lf     = {}
fftsa.sg_pk_lv     = {}

fftsa.sg_peaks_off = false      -- disables the peak table, to attribute display traffic

-- One peak as (frequency in hertz, volts), or nil where there is none.
--
-- pk_hz/pk_v are what the primitive already resolved, sub-bin corrected in both axes once a
-- frame rather than once per display user, and it is the only form the app passes. Without
-- them it falls back to the bin index and interpolates here, which is the form
-- tools/test_tsp.lua drives. fftsa.peak_interp is in tsp/fft_interp.tsp, which the archive
-- leaves out, so on the instrument that fallback answers nil rather than indexing a nil.
function fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
  if pk_hz ~= nil then
    local f = pk_hz[p]
    if f == nil then return nil end
    return f, pk_v[p]
  end
  if bi == nil or bv == nil or fftsa.peak_interp == nil then return nil end
  local k = bi[p]
  if k == nil or k <= 0 or not (bv[p] > 0) then return nil end
  local dk, iv = fftsa.peak_interp(k, fftsa.sg_nbins)
  if iv == nil then dk, iv = 0, math.sqrt(bv[p]) end
  return (k - 1 + dk) * binhz, iv
end

-- Refill the marker trace: one point a peak, at the frequency the peak table reports rather
-- than the column the trace drew. Sorted by frequency, because the peaks arrive
-- strongest-first and a line through them in amplitude order zigzags across the plot. Filled
-- before the spectrum refill, so the paint at the frame's yield sees both buffers complete.
function fftsa.sg_update_markers(bi, bv, count, binhz, pk_hz, pk_v)
  local mk = fftsa.sg_mk
  if mk == nil or not fftsa.sg_markers then return 0 end
  local log10 = math.log10
  local hz, db = fftsa.sg_mk_hz, fftsa.sg_mk_db
  local n = 0
  local p
  for p = 1, count do
    local f, iv = fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
    if f ~= nil then
      local d = 20 * log10(iv)
      if not (d > fftsa.sg_dbmin) then d = fftsa.sg_dbmin end
      if not (d < fftsa.sg_dbmax) then d = fftsa.sg_dbmax end
      -- Insertion by frequency, so the slots come out increasing in x.
      local j = n
      while j > 0 and hz[j] > f do
        hz[j + 1], db[j + 1] = hz[j], db[j]
        j = j - 1
      end
      hz[j + 1], db[j + 1] = f, d
      n = n + 1
    end
  end
  if n == 0 then return 0 end
  -- A needle a peak: the floor a pixel below the peak frequency, the peak, the floor a pixel
  -- above. The x values have to stay increasing or the line doubles back, so each foot is
  -- held at or above the previous needle's and two peaks within two pixels read as one.
  local span = fftsa.sg_fhi_hz - fftsa.sg_flo_hz
  local dx = span / fftsa.sg_plotpx
  if not (dx > 0) then dx = binhz end
  local floordb = fftsa.sg_dbmin
  local wr = buffer.write.reading
  local cap = mk.capacity
  local i, slot, prev = nil, 0, nil
  mk.clear()
  for i = 1, n do
    local f = hz[i]
    local l, r = f - dx, f + dx
    if prev ~= nil and l < prev then l = prev end
    if f < l then f = l end
    if r < f then r = f end
    if slot + fftsa.sg_mk_per <= cap then
      slot = slot + 1; wr(mk, floordb, l, slot, 0)
      slot = slot + 1; wr(mk, db[i],   f, slot, 0)
      slot = slot + 1; wr(mk, floordb, r, slot, 0)
      prev = r
    end
  end
  return slot
end

-- Gated at fftsa.sg_pk_period and skipped when no peak moved beyond the tolerances,
-- so a dithering last digit does not redraw the block on a steady signal.
function fftsa.sg_show_peaks(bi, bv, count, binhz, pk_hz, pk_v)
  if fftsa.sg_peaks_off then return false end
  -- Coming back from over-range the dashed block is on screen and the move gate has no
  -- memory of it, so the gate would hold the dashes until a peak happened to move. Clearing
  -- sg_pk_last forces one redraw of the real figures.
  if fftsa.sg_pk_over then
    fftsa.sg_pk_over, fftsa.sg_pk_last = false, nil
  end
  local now = os.clock()
  if fftsa.sg_pk_last ~= nil
     and (now - fftsa.sg_pk_last) < fftsa.sg_pk_period then
    return false
  end
  local abs = math.abs
  local moved = false
  for p = 1, count do
    local f, v = fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
    if f == nil then f, v = -1, -1 end
    local lf, lv = fftsa.sg_pk_lf[p], fftsa.sg_pk_lv[p]
    if lf == nil then
      moved = true
    elseif (f < 0) ~= (lf < 0) then
      moved = true                      -- a peak appeared or went away
    elseif f >= 0 then
      local df = fftsa.sg_pk_ftol * lf
      if df <= 0 then df = 1 end
      local dv = fftsa.sg_pk_vtol * lv
      if dv <= 0 then dv = 1e-12 end
      if abs(f - lf) > df or abs(v - lv) > dv then moved = true end
    end
    fftsa.sg_pk_lf[p], fftsa.sg_pk_lv[p] = f, v
  end
  if not moved then return false end
  fftsa.sg_pk_last = now
  return fftsa.sg_show_peaks_now(bi, bv, count, binhz, pk_hz, pk_v)
end

-- The microvolt format the peak table's volt column uses: one decimal on the 1 V and 0.1 V
-- ranges, where a whole-microvolt step throws away resolution, and whole microvolts on 10 V.
-- One decimal and not two, because the digitizer is 4.5 digits -- an LSB of about 2 uV on
-- 0.1 V -- and the measured per-bin noise floor is 2.95 uV. The widest result is "999.9 uV",
-- inside what "%.2f mV" and "%.4f V" already print in the same 82 px field.
fftsa.sg_uv_fmt_std  = "%0.0f uV"
fftsa.sg_uv_fmt_fine = "%0.1f uV"
fftsa.sg_uv_fine_vmax = 1        -- the largest range that gets the decimal

function fftsa.sg_uv_fmt(range)
  if range ~= nil and range <= fftsa.sg_uv_fine_vmax then return fftsa.sg_uv_fmt_fine end
  return fftsa.sg_uv_fmt_std
end

-- The unconditional draw; the gate above is the only thing deciding when it runs.
function fftsa.sg_show_peaks_now(bi, bv, count, binhz, pk_hz, pk_v)
  local log10, settext = math.log10, display.settext
  for p = 1, count do
    local f, v = fftsa.sg_peak_at(p, bi, bv, binhz, pk_hz, pk_v)
    if f ~= nil then
      local ftxt
      if f ~= f then ftxt = string.format("%d  ---", p)
      elseif f >= 1000 then ftxt = string.format("%d  %.3f kHz", p, f / 1000)
      else ftxt = string.format("%d  %.1f Hz", p, f) end
      -- An amplitude past the largest range is not a voltage, so both columns dash rather
      -- than one of them stating a figure. It is also a width matter: %.4f of the 9.9e+37
      -- sentinel is 45 characters where the column holds 8, and at a fixed x that overwrites
      -- the dB column and the whole second column with it.
      local vtxt, dtxt
      if v ~= v then vtxt, dtxt = "", ""
      elseif v > fftsa.sg_vmax_real then vtxt, dtxt = "---", "--- dBV"
      else
        if v >= 1 then vtxt = string.format("%.4f V", v)
        elseif v >= 1e-3 then vtxt = string.format("%.2f mV", v * 1e3)
        else vtxt = string.format(fftsa.sg_uv_fmt(fftsa.range), v * 1e6) end
        -- Floored at the plot's own floor: a 1e-26 power bin reads -260 dBV against an axis
        -- that stops at -120, which the trace cannot show and the column has no room for.
        local dbv = 20 * log10(v)
        if not (dbv > fftsa.sg_dbmin) then dbv = fftsa.sg_dbmin end
        dtxt = string.format("%.1f dBV", dbv)
      end
      settext(fftsa.sg_pk_f[p], ftxt)
      settext(fftsa.sg_pk_v[p], vtxt)
      settext(fftsa.sg_pk_d[p], dtxt)
    else
      settext(fftsa.sg_pk_f[p], string.format("%d  ---", p))
      settext(fftsa.sg_pk_v[p], "")
      settext(fftsa.sg_pk_d[p], "")
    end
  end
  return true
end


-- ================= tsp/native_link.tsp =================
-- native_link.tsp -- load the native DSP binary into heap and make it callable.
--
-- Called once at startup; sets fftsa.nl.ready when the native path is available. Every
-- failure is recorded and swallowed, and the app reports it from the frame that needs it.
--
-- No firmware address is written down here, and none is compared against either. The six
-- libm entries come from FNT and resolve_math, which find them in the code of Lua's own
-- math wrappers by the company each call keeps; the ki.peek8 closure and its f pointer come
-- from tostring and a read; the trampoline is self-contained PowerPC that flushes the cache
-- itself. Neither it nor the image reads the Lua stack, and what the call reports comes back
-- through a word of the params struct.
--
-- What remains firmware-shaped is ranges and layouts, not entry points: the .text extent in
-- TEXT_LO and TEXT_HI, the heap extent the image is compiled with, the closure's f at +12
-- and the reading-buffer descriptor offsets. Every one of those is a test that refuses, so a
-- build that moves them loses the native path.
--
-- Lua 5.0.2: no '#', no hex literals, no multi-return string.byte, math.mod not fmod.

fftsa = fftsa or {}
fftsa.nl = {
  ready     = false,  -- true once the binary is loaded, relocated and the plan is built
  fn        = {},     -- firmware math addresses resolved by resolve_math
  tramp     = 0,      -- heap address of the cache-flush trampoline
  entry     = 0,      -- heap address of dsp_native_run, which is image offset 0
  code_base = 0,      -- heap address the image is loaded at
  params    = 0,      -- heap address of the dsp_native_params struct
  code_buf  = nil,    -- buffer whose chunk storage holds the image, trampoline, params
  plan_buf  = nil,    -- buffer whose chunk storage holds the plan, arena and scratch
  peek8_cls = 0,      -- ki.peek8 closure address
  peek8_f   = 0,      -- original ki.peek8 f pointer, for restore
  nmax      = 0,      -- largest n the arena found at startup can hold
  last_rc   = nil,    -- status from the most recent native call
}

-- Status codes dsp_native.c writes into the params struct. Non-negative is a result.
fftsa.nl.RC = {
  EMAGIC = -1, EBOUNDS = -2, EPLAN = -3, EGEOM = -4, ECAPTURE = -5,
  EOUTPUT = -6, EDESC = -7, EARENA = -8, ESCRATCH = -9, ERUN = -10, EMATH = -11,
  EREDUCE = -12, ERESULT = -13,
}

-- A return code as its name, for anything an operator reads. "rc=-11" needs this file open
-- beside it; "rc=-11 EMATH" says a libm entry was refused, which is actionable from the
-- glass. The table is written name-to-number because that is how the code uses it, so this
-- walks it rather than keeping a second copy that could disagree.
-- The line of dsp_native.c that returned goes on the end as @NNN, and it is the half that
-- places a fault: there are 26 refusal sites against a dozen codes, and DSPN_ECAPTURE alone
-- has three sites with ten conditions among them. So the code names the stage and the line
-- names the test. Four characters on a settings line that holds 70, and placing one rc=-5
-- cost a hand-decoded hex dump of a descriptor without it.
function fftsa.nl.rc_name(rc)
  if type(rc) ~= 'number' then return tostring(rc) end
  local at = ''
  if rc ~= 0 and type(fftsa.nl.fail_at) == 'number' and fftsa.nl.fail_at ~= 0 then
    at = '@' .. tostring(fftsa.nl.fail_at)
  end
  local k, v
  for k, v in pairs(fftsa.nl.RC) do
    if v == rc then return tostring(rc) .. ' ' .. k .. at end
  end
  return tostring(rc) .. at
end

-- DSP_THD_MAINS_* from csrc/dsp.h. Hum at a multiple of the selected mains frequency is
-- passed over when the fundamental is sought; BOTH discounts 50 and 60.
fftsa.nl.MAINS_BOTH = -1
fftsa.nl.MAINS_A    = 50
fftsa.nl.MAINS_B    = 60

fftsa.nl.MODE_INIT  = 1
fftsa.nl.MODE_RUN   = 2
fftsa.nl.MODE_BYTES = 3
fftsa.nl.MODE_SEGS  = 4

fftsa.nl.MAGIC = 1146310705   -- 0x44535031, 'DSP1'

-- DSP_FFT_* from csrc/dsp.h. Four-step is the default there and the only one measured on
-- the instrument; radix-2 is kept because the equivalence tests run both.
fftsa.nl.FFT_RADIX2   = 0
fftsa.nl.FFT_FOURSTEP = 1

-- Chunk payload is a fixed 32,768 bytes; 1024 elements follows from 32768/32.
fftsa.nl.CHUNK_BYTES = 32768

-- The allocator only guarantees 16-byte alignment and DSP_ALIGN is 32: measured payload
-- addresses alternate between the two, and dsp_native_run refuses a misaligned segment
-- with DSPN_EBOUNDS, so an arena built straight from the chunk vector is a coin flip.
--
-- Every segment base is therefore rounded up to 32 and the usable size drops by one
-- alignment unit. SEG_BYTES stays a multiple of DSP_ALIGN and rounding up adds at most 31,
-- so align32(payload) + SEG_BYTES never leaves the payload. The same value has to go to
-- MODE_SEGS as to MODE_INIT, or the chunk count is computed for a size the arena lacks.
fftsa.nl.SEG_BYTES = 32768 - 32

local function align32(v) return v + math.mod(32 - math.mod(v, 32), 32) end
fftsa.nl._align32 = align32
fftsa.nl.PARAM_WORDS = 55

-- Overwritten by the generated dsp_native_reloc.lua, which reads them out of the linked
-- image. Not literals to rely on: the target is 32-bit big-endian PowerPC with 4-byte
-- pointers, so sizeof(dsp_plan) is 1024 there against 1120 on a 64-bit host.
fftsa.nl.SIZEOF_PLAN   = 0
fftsa.nl.SIZEOF_PARAMS = 0
fftsa.nl.SIZEOF_REAL   = 0

-- The native side's compiled backstop, also overwritten from the image. Zero here so an
-- un-generated module refuses every address rather than accepting every address.
fftsa.nl.BACKSTOP_LO = 0
fftsa.nl.BACKSTOP_HI = 0

-- Shape of the results block, also from the image: the peak slots it holds and the total
-- doubles Lua reads back out of it. Zero until the generated module loads, which makes
-- nl.results() refuse rather than decode a block of some other size.
fftsa.nl.RES_PEAKS   = 0
fftsa.nl.RES_DOUBLES = 0

-- Picker index to DSP_WINDOW_*, the enum in csrc/dsp.h, and a separate map from
-- fftsa.win_dsp, which goes to dsp.WINDOW_*. The two enums coincide today and nothing holds
-- them together, so each side of the seam carries its own map; the window_enum gate
-- compares this table against dsp.h, making a renumbering a build failure rather than a
-- measurement error. Index-parallel to fftsa.win_names.
fftsa.nl.WIN = {}
fftsa.nl.WIN[1] = 1    -- DSP_WINDOW_HANN
fftsa.nl.WIN[2] = 2    -- DSP_WINDOW_BLACKMAN
fftsa.nl.WIN[3] = 3    -- DSP_WINDOW_BLACKMAN_HARRIS
fftsa.nl.WIN[4] = 4    -- DSP_WINDOW_KAISER

-- Falls back to Hann on an index with no mapping, which is what fftsa.win_to_dsp does on
-- the other side. A silent fallback is wrong but bounded; an unmapped nil reaches the
-- params struct as a zero and selects DSP_WINDOW_RECT, which is no window at all.
function fftsa.nl.win_to_native(wi)
  local k = fftsa.nl.WIN[wi]
  if k == nil then k = fftsa.nl.WIN[1] end
  return k
end

-- What localnode.version answered, for a probe to report. Nothing is gated on it.
fftsa.nl.fw_seen = nil

-- The cache-flush trampoline, assembled from csrc/flush_tramp.S: dcbst out of the D-cache,
-- icbi and isync over the same range in the I-cache, in instructions of its own, so it
-- depends on no firmware address. It takes no Lua arguments -- the range is the two words at
-- TRAMP_RANGE, which nl.flush writes before the call and the code reaches through a bl/mflr
-- pair. Position-independent and relocation-free, which csrc/tools/emit_tramp.py checks when
-- it regenerates this literal. The bytes are not editable by hand.
fftsa.nl._TRAMP = '\072\000\000\012\000\000\000\000\000\000\000\000\125\104\002\166\072\000\000\005\125\040\002\166\128\105\255\240\128\137\255\244\125\104\003\166\040\004\000\000\065\130\000\068\124\163\034\020\056\165\000\031\084\165\000\052\084\099\000\052\124\102\027\120\124\000\024\108\056\099\000\032\124\003\040\064\065\128\255\244\124\000\004\172\124\000\055\172\056\198\000\032\124\006\040\064\065\128\255\244\124\000\004\172\076\000\001\044\056\096\000\000\078\128\000\032'
fftsa.nl.TRAMP_RANGE = 4

-- What write_params leaves in the status word, and no exit of dsp_native_run writes. A
-- status still reading this after a call means the call never reached an exit.
fftsa.nl.STATUS_UNSET = 2147483647

-- The compiled image and its relocation table, both generated by
-- csrc/tools/emit_reloc.py and embedded by tools/embed_native.py as base64. Nil means no
-- binary in the archive: nl.init still resolves addresses and installs the trampoline, but
-- leaves nl.ready false.
--
-- _DSP_CODE and _DSP_RELOC are the decoded bytes, filled once by nl.init.
fftsa.nl._DSP_CODE = nil
fftsa.nl._DSP_RELOC = nil
fftsa.nl._DSP_CODE_B64 = nil
fftsa.nl._DSP_CODE_B64_LEN = 0
fftsa.nl._DSP_RELOC_B64 = nil
fftsa.nl._DSP_RELOC_B64_LEN = 0
fftsa.nl._DSP_RELOC_BSS_LO = 0
fftsa.nl._DSP_RELOC_BSS_HI = 0

-- ---------------------------------------------------------------------------
-- Base64, so the image costs 1.37 characters a byte in the archive instead of the 4 that
-- decimal escapes take -- Lua 5.0.2 has no \xNN, and the archive's source is parsed at
-- every launch where this is decoded once in nl.init.
--
-- No padding and no tail case: embed_native.py pads the binary to a multiple of three and
-- emits the true length beside it, so this is a flat four-to-three mapping and the length
-- trims the padding. A tail case would be a branch nothing exercises until the day the
-- image length changes residue.
-- ---------------------------------------------------------------------------
local B64A = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
local b64map = nil

-- string.gsub with a function rather than a loop over string.byte: the scan and the
-- assembly both happen in C, so this is one Lua call per four characters. The map is keyed
-- by the character, which is what the captures are, so there is no string.byte at all.
local function b64decode(s, len)
  if s == nil or len == nil then return nil end
  local slen = string.len(s)
  if math.mod(slen, 4) ~= 0 then return nil end
  -- Validated before the substitution and not inside it: a function replacement returning
  -- nil leaves the match in place, so a stray character would pass through as itself.
  if string.find(s, '[^A-Za-z0-9+/]') ~= nil then return nil end
  if b64map == nil then
    b64map = {}
    local i
    for i = 1, 64 do b64map[string.sub(B64A, i, i)] = i - 1 end
  end
  local v = b64map
  local out = string.gsub(s, '(.)(.)(.)(.)', function(c1, c2, c3, c4)
    local a, b, c, d = v[c1], v[c2], v[c3], v[c4]
    return string.char(a * 4 + math.floor(b / 16),
                       math.mod(b, 16) * 16 + math.floor(c / 4),
                       math.mod(c, 4) * 64 + d)
  end)
  if string.len(out) < len then return nil end
  return string.sub(out, 1, len)
end
fftsa.nl._b64decode = b64decode

-- ---------------------------------------------------------------------------
-- Byte packing helpers.
-- ---------------------------------------------------------------------------

-- Two's complement for a negative v, which math.mod alone does not give: it is fmod and
-- keeps the sign, so math.mod(-1, 2^32) is -1 and string.char would then be handed -1 and
-- raise. dsp_bandmap.sense is -1 in an odd Nyquist zone, so this is reachable.
local function u32_pack(v)
  v = math.mod(v, 4294967296)
  if v < 0 then v = v + 4294967296 end
  local b4 = math.mod(v, 256); v = math.floor(v / 256)
  local b3 = math.mod(v, 256); v = math.floor(v / 256)
  local b2 = math.mod(v, 256)
  local b1 = math.mod(math.floor(v / 256), 256)
  return string.char(b1, b2, b3, b4)
end

local function u32_at(s, p)
  local b1 = string.byte(s, p)
  local b2 = string.byte(s, p + 1)
  local b3 = string.byte(s, p + 2)
  local b4 = string.byte(s, p + 3)
  return ((b1 * 256 + b2) * 256 + b3) * 256 + b4
end

local function hx(v) return string.format('%X', v) end

-- An IEEE-754 binary64 as the two 32-bit halves the target reads it back from, high half
-- first: the params struct is a wire format and Lua 5.0.2 cannot lay out a double, so every
-- double in it crosses as a word pair and pw_double in dsp_native.c reassembles one.
--
-- The arithmetic is exact, every multiply being by a power of two, so the result is the bit
-- pattern a host would have written; csrc/tools/test_f64.lua checks it against struct.pack,
-- signs, infinities and a NaN included. Subnormals flush to zero and an overflowing
-- exponent to an infinity, which nothing crossing here comes near: the smallest value is
-- the squared voltage floor at 1e-18 against a smallest normal of 2.2e-308.
local function f64_words(x)
  local sign = 0
  if x < 0 then sign = 2147483648; x = -x end
  -- A NaN first: it loses every ordered comparison below, so no later test can find it.
  if x ~= x then return sign + 2146959360, 0 end        -- 0x7FF80000, quiet NaN
  if x == 0 then return sign, 0 end
  -- Doubling leaves only zero and an infinity unchanged, and zero is gone. Lua 5.0.2 has
  -- no math.huge to compare against.
  if x + x == x then return sign + 2146435072, 0 end    -- 0x7FF00000
  local m, e = math.frexp(x)              -- 0.5 <= m < 1 and x = m * 2^e
  local eb = e + 1022                     -- biased exponent of the 1.f form, which is 2m
  if eb >= 2047 then return sign + 2146435072, 0 end
  if eb <= 0 then return sign, 0 end
  local f  = m * 2 - 1                    -- the 52-bit significand, 0 <= f < 1
  local hi = math.floor(f * 1048576)      -- its top 20 bits
  return sign + eb * 1048576 + hi, math.floor((f * 1048576 - hi) * 4294967296)
end
fftsa.nl._f64_words = f64_words

-- Firmware .text, where a lua_CFunction pointer must land. Anything else written into a
-- closure's f is a jump into data on the next call.
fftsa.nl.TEXT_LO = 16384      -- 0x00004000
fftsa.nl.TEXT_HI = 5402624    -- 0x00527000

function fftsa.nl._text_ok(a)
  return type(a) == 'number' and a >= fftsa.nl.TEXT_LO and a < fftsa.nl.TEXT_HI
end

local function align8(v) return v + math.mod(8 - math.mod(v, 8), 8) end

-- To a cache line. A flush works in whole lines, so anything that must not be invalidated
-- along with the image has to start on a line the image does not reach into.
local function align32(v) return v + math.mod(32 - math.mod(v, 32), 32) end
fftsa.nl._align32 = align32

-- The 32-byte line a byte belongs to, and one past the last line a range touches. The
-- range a flush covers is wider than the range asked for, by up to 31 bytes at each end.
local function line_lo(a) return a - math.mod(a, 32) end
local function line_hi(a, n) return line_lo(a + n - 1) + 32 end

-- Progress breadcrumbs for nl.init, off unless fftsa.nl.trace is set.
--
-- nl.init installs code and then branches into it, so a bluescreen takes the Lua state with
-- the instrument and there is nothing left to ask; a PC on the glass in the heap says only
-- that something executed garbage, and init has three places that branch to a heap address.
-- print() in TSP reaches the socket as the statement runs, so a trace crosses the wire
-- before the crash and the last line received names the step.
local function trace(tag, a, b)
  if not fftsa.nl.trace then return end
  local s = 'NLT|' .. tostring(tag)
  if a ~= nil then s = s .. '|' .. tostring(a) end
  if b ~= nil then s = s .. '|' .. tostring(b) end
  print(s)
end

-- Read a word from the instrument, or nil. Reads are DRAM-only by construction here:
-- every address passed in comes from the heap scan window or a descriptor inside it.
local function W(addr)
  return tonumber(ki.peek32(hx(addr)), 16)
end

-- A double as the eight bytes the target stores it as, for a content scan.
local function f64_pack(x)
  local hi, lo = f64_words(x)
  return u32_pack(hi) .. u32_pack(lo)
end

-- Is the double at addr this value? Both halves, so a shared exponent is not a match.
-- addr need only be 4-aligned, which is what the extra value at element+20 is.
--
-- THROUGH THE GUARD, not through W. The content scan confirms a candidate at its far
-- indices, which is the hit plus 255 strides -- 8160 bytes at a 32-byte element -- and a hit
-- can sit anywhere in the swept window including its last word. Measured from a hit at
-- BACKSTOP_HI - 32: the confirmation reached 8128 bytes PAST the top of DRAM, which is an
-- unguarded lwz and a bluescreen. W's own contract says every address it is handed comes
-- from inside the window, and this is the one caller for which that was never true.
--
-- nil reads as not-equal, which is the right answer and not a compromise: a record whose
-- tail is outside the backstop is one the native side could not read either, so refusing it
-- here is the same refusal one step earlier.
local function eq64(addr, v)
  local hi, lo = f64_words(v)
  local g = fftsa.nl._wg
  return g(addr) == hi and g(addr + 4) == lo
end

-- The inverse of f64_words, out of eight big-endian bytes at p in s. ldexp rather than a
-- power: m + 2^52 is at most 2^53 - 1 and so exact, and scaling by a power of two rounds
-- nothing, which makes the round trip bit-exact. check_f64.py tests both directions.
--
-- An infinity or a NaN comes back as nil rather than as a number: neither can be written to
-- a display field, a refused graph parameter being a modal dialog, and this firmware's
-- comparisons are not IEEE for a NaN, so the usual v ~= v test downstream would miss it.
local function f64_unpack(s, p)
  local b1 = string.byte(s, p)
  local b2 = string.byte(s, p + 1)
  local sign = 1
  if b1 >= 128 then sign = -1; b1 = b1 - 128 end
  local eb = b1 * 16 + math.floor(b2 / 16)
  local m = ((math.mod(b2, 16) * 256 + string.byte(s, p + 2)) * 256
             + string.byte(s, p + 3)) * 4294967296 + u32_at(s, p + 4)
  if eb == 2047 then return nil end
  if eb == 0 then return sign * math.ldexp(m, -1074) end
  return sign * math.ldexp(m + 4503599627370496, eb - 1075)
end
fftsa.nl._f64_unpack = f64_unpack

-- The same, out of four big-endian bytes, for a single-precision image. The reduced trace is
-- the one place dsp_real crosses to Lua as its own width; everything else in the wire format
-- is a double whatever the image was built in. Subnormals decode exactly rather than
-- flushing, this being a read, and an infinity or a NaN comes back as nil as above.
local function f32_unpack(s, p)
  local b1 = string.byte(s, p)
  local b2 = string.byte(s, p + 1)
  local sign = 1
  if b1 >= 128 then sign = -1; b1 = b1 - 128 end
  local eb = b1 * 2 + math.floor(b2 / 128)
  local m = (math.mod(b2, 128) * 256 + string.byte(s, p + 2)) * 256
            + string.byte(s, p + 3)
  if eb == 255 then return nil end
  if eb == 0 then return sign * math.ldexp(m, -149) end
  return sign * math.ldexp(m + 8388608, eb - 150)
end
fftsa.nl._f32_unpack = f32_unpack

-- And the forward direction, as the four big-endian bytes a single-precision store leaves.
-- Needed to search memory for a value the app put there: the display task keeps its trace as
-- float32, so a double packed the double way matches nothing.
--
-- Rounding is to nearest with ties to even, which is what frsp does on this core -- a needle
-- one bit out is a needle that is not found, and the failure looks like "the ring is not in
-- memory" rather than like a rounding bug. csrc/tools/check_f32.py checks every case below
-- against struct.pack.
local function f32_pack(x)
  local sign = 0
  if x < 0 then sign = 128; x = -x end
  -- A NaN loses every ordered comparison, so it has to go before any of them.
  if x ~= x then return string.char(sign + 127, 192, 0, 0) end
  if x == 0 then return string.char(sign, 0, 0, 0) end
  if x + x == x then return string.char(sign + 127, 128, 0, 0) end
  local m, e = math.frexp(x)              -- 0.5 <= m < 1 and x = m * 2^e
  local eb, f = e + 126, nil              -- 2m is the 1.f form, so its exponent is e - 1
  if eb <= 0 then
    -- Subnormal: the value is f * 2^-149 with f below 2^23, so the significand is the whole
    -- of it and the exponent field is zero. A round that carries into 2^23 lands on the
    -- smallest normal, which the carry below already handles.
    eb, f = 0, math.ldexp(x, 149)
  else
    f = (m * 2 - 1) * 8388608
  end
  local fi = math.floor(f)
  local r = f - fi
  if r > 0.5 then fi = fi + 1
  elseif r == 0.5 and math.mod(fi, 2) == 1 then fi = fi + 1 end
  if fi >= 8388608 then fi = fi - 8388608; eb = eb + 1 end
  if eb >= 255 then return string.char(sign + 127, 128, 0, 0) end
  return string.char(sign + math.floor(eb / 2),
                     math.mod(eb, 2) * 128 + math.floor(fi / 65536),
                     math.mod(math.floor(fi / 256), 256),
                     math.mod(fi, 256))
end
fftsa.nl._f32_pack = f32_pack

-- ---------------------------------------------------------------------------
-- Find the firmware math entries behind the Lua math wrappers.
--
-- The entries move between models as well as between builds, so nothing here is compared
-- against an address. What identifies the library call is the company it keeps.
--
-- Every math wrapper is the same shape: ten calls into the Lua VM, the library function if
-- it has one, then lua_pushnumber. math.abs, math.deg and math.rad have no library function
-- -- abs on a double is a sign-bit clear and the other two are one multiply, all three
-- inlined -- so every target they reach is VM glue by construction, and that is a property
-- of the Lua source rather than of the link map. Take their targets as the glue set, and a
-- one-argument wrapper's library entry is its one target outside it.
--
-- Measured on three images: DMM6500 1.7.17a and 1.7.18a, where the block sits at 0x002026F8
-- and 0x002026E0, and the DMM7510 1.7.16 function list, where it sits at 0x000CDD34. All
-- three are 13,228 bytes, function for function, in the same order. On both 6500 builds the
-- glue set is nine targets, every one-argument wrapper contains all nine, and the one target
-- outside it is the eleventh bl of twelve.
-- ---------------------------------------------------------------------------

-- The ceiling on one wrapper, not its length: the scan stops at the wrapper's blr, and the
-- longest of these is 0x16C bytes, 91 words. One memread rather than a peek a word at a
-- time, the scan needing the whole body and a round trip costing what a few peeks do.
fftsa.nl.SCAN_WORDS = 256

function fftsa.nl.FNT(fn)
  local s = tostring(fn)
  local _, e = string.find(s, ': ')
  if not e then return nil end
  local c = tonumber(string.sub(s, e + 1), 16)
  if not c then return nil end
  local w = W(c + 12)
  if not w then return nil end
  local nw = fftsa.nl.SCAN_WORDS
  local body = ki.memread(hx(w), hx(nw * 4))
  if body == nil or string.len(body) < nw * 4 then return nil end
  local out, i = {}, nil
  for i = 0, nw - 1 do
    local n = u32_at(body, i * 4 + 1)
    -- bl: primary opcode 18 with LK set and AA clear. Testing both low bits refuses bla,
    -- whose field is an absolute address and not the displacement this reads it as.
    if math.floor(n / 67108864) == 18 and math.mod(n, 4) == 1 then
      local r = math.mod(math.floor(n / 4), 16777216)
      if r >= 8388608 then r = r - 16777216 end
      table.insert(out, math.mod(w + i * 4 + r * 4, 4294967296))
    end
    if n == 1317011488 then break end   -- blr: the wrapper's one exit
  end
  return out
end

-- The six dsp.c calls, the wrappers that reach no library function at all, and the wider set
-- the cross-check needs. MATH_GLUE is what makes this work; MATH_CENSUS only confirms it.
fftsa.nl.MATH_NAMES  = { 'sin', 'cos', 'sqrt', 'log10', 'floor', 'ceil' }
fftsa.nl.MATH_GLUE   = { 'abs', 'deg', 'rad' }
fftsa.nl.MATH_CENSUS = { 'sin', 'cos', 'sqrt', 'log10', 'floor', 'ceil',
                         'tan', 'log', 'exp', 'asin', 'acos', 'atan' }

-- The smallest glue set worth believing. Nine on both measured builds; a sample that yields
-- a handful has not found the wrappers, and treating it as complete would leave most of a
-- wrapper's VM calls looking like library entries.
fftsa.nl.GLUE_MIN = 6

function fftsa.nl.resolve_math()
  local nl = fftsa.nl
  local fn = nl.fn
  local v = nil
  if localnode ~= nil then v = localnode.version end
  nl.fw_seen = tostring(v)

  local i, k = nil, nil
  for i = 1, table.getn(nl.MATH_NAMES) do fn[nl.MATH_NAMES[i]] = nil end
  nl.math_pos, nl.math_odd = {}, nil

  -- 1. The glue set, off the wrappers that call no library function.
  local glue, nglue = {}, 0
  for i = 1, table.getn(nl.MATH_GLUE) do
    local f = math[nl.MATH_GLUE[i]]
    if f ~= nil then
      local ts = nl.FNT(f)
      if ts ~= nil then
        for k = 1, table.getn(ts) do
          if not glue[ts[k]] then
            glue[ts[k]] = true
            nglue = nglue + 1
          end
        end
      end
    end
  end
  nl.glue, nl.nglue = glue, nglue
  if nglue < nl.GLUE_MIN then return 0 end

  -- 2. Each census wrapper's targets, and the ones not in the glue set. Every wrapper has
  --    to contain the whole glue set: a sample that is not the shared part is not glue, and
  --    the difference below would then be most of the wrapper.
  local tg, out = {}, {}
  for i = 1, table.getn(nl.MATH_CENSUS) do
    local nm = nl.MATH_CENSUS[i]
    if math[nm] ~= nil then
      local ts = nl.FNT(math[nm])
      if ts ~= nil then
        local have, left, pos = {}, {}, {}
        for k = 1, table.getn(ts) do
          have[ts[k]] = true
          if not glue[ts[k]] and not pos[ts[k]] then
            pos[ts[k]] = k
            table.insert(left, ts[k])
          end
        end
        local whole, g = true, nil
        for g in pairs(glue) do
          if not have[g] then whole = false end
        end
        if whole and table.getn(left) > 0 then
          tg[nm] = ts
          out[nm] = left
          nl.math_pos[nm] = pos[left[1]]
        end
      end
    end
  end

  -- 3. Exactly one target outside the glue set, or the name goes unresolved: a wrapper whose
  --    shape has changed has to lose the native path rather than hand out an address nothing
  --    has checked. In .text as well, which is what dspn_text_ok in the image tests the same
  --    six against -- refused here the launch says so, where the image answering EMATH is an
  --    app already on the glass and a frame that never arrives.
  local found = 0
  for i = 1, table.getn(nl.MATH_NAMES) do
    local nm = nl.MATH_NAMES[i]
    local left = out[nm]
    if left ~= nil and table.getn(left) == 1 and nl._text_ok(left[1]) then
      fn[nm] = left[1]
      found = found + 1
      -- Recorded, not required: on both measured builds the pick is the eleventh bl of
      -- twelve, the last being lua_pushnumber, and a build where it is not has changed shape
      -- in a way worth seeing in fw_probe. Not a gate, because a build that inlined the push
      -- would put the library call last and be refused for no reason.
      if nl.math_pos[nm] ~= table.getn(tg[nm]) - 1 then nl.math_odd = true end
    end
  end

  -- 4. Two names answering one address is the failure fw_probe was written to show. Checked
  --    rather than reported: if it appears, the six are not six functions. Both copies go,
  --    not the second one -- a shared address says neither name was identified, so keeping
  --    whichever came first would be a guess with a count that looked like progress.
  local seen = {}
  for i = 1, table.getn(nl.MATH_NAMES) do
    local a = fn[nl.MATH_NAMES[i]]
    if a ~= nil then seen[a] = (seen[a] or 0) + 1 end
  end
  for i = 1, table.getn(nl.MATH_NAMES) do
    local nm = nl.MATH_NAMES[i]
    local a = fn[nm]
    if a ~= nil and seen[a] > 1 then
      fn[nm] = nil
      found = found - 1
    end
  end
  return found
end

-- The resolved math addresses and the first words at each, as hex, for a probe to report.
-- resolve_math now refuses two names answering alike, so this is for reading the entries
-- back: one landing somewhere that is not a prologue shows up only here, and nl.math_odd
-- records a build whose library call is not where both measured ones put it.
function fftsa.nl.fw_probe(words)
  local fn = fftsa.nl.fn
  local names = fftsa.nl.MATH_NAMES
  local n = words or 4
  local out, i, j = '', nil, nil
  for i = 1, table.getn(names) do
    local a = fn[names[i]]
    out = out .. names[i] .. ' '
    if a == nil then
      out = out .. 'unresolved'
    else
      out = out .. string.format('%X:', a)
      for j = 0, n - 1 do
        local w = W(a + j * 4)
        if w == nil then out = out .. '????????'
        else out = out .. string.format('%08X', w) end
      end
    end
    out = out .. ' '
  end
  return tostring(fftsa.nl.fw_seen) .. ' ' .. out
end

-- ---------------------------------------------------------------------------
-- Relocation.
--
-- On PPC32 every data reference is `lis rX,hi` plus a `lo(rX)` access, an absolute address
-- fixed at link time, and clang's PPC backend has no small-data addressing to avoid that.
-- The image is linked at zero, so each relocation target doubles as an offset into it and
-- patching is target plus load address.
--
-- The patch is applied to the Lua string before it is written, so the instrument sees one
-- ki.memwrite rather than one per relocation. csrc/tools/test_relocate.lua checks it against
-- hand-computed answers, the ha carry boundary included.
-- ---------------------------------------------------------------------------
function fftsa.nl.relocate(image, reloc, code_base, bss_hi)
  local out  = {}
  local n    = 0
  local pos  = 1
  local ilen = string.len(image)
  local rlen = string.len(reloc)
  local r    = 1
  while r + 8 <= rlen + 1 do
    local kind   = string.byte(reloc, r)
    local field  = u32_at(reloc, r + 1)
    local target = u32_at(reloc, r + 5)
    local final  = math.mod(code_base + target, 4294967296)
    local repl, width
    if kind == 1 then
      repl  = u32_pack(final)
      width = 4
    else
      local half
      if kind == 2 then
        half = math.mod(final, 65536)
      else
        half = math.mod(math.floor((final + 32768) / 65536), 65536)
      end
      repl  = string.char(math.floor(half / 256), math.mod(half, 256))
      width = 2
    end
    if field < 0 or field + width > ilen then return nil, 'field out of range' end
    if field + 1 < pos then return nil, 'relocations overlap or are unsorted' end
    n = n + 1; out[n] = string.sub(image, pos, field)
    n = n + 1; out[n] = repl
    pos = field + width + 1
    r = r + 9
  end
  if r ~= rlen + 1 then return nil, 'relocation table is not whole entries' end
  n = n + 1; out[n] = string.sub(image, pos)
  local patched = table.concat(out)
  -- .bss has no file contents; the loader is what zeroes it.
  if bss_hi ~= nil and bss_hi > string.len(patched) then
    local z = {}
    local i
    for i = 1, bss_hi - string.len(patched) do z[i] = '\000' end
    patched = patched .. table.concat(z)
  end
  return patched
end

-- ---------------------------------------------------------------------------
-- Content scan over a heap range. A normal function rather than a loadstring, so the
-- packager's luac gate checks it like any other code.
-- ---------------------------------------------------------------------------
-- Where the heap is cannot be compiled in. A DMM6500 1.7.16-1.7.18 puts .heap at
-- 0x01036000..0x0D836000 and a DMM7510 1.7.16 at 0x008A2000..0x0F8A2000, so a window pair
-- measured on one model leaves about 45% of the other's heap unswept, and describe() answers
-- nil for a buffer the allocator placed there.
--
-- Lua's own objects come from the same allocator as reading-buffer storage, so tostring({})
-- is a heap address for free, on any model, with no section table and no scan. Measured on a
-- DMM6500 1.7.17a: a fresh table at 0x0387F730, fftsa.sg_buf's object at 0x03132A28 and
-- fftsa.cap's at 0x0328EFB8, against descriptors at 0x035BC570 and 0x0367F4A0 and a chunk
-- vector at 0x03676E60 -- the whole working set inside 7.6 MB. The first window is that
-- spread with threefold room, so the common case costs what a 32 MB window costs; the second
-- is everything the compiled backstop permits, for a heap that scatters further than measured.
fftsa.nl.ANCHOR_NEAR = 25165824         -- 24 MB either side
fftsa.nl.ANCHOR_FAR  = 134217728        -- 128 MB either side
-- The top of DRAM, which is the board and not a firmware build -- the same figure
-- dsp_native_bounds.h compiles in. Used only when the generated module has not loaded and
-- the backstop is still zero: clamping to a zero range would answer with no windows at all,
-- and describe() is also called at runtime by nl_bind, where refusing to sweep is worse than
-- sweeping wide.
fftsa.nl.DRAM_END = 268435456

-- The address inside what tostring() prints for a collectable Lua value: 'table: 3550a18',
-- 'userdata: 353b010', either with or without an 0x. Nil for anything that prints no address,
-- which is every value with a __tostring and every number and string.
function fftsa.nl.obj_addr(o)
  local t = tostring(o)
  if type(t) ~= 'string' then return nil end
  local h = string.gsub(t, '^.*:%s*', '')
  h = string.gsub(h, '^0[xX]', '')
  local a = tonumber(h, 16)
  if a == nil or a <= 0 then return nil end
  return a
end

function fftsa.nl.heap_anchor()
  return fftsa.nl.obj_addr({})
end

-- One word, refused rather than faulted for an address that is not a 4-aligned DRAM one.
-- ki.peek32 is an lwz with no validation, so a bad address is a precise data storage
-- interrupt and a bluescreen -- and unlike the sweep, whose addresses all come out of a
-- window it chose, the routes below start from a pointer the firmware gave us and follow it.
function fftsa.nl._wg(addr)
  if type(addr) ~= 'number' then return nil end
  if addr <= 0 or math.mod(addr, 4) ~= 0 then return nil end
  local lo, hi = fftsa.nl.BACKSTOP_LO, fftsa.nl.BACKSTOP_HI
  if lo == nil or hi == nil or lo >= hi then lo, hi = 0, fftsa.nl.DRAM_END end
  if addr < lo or addr + 4 > hi then return nil end
  return tonumber(ki.peek32(hx(addr)), 16)
end

-- A buffer's native instance, from the buffer itself rather than from a search.
--
-- A reading buffer is a Lua table with no own keys whose metatable carries CClassRef, a
-- userdata of one pointer: the C++ instance. getmetatable is unprotected on this firmware, so
-- the whole walk is two steps and no sweeping. This matters because the instance comes from
-- the C++ allocator, which is the allocator that places the column descriptors -- measured
-- 19 KB apart -- while tostring({}) anchors on the Lua allocator, which on a DMM7510 put
-- every window it chose in the wrong part of a 251 MB heap.
--
-- The pointer is read through _wg, so a metatable shaped differently on some other build
-- answers nil and the caller falls back to the sweep.
function fftsa.nl.cclass(buf)
  if type(buf) ~= 'table' and type(buf) ~= 'userdata' then return nil end
  local mt = getmetatable(buf)
  if type(mt) ~= 'table' then return nil end
  local ref = mt.CClassRef
  if ref == nil then return nil end
  local p = fftsa.nl.obj_addr(ref)
  if p == nil then return nil end
  -- The Udata holds one pointer and tostring already gave the payload, so the instance is at
  -- payload+0. Adding 16 here lands in the next object and dereferencing that faults.
  return fftsa.nl._wg(p)
end

-- The per-column pointers the instance lists. Its header is a NUL-terminated list of 16-byte
-- records (previous id, this id, two pointers), ids 9 and 14 being the reading and extra-value
-- columns of a STYLE_WRITABLE_FULL buffer. Every capture so far put the column descriptor
-- within a couple of hundred KB of these, so they are the cheapest window there is.
fftsa.nl.INST_CHAIN = 16
fftsa.nl.CHAIN_MAX = 8

function fftsa.nl.col_ptrs(inst)
  local out, n = {}, 0
  if inst == nil then return out end
  local k
  for k = 0, fftsa.nl.CHAIN_MAX - 1 do
    local rec = inst + fftsa.nl.INST_CHAIN + k * 16
    local id = fftsa.nl._wg(rec + 4)
    if id == nil or id == 0 then return out end
    local i
    for i = 8, 12, 4 do
      local p = fftsa.nl._wg(rec + i)
      if p ~= nil and p > 0 then n = n + 1; out[n] = p end
    end
  end
  return out
end

function fftsa.nl.sweep_windows()
  local nl = fftsa.nl
  local lo, hi = nl.BACKSTOP_LO, nl.BACKSTOP_HI
  if lo == nil or hi == nil or lo >= hi then lo, hi = 0, nl.DRAM_END end
  local a = nl.heap_anchor()
  local out = {}
  local n = 0
  if a ~= nil and a > lo and a < hi then
    local clamp = function(x, y)
      if x < lo then x = lo end
      if y > hi then y = hi end
      if x >= y then return nil end
      return { x, y }
    end
    local w1 = clamp(a - nl.ANCHOR_NEAR, a + nl.ANCHOR_NEAR)
    local w2 = clamp(a - nl.ANCHOR_FAR, a + nl.ANCHOR_FAR)
    if w1 ~= nil then n = n + 1 out[n] = w1 end
    if w2 ~= nil then n = n + 1 out[n] = w2 end
  end
  -- No anchor means tostring() did not give an address. Sweeping everything the backstop
  -- allows is slow, and it is the only thing left that can still succeed.
  if n == 0 then out[1] = { lo, hi } end
  nl.last_windows = out
  return out
end

-- Windows for a buffer's own storage and descriptor, cheapest first and covering everything.
--
-- A DMM7510 1.7.16 reported a confirmed element 0 at 0x0158D7C0 with no descriptor anywhere in
-- the two anchored windows. The descriptor layout is not the difference: the function that
-- initialises +0x44, +0x48, +0x54, +0x64, +0x74 and the four copies of n is byte-identical in
-- the 6500 1.7.17a and 7510 1.7.16 images, 1044 bytes of it. So the descriptor was simply
-- outside what tostring({}) could reach -- the anchored pair covers 143 MB of a heap that runs
-- to 248 MB -- and the fix is which windows get swept, in which order.
--
-- Four stages. The first three are each a fraction of a second and are where both models are
-- expected to answer; the last is minutes and is there so that nothing in DRAM is unreachable,
-- because a slow start beats a refusal.
fftsa.nl.TIGHT = 262144                 -- 256 KB either side, the measured arena distance
fftsa.nl.MID   = 4194304                -- 4 MB either side

function fftsa.nl._clamp_win(x, y, lo, hi)
  if x < lo then x = lo end
  if y > hi then y = hi end
  if x >= y then return nil end
  return { x, y }
end

function fftsa.nl.scan_windows(buf, elem0)
  local nl = fftsa.nl
  local lo, hi = nl.BACKSTOP_LO, nl.BACKSTOP_HI
  if lo == nil or hi == nil or lo >= hi then lo, hi = 0, nl.DRAM_END end
  local out, n = {}, 0
  local add = function(x, y)
    local w = nl._clamp_win(x, y, lo, hi)
    if w == nil then return end
    local i
    for i = 1, n do
      if out[i][1] == w[1] and out[i][2] == w[2] then return end
    end
    n = n + 1
    out[n] = w
  end

  -- Stage 1: the buffer's own C++ instance, its column pointers, the storage address if the
  -- caller has one, and whichever arena a descriptor was last found in.
  local inst = nl.cclass(buf)
  -- Only when there is a buffer to ask. A ring search passes none, and blanking this would
  -- both empty the error page's inst= and point the next descriptor call's chain walk at
  -- nothing.
  if buf ~= nil then nl.inst = inst end
  local centres, cn = {}, 0
  local push = function(c)
    if c ~= nil and c > 0 then cn = cn + 1; centres[cn] = c end
  end
  -- The instance and the storage first, because those are the two the widening stage uses:
  -- they are what the descriptor is known to sit near. The column pointers and the cached
  -- arena follow, tight only.
  push(inst)
  push(elem0)
  local cp = nl.col_ptrs(inst)
  local i
  for i = 1, table.getn(cp) do push(cp[i]) end
  push(nl.arena)
  for i = 1, cn do add(centres[i] - nl.TIGHT, centres[i] + nl.TIGHT) end

  -- Stage 2: the two strongest centres, widened. Two bands rather than one window, so this
  -- never re-reads what stage 1 covered.
  for i = 1, 2 do
    local c = centres[i]
    if c ~= nil then
      add(c - nl.MID, c - nl.TIGHT)
      add(c + nl.TIGHT, c + nl.MID)
    end
  end

  -- Stage 3: the anchored pair, unchanged. This is the whole of what 8.46 swept, so a model
  -- that works today keeps working even if every route above answers nothing.
  local sw = nl.sweep_windows()
  for i = 1, table.getn(sw) do add(sw[i][1], sw[i][2]) end

  -- Stage 4: everything the backstop allows. Minutes, and only reached when the app was
  -- otherwise going to refuse to start.
  add(lo, hi)
  nl.last_windows = out
  return out
end

function fftsa.nl.windows_str()
  local w = fftsa.nl.last_windows
  if w == nil then return 'windows=none' end
  local o, i = 'windows=', nil
  -- Two, then a count: this goes on the error page for an operator to photograph, and a
  -- four-stage ladder is a dozen ranges that would push everything after it off the glass.
  for i = 1, table.getn(w) do
    if i > 2 then
      o = o .. ',+' .. tostring(table.getn(w) - 2)
      return o
    end
    if i > 1 then o = o .. ',' end
    o = o .. hx(w[i][1]) .. '..' .. hx(w[i][2])
  end
  return o
end

-- Everything about the native path a failure report needs, in one string the panel can hold.
-- An operator on a model we have never run on can only send back what is on the glass, so
-- the screen has to carry the state rather than name a log to go and read.
function fftsa.nl.diag()
  local nl = fftsa.nl
  local o = 'model=' .. tostring(localnode.model) .. ' fw=' .. tostring(localnode.version)
  o = o .. ' why=' .. tostring(nl.why)
  o = o .. ' | ready=' .. tostring(nl.ready) .. ' entry=' .. tostring(nl.entry)
  o = o .. ' rc=' .. tostring(nl.last_rc) .. ' spent=' .. tostring(nl.boot_spent)
  o = o .. ' | backstop=' .. hx(nl.BACKSTOP_LO or 0) .. '..' .. hx(nl.BACKSTOP_HI or 0)
  o = o .. ' anchor=' .. hx(nl.heap_anchor() or 0) .. ' ' .. nl.windows_str()
  o = o .. ' | glue=' .. tostring(nl.nglue) .. '/' .. tostring(nl.GLUE_MIN)
  local np, k = 0, nil
  if nl.math_pos ~= nil then for k in pairs(nl.math_pos) do np = np + 1 end end
  o = o .. ' mathpos=' .. tostring(np) .. ' odd=' .. tostring(nl.math_odd)
  o = o .. ' inst=' .. hx(nl.inst or 0) .. ' arena=' .. hx(nl.arena or 0)
  o = o .. ' | chunk=' .. tostring(nl.chunk_span) .. '/' .. tostring(nl.CHUNK_BYTES)
  o = o .. ' raw=' .. tostring(nl._raw_n) .. ' hits=' .. tostring(nl._hit_n)
  o = o .. ' win=' .. tostring(nl._win_hit) .. ' first[' .. tostring(nl._hit_why) .. ']'
  -- The four the DMM7510 report could not answer: how much of the sweep reached memory, where
  -- the addresses it did find are, what the derived pass made of them, and the words
  -- themselves -- which is what makes the layout settleable from one grab instead of a round
  -- trip to another continent for each field.
  o = o .. ' | ' .. nl.sweep_str() .. ' ' .. nl.hits_str()
  o = o .. ' ' .. nl.desc_off_str() .. ' der[' .. tostring(nl._der_why) .. ']'
  o = o .. ' sig[' .. tostring(nl._sig_why) .. ']'
  o = o .. ' buf=' .. tostring(nl._desc_buf) .. ' cp=' .. tostring(nl._ncol)
  -- The element stride the content scan measured, and element 0. This is the figure that
  -- decides whether the native read is possible at all, it is per model -- a DMM7510's
  -- STYLE_STANDARD element is 20 bytes where a DMM6500's is 24 -- and it survives a failed
  -- descriptor walk, which is when it is most wanted. Without it on the page it has to be
  -- decoded out of the hit dump a word at a time.
  o = o .. ' str=' .. tostring(nl._stor_stride)
  o = o .. ' e0=' .. (nl._stor_elem0 ~= nil and hx(nl._stor_elem0) or 'nil')
  -- THE GEOMETRY THE NATIVE CALL WAS ACTUALLY HANDED, which is what every capture-side
  -- refusal is a judgement on. Without it a refusal names a test whose inputs are not on the
  -- page, and each one costs a round trip to another continent to ask for one more figure.
  local c = fftsa.nl_cap
  if c == nil then
    o = o .. ' cap[none]'
  else
    o = o .. ' cap[es=' .. tostring(c.elemsize) .. ' pc=' .. tostring(c.perchunk)
             .. ' nc=' .. tostring(c.nchunks) .. ' c1=' .. hx(c.chunk1 or 0)
             .. ' vec=' .. hx(c.vec or 0) .. ' ' .. hx(c.lo or 0) .. '..' .. hx(c.hi or 0)
             .. ']'
  end
  o = o .. ' geom[' .. tostring(nl._geom_why) .. ']'
  o = o .. ' | ' .. nl.hit_dump_str()
  o = o .. ' | plan=' .. tostring(nl.SIZEOF_PLAN) .. ' params=' .. tostring(nl.SIZEOF_PARAMS)
  o = o .. ' real=' .. tostring(nl.SIZEOF_REAL) .. ' align=' .. tostring(nl.DSP_ALIGN)
  -- Which of the six resolved, by name: one missing entry is enough to stop the install, and
  -- the census is the part that differs between models.
  local i
  o = o .. ' | libm '
  for i = 1, table.getn(nl.MATH_NAMES) do
    local nm = nl.MATH_NAMES[i]
    local a = nl.fn ~= nil and nl.fn[nm] or nil
    o = o .. nm .. '=' .. (a ~= nil and hx(a) or 'NIL')
    if i < table.getn(nl.MATH_NAMES) then o = o .. ' ' end
  end
  return o
end

-- A refusal that names itself. init has a dozen ways to give up before the native call is
-- ever made, and without a reason the panel reports the same "ready=false entry=nil rc=nil"
-- for every one of them -- which is what a DMM7510 1.7.16 reported, with nothing to act on.
function fftsa.nl._no(why)
  fftsa.nl.why = why
  return false
end

-- How much of a sweep reached memory. A window can run past the end of DRAM and a block can
-- come back nil or short, neither of which is an error here -- but "swept everything and the
-- needle is not there" and "swept almost nothing" are the same report without these counters,
-- and they call for opposite fixes. A DMM7510 reported 30 raw hits and no descriptor, which
-- either answer explains.
fftsa.nl._sw_blocks, fftsa.nl._sw_nil, fftsa.nl._sw_short, fftsa.nl._sw_bytes = 0, 0, 0, 0

function fftsa.nl.sweep_reset()
  local nl = fftsa.nl
  nl._sw_blocks, nl._sw_nil, nl._sw_short, nl._sw_bytes = 0, 0, 0, 0
end

-- Megabytes, because the figure an operator has to read off the glass and compare against a
-- heap size is the order of magnitude, and a byte count of nine digits costs a line.
function fftsa.nl.sweep_str()
  local nl = fftsa.nl
  return 'read=' .. tostring(math.floor((nl._sw_bytes or 0) / 1048576)) .. 'MB/'
         .. tostring(nl._sw_blocks) .. 'blk nil=' .. tostring(nl._sw_nil)
         .. ' short=' .. tostring(nl._sw_short)
end

fftsa.nl.SWEEP_BLOCK = 32768

function fftsa.nl.FINDS(lo, hi, pat)
  local nl  = fftsa.nl
  local a   = lo
  local out = {}
  local n   = 0
  local pl  = string.len(pat)
  while a < hi do
    local want = fftsa.nl.SWEEP_BLOCK
    if a + want > hi then want = hi - a end
    local s = ki.memread(hx(a), hx(want))
    local got = 0
    nl._sw_blocks = nl._sw_blocks + 1
    if s == nil then
      nl._sw_nil = nl._sw_nil + 1
    else
      got = string.len(s)
      nl._sw_bytes = nl._sw_bytes + got
      if got < want then nl._sw_short = nl._sw_short + 1 end
      local i = 1
      while true do
        local j = string.find(s, pat, i, true)
        if j == nil then break end
        n = n + 1; out[n] = a + j - 1
        i = j + 1
      end
    end
    -- Advance by what came back, not by what was asked for. A block answering short with the
    -- step taken from the request leaves everything between them unsearched -- on a 268 MB
    -- sweep that is most of it -- and the sweep still reports the hits it did reach, so the
    -- caller sees "swept and absent" for a needle it never looked at. _sw_short counts it.
    local nexta
    if got >= pl then
      -- Terminate on the tail rather than on the step, or the overlap subtraction
      -- leaves the address unchanged and the loop never ends.
      if a + got >= hi then break end
      nexta = a + got - (pl - 1)
    else
      -- Nothing usable came back: step over the block rather than re-reading it. want is at
      -- least one byte while a < hi, so this always advances.
      nexta = a + want
    end
    if nexta <= a then nexta = a + want end
    a = nexta
  end
  return out
end

-- Element storage of a buffer, by content scan over the buffer's own first readings.
--
-- No fixed sentinel: the needle is reading 1 as the eight bytes the element holds, so this
-- works on a capture as well as on a buffer seeded for the purpose, and two buffers seeded
-- alike cannot be mistaken for one another. Two passes, the arena recent allocations land
-- in first and then the wider heap, the narrow pass being 32 MB rather than 126 MB.
--
-- Confirmation uses the extra values as well as the readings, because fftsa.sg_mkbuf seeds
-- the trace buffer with the axis floor in every element and a distinct extra in each:
-- readings alone match at every element and the scan then returns whichever lies lowest in
-- memory, which for a two-chunk buffer need not be element 0. A trace shifted by a whole
-- chunk is still a plausible trace.

-- Readings nl.init seeds into a buffer it means to find, which has to be at least the
-- largest FAR_INDEX below or the check no small record can imitate does not cover the
-- buffers this module creates for itself -- exactly the ones whose readings are a regular
-- series and so the likeliest to be mimicked by a statistics record. 256 writes is under
-- two milliseconds, once, at install.
fftsa.nl.SEED_READS = 256

-- Consecutive readings a hit is confirmed against, and the far indices confirmed as well.
-- Six consecutive values prove very little; the same series still holding at index 256
-- proves an array of at least that many. Both are cheap -- seven double comparisons a
-- candidate -- where confirming all 256 would be 510 peek32 calls per hit.
local READ_CONFIRM = 6
local FAR_INDEX = { 64, 256 }

-- Returns the slot 0 address and the measured element stride, or nil.
--
-- has_extras is the caller's knowledge and not something to discover: reading .extravalues
-- on a STYLE_STANDARD buffer posts event 4927, for which the firmware puts a modal dialog
-- on the glass over the running app, and pcall does not help where it posts rather than
-- raises. Every caller created the buffer it is asking about.
function fftsa.nl._find_storage(buf, has_extras)
  -- Which term failed, for whoever reports the refusal: a sweep that answers only nil leaves
  -- the caller saying "no descriptor" with nothing to act on.
  local n = buf.n
  fftsa.nl._stor_why = nil
  if n == nil or n < READ_CONFIRM then
    fftsa.nl._stor_why = 'short record n=' .. tostring(n)
    return nil
  end
  local rd, ex = {}, nil
  local i
  for i = 1, READ_CONFIRM do
    rd[i] = buf.readings[i]
    if rd[i] == nil then return nil end
  end
  if has_extras then
    ex = {}
    for i = 1, 3 do
      ex[i] = buf.extravalues[i]
      if ex[i] == nil then return nil end
    end
  end
  -- Readings from the far end, which no small record can imitate: the firmware keeps
  -- separate 16-byte records of the same values -- extra-value records, statistics
  -- accumulators -- and a seeded buffer's first six readings are measurable at stride 16 at
  -- an address that is not element storage at all. The largest index, 256, is inside the
  -- first chunk whatever the element size is, the smallest plausible element of 8 bytes
  -- still putting 4096 in a chunk. Only indices the buffer has are used.
  local far, fn = {}, 0
  for i = 1, table.getn(FAR_INDEX) do
    local j = FAR_INDEX[i]
    if j > READ_CONFIRM and j <= n then
      fn = fn + 1
      far[fn] = j
      if buf.readings[j] == nil then return nil end
    end
  end
  local needle = f64_pack(rd[1])
  local windows = fftsa.nl.scan_windows(buf, nil)
  local wi
  local nhits = 0
  fftsa.nl.sweep_reset()
  for wi = 1, table.getn(windows) do
    local hits = fftsa.nl.FINDS(windows[wi][1], windows[wi][2], needle)
    nhits = nhits + table.getn(hits)
    local k
    for k = 1, table.getn(hits) do
      local h = hits[k]
      -- 4 and not 16: element 0 is not the chunk payload, so the allocator's guarantee does
      -- not reach it, and a 16-byte filter rejects real storage -- the trace buffer's element
      -- 0 is measurable at 0x037C71C8. Not 8 either: a 20-byte element puts half the readings
      -- in a record on a 4-aligned address, so the firmware is not loading them 8-aligned and
      -- element 0 need not be. The discrimination is the extras and the far readings below.
      if math.mod(h, 4) == 0 then
        -- Candidate strides 32, 24 and 20, all three unconditionally: they are the element
        -- sizes this firmware uses -- WRITABLE_FULL 32 on both models, STANDARD 24 on a
        -- DMM6500 and 20 on a DMM7510 -- and 32 is the only one that can hold the extra
        -- value at +20. The discovered offsets after them cover an element none of the three
        -- matches, and they can only be measured where readings 1 and 2 differ -- with every
        -- reading equal each offset matches and the list fills with noise, which is a quiet
        -- capture at 4.5 digits. 20 is in the list for exactly that case: a DMM7510 reported
        -- "no stride confirmed ... eq12=true", a quiet capture whose stride the discovery
        -- loop never ran to find. Each candidate still gets the full confirmation, and
        -- describe() checks the winner against the descriptor's elemsize.
        local cands, cn = { 32, 24, 20 }, 3
        if rd[2] ~= rd[1] then
          local off
          for off = 8, 64, 4 do
            if off ~= 32 and off ~= 24 and off ~= 20 and eq64(h + off, rd[2]) then
              cn = cn + 1; cands[cn] = off
            end
          end
        end
        local ci
        for ci = 1, cn do
          local s = cands[ci]
          local good = true
          for i = 2, READ_CONFIRM do
            if not eq64(h + (i - 1) * s, rd[i]) then good = false end
          end
          -- The far readings, which is the check a 16-byte record cannot pass.
          for i = 1, fn do
            if not eq64(h + (far[i] - 1) * s, buf.readings[far[i]]) then good = false end
          end
          -- The extra values, which also tell two elements of a seeded buffer apart when
          -- every reading in it is the same. They only fit an element of at least 28, so
          -- this is a stride test as well as a value test.
          if ex ~= nil then
            if s < 28 then good = false
            else
              for i = 1, 3 do
                if not eq64(h + (i - 1) * s + 20, ex[i]) then good = false end
              end
            end
          end
          if good then return h, s end
        end
      end
    end
  end
  fftsa.nl._stor_why = 'no stride confirmed n=' .. tostring(n) .. ' hits=' .. tostring(nhits)
                       .. ' eq12=' .. tostring(rd[2] == rd[1])
                       .. ' x=' .. tostring(has_extras)
                       .. ' ' .. fftsa.nl.sweep_str()
  return nil
end

-- The descriptor fields, from a base the caller already has. Five peek32, so re-reading
-- them is how a caller picks up a chunk vector that has lengthened, without the sweep
-- below. Confirmed by the two self-pointers and the chunk geometry, so a base that no
-- longer describes this buffer is refused here and the caller sweeps again. Returns the
-- base, elemsize, perchunk, the chunk vector and the chunk count.
-- The chunk payload size is the allocator's figure, not ours. A DMM6500 uses 32,768 bytes;
-- another model need not, and a DMM7510 1.7.16 rejected a perfectly good descriptor because
-- the two tests below demanded that exact number.
--
-- perchunk is how many elements fit one payload, so the payload is the power of two perchunk
-- exactly fills: elemsize * perchunk fits it, and one more element does not. That still pins
-- perchunk as tightly as the old pair did -- it just does not assume which payload size it is
-- pinning against. Identification does not rest on this anyway: +0x48 holding elem0 and the
-- two self-pointers at +0x54 and +0x64 both equalling base are three independent checks.
function fftsa.nl._chunk_span(elemsize, perchunk)
  if elemsize == nil or perchunk == nil then return nil end
  if elemsize < 8 or perchunk < 1 then return nil end
  local p = 4096
  while p <= 1048576 do
    if elemsize * perchunk <= p and elemsize * (perchunk + 1) > p then return p end
    p = p * 2
  end
  return nil
end

-- The descriptor field offsets, named rather than spelled out at each use so the derived
-- route below has something to compare what it found against, and so the one place that
-- matters -- the native cursor rewind, which writes at compiled offsets -- can refuse a
-- layout that is not the one the image was built for.
--
-- DOFF is the DMM6500's and the only one anything may be written at. DOFF_7510 is where the
-- same fields were found on a DMM7510 1.7.16a: vec, stor, s1, s2 and cap all 8 lower, es, pc
-- and nc unmoved. Read off three error pages, from two different buffers in two different
-- boots, after the derived route had already answered with them -- so it is that route's
-- finding written down, which is what lets the signature route below answer on that model
-- without the readings having to differ.
--
-- WHAT THE IMAGES DO AND DO NOT SETTLE. notes/firmware/structmatch.py finds the initialiser
-- 1044 bytes byte-identical at 6500 1.7.18 file offset 0x3F2AFC and 7510 1.7.16a 0x221DE4,
-- which was once read as proving the layout identical on both. It does not: that function
-- stores to EVERY 4-byte displacement from 0x04 to 0x94, as an unrolled init of a 16-byte
-- strided array -- r11 to 0x2C,0x3C,..,0x9C and r12 to 0x30,0x40,..,0x90 -- and a function
-- that writes every slot in a range cannot say which slot is which field. The 16-byte period
-- is visible in the records themselves: on the 7510 the words at +0x4C..+0x58 and +0x5C..+0x68
-- repeat the same (owner, ptr, ptr, count) shape, so the pair this module calls two owner
-- self-pointers is the owner field of two CONSECUTIVE array entries, and the 8 between the
-- models is where the array starts.
--
-- So these are two measured offset sets and not a derivation. Nothing rests on them being
-- right: every candidate is confirmed by content -- the storage pointer has to equal the
-- element 0 the scan measured, two words have to equal the base, and the geometry has to tile
-- a power-of-two payload -- so a wrong set fails to find rather than finding something wrong.
-- The route that needs no table at all is _derive_desc, and making the signature route derive
-- its base the same way would retire both of these.
fftsa.nl.DOFF = { es = 8, pc = 12, nc = 16, vec = 68, stor = 72, s1 = 84, s2 = 100,
                  cap = 116 }
fftsa.nl.DOFF_7510 = { es = 8, pc = 12, nc = 16, vec = 60, stor = 64, s1 = 76, s2 = 92,
                       cap = 108 }

-- Every layout to try, the compiled one first.
--
-- WHY A SECOND SET COSTS NO FALSE POSITIVE, stated correctly: it is not that the two sets
-- space those three words differently -- they do not, s1 and s2 are stor+12 and stor+28 in
-- both, and cap-32 and cap-16 in both. It is the VALUE the self-pointers have to hold. From
-- a sweep hit h the base is h-72 at one set and h-64 at the other, and the word at h+12 has
-- to equal whichever one is being tried, so at most one set can confirm. That is a stronger
-- property than the spacing claim and it is the one that holds.
--
-- It holds only for the two routes that anchor on a hit. _read_desc takes a base the caller
-- already has and tries each set at it, and a single base CAN satisfy both -- so the order
-- here is what decides, and the compiled set being first is what makes that safe. The order
-- is also per hit and not global: the layout loop is inside the hit loop, so a second-set
-- match on an earlier hit beats a first-set match on a later one.
--
-- And on the signature route there is one fewer check than it looks. elem0 is read FROM
-- base+stor there, so _read_desc_1's storage-pointer test is an identity on that path, which
-- also makes describe's "elemsize must equal the measured stride" cross-check compare the
-- descriptor's figure with itself. geom_ok is what closes that: it asks the firmware for the
-- readings at a chunk boundary, which no descriptor field can satisfy by agreeing with
-- itself.
fftsa.nl.DOFF_SETS = { fftsa.nl.DOFF, fftsa.nl.DOFF_7510 }

-- Which set last answered, so desc_off_ok() can refuse a write at offsets the image does not
-- use. nil until a descriptor has been read.
fftsa.nl.doff_used = nil

-- One candidate layout, read at D's offsets.
--
-- Every read here is guarded, not raw. A base reaching this is a word the firmware handed us
-- -- a cached one, a sweep hit, or a pointer out of the instance's column chain -- and only the
-- sweep hit is known to be in DRAM at all. An unguarded peek32 on the other two is an lwz on an
-- arbitrary address, which is a precise data storage interrupt and a bluescreen.
--
-- note belongs to the sweep's hit loop and to nothing else. It counts a candidate that got
-- past the two owner self-pointers and names the first one's geometry, which is what tells
-- "the sweep found the storage address but the record is shaped differently" from "the sweep
-- never covered it" -- the distinction a DMM7510 report could not make. The other callers
-- search on a different needle, so counting their candidates in the same two fields would
-- make the figure on the error page mean two things.
function fftsa.nl._read_desc_1(base, elem0, D, note)
  if base == nil then return nil end
  local nl = fftsa.nl
  local g = nl._wg
  if g(base + D.stor) ~= elem0 then return nil end     -- 0x48, the storage pointer
  if g(base + D.s1) ~= base or g(base + D.s2) ~= base then return nil end
  local elemsize = g(base + D.es)
  local perchunk = g(base + D.pc)
  local nchunks  = g(base + D.nc)
  -- The element size is a runtime field and need not divide the payload: a STYLE_STANDARD
  -- element of 24 bytes puts 1365 in a 32,768-byte payload, filling 32,760 and leaving 8
  -- spare, and one of 20 puts 1638 there for the same 8. So the test is a fit rather than an
  -- exact product, and _chunk_span finds which payload size it is a fit for.
  local span = nl._chunk_span(elemsize, perchunk)
  if note then
    nl._hit_n = (nl._hit_n or 0) + 1
    if nl._hit_why == nil then
      nl._hit_why = 'es=' .. tostring(elemsize) .. ' pc=' .. tostring(perchunk)
                    .. ' nc=' .. tostring(nchunks) .. ' span=' .. tostring(span)
    end
  end
  if elemsize == nil or perchunk == nil or nchunks == nil then return nil end
  if nchunks < 1 or nchunks >= 4096 or elemsize < 8 or perchunk < 1 then return nil end
  if span == nil then return nil end
  nl.chunk_span = span
  nl.doff_used = D
  -- The chunk count comes back with the vector because a caller indexing it has no other way
  -- to know where it ends, and an entry too far returns whatever follows in the heap -- which
  -- could pass the backstop and be written to.
  return base, elemsize, perchunk, g(base + D.vec), nchunks
end

-- Every candidate layout, from a base the caller already believes is a descriptor base --
-- a cached one, or a pointer out of the instance's column chain.
function fftsa.nl._read_desc(base, elem0)
  if base == nil then return nil end
  local si
  for si = 1, table.getn(fftsa.nl.DOFF_SETS) do
    local b, es, pc, v, nc = fftsa.nl._read_desc_1(base, elem0, fftsa.nl.DOFF_SETS[si])
    if b ~= nil then return b, es, pc, v, nc end
  end
  return nil
end

-- Every candidate layout, from a word that holds the storage pointer. The base follows from
-- each layout's own stor offset, so the hit is tried at each distance rather than at one --
-- which is what a sweep hit needs, because the hit is the only address it knows.
function fftsa.nl._read_desc_from_stor(h, elem0, note)
  if h == nil then return nil end
  local si
  for si = 1, table.getn(fftsa.nl.DOFF_SETS) do
    local D = fftsa.nl.DOFF_SETS[si]
    local b, es, pc, v, nc = fftsa.nl._read_desc_1(h - D.stor, elem0, D, note)
    if b ~= nil then return b, es, pc, v, nc end
  end
  return nil
end

-- The descriptor half of the report, cleared. Both halves of describe() sweep, and the
-- descriptor half does not run at all when the storage half fails -- so without this the
-- error page carries the PREVIOUS buffer's hits, dump and derived offsets beside this
-- buffer's storage failure. A DMM7510 grab read that way names the wrong buffer and the
-- wrong element size.
function fftsa.nl.desc_report_reset(buf)
  local nl = fftsa.nl
  nl._hit_n, nl._hit_why, nl._raw_n, nl._win_hit = 0, nil, 0, nil
  nl._raw_at, nl._der_why, nl.desc_off = {}, nil, nil
  nl._der_best, nl._der_best_n = nil, -1
  nl._ncol = nil
  -- The layout attribution goes with the rest of it. Leaving it attached to a buffer whose
  -- descriptor was never read is the same staleness, and it is the one field desc_off_ok()
  -- decides a write on.
  nl.doff_used = nil
  -- Which buffer this was, and how far the instance's column chain got. Both are invisible in
  -- the report otherwise: a chain that walked nothing and one that walked eight records give
  -- the same window count once the ladder's later stages are added, and the capacity says
  -- whether the buffer the allocator built is the one that was asked for.
  nl._desc_buf = 'cap' .. tostring(buf ~= nil and buf.capacity or nil)
                 .. '/n' .. tostring(buf ~= nil and buf.n or nil)
end

-- ---------------------------------------------------------------------------
-- The descriptor with its field offsets derived rather than assumed.
--
-- A DMM7510 1.7.16 reported 30 raw hits of a confirmed element 0 and not one of them a
-- descriptor by the test above, with the sweep covering the whole backstop. Either the words
-- holding that address were never read, which fftsa.nl.sweep_str now reports, or the layout is
-- not the one measured on a DMM6500 -- and the second is answerable here without a second
-- instrument.
--
-- Nothing below is an offset this module knows. Given one address where the storage pointer
-- was found, it reads the neighbourhood once and derives:
--
--   base      the value that appears at two or more of those words AND is the address they
--             are measured from, which is what an owner self-pointer is
--   stor      base to the storage pointer, from the hit
--   es, pc    a pair of adjacent words whose first equals the stride the content scan
--             MEASURED and whose second makes a power-of-two chunk payload with it
--   vec       a word that points at a word holding elem0, which is what a chunk vector's
--             entry 0 is
--   nc        a word in 1..4095 that counts exactly the leading vector entries which are
--             plausible payloads, the next one not being
--
-- Each term is confirmed against something already measured, so none of them rests on
-- another's being right. The caller gets the same five values _read_desc returns, plus the
-- offsets, and refuses the native cursor rewind if they are not the compiled set.
-- ---------------------------------------------------------------------------

-- How far either side of a storage-pointer hit the descriptor can reach. On the measured
-- layout the hit sits 0x48 above the base, so the geometry fields are 0x40 BELOW it and the
-- two self-pointers 0x0C and 0x1C above. A base is only accepted within BACK of the hit, so
-- these two spans always cover base..base+0x140 wherever in the record the hit falls.
fftsa.nl.DERIVE_BACK, fftsa.nl.DERIVE_FWD = 256, 320
fftsa.nl.DERIVE_SELF_MIN = 2
-- The longest chunk vector this will walk. 16,384 readings of 24 bytes is twelve chunks and a
-- capture has been measured at 49, so this is two orders of margin and bounds the walk at
-- about a third of a second rather than leaving it to a field that could be any word.
fftsa.nl.DERIVE_NC_MAX = 1024

-- Is a word a plausible chunk payload address? In the backstop, 4-aligned, and readable.
-- Nothing here authenticates it -- that is what entry 0 matching elem0 does -- it only
-- bounds how far a vector walk may go.
function fftsa.nl._payload_ok(a)
  if type(a) ~= 'number' or a == 0 then return false end
  -- 4 and not 8. This asked for 8 because a payload holds doubles the firmware loads
  -- directly, and that premise is gone: a 20-byte element leaves half of them 4-aligned,
  -- which is why dsp_native.c admits a 4-aligned payload base. An 8-byte test here would
  -- end the vector walk early on such a model and refuse a descriptor that is good.
  if math.mod(a, 4) ~= 0 then return false end
  return fftsa.nl._wg(a) ~= nil
end

function fftsa.nl._derive_desc(h, elem0, stride)
  local nl = fftsa.nl
  local g = nl._wg
  if h == nil or type(h) ~= 'number' or math.mod(h, 4) ~= 0 then return nil end
  if type(stride) ~= 'number' or stride < 8 then return nil end
  local back, fwd = nl.DERIVE_BACK, nl.DERIVE_FWD
  -- One guarded read a word over the neighbourhood, kept against its offset from the hit.
  -- 145 reads, which is why this runs only after the measured layout has answered nothing.
  local v, k = {}, nil
  for k = -back, fwd, 4 do v[k] = g(h + k) end

  -- The base. An owner self-pointer is a word whose value is the address the record starts
  -- at, so the base is a value that both lies at or below the hit, within reach of it, and
  -- appears at more than one of these words. Taking the most-repeated candidate rather than
  -- the first keeps a single coincidental word from winning over a real pair.
  local base, nself = nil, 0
  for k = -back, fwd, 4 do
    local b = v[k]
    if b ~= nil and b > 0 and math.mod(b, 4) == 0 and b <= h and h - b <= back then
      local c, k2 = 0, nil
      for k2 = -back, fwd, 4 do
        if v[k2] == b then c = c + 1 end
      end
      if c > nself then base, nself = b, c end
    end
  end
  -- The hit that got furthest, for the dump on the error page. Which hit to show cannot be
  -- decided by position -- the chunk vector holds the storage address too, and on a DMM6500
  -- so does allocator bookkeeping -- so it is the one whose neighbourhood looked most like a
  -- record that is worth the characters.
  if nl._der_best == nil or nself > nl._der_best_n then
    nl._der_best, nl._der_best_n = h, nself
  end
  if base == nil or nself < nl.DERIVE_SELF_MIN then
    nl._der_why = 'no self-pointer pair within ' .. tostring(back) .. ' of ' .. hx(h)
    return nil
  end

  -- Which two words those were, for the report and for the rewind gate. They are not a cache
  -- re-validation: the cached-base path goes through _read_desc, which tries DOFF_SETS and
  -- not these, so a model reached only by this route does re-sweep on a later describe()
  -- whose storage cache has missed. DOFF_7510 is why the DMM7510 no longer needs this route;
  -- the next model that does will need the cache path taught to carry derived offsets.
  local s1off, s2off = nil, nil
  for k = -back, fwd, 4 do
    if v[k] == base then
      if s1off == nil then s1off = h + k - base
      elseif s2off == nil then s2off = h + k - base end
    end
  end

  -- Offsets from the base now, bounded by what was read: a field the window does not cover is
  -- nil rather than a fresh read, so this cannot wander.
  local at = function(off)
    local kk = base + off - h
    if kk < -back or kk > fwd then return nil end
    return v[kk]
  end
  local span_hi = h + fwd - base

  -- es and pc: the first adjacent pair whose element size is the stride the content scan
  -- measured. That is the lock -- a word that happens to equal the stride with a neighbour
  -- that happens to fill a payload is the only false positive left, and describe() checks
  -- elemsize against the stride again on the way out.
  local off_es, perchunk, span = nil, nil, nil
  local off
  for off = 0, span_hi - 4, 4 do
    if at(off) == stride then
      local pc = at(off + 4)
      local sp = nl._chunk_span(stride, pc)
      if sp ~= nil then off_es, perchunk, span = off, pc, sp end
    end
    if off_es ~= nil then break end
  end
  if off_es == nil then
    nl._der_why = 'no elemsize=' .. tostring(stride) .. ' with a payload-filling perchunk in '
                  .. hx(base) .. '+0..' .. tostring(span_hi)
    return nil
  end

  -- vec: a word pointing at a word that holds elem0. A chunk vector's entry 0 is chunk 0's
  -- payload, and chunk 0's payload is where element 0 is -- which is the address the content
  -- scan confirmed against eleven readings. One indirection, content-checked.
  local off_vec, vec = nil, nil
  for off = 0, span_hi, 4 do
    local p = at(off)
    if p ~= nil and p > 0 and math.mod(p, 4) == 0 and g(p) == elem0 then
      off_vec, vec = off, p
      break
    end
  end
  if off_vec == nil then
    nl._der_why = 'no word pointing at ' .. hx(elem0) .. ' in ' .. hx(base) .. '+0..'
                  .. tostring(span_hi)
    return nil
  end

  -- nc: a word equal to the number of leading vector entries that are plausible payloads.
  --
  -- Walking the vector alone cannot find its end -- one entry past it is whatever the heap
  -- holds next, and a plausible word there reads as another chunk -- and a field alone cannot
  -- be told from any other small integer in the record. So the walk is done once, capped, and
  -- the count has to equal exactly what it reached. A vector whose next word also looks like a
  -- payload therefore refuses rather than overruns, and says which figure it refused.
  local m = 0
  while m < nl.DERIVE_NC_MAX do
    if not nl._payload_ok(g(vec + m * 4)) then break end
    m = m + 1
  end
  local off_nc = nil
  for off = 0, span_hi, 4 do
    if at(off) == m and m >= 1 then
      off_nc = off
      break
    end
  end
  if off_nc == nil then
    nl._der_why = 'no word equal to the ' .. tostring(m) .. ' plausible entries of the vector '
                  .. 'at ' .. hx(vec)
    return nil
  end
  local nchunks = m

  nl.chunk_span = span
  nl.desc_off = { es = off_es, pc = off_es + 4, nc = off_nc, vec = off_vec,
                  stor = h - base, s1 = s1off, s2 = s2off, self_n = nself }
  -- Cleared, because this route did not read a candidate layout and a value left here would
  -- be the one some earlier buffer matched.
  nl.doff_used = nil
  nl._der_why = nil
  return base, stride, perchunk, vec, nchunks
end

-- Do the derived offsets agree with the layout the native image writes at? The cursor rewind
-- in dsp_native.c stores at compiled displacements from the descriptor base, so a model whose
-- descriptor is shaped differently must not be handed one -- the fields it would overwrite
-- belong to whatever is really there.
-- THE DESCRIPTOR IS THE ARGUMENT, and an absent answer refuses.
--
-- This decides a write at displacements compiled into the image, and it used to decide it
-- from module state: which layout any buffer was read at most recently, with nil -- the state
-- every _find_desc entry resets to -- meaning permit. The caller holds a descriptor; that is
-- what has to be judged. With two layouts in the search the stale case stopped being
-- harmless: DOFF_7510's two self-pointers are at 76 and 92, which are exactly the
-- DESC_IT1_PTR and DESC_IT2_PTR the rewind in dsp_native.c stores at, so a write permitted
-- against the wrong layout would overwrite both owner pointers of a live column descriptor.
function fftsa.nl.desc_off_ok(d)
  local nl = fftsa.nl
  local D = nl.DOFF
  if d == nil then return false end
  local o = d.dderived
  if o ~= nil then                        -- the derived route answered, with its own offsets
    return o.es == D.es and o.pc == D.pc and o.nc == D.nc
           and o.vec == D.vec and o.stor == D.stor
  end
  -- Otherwise a candidate layout answered and it has to be the compiled one. A descriptor
  -- carrying neither is one this cannot place, which is a refusal and not a default.
  return d.doff ~= nil and d.doff == D
end

function fftsa.nl.desc_off_str()
  local nl = fftsa.nl
  local o = nl.desc_off
  if o == nil then
    -- Which candidate layout answered. 'measured' could not say, and the two sets differ by
    -- 8 in four fields -- so which of them a model matched is the layout finding itself.
    local u = nl.doff_used
    if u == nil then return 'doff=none' end
    if u == nl.DOFF then return 'doff=compiled' end
    return 'doff=stor' .. hx(u.stor) .. ',vec' .. hx(u.vec) .. ',cap' .. hx(u.cap)
  end
  return 'doff=stor' .. hx(o.stor) .. ',es' .. hx(o.es) .. ',nc' .. hx(o.nc)
         .. ',vec' .. hx(o.vec) .. ',s' .. hx(o.s1 or 0) .. '/' .. hx(o.s2 or 0)
         .. ',n' .. tostring(o.self_n)
end

-- The words around the hit the derived pass got furthest with.
--
-- This is the one diagnostic that lets a layout be worked out rather than guessed, and it is
-- here because the channel is a screen grab from another continent: asking for one more
-- figure costs a day, so the figures go on the glass now. The window spans the measured
-- layout's own fields as seen from the storage pointer -- elemsize, perchunk and the chunk
-- count sit 0x40 below it, the chunk vector 4 below, and the two self-pointers 0x0C and 0x1C
-- above -- so whatever shape this model's record has, these words contain it.
fftsa.nl.DUMP_LO, fftsa.nl.DUMP_HI = -72, 68

function fftsa.nl.hit_dump_str()
  local nl = fftsa.nl
  local h = nl._der_best
  if h == nil then
    local d = nl._raw_at
    if d == nil then return 'dump=none' end
    h = d[1]
  end
  if h == nil then return 'dump=none' end
  local o, k = 'dump' .. hx(h) .. tostring(nl.DUMP_LO) .. '[', nil
  for k = nl.DUMP_LO, nl.DUMP_HI, 4 do
    if k > nl.DUMP_LO then o = o .. ' ' end
    local w = nl._wg(h + k)
    if w == nil then o = o .. '-' else o = o .. hx(w) end
  end
  return o .. ']'
end

-- The distinct raw hits a report shows, and how many are kept to re-examine. The windows
-- overlap by design -- every tight one lies inside the backstop -- so the same word is found
-- several times and a raw count alone overstates how many places hold the address.
fftsa.nl.HITS_KEEP, fftsa.nl.HITS_SHOW = 64, 6

function fftsa.nl.hits_str()
  local nl = fftsa.nl
  local d = nl._raw_at
  if d == nil or table.getn(d) == 0 then return 'at=none' end
  local o, i = 'at=', nil
  for i = 1, table.getn(d) do
    if i > nl.HITS_SHOW then return o .. '+' .. tostring(table.getn(d) - nl.HITS_SHOW) end
    if i > 1 then o = o .. ',' end
    o = o .. hx(d[i])
  end
  return o
end

function fftsa.nl._find_desc(elem0, buf, stride)
  -- The cached base first, re-validated rather than trusted. Keyed on the storage address, so
  -- a buffer whose storage moved misses, and _read_desc refuses a stale base even if the key
  -- matched. This is the expensive half of describe() when the ladder has to escalate, so the
  -- cache is what keeps a second describe() of the same buffer free.
  local nl = fftsa.nl
  if nl._desc_of == elem0 then
    local b, es, pc, v, nc = nl._read_desc(nl._desc_at, elem0)
    if b ~= nil then return b, es, pc, v, nc end
    nl._desc_of, nl._desc_at = nil, nil
  end
  local needle = u32_pack(elem0)
  -- Two counts, because they fail differently and the panel has to tell them apart. _raw_n is
  -- how many times the storage address appears at all: zero means the descriptor is outside
  -- every window swept. _hit_n is how many of those passed the two owner self-pointers: raw
  -- hits with no confirmed one means the layout is not the one measured, which is what the
  -- derived pass below then answers. The DMM7510 report had only the one count.
  nl.desc_report_reset(buf)
  nl.sweep_reset()
  local seen, nseen = {}, 0
  local windows = fftsa.nl.scan_windows(buf, elem0)
  -- The chain pointers as the descriptor itself, before any sweeping. On a DMM6500 this does
  -- not answer: a sweep for the descriptor's own address found four references and all four
  -- were inside the descriptor or in allocator bookkeeping, so nothing outside it points at
  -- it. It is here because it costs three guarded reads a pointer against _read_desc's own
  -- validation, scan_windows has already walked the chain, and a model where one of those
  -- pointers is the descriptor gets it for nothing.
  local cand = fftsa.nl.col_ptrs(nl.inst)
  nl._ncol = table.getn(cand)
  local ci
  for ci = 1, table.getn(cand) do
    local b, es, pc, v, nc = nl._read_desc(cand[ci], elem0)
    if b ~= nil then
      nl._desc_of, nl._desc_at = elem0, b
      nl._win_hit, nl.arena = 0, b
      return b, es, pc, v, nc
    end
  end
  local wi
  for wi = 1, table.getn(windows) do
    local hits = fftsa.nl.FINDS(windows[wi][1], windows[wi][2], needle)
    nl._raw_n = nl._raw_n + table.getn(hits)
    local k
    for k = 1, table.getn(hits) do
      -- Kept for the derived pass and for the report, deduplicated: the same word is found
      -- once per window containing it, and a second examination of it proves nothing twice.
      if seen[hits[k]] == nil and nseen < nl.HITS_KEEP then
        nseen = nseen + 1
        seen[hits[k]] = true
        nl._raw_at[nseen] = hits[k]
      end
      -- Every candidate layout, each from the base its own stor offset puts the record at.
      -- A DMM7510's record is a DMM6500's with eight bytes gone ahead of the chunk vector, so
      -- its descriptor sits 8 lower than one offset alone looks and matched nothing there.
      local b, es, pc, v, nc = fftsa.nl._read_desc_from_stor(hits[k], elem0, true)
      if b ~= nil then
        nl._desc_of, nl._desc_at = elem0, b
        -- Which stage answered, and where: the next buffer gets a tight window around this
        -- arena, so at most one call ever pays for the wide stages.
        nl._win_hit, nl.arena = wi, b
        return b, es, pc, v, nc
      end
    end
  end

  -- Nothing matched the measured layout. The same hits again, with every offset derived from
  -- the data instead -- which is the half of "the sweep found the address but no descriptor"
  -- that a DMM6500 cannot answer, because its layout is the one being assumed.
  if stride ~= nil then
    local di
    for di = 1, table.getn(nl._raw_at) do
      local b, es, pc, v, nc = nl._derive_desc(nl._raw_at[di], elem0, stride)
      if b ~= nil then
        nl._desc_of, nl._desc_at = elem0, b
        nl._win_hit, nl.arena = -1, b
        return b, es, pc, v, nc
      end
    end
  end
  return nil
end

-- The descriptor from the buffer's capacity and n, which are descriptor fields at +0x74 and
-- +0x78 rather than values in the record. Returns the descriptor base, element 0, and the
-- same geometry _find_desc returns.
--
-- This goes first because the content scan identifies storage by the readings it holds, and
-- a record whose readings are all identical cannot tell one of its chunks from another:
-- confirmation at any stride passes everywhere, so the scan returns the lowest-addressed
-- chunk and that is not chunk 0. Measured on a shorted input, the scan answered 32,520 bytes
-- low -- exactly one chunk of 1355 elements -- and no descriptor references that address, so
-- the bind failed one step later with the storage half reporting success. A quiet or shorted
-- input is ordinary, so the capture buffer needs a route that ignores the signal.
--
-- Two adjacent big-endian words make a specific needle, and _read_desc_1 applies the same
-- validation as the other route. 878 hits on the instrument, exactly one a descriptor.
--
-- The capacity's offset is a field of each candidate layout, because this route is the one a
-- quiet capture depends on and it answers nothing when the offset is wrong. A DMM7510 found
-- 58 hits of the pair and no descriptor at 0x74, where its own capacity is at 0x6C.
function fftsa.nl._find_desc_by_sig(buf)
  local nl = fftsa.nl
  nl._sig_why = nil
  -- The descriptor half of the report belongs to the buffer being described, and this is one
  -- of the three paths that can resolve one. When this route answers, _find_desc is never
  -- called and so never resets it -- and this is the CAPTURE's primary route, so the page
  -- would carry the previous buffer's identity, hit list, dump and element size beside a
  -- successful bind. Measured: buffer B resolving at a 20-byte element while the page read
  -- cap4096/n1024 and es=32.
  nl.desc_report_reset(buf)
  local cap, n = buf.capacity, buf.n
  if type(cap) ~= 'number' or type(n) ~= 'number' or cap < 1 or n < 1 then
    nl._sig_why = 'cap=' .. tostring(cap) .. ' n=' .. tostring(n)
    return nil
  end
  local needle = u32_pack(cap) .. u32_pack(n)
  local windows = fftsa.nl.scan_windows(buf, nil)
  local wi
  local nhits = 0
  nl.sweep_reset()
  for wi = 1, table.getn(windows) do
    local hits = fftsa.nl.FINDS(windows[wi][1], windows[wi][2], needle)
    nhits = nhits + table.getn(hits)
    local k
    for k = 1, table.getn(hits) do
      local si
      for si = 1, table.getn(nl.DOFF_SETS) do
        local D = nl.DOFF_SETS[si]
        local base = hits[k] - D.cap
        -- The storage pointer this layout would put in that record, taken as the content the
        -- rest of the validation is against: elem0 is not known here, which is the whole
        -- point of the route -- a quiet capture cannot be identified by its readings.
        local elem0 = fftsa.nl._wg(base + D.stor)
        if elem0 ~= nil and elem0 ~= 0 then
          local b, es, pc, v, nc = nl._read_desc_1(base, elem0, D)
          if b ~= nil then
            nl._desc_of, nl._desc_at = elem0, base
            nl._win_hit, nl.arena = wi, base
            return base, elem0, es, pc, v, nc
          end
        end
      end
    end
  end
  -- Named, because this route failing used to leave no trace at all: the caller fell through
  -- to the content scan and reported whatever that said, so a capture buffer whose signature
  -- was never found read exactly like one whose readings could not be confirmed.
  nl._sig_why = 'cap=' .. tostring(cap) .. '/n=' .. tostring(n) .. ' sig hits=' .. tostring(nhits)
                .. ' ' .. nl.sweep_str()
  return nil
end

-- ---------------------------------------------------------------------------
-- The display task's own trace ring.
--
-- What the graph widget draws is not the buffer and not the buffer-side staging ring. It is a
-- ring of records the display task keeps, fed one record per buffer.write.reading, and writing
-- it directly is the only way past 510 blocking appends a frame: no bulk write exists, the
-- staging ring's pending count cannot be pre-loaded because the push sets it, and
-- display.setvalue refuses a graph with event 1717. All three measured.
--
-- NOTHING HERE IS A COMPILED ADDRESS AND NOTHING HERE IS AN ASSUMED OFFSET. The record stride
-- and the distance between a record's value and its x are both derived, because a DMM7510's
-- have never been measured and the operator's instruction is not to assume them. What is
-- assumed is only that the records are evenly spaced and hold the two fields as float32 pairs,
-- and the cross-check below fails closed if even that is wrong.
-- ---------------------------------------------------------------------------

-- A record is this far apart at most, and a ring holds between these many. Both are bounds on
-- a search rather than knowledge: the one measured geometry is 721 records of 56 bytes.
fftsa.nl.REC_MIN, fftsa.nl.REC_MAX = 16, 128
fftsa.nl.RING_MIN, fftsa.nl.RING_MAX = 8, 4096

-- Find the records the display task is drawing, from values only this app could have appended.
--
-- sentinels is the list of {db, hz} pairs just appended, in order, at least three of them with
-- distinct db values. The needle is a db packed as float32 TWICE, because the record holds two
-- copies of it side by side, and eight bytes of a specific float is not something the heap is
-- full of.
--
-- Returns a geometry table or nil, with nl.ring_why saying which term failed:
--   val0    address of sentinel 1's value field
--   stride  bytes between consecutive records, measured from two sentinels
--   dx      value field to x field, measured, and signed -- the x may precede the value
--   nconf   how many sentinels were confirmed at that geometry
function fftsa.nl.find_ring_records(sentinels, full)
  local nl = fftsa.nl
  nl.ring_why = nil
  local ns = sentinels ~= nil and table.getn(sentinels) or 0
  if ns < 3 then
    nl.ring_why = 'need 3 sentinels, got ' .. tostring(ns)
    return nil
  end
  local pat, i = {}, nil
  for i = 1, ns do
    local s = sentinels[i]
    if s == nil or type(s.db) ~= 'number' or type(s.hz) ~= 'number' then
      nl.ring_why = 'sentinel ' .. tostring(i) .. ' is not a db/hz pair'
      return nil
    end
    pat[i] = f32_pack(s.db)
  end
  if pat[1] == pat[2] then
    nl.ring_why = 'sentinels 1 and 2 pack to the same float32'
    return nil
  end
  local n1 = pat[1] .. pat[1]

  -- TWO SEARCHES, AND THE STRIDE COMES FROM CANDIDATES RATHER THAN FROM A HIT DIFFERENCE.
  --
  -- FINDS matches its own needle. The pattern is a live Lua string in the swept heap, so every
  -- search returns one hit that is the needle's own storage -- measured by searching for three
  -- dB values never appended anywhere and getting exactly one hit each. Differencing two
  -- needles' hits therefore produces a meaningless stride, and when two 8-byte needles happen
  -- to be interned 56 bytes apart it produces a CONVINCING one: that is how 120 records of
  -- float were written over Lua's string table, which bluescreened at 0x0022D270 in
  -- luaS_newlstr walking a chain through an overwritten next pointer.
  --
  -- The needle is re-interned on every call, so a self-hit lands somewhere different each
  -- search while a real record does not move. Two searches and an intersection is the lock,
  -- and it costs one extra sweep rather than any knowledge of where the Lua heap is.
  local windows = nl.scan_windows(nil, nil)
  -- WINDOW BY WINDOW, AND STOP AT THE FIRST ONE THAT CONFIRMS A CANDIDATE.
  --
  -- Sweeping the whole ladder before confirming anything cost 41 s, measured repeatedly -- and
  -- the ring is about 40 KB from nl.arena, which stage 1 already puts a tight window around.
  -- The last stage is the whole 268 MB backstop and is where almost all of that time goes, so
  -- stopping as soon as a candidate stands up skips it.
  --
  -- BOTH LOCKS SURVIVE BEING APPLIED PER WINDOW. The two searches still drop a needle's own
  -- storage, because the needle is re-interned per search wherever it lands; the stride
  -- confirmation still rejects one. What changes is only how much memory is read before the
  -- answer is believed.
  --
  -- `full` sweeps the whole ladder anyway and is the caller's fallback: stopping early can
  -- stop on a window that holds the 28-byte staging ring and not the trace ring, and the only
  -- thing that tells those apart is the header, which the caller looks for. So a caller that
  -- finds no header among the fast candidates asks again with full set.
  local out, nout = {}, 0
  local h1n, h2n, nsall = 0, 0, 0
  local wi
  for wi = 1, table.getn(windows) do
    local lo, hi = windows[wi][1], windows[wi][2]
    local h1 = nl.FINDS(lo, hi, n1)
    h1n = h1n + table.getn(h1)
    -- THE SECOND SEARCH ONLY WHERE THE FIRST FOUND SOMETHING.
    --
    -- It sweeps the same window again so that a hit which MOVED between the two can be
    -- dropped: the needle is a live Lua string in the heap being searched, so every search
    -- returns its own storage. But a window with no hits has nothing to intersect, and
    -- sweeping it twice was half of a 41 s find -- the backstop alone is 268 MB.
    --
    -- The lock is not weakened. What actually caught the self-hit pair that bluescreened the
    -- instrument was the STRIDE confirmation below, not the intersection; the intersection is
    -- defence in depth over the same candidates, and candidates only exist where h1 is
    -- non-empty. So the window that would have been excused is a window with nothing in it.
    local h2 = {}
    if table.getn(h1) > 0 then
      h2 = nl.FINDS(lo, hi, n1)
      h2n = h2n + table.getn(h2)
    end
    -- Deduped as well as intersected. The ladder's windows overlap, so one address comes back
    -- once per window it falls in, and without this the confirm loop runs that many times over
    -- for nothing -- a handful of hits became 29 candidates on the first run of it.
    local stable, ns = {}, 0
    local a, b
    for a = 1, table.getn(h1) do
      local seen, keep = false, false
      for b = 1, table.getn(h2) do
        if h1[a] == h2[b] then keep = true end
      end
      if keep then
        for b = 1, ns do
          if stable[b] == h1[a] then seen = true end
        end
        for b = 1, nout do
          if out[b].val0 == h1[a] then seen = true end
        end
        if not seen then ns = ns + 1; stable[ns] = h1[a] end
      end
    end
    nsall = nsall + ns
    -- EVERY confirmed candidate in this window, not the first. The buffer-side staging ring
    -- holds the same two float32 pairs in a 28-byte record, appended in the same order, so it
    -- confirms at a stride just as well -- and it is not what the widget draws.
    local ci, sv
    for ci = 1, ns do
      for sv = nl.REC_MIN, nl.REC_MAX, 4 do
        local g = nl._ring_confirm(stable[ci], sv, sentinels, pat)
        if g ~= nil then nout = nout + 1; out[nout] = g end
      end
    end
    nl.ring_win, nl.ring_nwin = wi, table.getn(windows)
    if nout > 0 and not full then break end
  end
  nl.ring_hits = h1n .. '/' .. h2n .. '/' .. nsall
  nl.ring_cands = out
  if nout == 0 then
    nl.ring_why = 'no stride between ' .. nl.REC_MIN .. ' and ' .. nl.REC_MAX
                  .. ' confirmed, hits ' .. tostring(nl.ring_hits)
    return nil
  end
  return out[1]
end

-- The whole discovery: the records, then the header that identifies which candidate is the
-- display task's ring rather than a staging ring that looks like one.
function fftsa.nl.find_ring(sentinels, full)
  local nl = fftsa.nl
  if nl.find_ring_records(sentinels, full) == nil then return nil end
  local c = nl.ring_cands
  local i
  for i = 1, table.getn(c) do
    if nl.find_ring_header(c[i]) ~= nil then
      nl.ring = c[i]
      nl.ring_why = nil
      return c[i]
    end
  end
  nl.ring_why = 'no header for any of ' .. tostring(table.getn(c)) .. ' record candidates: '
                .. tostring(nl.ring_why)
  -- The fast search stops at the first window that confirms anything, and that window can
  -- hold the staging ring and not the trace ring. Only the header tells them apart, so a
  -- fast pass with no header is exactly the case the whole ladder exists for.
  --
  -- UNLESS IT ALREADY SWEPT THE LOT. Measured 2026-11-09: the window that confirmed first was
  -- the LAST one, the whole backstop -- the ring is not reliably near any centre scan_windows
  -- has when it is called with no buffer. Re-running the full ladder then costs a second 42 s
  -- to read the same memory and reach the same answer.
  if not full and nl.ring_win ~= nil and nl.ring_win < nl.ring_nwin then
    return nl.find_ring(sentinels, true)
  end
  return nil
end

-- Every sentinel at the proposed geometry, read as one block, plus the x field's offset.
-- Reading the whole span once rather than a field at a time is what makes a wrong candidate
-- cheap: a block that does not hold sentinel 3 is rejected on one memread.
function fftsa.nl._ring_confirm(val0, stride, sentinels, pat)
  local nl = fftsa.nl
  local ns = table.getn(sentinels)
  local span = (ns - 1) * stride + 8
  local blk = ki.memread(hx(val0), hx(span))
  if blk == nil or string.len(blk) < span then return nil end
  local i
  for i = 1, ns do
    local at = (i - 1) * stride + 1
    if string.sub(blk, at, at + 7) ~= pat[i] .. pat[i] then return nil end
  end
  -- The x field, by searching one record's worth of bytes for the x the same append carried.
  -- Its offset comes back relative to the value field, which is all a writer needs: the record
  -- base, and therefore the offsets the firmware's own header uses, are never required.
  local xp = f32_pack(sentinels[1].hz)
  local one = ki.memread(hx(val0 - stride), hx(2 * stride))
  if one == nil or string.len(one) < 2 * stride then return nil end
  local p2 = f32_pack(sentinels[2].hz)
  local xn, at = xp .. xp, 1
  while true do
    local j = string.find(one, xn, at, true)
    if j == nil then return nil end
    local dx = j - 1 - stride
    -- Confirm the offset on a DIFFERENT record, because the eight bytes before the record can
    -- hold anything and the first match need not be the field. Every match is tried, so a
    -- decoy ahead of the real one costs one eight-byte read rather than the whole geometry.
    local x2 = ki.memread(hx(val0 + stride + dx), hx(8))
    if x2 ~= nil and x2 == p2 .. p2 then
      return { val0 = val0, stride = stride, dx = dx, nconf = ns }
    end
    at = j + 1
  end
end

-- The ring's own header, found from a record address and the stride rather than from an
-- offset. A writer needs it for the count and the cursors: the records alone are a picture
-- the task will overwrite from wherever its cursor happens to sit.
--
-- The header starts with the two bounds as adjacent words, which is what makes it findable:
-- a word pair (lo, hi) with hi above lo, their difference a whole number of records, and the
-- record we have already confirmed inside it. The two cursors and the count then have to be
-- consistent with those bounds, which is what rejects an unrelated pair.
--
-- The scan is local and bounded. The header measured 40 KB below the ring on a 6500 1.7.17a,
-- and the ring is at most RING_MAX records long, so a window either side of the record covers
-- it without sweeping anything.
fftsa.nl.HDR_BELOW, fftsa.nl.HDR_ABOVE = 262144, 65536
fftsa.nl.HDR_OLD, fftsa.nl.HDR_WRITE, fftsa.nl.HDR_COUNT = 8, 12, 20

function fftsa.nl.find_ring_header(g)
  local nl = fftsa.nl
  nl.ring_why = nil
  if g == nil or g.val0 == nil or g.stride == nil then
    nl.ring_why = 'no record geometry to find a header from'
    return nil
  end
  local v, s = g.val0, g.stride
  local lo = v - nl.HDR_BELOW
  if lo < nl.BACKSTOP_LO then lo = nl.BACKSTOP_LO end
  local hi = v + nl.HDR_ABOVE
  local found, nfound = nil, 0
  -- The candidate bounds are a pointer whose value is within one ring of the record, so its
  -- top half is one of a handful of values. Searching for those two bytes jumps between
  -- candidate positions instead of testing every word: a 2-byte prefix lands about five times
  -- in 320 KB, against 80,000 word positions to test blind.
  local maxspan = nl.RING_MAX * s
  local pre, np = {}, 0
  local t = math.floor(v / 65536)
  local lot = math.floor((v - maxspan) / 65536)
  -- Clamped, because a record below maxspan from zero makes this negative and math.mod keeps
  -- the sign -- string.char would then be handed a negative byte and RAISE, inside bind.
  if lot < 0 then lot = 0 end
  local k
  for k = lot, t do
    np = np + 1
    pre[np] = string.char(math.mod(math.floor(k / 256), 256), math.mod(k, 256))
  end
  local a = lo
  while a < hi do
    local step = 32768
    if a + step > hi then step = hi - a end
    local blk = ki.memread(hx(a), hx(step))
    if blk ~= nil then
      local pi
      for pi = 1, np do
        local i = 1
        while true do
          local j = string.find(blk, pre[pi], i, true)
          if j == nil then break end
          local at = a + j - 1
          if math.mod(at, 4) == 0 and at + 24 <= a + step then
            local c = nl._ring_hdr_ok(at, blk, j, g)
            if c ~= nil then
              nfound = nfound + 1
              if found == nil then found = c end
            end
          end
          i = j + 1
        end
      end
    end
    if a + step >= hi then break end
    -- Overlap by the longest structure a test reads, or a header straddling a slice edge is
    -- missed -- the same tail case FINDS has.
    a = a + step - 24
  end
  nl.ring_hdrs = nfound
  if found == nil then
    nl.ring_why = 'no ring header near the record, ' .. tostring(np) .. ' prefixes swept'
    return nil
  end
  if nfound > 1 then
    nl.ring_why = tostring(nfound) .. ' candidate headers, so none is identified'
    return nil
  end
  g.hdr = found.hdr
  g.lo, g.hi, g.nrec = found.lo, found.hi, found.nrec
  -- The field offsets inside a record, which only the ring start can give. A writer does not
  -- need them -- it addresses fields relative to val0 -- but a report that names them is how
  -- an operator on an unmeasured model can say what their instrument's record looks like.
  g.ov, g.ox = found.ov, found.ox
  return g
end

-- One candidate, judged entirely on consistency. Six terms, and the value field's own address
-- is NOT one of them being on the record grid: that address is a field inside a record, not a
-- record base, so its distance from the ring start is the field offset and is a multiple of
-- nothing. What it does have to satisfy is that both eight-byte fields fit inside one record
-- at the offsets already measured, which is the term that replaces it.
function fftsa.nl._ring_hdr_ok(at, blk, j, g)
  local nl = fftsa.nl
  local v, s = g.val0, g.stride
  local w = function(off)
    local p = j + off
    if p + 3 <= string.len(blk) then return u32_at(blk, p) end
    return nl._wg(at + off)
  end
  local lo, hi = w(0), w(4)
  if lo == nil or hi == nil or hi <= lo then return nil end
  local span = hi - lo
  if math.mod(span, s) ~= 0 then return nil end
  local n = span / s
  if n < nl.RING_MIN or n > nl.RING_MAX then return nil end
  if v < lo or v >= hi then return nil end
  -- Where the two fields sit inside a record, and whether they both fit in one.
  local ov = math.mod(v - lo, s)
  local ox = math.mod(ov + g.dx, s)
  if ov + 8 > s or ox + 8 > s then return nil end
  local old, wr, cnt = w(nl.HDR_OLD), w(nl.HDR_WRITE), w(nl.HDR_COUNT)
  if old == nil or wr == nil or cnt == nil then return nil end
  if old < lo or old >= hi or math.mod(old - lo, s) ~= 0 then return nil end
  if wr < lo or wr >= hi or math.mod(wr - lo, s) ~= 0 then return nil end
  if cnt < 1 or cnt > n then return nil end
  return { hdr = at, lo = lo, hi = hi, nrec = n, ov = ov, ox = ox }
end

-- The header as five numbers. A caller proves the field order by CAUSE rather than by layout:
-- read this, append one reading, read it again. The count must rise by one and the write
-- cursor advance by exactly one stride. Nothing else in memory does that.
function fftsa.nl.ring_header(g)
  local nl = fftsa.nl
  if g == nil or g.hdr == nil then return nil end
  return { lo = nl._wg(g.hdr), hi = nl._wg(g.hdr + 4),
           oldest = nl._wg(g.hdr + nl.HDR_OLD),
           write = nl._wg(g.hdr + nl.HDR_WRITE),
           count = nl._wg(g.hdr + nl.HDR_COUNT) }
end

-- ---------------------------------------------------------------------------
-- The pixel fill: one memwrite a frame in place of 510 appends.
--
-- A frame reaches the glass through buffer.write.reading, one call a point at about 80 us:
-- 39 ms of a 100 ms frame spent on IPC round trips. The display task does not read the
-- buffer. It keeps its own ring of 56-byte records, one pushed per append, and what it draws
-- is not the reading but the two PIXEL triples the firmware computed when the append arrived:
--
--   rec +0x00  x pixel, int32, three identical copies
--   rec +0x0C  y pixel, int32, three identical copies
--   rec +0x18  two zero words
--   rec +0x20  value float32 twice   +0x28 flags   +0x2C x float32 twice   +0x34 2.0f
--
-- ki.memwrite is memcpy with no destination check, so the whole ring goes in one call. The
-- measured ladder for a 510-record pass: 39 ms of appends, 19.3 ms writing a record at a
-- time, 9.6 ms as one block.
--
-- WHAT MAKES IT CHEAP IS THAT EVERY SLOT KEEPS ITS FREQUENCY. The ring is 721 records and a
-- pass is 510, so continuing to append would rotate the slot-to-column assignment by 211
-- every frame and every x pixel would have to be rewritten with it. Engaged, a frame appends
-- ONCE: the cursor moves one record and every other slot keeps the x pixel, the frequency and
-- the flags it already held. So the assignment is solved once, only the y triples are
-- rewritten each frame, and the picture stays the one the appends drew.
--
-- THE ONE APPEND IS NOT OPTIONAL, and it does two jobs. A record written behind the task's
-- back sets no dirty flag, so nothing repaints until an append posts a message. And the record
-- it writes is the firmware's own pixel for a decibel this code knows, which is the only
-- continuing check that the map has not gone stale -- the map cannot be re-fitted once the
-- appends stop, because nothing else on the instrument computes a pixel. It is appended at the
-- frequency the slot it lands in already carries, so it draws the point this code would have
-- drawn there and is not a perturbation.
--
-- NOTHING HERE IS A HARDCODED OFFSET. The stride, the value field and the x field come from
-- the search. The y triple is identified by fitting each repeating triple in a record against
-- the value the same record carries. The map's slope and intercept are least squares over the
-- whole ring. A model whose plot geometry has never been measured gets the same treatment as
-- the one this was written on.
-- ---------------------------------------------------------------------------

-- Bytes a frame sweeps while seeking. 25 MB/s measured on the instrument's own clock, so this
-- is about 10 ms of a 100 ms frame: the search costs a tenth of the frame rate while it runs
-- and nothing once it answers. Every window the ladder offers plus one pass over the backstop
-- is 274 MB, so the worst case is about two minutes of frames and the measured cases are a
-- second or two.
fftsa.nl.PX_BUDGET = 262144
-- A window wider than this is left to the one backstop pass at the end of the ladder, which
-- covers it anyway. scan_windows ends with three overlapping wide stages; sweeping all of them
-- would read 60 MB twice over on the boots where the tight windows miss.
fftsa.nl.PX_WIN_MAX = 4194304
-- The fit has to span this many decibels before it is believed. Pixels are integers, so a
-- narrow span fits a slope badly and the unfitted points still agree: a 3 dB spread once fitted
-- 1.667 px/dB against a true 2, and the points left out predicted within 0.67 px. A span test
-- is what catches that; a residual test alone does not.
fftsa.nl.PX_SPAN_MIN = 20
fftsa.nl.PX_RESID_MAX = 1.5
-- The firmware's own point, read back each frame, may differ from the prediction by this much
-- before the map is called stale. One pixel is rounding; three is a moved axis.
fftsa.nl.PX_DRIFT_MAX = 3
fftsa.nl.PX_DRIFT_RUN = 5
-- Panel rows, which is what a y pixel is clamped to. Writing one outside the plot would draw
-- outside the plot: the widget clamps a below-floor READING, and a pixel written here has
-- already been past that.
fftsa.nl.PX_YMAX = 479
-- A PIXEL IS A SMALL INTEGER, and a word in a triple that is not one is not a pixel.
--
-- One record of 721 came back with 54,099,264 at the x triple -- a heap address, in a slot
-- whose frequency and decibels were both sound. Least squares has no defence against that: the
-- slope for the x pixel against frequency came out -4.41 instead of 0.0138, and the residual
-- it was judged on was 5.4e7, so the x triple could not be identified and the map was refused
-- on a ring that was entirely correct apart from that one word. Measured 2026-11-09.
--
-- Generous, because the point is to exclude an address and not to assume a panel size.
fftsa.nl.PX_PIX_MAX = 8191
-- How much of the window has to be usable, and has to fit, before a fit is believed. The
-- outlier above is 0.2% of a window; a structure that merely resembles a ring is not going to
-- come within a pixel on 95% of 510 records.
fftsa.nl.PX_FIT_FRAC = 0.95
-- How many pixels a triple has to sweep before it can be called the frequency axis, and how
-- far clear of the other triple it has to be.
--
-- "The y pixel is not affine in frequency" is not a discriminator, because a trace can be very
-- nearly a straight line. Measured 2026-11-09 on an input with no signal: every column sat on
-- the axis floor, so the y pixel was CONSTANT, a constant is affine in anything, and both
-- triples came back fitting frequency on all 510 records. A flat trace also fits with a peak
-- in it -- one column out of 510 is 0.2% and passes a 95% inlier test.
--
-- What does separate them is how far the fitted line travels: the frequency axis crosses the
-- plot, about 680 px, and the decibel axis against frequency travels however much the trace
-- happens to tilt, which is tens of pixels for a sloping noise floor and none for a flat one.
fftsa.nl.PX_DRAW_MIN = 128
fftsa.nl.PX_DRAW_RATIO = 4
-- A candidate that confirms a stride but whose ring will not map is abandoned after this many
-- frames, and the sweep carries on from where it was.
fftsa.nl.PX_MAP_TRIES = 8
-- How far the task's own cursors may drift before the window is called somebody else's. One
-- append moves them by one record a frame, which is what this exists to absorb; a jump of more
-- than a few records means something other than this frame is feeding the ring.
fftsa.nl.PX_SLIP_MAX = 8
-- Frames of plain appending after a drop, before the search is allowed to map again.
--
-- The map is fitted by comparing the y triple against the value field of the SAME record, and
-- an engaged frame writes the y triples and not the values -- so after even one pixel frame the
-- two no longer describe the same spectrum and nothing can be fitted from them. The appends
-- rewrite both together, so a couple of frames of them puts the ring back in a state a map can
-- be derived from. Measured 2026-11-09: a re-map straight after a drop refused with "no value
-- field the y triple is affine in", every time.
fftsa.nl.PX_HOLD = 4

fftsa.nl.px = { state = 'idle' }

function fftsa.nl.px_clear()
  local p = fftsa.nl.px
  p.g, p.idx, p.ytab, p.yb, p.T = nil, nil, nil, nil, nil
  p.ay, p.by, p.nrec, p.lo, p.hdr, p.stride = nil, nil, nil, nil, nil, nil
  p.yoff, p.xoff, p.ov, p.ox, p.nseg = nil, nil, nil, nil, nil
  p.resid, p.span, p.hz1, p.hz2 = nil, nil, nil, nil
  p.drift, p.slot, p.slotdb, p.maptries = 0, nil, nil, 0
  p.xcol, p.cands = nil, nil
end

-- Off for the rest of the session, with the reason kept for the error and About pages. The
-- frame then fills by appending, which is what every build before this one did.
function fftsa.nl.px_off(why)
  local nl = fftsa.nl
  nl.px_clear()
  nl.px.state = 'off'
  nl.px.why = why
  return nil
end

-- A frame dropping the path, with its reason kept where the search cannot overwrite it.
--
-- px_restart puts the reason in p.why, and the search runs later in the SAME frame and writes
-- its own there -- so the reason a frame gave up was never readable. It is the one reason that
-- matters most: everything else is a search that has not finished yet.
function fftsa.nl.px_dropframe(why)
  fftsa.nl.px.whyframe = why
  return fftsa.nl.px_restart(why)
end

-- Back to the start without giving up: the geometry was wrong or the plan changed, and the
-- next frame begins the search again. Counters survive, so a report says how many times.
function fftsa.nl.px_restart(why)
  local nl = fftsa.nl
  local laps = nl.px.restarts
  nl.px_clear()
  nl.px.state = 'idle'
  nl.px.why = why
  nl.px.restarts = (laps or 0) + 1
  nl.px.wins, nl.px.wi, nl.px.at = nil, nil, nil
  -- The name is tried again from scratch. noname is only a record of one ladder having been
  -- swept without finding it, and a restart means the plan or the traces changed.
  nl.px.noname = nil
  return nil
end

-- The ladder, cheap windows first and one pass over everything last.
-- THE TRACE OBJECT CARRIES THE BUFFER'S NAME, and that is a far better needle than any
-- reading.
--
-- The display task allocates one trace object per display.graph.add -- 0x14220 bytes on the
-- GUI side, appended to the graph widget's null-terminated trace array -- and the record ring
-- lives INSIDE it, at a fixed offset, behind a small header of bounds and cursors. The
-- distance from that header to the ring measured 0x30 on every boot this app has been found
-- on, which is what the layout says it should be.
--
-- Near the front of the same object is the buffer's NAME, as a NUL-terminated string. This app
-- creates its trace buffer into a bare global for exactly that reason -- a buffer the display
-- task cannot name is subscribed as defbuffer1 instead, and the graph then draws defbuffer1 on
-- defbuffer1's units -- so the name is known, unique and chosen by this app: FFTSA_TRACE.
--
-- WHY IT BEATS SEARCHING FOR READINGS. Every failure the reading search met today is absent
-- here:
--
--   * it does not wait for the display task. An append lands in a staging ring and is copied
--     across later, so at the end of a fill the trace ring still holds the PREVIOUS pass and a
--     needle built from this frame's decibels matches nothing. The name is there from the
--     moment the trace is created.
--   * it does not care what the spectrum looks like. A trace pinned flat on the axis floor
--     offers no distinct values to search for and no decibel span to fit; the name is the same
--     either way.
--   * it cannot be confused with the staging ring, which holds the same floats in the same
--     order in a 28-byte record and confirmed a stride just as well.
--   * it says WHICH trace. The marker trace is a second object of the same shape; it carries
--     FFTSA_MARK.
--
-- And one hit yields the whole geometry by arithmetic rather than by further searching: no
-- stride to try, no header to scan for, no candidate list to work through.
--
-- NOTHING IS ASSUMED FROM THE LAYOUT. The distance from the name to the bounds pair is
-- DERIVED: a bounded walk forward from the hit for two adjacent words that are a plausible
-- ring -- the second above the first, their difference a whole number of records, the count and
-- both cursors consistent with them -- which is the same test the record route applies, over a
-- kilobyte instead of three hundred.
fftsa.nl.PX_NAME = 'FFTSA_TRACE'
-- How far past the name the bounds pair may sit. The layout puts the name at +0x08 and the
-- bounds at +0x1F0, so 0x1E8; this is that with room for a build that moved a field.
fftsa.nl.PX_NAME_SCAN = 1024

-- Every geometry a trace object whose name was found at `at` could have.
--
-- A LIST, because the bounds do not fix the stride. The span between them is a whole number of
-- records at more than one record size -- the measured ring is 40,376 bytes, which is 721
-- records of 56 and also 1,442 of 28 -- and nothing in the header says which. So each plausible
-- stride is returned and px_map adjudicates: a wrong stride cuts the records in the wrong
-- places and its x field then holds a frequency this plan does not have, in almost every slot.
--
-- Same shape as the record route's output, so px_map takes either without knowing which found
-- it: lo, hi, nrec, stride, hdr.
function fftsa.nl.px_from_name(at)
  local nl = fftsa.nl
  local out, nout = {}, 0
  local o
  for o = 0, nl.PX_NAME_SCAN, 4 do
    local h = at + o
    local lo, hi = nl._wg(h), nl._wg(h + 4)
    if lo ~= nil and hi ~= nil and hi > lo then
      local span = hi - lo
      -- The ring sits inside this very object, just past its own bounds words, so a pair that
      -- points anywhere else is some other structure that happens to be ordered.
      if lo > h and lo - h < nl.PX_NAME_SCAN and math.mod(span, 4) == 0 then
        local sv
        for sv = nl.REC_MIN, nl.REC_MAX, 4 do
          if math.mod(span, sv) == 0 then
            local n = span / sv
            if n >= nl.RING_MIN and n <= nl.RING_MAX then
              local old = nl._wg(h + nl.HDR_OLD)
              local wr = nl._wg(h + nl.HDR_WRITE)
              local cnt = nl._wg(h + nl.HDR_COUNT)
              if old ~= nil and wr ~= nil and cnt ~= nil
                 and old >= lo and old < hi and math.mod(old - lo, sv) == 0
                 and wr >= lo and wr <= hi and math.mod(wr - lo, sv) == 0
                 and cnt >= 1 and cnt <= n then
                nout = nout + 1
                out[nout] = { lo = lo, hi = hi, nrec = n, stride = sv, hdr = h,
                              name_at = at, name_off = o }
              end
            end
          end
        end
        -- The first bounds pair that stands up at all is the one: a second, further on, would
        -- be inside the ring itself.
        if nout > 0 then return out end
      end
    end
  end
  return out
end

function fftsa.nl.px_windows(buf)
  local nl = fftsa.nl
  local all = nl.scan_windows(buf, nil)
  local out, n = {}, 0
  local i
  for i = 1, table.getn(all) do
    if all[i][2] - all[i][1] <= nl.PX_WIN_MAX then
      n = n + 1
      out[n] = all[i]
    end
  end
  local lo, hi = nl.BACKSTOP_LO, nl.BACKSTOP_HI
  if lo == nil or hi == nil or lo >= hi then lo, hi = 0, nl.DRAM_END end
  n = n + 1
  out[n] = { lo, hi }
  return out
end

-- One budgeted slice of the search, resumable across frames.
--
-- THE NEEDLE IS THE FREQUENCY AXIS, and the reason is a one-frame lag that nothing else can be
-- made robust against.
--
-- The obvious needle is the decibels the fill has just written: db[1], db[2], db[3] go into
-- consecutive slots, so four of them confirm a stride the way four sentinels do. It does not
-- work from inside a frame. An append does not write the trace ring -- it pushes a 28-byte
-- record into a buffer-side STAGING ring and posts a message, and the display task copies it
-- across only when it runs, which is while the Lua thread is blocked. So at the end of a fill
-- the staging ring holds this pass and the trace ring still holds the LAST one.
--
-- Measured 2026-11-09, sweeping the window the ring is in with the frame's own decibels: the
-- slice holding the staging ring confirmed at a 28-byte stride, and the slice holding the trace
-- ring confirmed nothing. probe_ringfind met the same thing from the other side and answered it
-- with delay(1.5) after appending, which a frame cannot afford.
--
-- The frequencies have no lag. nl.reduce fixes them as an affine series the primitive derives
-- before its segment loop and then caches, so hz is the same series bit for bit in every frame
-- and every pass -- and the ascending lap writes hz[j], hz[j+1], hz[j+2] into consecutive
-- records whichever pass wrote them. A slice over the ring confirms in any frame, however far
-- behind the display task is.
--
-- EVERY confirmed geometry from the slice is returned, not the first.
--
-- A hit confirms at more than one stride, and the first one is the wrong one: the staging ring
-- carries the same floats in the same order in a 28-byte record, and 28 comes first in the
-- REC_MIN..REC_MAX walk. Only the header tells them apart, so returning the first confirmation
-- and discarding it when it has no header throws away the real geometry found in the same slice
-- and moves the cursor past it -- 981 MB swept and reported absent, measured.
--
-- An empty list means the budget ran out with nothing, and the cursor is left where it stopped.

-- Which four columns to look for, and the eight bytes to look for them with.
--
-- A frequency of zero packs to four zero bytes, and eight zero bytes are everywhere in memory
-- -- including two words inside every record of the ring itself. So the column is chosen for
-- the bit pattern it gives rather than taken from the start of the band: the most non-zero
-- bytes wins, and four consecutive columns have to be distinct or no stride can be confirmed.
function fftsa.nl.px_xneedle(hz, nseg)
  if hz == nil or nseg == nil or nseg < 8 then return nil end
  local best, bestscore = nil, -1
  local j
  for j = 1, nseg - 3 do
    local p = f32_pack(hz[j])
    local score, k = 0, nil
    for k = 1, 4 do
      if string.byte(p, k) ~= 0 then score = score + 1 end
    end
    if hz[j] == hz[j + 1] or hz[j + 1] == hz[j + 2] or hz[j + 2] == hz[j + 3] then
      score = -1
    end
    if score > bestscore then best, bestscore = j, score end
  end
  if best == nil or bestscore < 1 then return nil end
  local xs, i = {}, nil
  for i = 1, 4 do xs[i] = f32_pack(hz[best + i - 1]) end
  return xs, best
end

-- Four consecutive records holding four known frequencies, read as one block: a wrong stride
-- costs one memread.
function fftsa.nl.px_xconfirm(xat, stride, xs)
  local n = table.getn(xs)
  local span = (n - 1) * stride + 8
  local blk = ki.memread(hx(xat), hx(span))
  if blk == nil or string.len(blk) < span then return nil end
  local i
  for i = 1, n do
    local at = (i - 1) * stride + 1
    if string.sub(blk, at, at + 7) ~= xs[i] .. xs[i] then return nil end
  end
  -- val0 is the x field, and dx is zero because this confirmed on the x and nothing else. The
  -- header check reads both as "a field at this offset, which must fit inside a record", which
  -- is all it needs; px_map derives the value field for itself.
  return { val0 = xat, stride = stride, dx = 0, nconf = n }
end

function fftsa.nl.px_seek(hz, nseg, budget, buf)
  local nl = fftsa.nl
  local p = nl.px
  local out, nout = {}, 0
  -- The name first. It is longer, it is unique to this app, and it is in memory whatever the
  -- display task and the spectrum are doing -- see px_from_name. The frequency series stays as
  -- the second needle, for a build that does not keep the name where this can reach it.
  local n1 = nl.PX_NAME .. string.char(0)
  local byname, xs = true, nil
  if p.noname then
    local j
    xs, j = nl.px_xneedle(hz, nseg)
    byname = false
    if xs == nil then
      p.degen = (p.degen or 0) + 1
      return out
    end
    p.xcol = j
    n1 = xs[1] .. xs[1]
  end
  if p.wins == nil then
    p.wins = nl.px_windows(buf)
    p.wi, p.at, p.swept = 1, p.wins[1][1], p.swept or 0
  end
  local left = budget
  while left > 0 do
    local w = p.wins[p.wi]
    if w == nil then
      -- The ladder is spent. The name found nothing, so the next lap uses the other needle --
      -- and if that fails too, laps simply counts how many times round it has been.
      p.wins, p.wi, p.at = nil, nil, nil
      p.laps = (p.laps or 0) + 1
      if byname then p.noname = true end
      return out
    end
    if p.at == nil or p.at < w[1] or p.at + 8 > w[2] then
      p.wi = p.wi + 1
      p.at = nil
      if p.wins[p.wi] ~= nil then p.at = p.wins[p.wi][1] end
    else
      local lo = p.at
      local hi = lo + left
      if hi > w[2] then hi = w[2] end
      local h = nl.FINDS(lo, hi, n1)
      p.swept = p.swept + (hi - lo)
      left = left - (hi - lo)
      -- Overlap by the needle's tail, or a record straddling a slice edge is never matched.
      -- Past the window's end this leaves at+8 above w[2], which advances the window above.
      p.at = hi - 7
      local k, sv
      for k = 1, table.getn(h) do
        p.hits = (p.hits or 0) + 1
        if byname then
          -- One hit, every geometry it could be, by arithmetic. No header to go looking for:
          -- the bounds come out of a bounded walk forward from the name.
          local gs = nl.px_from_name(h[k])
          local gi
          for gi = 1, table.getn(gs) do
            nout = nout + 1
            out[nout] = gs[gi]
          end
        else
          for sv = nl.REC_MIN, nl.REC_MAX, 4 do
            local g = nl.px_xconfirm(h[k], sv, xs)
            if g ~= nil then
              nout = nout + 1
              out[nout] = g
            end
          end
        end
      end
      -- Returned as soon as this slice has anything, so the header tries start on the next
      -- frame rather than after the rest of the budget.
      if nout > 0 then return out end
    end
  end
  return out
end

-- Offsets in a record where three consecutive words are equal.
--
-- The two pixel fields are the only repeating shape in the 56 bytes -- the value and the x
-- float are PAIRS -- so this finds them without knowing the layout. Overlapping offsets inside
-- one run are dropped: a y pixel of zero beside the two zero words would otherwise report a
-- second triple that is three quarters padding.
-- The offsets that are a triple in EVERY record sampled, which is what a field is.
--
-- One record is not enough. The first record of the ring is the band's first column, and at dc
-- the x float is zero and the flags beside it are zero -- so three consecutive zero words
-- appear where no field is, and a third triple is reported at the flags. Intersecting over
-- records spread through the window removes it: a real field is a triple wherever you look.
function fftsa.nl.px_triples_common(blk, nrec, stride, k)
  local step = math.floor(nrec / k)
  if step < 1 then step = 1 end
  local keep, s = nil, nil
  for s = 1, nrec, step do
    local tr = fftsa.nl.px_triples(string.sub(blk, (s - 1) * stride + 1, s * stride), stride)
    if keep == nil then
      keep = tr
    else
      local both, n, i, j = {}, 0, nil, nil
      for i = 1, table.getn(keep) do
        for j = 1, table.getn(tr) do
          if keep[i] == tr[j] then
            n = n + 1
            both[n] = keep[i]
          end
        end
      end
      keep = both
    end
    if table.getn(keep) == 0 then return keep end
  end
  if keep == nil then keep = {} end
  return keep
end

function fftsa.nl.px_triples(rec, stride)
  local out, n, prev = {}, 0, nil
  local o
  for o = 0, stride - 12, 4 do
    local a = u32_at(rec, o + 1)
    if a == u32_at(rec, o + 5) and a == u32_at(rec, o + 9) then
      if prev == nil or o - prev > 8 then
        n = n + 1
        out[n] = o
      end
      prev = o
    end
  end
  return out
end

-- Least squares of one per-slot series against another, centred so the normal equations do not
-- cancel: 721 records of about -100 dB give a sum of squares near 5e9 against a variance term
-- near 1e7, and the centred form never forms either.
--
-- Returns slope, intercept, worst residual, the span of the independent variable, the count,
-- and how many of them fall within tol. nil when fewer than eight slots are usable or the
-- independent variable does not vary -- a constant field fits everything and must never be
-- taken as a map.
--
-- THE INLIER COUNT IS WHAT CALLERS JUDGE ON, not the worst residual: a single word that is not
-- a pixel moves the worst residual by seven orders of magnitude. px_words drops the word that
-- caused that one, and this is the second line of defence for whatever the first one misses.
function fftsa.nl.px_fit(ys, xs, n, tol)
  local sx, sy, m = 0, 0, 0
  local xlo, xhi = nil, nil
  local s
  for s = 1, n do
    if xs[s] ~= nil and ys[s] ~= nil then
      sx = sx + xs[s]
      sy = sy + ys[s]
      m = m + 1
      if xlo == nil or xs[s] < xlo then xlo = xs[s] end
      if xhi == nil or xs[s] > xhi then xhi = xs[s] end
    end
  end
  if m < 8 or xlo == nil or xhi <= xlo then return nil end
  local mx, my = sx / m, sy / m
  local sxx, sxy = 0, 0
  for s = 1, n do
    if xs[s] ~= nil and ys[s] ~= nil then
      local dx = xs[s] - mx
      sxx = sxx + dx * dx
      sxy = sxy + dx * (ys[s] - my)
    end
  end
  if sxx <= 0 then return nil end
  local a = sxy / sxx
  local b = my - a * mx
  local worst, nin = 0, 0
  for s = 1, n do
    if xs[s] ~= nil and ys[s] ~= nil then
      local e = a * xs[s] + b - ys[s]
      if e < 0 then e = -e end
      if e > worst then worst = e end
      if tol == nil or e <= tol then nin = nin + 1 end
    end
  end
  return a, b, worst, xhi - xlo, m, nin
end

-- One record field across the window, as a per-slot array. Words for a pixel triple, float32
-- for a value or a frequency. A word outside PX_PIX_MAX comes back nil, so the fit skips it
-- rather than being dragged across the plot by it.
function fftsa.nl.px_words(blk, nrec, stride, o)
  local out, s, hi = {}, nil, fftsa.nl.PX_PIX_MAX
  for s = 1, nrec do
    local w = u32_at(blk, (s - 1) * stride + o + 1)
    if w <= hi then out[s] = w end
  end
  return out
end

function fftsa.nl.px_floats(blk, nrec, stride, o)
  local out, s = {}, nil
  for s = 1, nrec do
    out[s] = f32_unpack(blk, (s - 1) * stride + o + 1)
  end
  return out
end

-- Everything the frame needs, solved once from the ring the appends have already filled: which
-- slot carries which column, which triple is the decibel axis, and the map onto it. Returns true
-- when all of it stands up.
--
-- NOTHING HERE DEPENDS ON WHICH FRAME WROTE A RECORD, which is what makes it safe to run while
-- the display task is an unknown distance behind. Every term is either a frequency -- the same
-- series in every pass -- or a comparison between two fields of the SAME record:
--
--   the slot map        the x field against this plan's own frequencies, exact float32
--   which triple is x   the x triple against the x field in the same record, affine by
--                       construction, so it fits to half a pixel and the y triple does not
--   which triple is y   whichever one is left, there having to be exactly one
--   the decibel map     the y triple against the value field in the same record
--   the value field     the offset the y triple turns out to be affine in, over a wide
--                       enough span to have fitted a slope at all
--
-- THE SLOT MAP IS AN EXACT FLOAT32 MATCH, not a nearest-frequency search, and 721 exact matches
-- against a 255-member set is also the confirmation that this is the right ring: nothing else in
-- memory is a permutation of the app's own axis.
function fftsa.nl.px_map(g, db, hz, nseg)
  local nl = fftsa.nl
  local p = nl.px
  p.why = nil
  if g == nil or g.lo == nil or g.hi == nil or g.nrec == nil or g.hdr == nil then
    p.why = 'no ring geometry to map'
    return false
  end
  local stride, ox = g.stride, g.ox
  if stride == nil or stride < nl.REC_MIN then
    p.why = 'record stride ' .. tostring(stride) .. ' is not usable'
    return false
  end
  if ox ~= nil and ox + 8 > stride then
    p.why = 'x field at ' .. tostring(ox) .. ' does not fit a ' .. tostring(stride)
            .. '-byte record'
    return false
  end
  -- ONLY THE DRAWN WINDOW, which is not the whole ring.
  --
  -- The ring is 721 records and the header reported count 510 with oldest at the ring start:
  -- the trace buffer is FILL_CONTINUOUS at a capacity of exactly one pass, so the cursor
  -- returns to slot 1 every pass and the task mirrors it. The 211 records past the count have
  -- never been written and mapping them finds no frequency in them. Measured 2026-11-09.
  local lo = nl._wg(g.hdr + nl.HDR_OLD)
  local cnt = nl._wg(g.hdr + nl.HDR_COUNT)
  if lo == nil or cnt == nil or cnt < nl.RING_MIN or cnt > g.nrec then
    p.why = 'header count ' .. tostring(cnt) .. ' is not 8..' .. tostring(g.nrec)
    return false
  end
  if lo < g.lo or lo + cnt * stride > g.hi or math.mod(lo - g.lo, stride) ~= 0 then
    p.why = 'the drawn window ' .. hx(lo) .. '+' .. tostring(cnt)
            .. ' is not inside the ring'
    return false
  end
  local span = cnt * stride
  -- THE ONE BOUNDS TEST BEFORE ANYTHING IS WRITTEN. px_frame writes the whole block with a
  -- plain ki.memwrite, which is memcpy and validates nothing, so the range is checked here --
  -- once, where a refusal costs a fallback rather than a frame -- against the same backstop
  -- every other write in this module answers to.
  local blo, bhi = nl.BACKSTOP_LO, nl.BACKSTOP_HI
  if blo == nil or bhi == nil or blo >= bhi then blo, bhi = 0, nl.DRAM_END end
  if lo < blo or lo + span > bhi then
    p.why = 'window ' .. hx(lo) .. '+' .. tostring(span) .. ' is outside the backstop'
    return false
  end
  local blk = ki.memread(hx(lo), hx(span))
  if blk == nil or string.len(blk) ~= span then
    p.why = 'window read gave ' .. tostring(blk ~= nil and string.len(blk) or 0)
            .. ' of ' .. tostring(span)
    return false
  end

  -- The slot map, and the confirmation, in one pass.
  local key, j = {}, nil
  for j = 1, nseg do key[f32_pack(hz[j])] = j end

  -- WHERE THE X FIELD IS, when the caller did not say. The record route finds it while
  -- confirming a stride; the name route never looks at a record, so it is derived here -- the
  -- one offset whose four bytes are a member of THIS plan's frequency series in every slot.
  -- A permutation of the app's own axis, 510 slots deep, is not something another field can
  -- imitate. The x is stored twice side by side, so the lower of the two matches wins.
  if ox == nil then
    local o, s2
    for o = 0, stride - 4, 4 do
      local all = true
      for s2 = 1, cnt do
        local b2 = (s2 - 1) * stride
        if key[string.sub(blk, b2 + o + 1, b2 + o + 4)] == nil then
          all = false
          break
        end
      end
      if all then
        ox = o
        break
      end
    end
    if ox == nil then
      p.why = 'no field in a ' .. tostring(stride) .. '-byte record holds this plan'
              .. ' frequency in all ' .. tostring(cnt) .. ' slots'
      return false
    end
    g.ox = ox
  end
  local idx, miss, s, xv = {}, 0, nil, {}
  for s = 1, cnt do
    local base = (s - 1) * stride
    local k = key[string.sub(blk, base + ox + 1, base + ox + 4)]
    if k == nil then
      miss = miss + 1
    else
      idx[s] = k
      xv[s] = hz[k]
    end
  end
  if miss > 0 then
    -- Ordinary immediately after a retune or a launch: the window still holds slots the new
    -- plan has not written yet, and two frames of appends clear them. The caller retries.
    p.why = tostring(miss) .. ' of ' .. tostring(cnt)
            .. ' slots carry a frequency this plan does not have'
    return false
  end

  -- Which triple is which. The x pixel is an affine function of the x field in the same record
  -- whatever the spectrum does, so it is the one that can be named first; the y pixel is a
  -- function of the decibels, which are not affine in frequency unless the trace is a straight
  -- line. Never test any of this against a ramp.
  local need = nl.PX_FIT_FRAC * cnt
  local tr = nl.px_triples_common(blk, cnt, stride, 8)
  local xoff, yoff, nleft = nil, nil, 0
  local best, second = 0, 0
  local rep, i = '', nil
  for i = 1, table.getn(tr) do
    local ws = nl.px_words(blk, cnt, stride, tr[i])
    local a, b, w, sp, m, nin = nl.px_fit(ws, xv, cnt, nl.PX_RESID_MAX)
    if a == nil then
      rep = rep .. ' ' .. tostring(tr[i]) .. ':flat'
    else
      -- How far the fitted line travels across the plot, which is the term that tells the
      -- frequency axis from a trace that merely looks like a straight line.
      local rng = a * sp
      if rng < 0 then rng = -rng end
      rep = rep .. string.format(' %d:in%d/%d/%.0fpx', tr[i], nin, m, rng)
      if nin >= need and rng > best then
        second = best
        best = rng
        xoff = tr[i]
      elseif rng > second then
        second = rng
      end
    end
  end
  if xoff == nil or best < nl.PX_DRAW_MIN or best < nl.PX_DRAW_RATIO * second then
    p.why = 'the x pixel is not identified at ' .. hx(lo) .. '/' .. tostring(stride)
            .. ', triples vs frequency --' .. rep
    return false
  end
  for i = 1, table.getn(tr) do
    if tr[i] ~= xoff then
      nleft = nleft + 1
      yoff = tr[i]
    end
  end
  if nleft ~= 1 then
    p.why = tostring(nleft) .. ' triples left after the x pixel at ' .. tostring(xoff)
            .. ', need exactly 1 --' .. rep
    return false
  end

  -- The value field, and the decibel map with it: the offset the y triple is affine in. A
  -- doubled float32 is the shape, a wide span is what makes a slope mean anything, and the two
  -- zero words -- constant, so they fit nothing -- are what the span test is for.
  local yw = nl.px_words(blk, cnt, stride, yoff)
  local ov, ay, by, resid, dbspan = nil, nil, nil, nil, nil
  local o
  for o = 0, stride - 8, 4 do
    -- Never the x field. It is a doubled float32 that spans the whole band, so against a trace
    -- that happens to be flat the y triple fits it perfectly with a slope of nothing -- and the
    -- map that came out of that would put every column on one row. Measured against a fixture
    -- whose spectrum was deliberately flat.
    if o ~= ox and string.sub(blk, o + 1, o + 4) == string.sub(blk, o + 5, o + 8) then
      local vs = nl.px_floats(blk, cnt, stride, o)
      local a, b, w, sp, m, nin = nl.px_fit(yw, vs, cnt, nl.PX_RESID_MAX)
      local rng = nil
      if a ~= nil then
        rng = a * sp
        if rng < 0 then rng = -rng end
      end
      if a ~= nil and nin >= need and sp >= nl.PX_SPAN_MIN
         and rng >= nl.PX_SPAN_MIN then
        if ov ~= nil then
          p.why = 'the value field is ambiguous: ' .. tostring(ov) .. ' and ' .. tostring(o)
          return false
        end
        ov, ay, by, resid, dbspan = o, a, b, w, sp
      end
    end
  end
  if ov == nil then
    p.why = 'no value field the y triple at ' .. tostring(yoff) .. ' is affine in, over '
            .. tostring(nl.PX_SPAN_MIN) .. ' dB'
    return false
  end

  -- The pieces, sliced out of the records the app itself wrote, so the x pixels, the value, the
  -- x float and the flags stay the firmware's own. Only the middle piece is rewritten.
  local T = {}
  for s = 1, cnt do
    local base = (s - 1) * stride
    T[3 * s - 2] = string.sub(blk, base + 1, base + yoff)
    T[3 * s - 1] = string.sub(blk, base + yoff + 1, base + yoff + 12)
    T[3 * s] = string.sub(blk, base + yoff + 13, base + stride)
  end
  -- Every y a panel row can be, built once. A frame then stores table entries and formats
  -- nothing: the 19.3 ms of a per-record write was mostly string.format and string.char.
  local ytab, y = {}, nil
  local c, fl, md = string.char, math.floor, math.mod
  for y = 0, nl.PX_YMAX do
    local w = c(md(fl(y / 16777216), 256), md(fl(y / 65536), 256),
                md(fl(y / 256), 256), md(y, 256))
    ytab[y] = w .. w .. w
  end
  p.g, p.lo, p.hdr, p.stride, p.nrec = g, lo, g.hdr, stride, cnt
  p.ov, p.ox, p.yoff, p.xoff, p.nseg = ov, ox, yoff, xoff, nseg
  -- The frequency series, as the two numbers that fix it. nl.reduce forms every frequency as
  -- f0 + c * fstep and keys its own cache on exactly this pair, so an equal pair at an equal
  -- count is the same axis to the last bit. The slot map is a permutation of that axis and
  -- means nothing against another one: a retune that happened to keep nseg would otherwise
  -- draw the new spectrum at the old frequencies, correctly and silently.
  p.hz1, p.hz2 = hz[1], hz[2]
  p.ay, p.by, p.resid, p.span = ay, by, resid, dbspan
  p.idx, p.ytab, p.T, p.yb = idx, ytab, T, {}
  p.drift, p.slot, p.slotdb = 0, nil, nil
  return true
end

-- One frame. Returns the points drawn, or nil to leave the caller its append path.
--
-- tb and t are the caller's: the trace buffer and the one timestamp this frame may use. The
-- reserve-before-write discipline that keeps event 4924 off the glass lives in sg_fill, which
-- owns sg_stamp, and splitting it across two files is how a reservation comes to be recorded
-- after the write it was meant to cover.
function fftsa.nl.px_frame(db, hz, nseg, tb, t)
  local nl = fftsa.nl
  local p = nl.px
  if p.nseg ~= nseg then
    return nl.px_dropframe('nseg moved from ' .. tostring(p.nseg) .. ' to ' .. tostring(nseg))
  end
  if p.hz1 ~= hz[1] or p.hz2 ~= hz[2] then
    return nl.px_dropframe('the frequency series moved under the slot map')
  end
  local stride, nrec, lo = p.stride, p.nrec, p.lo
  -- The cursor, which says where the repaint's own append will land. Read rather than tracked:
  -- one memread of 24 bytes against a count that would drift silently if anything else ever
  -- appended.
  local h = ki.memread(hx(p.hdr), hx(24))
  if h == nil or string.len(h) < 24 then
    return nl.px_dropframe('header read gave ' .. tostring(h ~= nil and string.len(h) or 0))
  end
  -- THE WINDOW IS PUT BACK, every frame, before anything is written.
  --
  -- One append moves the task's window: count is already the whole pass, so oldest advances a
  -- record and the window slides onto slots the task has NEVER written -- 211 of the 721 in the
  -- ring are virgin, and one more would enter the drawn window every frame, to be drawn against
  -- an x pixel of zero. The trace would lose a column a frame to the left edge.
  --
  -- Putting them back immediately after the append does not work. The task consumes the staged
  -- record while the Lua thread is blocked, which may be during that very call or at the next
  -- one, so a restore written straight afterwards lands before the advance about half the time
  -- and is simply overwritten. Measured: 90 pixel frames, the window crept anyway, count
  -- reached 511. HERE it is deterministic -- a whole frame has passed, the task has certainly
  -- consumed, and the three words go back to what px_map validated.
  --
  -- The write cursor is parked one slot PAST the window on purpose. The record the append
  -- leaves there is never drawn, so its value cannot perturb the picture, and it is the one
  -- record in the ring this code never overwrites -- which is what makes it a clean place to
  -- read the firmware's own pixel back from and check the map against.
  local old0, cnt0 = u32_at(h, nl.HDR_OLD + 1), u32_at(h, nl.HDR_COUNT + 1)
  local slip = (old0 - lo) / stride
  if slip < 0 then slip = -slip end
  if slip > nl.PX_SLIP_MAX or math.mod(old0 - lo, stride) ~= 0
     or cnt0 < nrec or cnt0 > nrec + nl.PX_SLIP_MAX then
    return nl.px_dropframe('the drawn window moved from ' .. hx(lo) .. '+' .. tostring(nrec)
                           .. ' to ' .. hx(old0) .. '+' .. tostring(cnt0))
  end
  local wr = lo + nrec * stride
  local function putback(off, want)
    ki.memwrite(hx(p.hdr + off),
                string.char(math.mod(math.floor(want / 16777216), 256),
                            math.mod(math.floor(want / 65536), 256),
                            math.mod(math.floor(want / 256), 256),
                            math.mod(want, 256)))
  end
  if old0 ~= lo or cnt0 ~= nrec then
    putback(nl.HDR_OLD, lo)
    putback(nl.HDR_COUNT, nrec)
    p.restored = (p.restored or 0) + 1
  end
  putback(nl.HDR_WRITE, wr)
  -- THE MAP, CHECKED AGAINST THE FIRMWARE'S OWN ANSWER. The previous frame appended a decibel
  -- this code knows into a slot it knows, and the firmware wrote the pixel. Read it back before
  -- the block write covers it.
  if p.slot ~= nil and p.slotdb ~= nil then
    local pv = ki.memread(hx(lo + (p.slot - 1) * stride + p.yoff), hx(4))
    if pv ~= nil and string.len(pv) >= 4 then
      local e = p.ay * p.slotdb + p.by - u32_at(pv, 1)
      if e < 0 then e = -e end
      p.lastdrift = e
      if e > nl.PX_DRIFT_MAX then
        p.drift = (p.drift or 0) + 1
        if p.drift >= nl.PX_DRIFT_RUN then
          return nl.px_dropframe('the map is ' .. string.format('%.1f', e)
                               .. " px out on the firmware's own point")
        end
      else
        p.drift = 0
      end
    end
  end
  local T, ytab, idx, yb = p.T, p.ytab, p.idx, p.yb
  local ay, by, ymax = p.ay, p.by, nl.PX_YMAX
  local fl = math.floor
  local j
  for j = 1, nseg do
    local y = fl(ay * db[j] + by + 0.5)
    if y < 0 then y = 0 end
    if y > ymax then y = ymax end
    yb[j] = ytab[y]
  end
  local s
  for s = 1, nrec do
    T[3 * s - 1] = yb[idx[s]]
  end
  ki.memwrite(hx(lo), table.concat(T))
  -- The repaint. At the frequency the cursor's slot already carries, so the firmware draws the
  -- point this code would have drawn there, and its pixel is next frame's check on the map.
  --
  -- Outside the window the appended record is never drawn, which is cleaner still -- the
  -- message is posted either way -- so any column will do and the one that exists is used.
  local slot = (wr - lo) / stride + 1
  local k = idx[slot]
  if k == nil then k = 1 end
  buffer.write.reading(tb, db[k], hz[k], t, 0)
  p.slot, p.slotdb = slot, db[k]
  p.frames = (p.frames or 0) + 1
  return nseg
end

-- The cached geometry, in a global with the lifetime that suits it: the display task allocates
-- a ring per trace object, so the address holds for the life of the launch and a relaunch in
-- the same boot usually gets the same one back. px_map re-validates it from content before a
-- byte is written -- 721 exact float32 matches against the app's own axis -- so a stale cache
-- costs one ring read and falls through to the search.
function fftsa.nl.px_cache_put(g)
  FFTSA_PXRING = string.format('%d,%d,%d,%d,%d,%d',
                               g.lo, g.hi, g.nrec, g.stride, g.ox, g.hdr)
end

function fftsa.nl.px_cache_get()
  if type(FFTSA_PXRING) ~= 'string' then return nil end
  local f, n = {}, 0
  local w
  for w in string.gfind(FFTSA_PXRING, '[-0-9]+') do
    n = n + 1
    f[n] = tonumber(w)
  end
  if n ~= 6 then return nil end
  -- No value offset: px_map derives that from the ring every time, so caching it would be
  -- storing a number nothing reads against the chance of it being wrong.
  return { lo = f[1], hi = f[2], nrec = f[3], stride = f[4], ox = f[5], hdr = f[6] }
end

-- The whole path, driven one frame at a time. Returns the points drawn, or nil when the
-- caller still has to append.
function fftsa.nl.px_try(db, hz, nseg, tb, t)
  local nl = fftsa.nl
  local p = nl.px
  local st = p.state
  if st == 'off' then return nil end
  if st == 'on' then return nl.px_frame(db, hz, nseg, tb, t) end
  if nseg == nil or nseg < 8 then return nil end
  if st == 'idle' then
    local c = nl.px_cache_get()
    if c ~= nil and nl.px_map(c, db, hz, nseg) then
      p.state = 'on'
      p.from = 'cache'
      return nl.px_frame(db, hz, nseg, tb, t)
    end
    p.state = 'seek'
    return nil
  end
  if st == 'seek' then
    local c = nl.px_seek(hz, nseg, nl.PX_BUDGET, tb)
    if c == nil or table.getn(c) == 0 then return nil end
    p.cands, p.state = c, 'hdr'
    p.ncand = (p.ncand or 0) + table.getn(c)
    return nil
  end
  -- ONE HEADER SEARCH A FRAME, and every candidate gets one.
  --
  -- The header is what tells the trace ring from the 28-byte staging ring, which holds the same
  -- two float32 pairs in the same order and so confirms a stride just as well. It is a bounded
  -- scan of a few hundred kilobytes, which is a frame's worth on its own -- so the candidates
  -- are worked through one per frame rather than all in the frame that found them.
  if st == 'hdr' then
    local c = p.cands
    if c == nil or table.getn(c) == 0 then
      p.cands, p.state = nil, 'seek'
      return nil
    end
    local g = c[table.getn(c)]
    table.remove(c)
    -- A name-derived geometry already has its bounds and its header; only the record route
    -- has to go looking for one.
    if g.hdr ~= nil and g.lo ~= nil then
      g.ox = nil
      p.g, p.state, p.maptries = g, 'map', 0
      return nil
    end
    if nl.find_ring_header(g) ~= nil then
      -- val0 is the x field, so the offset the header check measured for it IS the x offset.
      -- The value field is not needed here and px_map derives it.
      g.ox = math.mod(g.val0 - g.lo, g.stride)
      p.g, p.state, p.maptries = g, 'map', 0
    else
      p.why = 'header: ' .. tostring(nl.ring_why)
    end
    return nil
  end
  if st == 'map' then
    if nl.px_map(p.g, db, hz, nseg) then
      p.state = 'on'
      p.from = 'search'
      nl.px_cache_put(p.g)
      return nl.px_frame(db, hz, nseg, tb, t)
    end
    p.maptries = (p.maptries or 0) + 1
    if p.maptries >= nl.PX_MAP_TRIES then
      -- The candidate confirmed a stride and carried a header and still will not map, so it is
      -- not this trace's ring. The other candidates from the same slice get their turn before
      -- the sweep carries on from where it stopped.
      p.g, p.state = nil, 'hdr'
    end
    return nil
  end
  return nil
end

-- The state as one field for the error and About pages.
function fftsa.nl.px_str()
  local nl = fftsa.nl
  local p = nl.px
  local o = 'px=' .. tostring(p.state)
  if p.lo ~= nil then
    o = o .. ' ring=' .. hx(p.lo) .. '/' .. tostring(p.nrec) .. 'x' .. tostring(p.stride)
        .. ' x@' .. tostring(p.xoff) .. ' y@' .. tostring(p.yoff)
        .. ' v@' .. tostring(p.ov) .. ' xf@' .. tostring(p.ox)
  end
  if p.xcol ~= nil then o = o .. ' col=' .. tostring(p.xcol) end
  if p.ay ~= nil then
    o = o .. string.format(' map=%.4f*db%+.2f r=%.2f sp=%.0f', p.ay, p.by, p.resid, p.span)
  end
  if p.frames ~= nil then o = o .. ' n=' .. tostring(p.frames) end
  if p.from ~= nil then o = o .. ' via=' .. tostring(p.from) end
  if p.swept ~= nil then
    o = o .. ' swept=' .. tostring(math.floor(p.swept / 1048576)) .. 'MB'
  end
  -- Hits and candidates, because without them a search that finds the ring and rejects it
  -- reads exactly like a search that never reached it. That is how the staging-ring stride
  -- came to look like 981 MB of absence.
  if p.hits ~= nil then o = o .. ' hit=' .. tostring(p.hits) end
  if p.ncand ~= nil then o = o .. ' cand=' .. tostring(p.ncand) end
  if p.cands ~= nil then o = o .. '/' .. tostring(table.getn(p.cands)) .. 'left' end
  if p.degen ~= nil then o = o .. ' flat=' .. tostring(p.degen) end
  if p.lastdrift ~= nil then o = o .. string.format(' d=%.1f', p.lastdrift) end
  if p.hdr ~= nil then
    local h = ki.memread(hx(p.hdr), hx(24))
    if h ~= nil and string.len(h) >= 24 then
      o = o .. ' hdr[old=' .. hx(u32_at(h, nl.HDR_OLD + 1))
          .. ' wr=' .. hx(u32_at(h, nl.HDR_WRITE + 1))
          .. ' n=' .. tostring(u32_at(h, nl.HDR_COUNT + 1)) .. ']'
    end
  end
  if p.whyframe ~= nil then o = o .. ' frame=' .. tostring(p.whyframe) end
  if p.laps ~= nil then o = o .. ' laps=' .. tostring(p.laps) end
  if p.restarts ~= nil then o = o .. ' re=' .. tostring(p.restarts) end
  if p.why ~= nil then o = o .. ' why=' .. tostring(p.why) end
  return o
end

-- ---------------------------------------------------------------------------
-- Params struct. Field order must match dsp_native_params in dsp_native.c exactly.
-- ---------------------------------------------------------------------------
function fftsa.nl.write_params(t)
  local fn = fftsa.nl.fn
  -- The word count against the struct the compiler laid out: PARAM_WORDS is a number in
  -- this file and SIZEOF_PARAMS comes out of the linked image, so this is the one check that
  -- catches a field added on one side only -- which would shift every word after it and hand
  -- dsp_native_run a valid-looking address for something else. Skipped when SIZEOF_PARAMS is
  -- zero, which is a module with no generated code to run.
  if fftsa.nl.SIZEOF_PARAMS ~= 0 and
     fftsa.nl.PARAM_WORDS * 4 ~= fftsa.nl.SIZEOF_PARAMS then
    return false
  end
  local f0h, f0l = f64_words(t.red_f0 or 0)
  local bwh, bwl = f64_words(t.red_binhz or 0)
  local dnh, dnl = f64_words(t.red_dbmin or 0)
  local dxh, dxl = f64_words(t.red_dbmax or 0)
  local vfh, vfl = f64_words(t.red_vfloor or 0)
  local w = {
    fftsa.nl.MAGIC,
    t.mode or 0,
    t.wr_lo or 0, t.wr_hi or 0,
    t.rd_lo or 0, t.rd_hi or 0,
    t.out_lo or 0, t.out_hi or 0,
    t.seg_bytes or 0, t.nsegs or 0, t.segs_addr or 0,
    t.plan_addr or 0,
    t.src_flat or 0,              -- unused: the capture is read in place
    t.cap_chunk1 or 0, t.cap_chunk2 or 0, t.cap_n or 0, t.cap_perchunk or 0,
    t.cap_stride or 32,
    t.cap_vec or 0, t.cap_nchunks or 0,
    t.out_chunk1 or 0, t.out_chunk2 or 0, t.out_perchunk or 0, t.out_desc or 0,
    fftsa.nl.STATUS_UNSET,
    fn.sin or 0, fn.cos or 0, fn.sqrt or 0,
    fn.log10 or 0, fn.floor or 0, fn.ceil or 0,
    t.init_kind or 0, t.init_beta_milli or 0,
    t.init_decim or 1, t.init_method or 0,
    t.red_nseg or 0, t.red_k0 or 0, t.red_k1 or 0,
    t.red_db or 0, t.red_hz or 0, t.red_sense or 1,
    f0h, f0l, bwh, bwl, dnh, dnl, dxh, dxl, vfh, vfl,
    t.res_addr or 0, t.res_npk or 0, t.res_mains or 0,
    -- The image writes the line of dsp_native.c that refused into fail_at. Written here as
    -- well, and zero, because that is what keeps a line from the PREVIOUS call being read as
    -- this one's; a caller has no reason to set it.
    t.fail_at or 0,
  }
  if table.getn(w) ~= fftsa.nl.PARAM_WORDS then return false end
  local parts = {}
  local i
  for i = 1, table.getn(w) do parts[i] = u32_pack(w[i]) end
  ki.memwrite(hx(fftsa.nl.params), table.concat(parts))
  return true
end

-- ---------------------------------------------------------------------------
-- Redirect ki.peek8 to a heap address, call it, and restore in both exits.
--
-- The restore writes back the pointer captured before the redirect, never a recomputed
-- one, so a failure inside the call cannot leave ki.peek8 pointing at our code.
-- ---------------------------------------------------------------------------
local function via_peek8(addr)
  local nl = fftsa.nl
  if nl.peek8_cls == 0 then return false, 'no closure' end
  -- Checked on the way in, not just at capture: the restore below is unconditional, so
  -- if this is wrong the redirect must not happen at all.
  if not nl._text_ok(nl.peek8_f) then return false, 'restore value not in .text' end
  local slot = hx(nl.peek8_cls + 12)
  local orig = string.format('%08X', nl.peek8_f)
  ki.poke32(slot, string.format('%08X', addr))
  -- No arguments. Neither the trampoline nor the image reads the Lua stack, so there is
  -- nothing to pass; both take what they need from memory Lua wrote beforehand.
  local ok, r = pcall(ki.peek8)
  ki.poke32(slot, orig)
  -- Whether the branch returned normally is all the return value can say: both pieces of
  -- native code leave zero Lua values, so r is nil either way and what they computed is
  -- read out of memory afterwards.
  fftsa.nl.last_call = ok
  if not ok then
    fftsa.nl.last_err = tostring(r)
    return false, r
  end
  fftsa.nl.last_err = nil
  return true
end
fftsa.nl._via_peek8 = via_peek8

-- Flush written code out of the D-cache and invalidate the I-cache for it.
local function flush(addr, len)
  local nl = fftsa.nl
  if nl.tramp == nil or nl.tramp == 0 then return false end
  if addr == nil or len == nil or len <= 0 then return false end
  -- Refuse to flush the trampoline's own range: icbi on a line the CPU is executing from,
  -- followed by isync, forces a re-fetch mid-function, which bluescreens. Tested line by
  -- line and not byte by byte, because the flush works in whole lines -- a range ending a
  -- few bytes short of the trampoline still invalidates its first line, and a byte test
  -- would pass that straight through.
  local tlo = nl.tramp
  if line_hi(addr, len) > line_lo(tlo) and
     line_lo(addr) < line_hi(tlo, string.len(nl._TRAMP)) then
    return false
  end
  -- The range, into the two words the trampoline loads it from. A plain store read back by
  -- a plain load on the same core, so it needs no barrier of its own.
  ki.memwrite(hx(tlo + nl.TRAMP_RANGE), u32_pack(addr) .. u32_pack(len))
  via_peek8(tlo)
  return nl.last_call == true
end
fftsa.nl.flush = flush

-- Call native code at addr and read back the status it wrote into the params struct, as a
-- signed number, or nil and a reason. Three distinct failures, each naming itself: the
-- branch raised, the word could not be read, or the word still holds STATUS_UNSET -- which
-- means the code returned without passing any exit of dsp_native_run, and that is what
-- landing in the wrong place looks like from here.
local function call_native(addr)
  local nl = fftsa.nl
  local function refuse(why)
    nl.last_err = why
    return nil, why
  end
  if nl.params == nil or nl.params == 0 then return refuse('no params') end
  if nl.STATUS_OFF == nil or nl.STATUS_OFF == 0 then return refuse('no status offset') end
  local ok, err = via_peek8(addr)
  if not ok then return nil, err end
  local s = ki.memread(hx(nl.params + nl.STATUS_OFF), hx(4))
  if s == nil or string.len(s) < 4 then return refuse('status unreadable') end
  -- WHICH test refused, read before the code is interpreted so it is kept even on the
  -- paths that return early below. A status code names the stage; the line names the test.
  nl.fail_at = nil
  if nl.FAIL_OFF ~= nil and nl.FAIL_OFF ~= 0 then
    local f = ki.memread(hx(nl.params + nl.FAIL_OFF), hx(4))
    if f ~= nil and string.len(f) >= 4 then
      local fv = u32_at(f, 1)
      if fv ~= 0 then nl.fail_at = fv end
    end
  end
  local v = u32_at(s, 1)
  if v == nl.STATUS_UNSET then return refuse('no status') end
  if v >= 2147483648 then v = v - 4294967296 end
  return v
end
fftsa.nl.call_native = call_native

-- Put ki.peek8 back. Refuses rather than writing a value that is not a .text address:
-- a restore that writes garbage is worse than no restore, because the closure still
-- works until something calls it.
function fftsa.nl.restore_peek8()
  local nl = fftsa.nl
  if nl.peek8_cls == 0 then return false end
  if not nl._text_ok(nl.peek8_f) then return false end
  ki.poke32(hx(nl.peek8_cls + 12), string.format('%08X', nl.peek8_f))
  return true
end

-- Every failure exit from nl.init comes through here, and deleting the buffers is not
-- enough: nl.entry, nl.tramp and nl.params point into chunk storage the delete frees, so a
-- later via_peek8 through a stale nl.entry would branch into whatever the allocator hands
-- out next. peek8_cls and peek8_f are kept, restore_peek8 needing them, and they are
-- firmware addresses rather than heap.
function fftsa.nl._abort(cb, pb, why)
  local nl = fftsa.nl
  -- Every caller names its own refusal. Without this the panel reports "rc=nil nil" and the
  -- nine ways init can give up before the native call are indistinguishable from each other.
  nl.why = why or 'unspecified'
  if pb ~= nil then pcall(function() buffer.delete(pb) end) end
  if cb ~= nil then pcall(function() buffer.delete(cb) end) end
  nl.ready     = false
  nl.entry     = nil
  nl.tramp     = nil
  nl.params    = nil
  nl.code_buf  = nil
  nl.code_base = nil
  nl.plan_buf  = nil
  nl.plan_addr = nil
  nl.segs_addr = nil
  return false
end

-- ---------------------------------------------------------------------------
-- Init. Called once per boot, at startup, before any frame. Once per boot is conservative
-- rather than necessary, and it stays because nothing needs a second install: nl.reinit
-- re-plans without one, so relaxing it would buy nothing and give up a backstop.
--
-- barrier_buf is accepted and validated but not used as the barrier. init fills its own code
-- buffer and barriers on that, because buffer.getstats is the barrier only when it makes the
-- service-task call, which on an empty buffer it need not -- and the caller's buffer is
-- empty more often than not.
--
-- Returns true with nl.ready set, or false with every heap-derived field nil'd.
-- ---------------------------------------------------------------------------
function fftsa.nl.init(barrier_buf, want_n, kind, beta, decim, method, want_nseg)
  local nl = fftsa.nl

  -- One install per boot, and a module field cannot enforce it: fftsa.start() calls this on
  -- every app start and a stop/restart with no power cycle reloads the script, so any flag
  -- kept in nl is gone while the heap code and its I-cache lines are not. A second install
  -- at a fresh address wedges the interpreter, the IPC barrier draining the store buffer to
  -- DRAM without invalidating the I-cache and the trampoline being unable to flush a
  -- replacement for itself. A Lua global is the only storage scoped to the boot rather than
  -- the script. NLBOOT is shared with the probes on purpose: both install heap code, so
  -- either blocks the other.
  --
  -- The first statement, ahead of nl.ready = false, so a refusal cannot damage an install
  -- that is already working: within one script session a second call would otherwise clear
  -- ready on a good install.
  if NLBOOT ~= nil then
    nl.boot_spent = true
    -- Spent means installed, not unusable: nl.reattach resumes the install this boot already
    -- made, which is what lets a relaunch run compiled at all. It validates before it
    -- believes and answers false on any doubt.
    if nl.reattach(want_n, kind, beta, decim, method) then return true end
    return nl._no('one install per boot is spent and reattach refused: the earlier '
                  .. 'install is gone or no longer validates')
  end
  nl.boot_spent = false

  nl.ready = false
  -- want_n sizes the arena, so it is the largest count the app can ask for and not the one
  -- in force: nl.reinit re-plans for anything at or below it without touching the heap,
  -- and a count above it has no arena to be planned into.
  want_n = want_n or 512
  want_nseg = want_nseg or 255

  -- Decoded once and kept: the base64 is what the archive carries, and this is the only
  -- place that turns it into bytes.
  if nl._DSP_CODE == nil and nl._DSP_CODE_B64 ~= nil then
    trace('b64', nl._DSP_CODE_B64_LEN, nl._DSP_RELOC_B64_LEN)
    nl._DSP_CODE  = b64decode(nl._DSP_CODE_B64, nl._DSP_CODE_B64_LEN)
    nl._DSP_RELOC = b64decode(nl._DSP_RELOC_B64, nl._DSP_RELOC_B64_LEN)
    trace('b64.ok', nl._DSP_CODE ~= nil and string.len(nl._DSP_CODE) or 'nil')
  end
  if nl._DSP_CODE == nil or string.len(nl._DSP_CODE) == 0 then
    return nl._no('native_code.tsp did not load: no image')
  end
  if nl._DSP_RELOC == nil then
    return nl._no('native_code.tsp did not load: no relocation table')
  end
  -- Zero or nil means the generated module never loaded, and every size below would then be
  -- wrong in a way that still produces addresses. PARAMS_SLOT and STATUS_OFF are in the list
  -- because without them the image gets no params address and reports nothing, which is a
  -- call into code whose one pointer is zero.
  if nl.SIZEOF_REAL == 0 or nl.SIZEOF_PLAN == 0 or nl.SIZEOF_PARAMS == 0 or
     nl.RES_DOUBLES == 0 or nl.RES_PEAKS == 0 or
     nl.PARAMS_SLOT == nil or nl.PARAMS_SLOT == 0 or
     nl.STATUS_OFF == nil or nl.STATUS_OFF == 0 then
    return nl._no('generated sizes are zero or nil: real=' .. tostring(nl.SIZEOF_REAL)
                  .. ' plan=' .. tostring(nl.SIZEOF_PLAN) .. ' params='
                  .. tostring(nl.SIZEOF_PARAMS) .. ' slot=' .. tostring(nl.PARAMS_SLOT)
                  .. ' status=' .. tostring(nl.STATUS_OFF))
  end

  -- No array has to fit a chunk whole: dsp_plan_init_segs cuts one too long for a segment
  -- into slices, and the transform reads the capture in place. What bounds n is the chunk
  -- count dsp_plan_segs reports at step 7 against DSPN_MAX_SEGS, and a count needing more is
  -- refused there. DSP_N_MAX is the library's own ceiling.
  local nmax = 65536
  nl.nceil = nmax
  -- The plan struct has a chunk to itself, which is the one size still checked here.
  if align8(nl.SIZEOF_PLAN) + 32 > nl.CHUNK_BYTES then
    trace('size.plan', nl.SIZEOF_PLAN)
    return nl._no('plan struct of ' .. tostring(nl.SIZEOF_PLAN)
                  .. ' bytes does not leave a chunk room for alignment')
  end
  -- Two arrays of want_nseg dsp_real share the reduction chunk with the results block,
  -- whose size is fixed by the image. DSPN_RES_BYTES in dsp_native.c, computed from the
  -- same two figures rather than sent across as a third.
  local res_bytes = nl.RES_DOUBLES * 8 + nl.RES_PEAKS * 4
                    + 2 * nl.RES_PEAKS * nl.SIZEOF_REAL
  nl.nseg_ceil = math.floor((nl.CHUNK_BYTES - 32 - res_bytes) / (2 * nl.SIZEOF_REAL))
  if want_n > nmax or want_nseg < 2 or want_nseg > nl.nseg_ceil then
    trace('size.refused', want_n, want_nseg)
    return nl._no('size refused: n=' .. tostring(want_n) .. ' max=' .. tostring(nmax)
                  .. ' nseg=' .. tostring(want_nseg) .. ' ceil=' .. tostring(nl.nseg_ceil))
  end

  -- 1. Firmware math addresses. All six are needed; dsp.c calls every one.
  trace('math')
  local nmath = nl.resolve_math()
  if nmath < 6 then
    return nl._no('resolve_math found ' .. tostring(nmath) .. ' of 6 libm entries: glue='
                  .. tostring(nl.nglue) .. ' need>=' .. tostring(nl.GLUE_MIN)
                  .. ' mathpos=' .. tostring(nl.math_pos) .. ' odd=' .. tostring(nl.math_odd))
  end
  trace('math.ok')

  -- 2. The ki.peek8 closure, and its original f pointer.
  local s = tostring(ki.peek8)
  local _, e = string.find(s, ': ')
  if not e then return nl._no('ki.peek8 does not tostring to an address: ' .. tostring(s)) end
  local cls = tonumber(string.sub(s, e + 1), 16)
  if not cls then return nl._no('ki.peek8 address will not parse as hex: ' .. tostring(s)) end
  -- This value is written back into a live lua_CFunction pointer by every redirect, so it
  -- is validated before it is kept, and one transport read is not enough: a desynchronised
  -- socket can return a heap address here, which the restore then writes into the dispatch
  -- path. Two agreeing reads, both inside firmware .text, or refuse.
  local orig_f = W(cls + 12)
  if orig_f == nil then
    return nl._no('cannot read the ki.peek8 f pointer at ' .. hx(cls + 12))
  end
  if not fftsa.nl._text_ok(orig_f) then
    return nl._no('ki.peek8 f pointer ' .. hx(orig_f) .. ' is outside .text '
                  .. hx(nl.TEXT_LO) .. '..' .. hx(nl.TEXT_HI))
  end
  if W(cls + 12) ~= orig_f then
    return nl._no('the ki.peek8 f pointer read back differently: transport is unreliable')
  end
  nl.peek8_cls = cls
  nl.peek8_f   = orig_f

  -- 3. Code buffer. Capacity 1024 is exactly one chunk, so the span below is known to
  --    be one allocation rather than relying on how a short buffer is sized.
  local cb = buffer.make(1024, buffer.STYLE_WRITABLE_FULL)
  buffer.write.format(cb, buffer.UNIT_VOLT, buffer.DIGITS_6_5,
                      buffer.UNIT_VOLT, buffer.DIGITS_6_5)
  -- Distinct readings and distinct extras, nl.SEED_READS of each, because _find_storage
  -- confirms a hit against that many and refuses a buffer it cannot tell element from
  -- element.
  local k
  for k = 1, fftsa.nl.SEED_READS do
    buffer.write.reading(cb, 1000000 + k, 3000000 + k, k, 0)
  end

  -- The barrier uses cb, the buffer this function just filled, and not the caller's:
  -- buffer.getstats is the barrier only when it makes the service-task call, which on an
  -- empty buffer it need not, and an empty one bluescreens the instrument -- the trampoline
  -- never reaching DRAM, the I-cache filling from stale heap. fftsa.start() passes
  -- fftsa.cap, empty until the first capture, so barrier_buf is validated and not used.
  if barrier_buf ~= nil and barrier_buf.n == nil then
    return fftsa.nl._abort(cb, nil, 'the barrier buffer passed in has no n: it is not a '
                           .. 'live reading buffer')
  end
  local bar = cb
  if bar.n == nil or bar.n < 1 then
    return fftsa.nl._abort(cb, nil, 'the code buffer seeded to ' .. tostring(bar.n)
                           .. ' readings, so buffer.write.reading is not storing')
  end
  buffer.getstats(bar)

  trace('scan.code')
  -- true: cb is STYLE_WRITABLE_FULL, seeded with distinct readings and distinct extras.
  local code_base, code_stride = nl._find_storage(cb, true)
  if code_stride ~= nil and code_stride ~= 32 then
    -- The layout below places the trampoline and the params struct by byte offset inside
    -- this chunk, which holds whatever the element size is -- but a WRITABLE_FULL element
    -- of anything but 32 means the measured layout has moved.
    trace('code.stride.BAD', code_stride)
    return fftsa.nl._abort(cb, nil, 'the code buffer element is ' .. tostring(code_stride)
                           .. ' bytes, not 32, so the trampoline and params layout inside '
                           .. 'its chunk has moved')
  end
  if not code_base then
    return fftsa.nl._abort(cb, nil, 'code buffer: no storage found -- '
                           .. tostring(nl._stor_why) .. ' inst=' .. hx(nl.inst or 0)
                           .. ' ' .. fftsa.nl.windows_str())
  end
  trace('code_base', hx(code_base))
  nl.code_buf  = cb
  nl.code_base = code_base

  -- 4. Layout, derived from the image rather than fixed: the image is tens of kilobytes, so
  --    a trampoline at a fixed +256 would sit inside it.
  --
  -- The trampoline starts on a cache line, aligned on the absolute address so it holds
  -- whatever the chunk payload is aligned to. The image's flush rounds up to a whole line
  -- and the image ends wherever the compiler leaves it, so without this, flushing the image
  -- invalidates the trampoline's first line while the CPU is fetching from it. nl.flush
  -- refuses that case as well, so a layout mistake costs an unflushed image.
  local img_span   = align8(nl._DSP_RELOC_BSS_HI)
  if img_span < align8(string.len(nl._DSP_CODE)) then
    img_span = align8(string.len(nl._DSP_CODE))
  end
  local tramp_at   = align32(code_base + img_span)
  local params_at  = tramp_at + align8(string.len(nl._TRAMP))
  local span       = (params_at - code_base) + nl.PARAM_WORDS * 4
  if span > nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, nil, 'the image, trampoline and params need '
                           .. tostring(span) .. ' bytes of a ' .. tostring(nl.CHUNK_BYTES)
                           .. '-byte chunk')
  end
  nl.params = params_at
  trace('layout', hx(tramp_at), hx(params_at))

  -- 5. Trampoline first, so later writes can be flushed properly. Its own first execution
  --    rides on the IPC barrier alone.
  --
  -- The boot is claimed here, before the first write rather than after the last: a failure
  -- or a wedge from this point on has still consumed the one install the boot allows, and
  -- refusing a retry that might have been safe costs a power cycle where allowing one that
  -- is not costs a wedge and a power cycle. Nothing clears NLBOOT, _abort included.
  NLBOOT = tramp_at
  trace('tramp.write', hx(tramp_at), string.len(nl._TRAMP))
  ki.memwrite(hx(tramp_at), nl._TRAMP)
  buffer.getstats(bar)

  -- Confirm the bytes are where they are expected before branching to them. A read goes
  -- through the D-cache, so this proves nothing about DRAM visibility -- the barrier's job
  -- -- but it catches a write that landed elsewhere, which otherwise costs a bluescreen.
  local back = ki.memread(hx(tramp_at), hx(string.len(nl._TRAMP)))
  if back ~= nl._TRAMP then
    trace('tramp.readback.BAD', (back == nil) and 'nil' or string.len(back))
    return fftsa.nl._abort(cb, nil, 'the trampoline read back '
                           .. ((back == nil) and 'nil' or tostring(string.len(back)))
                           .. ' bytes of ' .. tostring(string.len(nl._TRAMP))
                           .. ' at ' .. hx(tramp_at) .. ': the write landed elsewhere')
  end
  trace('tramp.readback.ok')

  nl.tramp = tramp_at
  -- The trampoline is never flushed, and nl.flush refuses a range covering it: icbi on a
  -- line the core is executing from, followed by isync, re-fetches the instruction stream
  -- mid-function, which bluescreens at trampoline+64. It needs no flush either -- the
  -- barrier above puts the bytes in DRAM and a line not instruction-fetched since boot
  -- fills from there.
  trace('tramp.ok')

  -- 6. The image, patched for this load address.
  local img, err = nl.relocate(nl._DSP_CODE, nl._DSP_RELOC, code_base,
                               nl._DSP_RELOC_BSS_HI)
  if img == nil then
    return fftsa.nl._abort(cb, nil, 'relocation refused: ' .. tostring(err))
  end
  trace('img.reloc', string.len(img))
  -- The params address into the word the image reads it from, patched into the bytes before
  -- they are written so the image is never in memory with the slot unset. The offset comes
  -- from the linked image's symbol, so it follows a rebuild.
  if nl.PARAMS_SLOT == nil or nl.PARAMS_SLOT == 0 or
     nl.PARAMS_SLOT + 4 > string.len(img) then
    trace('params.slot.BAD', tostring(nl.PARAMS_SLOT))
    return fftsa.nl._abort(cb, nil, 'the params slot is ' .. tostring(nl.PARAMS_SLOT)
                           .. ' in an image of ' .. tostring(string.len(img))
                           .. ': the generated module does not match the image')
  end
  img = string.sub(img, 1, nl.PARAMS_SLOT) .. u32_pack(params_at) ..
        string.sub(img, nl.PARAMS_SLOT + 5)
  trace('params.slot', nl.PARAMS_SLOT, hx(params_at))
  ki.memwrite(hx(code_base), img)

  -- The slot read back before anything is called: it is the one pointer the image takes on
  -- trust and the entry writes a word through it, so an address that landed wrong but still
  -- inside the heap would pass the bounds test there. Four bytes to rule it out.
  local slot = ki.memread(hx(code_base + nl.PARAMS_SLOT), hx(4))
  if slot == nil or string.len(slot) < 4 or u32_at(slot, 1) ~= params_at then
    trace('params.slot.readback.BAD', (slot == nil) and 'nil' or hx(u32_at(slot, 1)))
    return fftsa.nl._abort(cb, nil, 'the params slot read back '
                           .. ((slot == nil) and 'nil' or hx(u32_at(slot, 1)))
                           .. ' and not ' .. hx(params_at) .. ': the image landed wrong')
  end
  buffer.getstats(bar)
  -- The image is a different range from the trampoline, so this is the trampoline's
  -- legitimate use. Recorded rather than ignored, because a silent failure leaves the
  -- I-cache able to serve stale lines for the image, which is a wrong answer and not a
  -- fault. Not fatal on a first install, where the image's lines have not been fetched
  -- since boot either and the barrier covers them.
  trace('img.flush')
  nl.flushed = flush(code_base, string.len(img))
  trace('img.flush.ok', tostring(nl.flushed))
  nl.entry = code_base
  trace('img.ok')

  -- 7. How many chunks the arena needs, asked of the binary rather than guessed. The arrays
  --    are laid out one per chunk by dsp_plan_init_segs, so the arena needs no contiguous
  --    memory -- which it could not have, the allocator placing chunk payloads
  --    independently. SEG_BYTES, the same value MODE_INIT gets: asking with CHUNK_BYTES
  --    would count chunks for an arena 32 bytes per segment larger than the one built.
  nl.write_params({ mode = nl.MODE_SEGS, cap_n = want_n,
                    seg_bytes = nl.SEG_BYTES,
                    init_decim = decim or 1, init_method = method or 0 })
  trace('call.segs', hx(code_base), hx(nl.params))
  local nseg = call_native(code_base)
  trace('call.segs.ret', tostring(nseg))
  if type(nseg) ~= 'number' or nseg <= 0 then
    -- Zero means no chunk can hold one of the arrays: the window is n * 8 bytes, so
    -- this is the bound on n rather than a failure of the mechanism.
    nl.nmax = 0
    return fftsa.nl._abort(cb, nil, 'MODE_SEGS answered ' .. tostring(nseg)
                           .. ' segments for n=' .. tostring(want_n) .. ' at '
                           .. tostring(nl.SEG_BYTES) .. ' bytes a segment: no chunk holds '
                           .. 'one of the arrays')
  end

  -- 8. Plan buffer: one chunk per segment, one for the plan struct, one for the reduction's
  --    two arrays. Three lifetimes, three chunks -- sharing the host chunk would make the
  --    largest n depend on the largest trace, and the refusal would not say which of the
  --    two sizes failed to fit.
  local chunks_wanted = nseg + 2
  local pb = buffer.make(chunks_wanted * 1024, buffer.STYLE_WRITABLE_FULL)
  buffer.write.format(pb, buffer.UNIT_VOLT, buffer.DIGITS_6_5,
                      buffer.UNIT_VOLT, buffer.DIGITS_6_5)
  for k = 1, fftsa.nl.SEED_READS do
    buffer.write.reading(pb, 2000000 + k, 4000000 + k, k, 0)
  end
  buffer.getstats(bar)

  trace('scan.plan')
  -- STYLE_WRITABLE_FULL, so it does store extra values and asking for them is safe.
  local pdesc = nl.describe(pb, true)
  if pdesc == nil or pdesc.vec == nil then
    -- Only what diag() does not already carry. nl.why is reported THROUGH diag -- it prints
    -- it as why= -- so the sweep counts, the hit list, the derived offsets, the window ladder
    -- and the word dump would all appear twice, which cost four of the thirteen lines the
    -- glass has.
    return fftsa.nl._abort(cb, pb, 'plan: ' .. tostring(nl._stor_why)
                           .. ' want=' .. tostring(chunks_wanted) .. 'ch for '
                           .. tostring(nseg) .. 'seg')
  end
  trace('plan.desc', hx(pdesc.chunk1), tostring(pdesc.nchunks))

  -- The vector has to hold the entries about to be read out of it. The chunk count is the
  -- descriptor's own field at +0x10, so this is the allocator's answer and not an inference
  -- from the capacity asked for: one entry past the end returns whatever follows in the
  -- heap, and anything that looks like a heap address passes the native backstop.
  -- Everything below lays the plan out against nl.CHUNK_BYTES, and the compiled image
  -- bounds a strided walk with DSPN_CHUNK_BYTES, so a payload of some other size cannot be
  -- used even though the descriptor is now recognised. Reported with the real figure, which
  -- is what parameterising both sides would need.
  if nl.chunk_span ~= nil and nl.chunk_span ~= nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, pb, 'this model has a ' .. tostring(nl.chunk_span)
                           .. '-byte chunk payload, not ' .. tostring(nl.CHUNK_BYTES)
                           .. ' -- elemsize=' .. tostring(pdesc.elemsize)
                           .. ' perchunk=' .. tostring(pdesc.perchunk))
  end
  if pdesc.nchunks == nil or pdesc.nchunks < chunks_wanted then
    return fftsa.nl._abort(cb, pb, 'plan buffer has ' .. tostring(pdesc.nchunks)
                           .. ' chunks, needs ' .. tostring(chunks_wanted))
  end
  nl.plan_buf = pb

  -- Chunk payload addresses from the vector. They are neither in address order nor
  -- adjacent, which dsp_plan_init_segs does not care about and nothing here may assume.
  -- Each is checked against the backstop here as well as by the native entry point, so a
  -- bad vector is a refusal from Lua rather than a status code from a call already handed
  -- it. These addresses are the allocator's own answer, read from the descriptor's chunk
  -- vector, and they are what the writable window below is derived from -- so this is a
  -- sanity check on the descriptor, not the bound that keeps a write off firmware.
  local payload = {}
  local i
  for i = 1, chunks_wanted do
    local a = W(pdesc.vec + (i - 1) * 4)
    if a == nil or a == 0 then
      return fftsa.nl._abort(cb, pb, 'chunk ' .. tostring(i) .. ' of '
                             .. tostring(chunks_wanted) .. ' is a null payload')
    end
    if a < nl.BACKSTOP_LO or a + nl.CHUNK_BYTES > nl.BACKSTOP_HI then
      return fftsa.nl._abort(cb, pb, 'chunk ' .. tostring(i) .. ' at ' .. hx(a)
                             .. ' is outside the backstop ' .. hx(nl.BACKSTOP_LO)
                             .. '..' .. hx(nl.BACKSTOP_HI))
    end
    payload[i] = a
  end

  -- Segment bases rounded up to DSP_ALIGN: the allocator guarantees 16 and dsp.c needs 32,
  -- so a raw payload is refused with DSPN_EBOUNDS half the time. The raw payloads still
  -- define the window below, the rounding losing addressable bytes and not permission.
  local segbase = {}
  for i = 1, nseg do
    segbase[i] = align32(payload[i])
    if (segbase[i] - payload[i]) + nl.SEG_BYTES > nl.CHUNK_BYTES then
      return fftsa.nl._abort(cb, pb, 'segment ' .. tostring(i) .. ': ' .. tostring(nl.SEG_BYTES)
                             .. ' bytes will not fit a chunk after 32-byte alignment')
    end
  end

  -- The first nseg chunks are the arena, then the plan struct, then the reduction's two
  -- arrays. The struct has its chunk to itself, and nothing shares it: the transform reads
  -- the capture in place, so there is no de-strided copy to place after it.
  local host      = align32(payload[nseg + 1])
  local plan_addr = host
  if (host - payload[nseg + 1]) + align8(nl.SIZEOF_PLAN) > nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, pb, 'plan struct of ' .. tostring(nl.SIZEOF_PLAN)
                           .. ' bytes will not fit a chunk')
  end

  -- dsp_reduce writes nseg entries into each of db and hz, and the trace count is a
  -- front-panel choice, so the room is for the largest the app can ask for rather than the
  -- one in force. Both are dsp_real, and SIZEOF_REAL comes out of the image.
  local red_host = align32(payload[nseg + 2])
  local red_db   = red_host
  local red_hz   = red_host + want_nseg * nl.SIZEOF_REAL
  -- The results block follows the two arrays. 8-aligned, which the native side requires
  -- because it reads and writes it as doubles: red_host is 32-aligned and both arrays are
  -- a whole number of dsp_real, so the sum is.
  local res_addr = red_hz + want_nseg * nl.SIZEOF_REAL
  if (res_addr - payload[nseg + 2]) + res_bytes > nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, pb, 'reduction arrays plus a ' .. tostring(res_bytes)
                           .. '-byte results block will not fit a chunk')
  end

  -- The segment vector itself, in the code buffer above the params struct.
  local segs_addr = nl.params + align8(nl.PARAM_WORDS * 4)
  if (segs_addr - code_base) + nseg * 4 > nl.CHUNK_BYTES then
    return fftsa.nl._abort(cb, pb, 'the ' .. tostring(nseg)
                           .. '-entry segment vector will not fit above the params struct')
  end
  local sv = {}
  for i = 1, nseg do sv[i] = u32_pack(segbase[i]) end
  trace('segs.write', hx(segs_addr), nseg)
  ki.memwrite(hx(segs_addr), table.concat(sv))

  -- The writable window has to cover every chunk of this buffer, and the chunks are
  -- scattered, so it spans from the lowest to the highest.
  local lo, hi = payload[1], payload[1]
  for i = 2, chunks_wanted do
    if payload[i] < lo then lo = payload[i] end
    if payload[i] > hi then hi = payload[i] end
  end
  nl.wr_lo = lo
  nl.wr_hi = hi + nl.CHUNK_BYTES

  -- 9. Build the plan across the chunks.
  nl.write_params({
    mode = nl.MODE_INIT,
    wr_lo = nl.wr_lo, wr_hi = nl.wr_hi,
    rd_lo = nl.wr_lo, rd_hi = nl.wr_hi,
    out_lo = nl.wr_lo, out_hi = nl.wr_hi,
    seg_bytes = nl.SEG_BYTES, nsegs = nseg, segs_addr = segs_addr,
    plan_addr = plan_addr, cap_n = want_n,
    init_kind = kind or 1,
    init_beta_milli = math.floor((beta or 0) * 1000),
    init_decim = decim or 1, init_method = method or 0,
  })
  trace('call.init')
  local rc = call_native(code_base)
  trace('call.init.ret', tostring(rc))
  nl.last_rc = rc
  if rc ~= 0 then
    return fftsa.nl._abort(cb, pb, 'MODE_INIT refused with rc=' .. nl.rc_name(rc))
  end

  nl.plan_addr = plan_addr
  nl.seg_bytes = nl.SEG_BYTES
  nl.nsegs     = nseg
  nl.segs_addr = segs_addr
  nl.red_db    = red_db
  nl.red_hz    = red_hz
  nl.res_addr  = res_addr
  nl.nseg_max  = want_nseg
  nl.kind      = kind or 1
  nl.beta      = beta or 0
  nl.decim     = decim or 1
  nl.method    = method or 0
  nl.n         = want_n
  nl.nmax      = want_n
  nl.ready     = true
  nl.stash()
  trace('done')
  return true
end

-- ---------------------------------------------------------------------------
-- Keeping an install across a relaunch.
--
-- The code, the trampoline, the params struct and the arena all live in the chunk storage of
-- two reading buffers, and a reading buffer outlives the script that made it. So a relaunch
-- has not lost the install, only the Lua side of it: the module body rebuilds fftsa.nl and
-- takes every address with it. Nothing but a power cycle clears a global, which is where
-- NLBOOT already lives, so the addresses go beside it. That is what lets a second launch in
-- one power cycle run compiled, and it needs no second install, so the hazard the
-- one-install-per-boot rule exists for never arises.
--
-- Scalars, the two buffer handles, and fn, which holds the resolved firmware math addresses.
-- Functions are deliberately not copied: they have to come from the module being loaded, or
-- a relaunch would run the previous build's Lua.
--
-- _stor_of goes too, and it is the capture buffer's handle rather than one of this module's,
-- because it is describe()'s cache key. The address that cache holds is a number and
-- survives anyway, but without the key the `_stor_of == buf` test fails and describe()
-- discards a still-valid address to sweep the heap again. Safe because apply() keeps that
-- buffer for the power cycle, so its storage cannot have moved, and a handle for a buffer
-- that did go compares unequal to the live one.
function fftsa.nl.stash()
  local nl, out = fftsa.nl, {}
  local k, v
  for k, v in pairs(nl) do
    local t = type(v)
    if t == 'number' or t == 'string' or t == 'boolean' then
      out[k] = v
    elseif k == 'fn' and t == 'table' then
      local fn, k2, v2 = {}, nil, nil
      for k2, v2 in pairs(v) do
        if type(v2) == 'number' then fn[k2] = v2 end
      end
      out[k] = fn
    elseif k == 'code_buf' or k == 'plan_buf' or k == '_stor_of' then
      out[k] = v
    end
  end
  NLSTASH = out
  return true
end

-- A buffer the firmware has dropped raises on a capacity read, which is the only liveness
-- test there is: the handle itself goes on answering.
local function buf_alive(b)
  if b == nil then return false end
  local ok, cap = pcall(function() return b.capacity end)
  return ok and type(cap) == 'number' and cap > 0
end

-- Resume the install this boot already made. Returns true with nl.ready set, or false
-- having changed nothing that matters.
--
-- Four things are checked before any of it is believed, the alternative to a refusal being
-- a call into whatever now occupies those addresses:
--
--   1. both buffers are still alive, so their chunk storage is still this module's
--   2. the trampoline's own bytes still match the literal this module carries
--   3. the params address still sits in the image's slot
--   4. reinit, which calls the installed code, returns a zero status
--
-- 2 matters most: it reads the heap where the image was written and compares it with what
-- was written there, so an overwritten image fails before anything is called.
function fftsa.nl.reattach(want_n, kind, beta, decim, method)
  local nl = fftsa.nl
  local s = NLSTASH
  if type(s) ~= 'table' then return false end
  -- Everything the checks below need, from the stash rather than from nl: the stash is what
  -- the install actually used, and a relaunch reloads the modules in an order this has no
  -- business depending on.
  if s.entry == nil or s.params == nil or s.tramp == nil or s.code_base == nil
     or s.PARAMS_SLOT == nil or s.TRAMP_RANGE == nil or s._TRAMP == nil then
    return false
  end
  if not buf_alive(s.code_buf) or not buf_alive(s.plan_buf) then
    trace('reattach.dead')
    return false
  end
  -- The trampoline's code, byte for byte, read back rather than trusted -- every byte
  -- except the two range words at nl.TRAMP_RANGE, which are its arguments: nl.flush writes
  -- the address and the length into them before each call, so the zeros the literal carries
  -- there are stale from the first flush onwards. One-based here, so the words occupy
  -- TRAMP_RANGE+1 through TRAMP_RANGE+8 and the code resumes at TRAMP_RANGE+9.
  local want = s._TRAMP
  local got = ki.memread(hx(s.tramp), hx(string.len(want)))
  local head, tail = s.TRAMP_RANGE, s.TRAMP_RANGE + 9
  if string.len(got) ~= string.len(want)
     or string.sub(got, 1, head) ~= string.sub(want, 1, head)
     or string.sub(got, tail) ~= string.sub(want, tail) then
    trace('reattach.tramp', hx(s.tramp))
    return false
  end
  -- The params address, in the word the image reads it from.
  local slot = W(s.code_base + s.PARAMS_SLOT)
  if slot ~= s.params then
    trace('reattach.params', hx(slot or 0))
    return false
  end
  local k, v
  for k, v in pairs(s) do nl[k] = v end
  nl.ready = false
  -- And the plan, rebuilt by the code itself. A count above what the arena was sized for
  -- is refused in there, which is the same answer init would have given.
  if not nl.reinit(want_n or s.n, kind, beta, decim, method) then
    trace('reattach.replan', tostring(nl.last_rc))
    nl.ready = false
    return false
  end
  nl.reattached = true
  trace('reattach.ok', hx(s.entry))
  return true
end

-- ---------------------------------------------------------------------------
-- Re-plan without reinstalling.
--
-- Only MODE_INIT depends on the sample count, the window and the beta, and all three are
-- front-panel choices. The code, the trampoline, the params struct and the arena are where
-- init left them, so a press costs one write_params and one call rather than a content
-- scan, a relocation and an install.
--
-- The arena was sized for the count init was given, so this only goes down from nl.nmax: a
-- larger count has no arena to be planned into and is refused here rather than left to
-- dsp_plan_init_segs, which would zero the plan and answer with a status code.
--
-- nl.ready is cleared for the duration, or a frame dispatched from the timer between the
-- write and the return would run against a plan being rebuilt under it.
-- ---------------------------------------------------------------------------
function fftsa.nl.reinit(want_n, kind, beta, decim, method)
  local nl = fftsa.nl
  if nl.entry == nil or nl.entry == 0 then return false end
  if nl.plan_addr == nil or nl.segs_addr == nil or nl.nsegs == nil then return false end
  want_n = want_n or nl.n
  if nl.nmax == nil or want_n > nl.nmax or want_n < 2 then return false end
  kind   = kind or nl.kind
  beta   = beta or nl.beta
  decim  = decim or nl.decim
  method = method or nl.method

  nl.ready = false
  local ok = nl.write_params({
    mode = nl.MODE_INIT,
    wr_lo = nl.wr_lo, wr_hi = nl.wr_hi,
    rd_lo = nl.wr_lo, rd_hi = nl.wr_hi,
    out_lo = nl.wr_lo, out_hi = nl.wr_hi,
    seg_bytes = nl.seg_bytes, nsegs = nl.nsegs, segs_addr = nl.segs_addr,
    plan_addr = nl.plan_addr, cap_n = want_n,
    init_kind = kind,
    init_beta_milli = math.floor(beta * 1000),
    init_decim = decim, init_method = method,
  })
  if not ok then return false end
  local rc = call_native(nl.entry)
  nl.last_rc = rc
  if rc ~= 0 then return false end
  nl.n      = want_n
  nl.kind   = kind
  nl.beta   = beta
  nl.decim  = decim
  nl.method = method
  nl.ready  = true
  return true
end

-- ---------------------------------------------------------------------------
-- Run one frame. Returns the trace point count, which is what the app reports as nseg, or
-- nil with nl.last_rc set. Not the bin count: the run ends in dsp_reduce.
--
-- cap and out each describe one buffer's chunk storage:
--   chunk1, chunk2   payload addresses, chunk2 zero when one chunk holds it all
--   perchunk         elements per chunk, from the descriptor
--   lo, hi           the span the native code may touch in that buffer
--   out.desc         the column descriptor base, for the cursor rewind
--
-- Chunk payloads are placed independently by the allocator -- 0x8010 is the block size and
-- not a pitch, so the second payload can sit below the first. lo and hi therefore span from
-- the lowest payload to the highest plus CHUNK_BYTES, and the native side additionally
-- requires each strided access to stay inside the chunk it starts in, the span alone
-- permitting whatever else lives between two scattered payloads.
--
-- red carries the reduction, which is everything the trace depends on and nothing the plan
-- does: nseg, the bin window k0..k1 (zero based, where the Lua implementation's bins are one
-- based), the decibel limits, the voltage floor and the bin-to-hertz map. binhz is measured
-- per frame off the capture's timestamps, so it is not a constant and is not in the plan.
-- ---------------------------------------------------------------------------
function fftsa.nl.call_dsp(cap, out, red)
  local nl = fftsa.nl
  if not nl.ready then return nil end
  if cap == nil or red == nil then return nil end
  -- The record is read in place through the chunk vector, so a descriptor without one is
  -- refused here rather than reaching the entry point as a zero address.
  if cap.vec == nil or cap.nchunks == nil or cap.nchunks < 1 then return nil end
  -- Checked here as well as natively, a refusal from dsp_native_run arriving as a status
  -- code after the params are written and reading the same as a bad address.
  local ns = red.nseg
  if ns == nil or ns < 1 or nl.nseg_max == nil or ns > nl.nseg_max then return nil end
  if red.binhz == nil or not (red.binhz > 0) then return nil end
  if red.k0 == nil or red.k1 == nil or red.k0 < 0 or red.k1 < red.k0 then return nil end
  if red.dbmin == nil or red.dbmax == nil or not (red.dbmin < red.dbmax) then return nil end
  -- out nil asks for the reduction and nothing else. The trace reaches the graph through
  -- buffer.write.reading, so the primitive has nothing to write into a reading buffer, and
  -- a descriptor of zero is what tells it so -- and so no content scan for that storage.
  local out_lo, out_hi, out_ch1, out_ch2, out_per, out_desc = 0, 0, 0, 0, 0, 0
  if out ~= nil then
    out_lo, out_hi = out.lo, out.hi
    out_ch1, out_ch2, out_per, out_desc = out.chunk1, out.chunk2, out.perchunk, out.desc
    if out_desc == nil or out_desc == 0 then return nil end
    -- The cursor rewind in the image stores at displacements compiled into it. If the
    -- descriptor was identified with offsets derived from the data and they are not those,
    -- the fields it would write belong to something else -- which is how a freed-widget
    -- bluescreen is reached. The app passes out = nil and asks for the reduction only, so
    -- this refuses a call no caller makes today rather than permitting one.
    if not nl.desc_off_ok(out) then return nil end
  end

  local ok = nl.write_params({
    mode = nl.MODE_RUN,
    wr_lo = nl.wr_lo, wr_hi = nl.wr_hi,
    rd_lo = cap.lo, rd_hi = cap.hi,
    out_lo = out_lo, out_hi = out_hi,
    seg_bytes = nl.seg_bytes, nsegs = nl.nsegs, segs_addr = nl.segs_addr,
    plan_addr = nl.plan_addr,
    cap_chunk1 = cap.chunk1, cap_chunk2 = cap.chunk2,
    cap_n = nl.n, cap_perchunk = cap.perchunk, cap_stride = cap.elemsize,
    cap_vec = cap.vec, cap_nchunks = cap.nchunks,
    out_chunk1 = out_ch1, out_chunk2 = out_ch2,
    out_perchunk = out_per, out_desc = out_desc,
    red_nseg = ns, red_k0 = red.k0, red_k1 = red.k1,
    red_db = nl.red_db, red_hz = nl.red_hz,
    red_sense = red.sense or 1,
    red_f0 = red.f0 or 0, red_binhz = red.binhz,
    red_dbmin = red.dbmin, red_dbmax = red.dbmax,
    red_vfloor = red.vfloor or 0,
    res_addr = nl.res_addr,
    res_npk = red.npk or 0,
    res_mains = red.mains or nl.MAINS_BOTH,
  })
  if not ok then return nil end

  local r = call_native(nl.entry)
  nl.last_rc = r
  if type(r) ~= 'number' or r < 0 then return nil end
  return r
end

-- ---------------------------------------------------------------------------
-- The figures the last run produced that are not the trace: the ranked peaks, and the
-- distortion and noise measurement.
--
-- One ki.memread for the whole block and a decode per value, rather than a pair of peek32
-- per double or a reading buffer of its own -- a buffer would need a chunk, a content scan
-- to find it and a window to validate, and Lua can only read as many elements as the
-- descriptor says are present, so the scalars would have to live inside the plotted trace.
--
-- The tables are allocated once and refilled, this running in a frame, and the peak tables
-- are cleared to nil past the count found so a frame that finds fewer peaks than the last
-- cannot leave a stale row on screen.
--
-- Returns nil when there is nothing to read, which is what a caller gets before the first
-- run and after a failure. thd, snr and noise are nil where the measurement did not apply:
-- 0 dB and 0% are both real answers, so the native side sends a flag per figure.
-- ---------------------------------------------------------------------------
function fftsa.nl.results()
  local nl = fftsa.nl
  if nl.res_addr == nil or nl.RES_DOUBLES == 0 then return nil end
  local nbytes = nl.RES_DOUBLES * 8
  local s = ki.memread(hx(nl.res_addr), hx(nbytes))
  if s == nil or string.len(s) ~= nbytes then return nil end
  if nl._res == nil then
    nl._res = { hz = {}, v = {} }
  end
  local r  = nl._res
  local np = nl.RES_PEAKS
  local sc = 2 * np * 8 + 1              -- first scalar, 1-based byte offset
  local npk = f64_unpack(s, sc)
  if npk == nil or npk < 0 then npk = 0 end
  if npk > np then npk = np end
  local i
  for i = 1, npk do
    r.v[i]  = f64_unpack(s, (2 * i - 2) * 8 + 1)
    r.hz[i] = f64_unpack(s, (2 * i - 1) * 8 + 1)
  end
  for i = npk + 1, np do
    r.v[i], r.hz[i] = nil, nil
  end
  r.npk   = npk
  r.thd   = nil
  r.snr   = nil
  r.noise = nil
  if f64_unpack(s, sc + 16) == 1 then r.thd   = f64_unpack(s, sc + 8)  end
  if f64_unpack(s, sc + 32) == 1 then r.snr   = f64_unpack(s, sc + 24) end
  if f64_unpack(s, sc + 48) == 1 then r.noise = f64_unpack(s, sc + 40) end
  r.f0_hz = f64_unpack(s, sc + 56)
  r.amp0  = f64_unpack(s, sc + 64)
  r.nbins = f64_unpack(s, sc + 72)
  return r
end

-- ---------------------------------------------------------------------------
-- The reduced trace the last run produced: one decibel value per segment and the frequency
-- of each, in two tables for the caller to write with buffer.write.reading.
--
-- That write is the only route onto a graph. The native side can put the same numbers into
-- the bound buffer's chunk storage and rewind its descriptor -- the buffer then reads back
-- correct from Lua and buf.n says the right count -- and the graph stays blank, because the
-- display task works from its own copy and no notify call reaches a write it never saw.
--
-- A value that does not decode to a finite number fails the whole call rather than leaving a
-- hole, a nil reaching buffer.write.reading being a posted event per point. The tables are
-- allocated once and refilled, this running in a frame: the decibels every call and the
-- frequencies only when the plan behind them moves.
-- ---------------------------------------------------------------------------
function fftsa.nl.reduce(nseg)
  local nl = fftsa.nl
  if nl.red_db == nil or nl.red_hz == nil then return nil end
  if nseg == nil or nl.nseg_max == nil or nseg < 1 or nseg > nl.nseg_max then return nil end
  -- The reduced arrays are dsp_real, so their width comes from the image rather than from
  -- here. A decoder picked for the wrong width reads a plausible wrong trace, not a
  -- refusal, so an image reporting neither width is refused outright.
  local sz = nl.SIZEOF_REAL
  local f_unpack
  if sz == 8 then f_unpack = f64_unpack
  elseif sz == 4 then f_unpack = f32_unpack
  else return nil end
  local nbytes = nseg * sz
  local sd = ki.memread(hx(nl.red_db), hx(nbytes))
  if sd == nil or string.len(sd) ~= nbytes then return nil end
  if nl._red == nil then nl._red = { db = {}, hz = {} } end
  local r = nl._red
  local db, hz = r.db, r.hz
  local i, p
  -- The frequencies are an affine series the plan fixes: the primitive forms every one as
  -- f0 + c * fstep from two numbers it derives before the segment loop, so no sample can
  -- change one and they are decoded once a plan rather than once a frame. The two elements
  -- read here are those same two numbers, so an equal pair at an equal count and address is
  -- the same series to the last bit. Asking the array rather than recomputing the series
  -- from the span keeps one owner of the arithmetic: a cache agreeing with a formula here
  -- and not with the primitive would plot the right trace against the wrong axis.
  local probe = 2 * sz
  if nseg < 2 then probe = sz end
  local sp = ki.memread(hx(nl.red_hz), hx(probe))
  if sp == nil or string.len(sp) ~= probe then return nil end
  local h1 = f_unpack(sp, 1)
  local h2 = nil
  if nseg >= 2 then h2 = f_unpack(sp, 1 + sz) end
  if h1 == nil or (nseg >= 2 and h2 == nil) then return nil end
  -- The width is in the key as well, because an image rebuilt in the other precision keeps
  -- the same arena addresses: the series would read as unchanged while every stride moved.
  if r.hz_nseg ~= nseg or r.hz_at ~= nl.red_hz or r.hz_sz ~= sz
     or r.hz_1 ~= h1 or r.hz_2 ~= h2 then
    -- Cleared before the read, so a short read or an undecodable value cannot leave the
    -- key describing a table that was only half refilled.
    r.hz_nseg, r.hz_at, r.hz_sz, r.hz_1, r.hz_2 = nil, nil, nil, nil, nil
    local sf = ki.memread(hx(nl.red_hz), hx(nbytes))
    if sf == nil or string.len(sf) ~= nbytes then return nil end
    p = 1
    for i = 1, nseg do
      local f = f_unpack(sf, p)
      if f == nil then return nil end
      hz[i] = f
      p = p + sz
    end
    r.hz_nseg, r.hz_at, r.hz_sz = nseg, nl.red_hz, sz
    r.hz_1, r.hz_2 = h1, h2
  end
  p = 1
  for i = 1, nseg do
    local v = f_unpack(sd, p)
    if v == nil then return nil end
    db[i] = v
    p = p + sz
  end
  r.nseg = nseg
  return r
end

-- ---------------------------------------------------------------------------
-- Does the derived geometry actually address the firmware's own readings?
--
-- Everything above identifies the record from two or three agreeing figures, and that is
-- enough to be confident and not enough to be sure. The element size is a RUNTIME field --
-- a sum of the widths of whatever columns a style enables, which no constant in the firmware
-- image records -- so it is per model and cannot be looked up. A DMM6500's is 24 and a
-- DMM7510 1.7.16a reads 20, and the second figure rests on a descriptor whose three geometry
-- words agree with each other. A wrong element size does not refuse: it reads the wrong bytes
-- as samples and draws a plausible, wrong spectrum.
--
-- So this asks the firmware. Element j of the record is at blk[j / perchunk] + (j % perchunk)
-- * elemsize, which is exactly what dsp_src_at computes, so checking that address against
-- buf.readings[j + 1] tests the mapping the native call will actually use:
--
--   * every chunk the record occupies, at its first element -- which pins PERCHUNK, because
--     at perchunk 1638 chunk 1 begins at reading 1639 and at 1365 it begins at 1366
--   * the last element of chunk 0 -- which pins ELEMSIZE across a whole chunk, where the
--     content scan's far indices reach element 256 and no further
--
-- Two readings and a stride confirm on a periodic input at more than one spacing; a chunk
-- boundary does not, because a wrong element size moves it by hundreds of elements.
--
-- About a dozen comparisons, at Apply and never in a frame. It costs the DMM6500 the same
-- dozen and gains it the same guarantee: the one failure this module had no symptom for was
-- a chunk mapping that reads the inter-chunk header back as samples.
fftsa.nl.GEOM_CHUNKS_MAX = 32          -- DSP_MAX_SRC_BLOCKS; a record cannot span more

-- Element sizes to try when the geometry does not fit, smallest first. Every multiple of 4
-- from a bare double to 48: the figure is a runtime sum of the widths of whatever columns a
-- style enables, so it is not drawn from a list the firmware holds and a model may use one
-- nobody has seen.
fftsa.nl.ES_CANDIDATES = { 8, 12, 16, 20, 24, 28, 32, 36, 40, 44, 48 }

-- Which element size WOULD put the right reading at the second chunk's base.
--
-- The refusal below says the geometry is wrong. This says what it probably is, which is the
-- figure a fix needs rather than the figure that failed. A chunk boundary is what makes it
-- answerable at all: perchunk is CHUNK_BYTES/elemsize, so each candidate predicts a
-- DIFFERENT reading index at the same address -- 1366 at 24 bytes, 1639 at 20 -- and only the
-- true one matches. Eleven candidates and two reads each, on the failing path only.
--
-- This is the figure that cost a session: a DMM7510 reported rc=-5 and settling the element
-- size took a hand-decoded hex dump of the descriptor and an argument about design priors.
function fftsa.nl._es_fit(buf, d)
  local nl = fftsa.nl
  if buf == nil or d == nil or d.vec == nil then return nil end
  local n = buf.n
  if type(n) ~= 'number' then return nil end
  local c1 = nl._wg(d.vec + 4)
  if c1 == nil or c1 == 0 then return nil end
  local i
  for i = 1, table.getn(nl.ES_CANDIDATES) do
    local es = nl.ES_CANDIDATES[i]
    -- Elements that fit one payload, which is what perchunk means.
    local pc = math.floor(nl.CHUNK_BYTES / es)
    if pc >= 1 and pc < n then
      local v = buf.readings[pc + 1]
      if v ~= nil and eq64(c1, v) then return es, pc end
    end
  end
  return nil
end

function fftsa.nl.geom_ok(buf, d)
  local nl = fftsa.nl
  -- Both cleared on the way in: _geom_n is how many indices were confirmed, and a stale one
  -- reads as this call having checked something when it returned before looking.
  nl._geom_why, nl._geom_n = nil, nil
  if buf == nil or d == nil then return true end
  local n, pc, es = buf.n, d.perchunk, d.elemsize
  if type(n) ~= 'number' or type(pc) ~= 'number' or type(es) ~= 'number' then return true end
  if n < 1 or pc < 1 or es < 8 then return true end
  -- Which address holds element j, by the native side's own arithmetic. blk[0] is the
  -- record's first element and not the chunk payload, which is why it is carried separately.
  local function at(j)
    local k = math.floor(j / pc)
    if k == 0 then return d.chunk1 + j * es end
    if d.vec == nil or k >= nl.GEOM_CHUNKS_MAX then return nil end
    local b = W(d.vec + k * 4)
    if b == nil or b == 0 then return nil end
    return b + math.mod(j, pc) * es
  end
  -- The indices to confirm: the first element of every chunk the record reaches, and the
  -- last element of chunk 0. Zero-based j, so reading index is j + 1.
  local want, nw = {}, 0
  local j = 0
  while j < n and nw < nl.GEOM_CHUNKS_MAX do
    nw = nw + 1; want[nw] = j
    j = j + pc
  end
  local last0 = pc - 1
  if last0 >= n then last0 = n - 1 end
  if last0 > 0 then nw = nw + 1; want[nw] = last0 end
  local i
  for i = 1, nw do
    j = want[i]
    local v = buf.readings[j + 1]
    local a = at(j)
    if v == nil then
      nl._geom_why = 'reading ' .. tostring(j + 1) .. ' of ' .. tostring(n) .. ' reads nil'
      return false
    end
    if a == nil then
      nl._geom_why = 'no chunk for element ' .. tostring(j) .. ' pc=' .. tostring(pc)
      return false
    end
    if not eq64(a, v) then
      -- Both figures and the index, because this is where a per-model element size is
      -- settled: the reading the firmware reports at an index against what is at the address
      -- es and pc put it at. es=20 and es=24 disagree first at the second chunk's base.
      nl._geom_why = 'reading ' .. tostring(j + 1) .. ' is not at ' .. hx(a)
                     .. ' for es=' .. tostring(es) .. ' pc=' .. tostring(pc)
      -- And what would fit, when that is answerable. A refusal naming the right figure is
      -- one grab; a refusal naming only the wrong one is a round trip for each guess.
      local fes, fpc = nl._es_fit(buf, d)
      if fes ~= nil then
        nl._geom_why = nl._geom_why .. ' -- fits es=' .. tostring(fes)
                       .. ' pc=' .. tostring(fpc)
      end
      return false
    end
  end
  nl._geom_n = nw
  return true
end

-- Describe a buffer's storage for call_dsp, from the content scan and descriptor walk.
-- Returns nil if either step fails, so a caller cannot build a half-filled table.
function fftsa.nl.describe(buf, has_extras)
  -- Both halves sweep the heap and both are cached, against different keys. Finding storage
  -- is keyed on the buffer, since only a replacement moves it. Finding the descriptor is
  -- keyed on the storage address, inside _find_desc, and its five words are re-read every
  -- call -- which is what makes calling describe() again cheap, and is how a chunk vector
  -- that has lengthened is picked up.
  local nl = fftsa.nl
  local elem0, stride
  -- Carried out of the signature route, which returns the descriptor with the address.
  local sdesc, selemsize, sperchunk, svec, snchunks
  if nl._stor_of == buf and nl._stor_x == has_extras and nl._stor_elem0 ~= nil then
    elem0, stride = nl._stor_elem0, nl._stor_stride
  else
    nl._stor_of, nl._stor_x, nl._stor_elem0, nl._stor_stride = nil, nil, nil, nil
    nl._stor_why = nil
    -- The signature route for a buffer with no extra values, which is the capture: its
    -- readings are whatever was on the input, and an all-identical record defeats a content
    -- scan. It answers with the descriptor too, so the second sweep is skipped. The buffers
    -- init creates are seeded distinctly and carry extras, so they keep the content route.
    if not has_extras then
      local b, e0, es, pc, v, nc = nl._find_desc_by_sig(buf)
      if b ~= nil then
        elem0, stride = e0, es
        sdesc, selemsize, sperchunk, svec, snchunks = b, es, pc, v, nc
      end
    end
    if elem0 == nil then elem0, stride = nl._find_storage(buf, has_extras) end
    if elem0 then
      nl._stor_of, nl._stor_x = buf, has_extras
      nl._stor_elem0, nl._stor_stride = elem0, stride
    end
  end
  if not elem0 then
    -- Nothing was looked for, so nothing may be reported: _find_desc never ran, and without
    -- this the error page shows the last buffer that DID reach it -- its hits, its dump, its
    -- derived offsets -- beside this buffer's storage failure.
    nl.desc_report_reset(buf)
    return nil
  end
  local desc, elemsize, perchunk, vec, nchunks = sdesc, selemsize, sperchunk, svec, snchunks
  if desc == nil then
    -- The stride goes with it: the derived route locks the element-size field against the
    -- figure the content scan measured, which is the only thing it has that is not an offset.
    desc, elemsize, perchunk, vec, nchunks = fftsa.nl._find_desc(elem0, buf, stride)
  end
  -- Each of the two halves names itself: _find_storage sets _stor_why on its own failures
  -- and clears it on the way in, so without these the caller reports "nil" for a refusal
  -- that happened here.
  if not desc then
    nl._stor_why = 'no descriptor for elem0=' .. hx(elem0) .. ' stride=' .. tostring(stride)
    return nil
  end
  -- Two independent answers to the same question, so they have to agree: the stride measured
  -- from the spacing of the readings, and the element size the descriptor states.
  -- Disagreement means one of the two is not this buffer's, and nothing below is then safe.
  if elemsize ~= stride then
    nl._stor_why = 'elemsize ' .. tostring(elemsize) .. ' disagrees with stride '
                   .. tostring(stride) .. ' at elem0=' .. hx(elem0)
    return nil
  end
  -- The window must cover every payload, and they are scattered -- the second often sits
  -- below the first -- so it spans from the lowest to the highest, the way nl.init does it.
  -- Taking hi from the second gives hi < lo, which dsp_native_run rejects as EBOUNDS.
  local ch2 = 0
  local lo  = elem0
  local hi  = elem0 + fftsa.nl.CHUNK_BYTES
  -- Every chunk the vector holds, because the native side reads the record in place and a
  -- long one spans many: 16,384 readings of 24 bytes is twelve chunks. The window is what it
  -- validates each payload address against, so a chunk left out of lo..hi is a refusal from
  -- the entry point on every frame. Bounded by the descriptor's own chunk count at +0x10 and
  -- not by the capacity asked for: one entry past the end returns whatever follows in the
  -- heap, and anything looking like a heap address would widen the window.
  if vec ~= nil and nchunks ~= nil and nchunks >= 1 then
    local i
    for i = 1, nchunks do
      local a = W(vec + (i - 1) * 4)
      if a == nil or a == 0 then
        nl._stor_why = 'chunk ' .. tostring(i) .. ' of ' .. tostring(nchunks) .. ' reads '
                       .. tostring(a) .. ' at vec=' .. hx(vec)
        return nil
      end
      if a < lo then lo = a end
      if a + fftsa.nl.CHUNK_BYTES > hi then hi = a + fftsa.nl.CHUNK_BYTES end
      if i == 2 then ch2 = a end
    end
  end
  -- Which layout this was read at travels WITH the descriptor, so a caller asking whether
  -- it may be written to is answered about the descriptor it holds rather than about
  -- whichever buffer was described last.
  local d = { chunk1 = elem0, chunk2 = ch2, perchunk = perchunk,
              elemsize = elemsize, desc = desc, vec = vec, nchunks = nchunks,
              lo = lo, hi = hi, doff = nl.doff_used, dderived = nl.desc_off }
  -- The last gate, and the only one that asks the firmware rather than the record. Refused
  -- here rather than left to the native call: a geometry that addresses the wrong bytes is
  -- not refused there, it draws a wrong spectrum.
  if not fftsa.nl.geom_ok(buf, d) then
    nl._stor_why = 'geometry does not address the readings -- ' .. tostring(nl._geom_why)
    return nil
  end
  return d
end


-- ================= tsp/native_code.tsp =================
-- native_code.tsp -- generated by tools/embed_native.py; do not edit.
--
-- The compiled PowerPC image and the relocation table that places it at its load
-- address. Concatenated after native_link.tsp, which creates fftsa.nl, and before
-- spectrum_app.tsp, which reads nl.ready.
--
-- 25328 bytes of image, 2565 relocation bytes (285 entries).

fftsa.nl._DSP_CODE_B64_LEN = 25328
fftsa.nl._DSP_CODE_B64 = table.concat({
'',
'',
'',
'',
'',
'',
'',
'',
'',
'',
'',
})

-- Relocation table and the target struct sizes, from emit_reloc.py.
fftsa.nl._DSP_RELOC_B64_LEN = 2565
fftsa.nl._DSP_RELOC_B64 = table.concat({
'',
'',
})

-- Generated by csrc/tools/emit_reloc.py; do not edit.
-- 285 relocations over a 25328-byte image.
fftsa.nl._DSP_RELOC_BSS_LO = 25328
fftsa.nl._DSP_RELOC_BSS_HI = 25356
-- struct sizes from the target compiler, not from a host build
fftsa.nl.SIZEOF_PLAN = 2504
fftsa.nl.SIZEOF_PARAMS = 220
fftsa.nl.SIZEOF_REAL = 4
fftsa.nl.DSP_ALIGN = 32
-- backstop bounds from dsp_native_bounds.h, so Lua holds no second copy
fftsa.nl.BACKSTOP_LO = 12288
fftsa.nl.BACKSTOP_HI = 268435456
-- results block: Lua reserves the memory and decodes what lands in it
fftsa.nl.RES_PEAKS = 16
fftsa.nl.RES_DOUBLES = 42
-- the word in the image the params address is patched into, and the word
-- of the params struct the call reports through
fftsa.nl.PARAMS_SLOT = 25328
fftsa.nl.STATUS_OFF = 96
-- the line of dsp_native.c that refused, so a status code names the test
fftsa.nl.FAIL_OFF = 216



-- ================= tsp/dsp_lua.tsp =================
-- dsp_lua.tsp -- the app's signal-processing interface, in a table of its own. Lua 5.0.2.
--
-- The whole data path reaches the math through one table, dsp: attributes to configure and
-- one call to run, in the style of dmm.digitize -- commit, spectrum, plan, peak,
-- distortion, release and lastevent, over dsp.fft, dsp.filter, dsp.out, dsp.peaks and
-- dsp.thd. The app cannot reach past it, so an implementation bound under the same names
-- behaves the same or not at all.
--
-- Nothing is installed at load time: the body is a function, so the gate at the head of
-- tsp/spectrum_app.tsp can decline to call it and leave a dsp the instrument already has.
--
-- Every argument the interface says is illegal is refused here too, an implementation
-- kinder than its own rules hiding the defect the rules exist to catch.

fftsa = fftsa or {}   -- the single global this app exposes

function fftsa.dsp_install()
  dsp = {}

  -- Negative, so a caller can test one answer for failure, and fixed rather than an enum
  -- the firmware might number differently.
  dsp.OK, dsp.EARG, dsp.EPOW2, dsp.ENOMEM = 0, -1, -2, -3
  dsp.EUNSUPPORTED, dsp.ESHORT, dsp.EBETA = -4, -5, -6
  dsp.EDECLINE, dsp.EALIGN, dsp.EZONE = -7, -8, -9
  -- No code in dsp.h covers a plan an attribute write has invalidated.
  dsp.EDIRTY = -10

  dsp.WINDOW_RECT, dsp.WINDOW_HANN, dsp.WINDOW_BLACKMAN = 0, 1, 2
  dsp.WINDOW_BLACKMAN_HARRIS, dsp.WINDOW_KAISER = 3, 4
  dsp.OFF, dsp.ON = 0, 1
  -- Negative, because every real selection is a frequency and so positive.
  dsp.MAINS_BOTH = -1

  dsp.version = 1

  -- Posted rather than raised, the convention throughout: a raise inside a timer or button
  -- callback posts -286 and leaves the app on screen and dead. One record and a monotonic
  -- count, so a test can assert a refusal posted and a caller can tell a fresh one from a
  -- stale one without the records accumulating across an unattended power cycle.
  dsp.events = {}
  dsp.nevents = 0
  local function post(code, why)
    dsp.nevents = dsp.nevents + 1
    dsp.events[1] = {code = code, why = why}
    return code
  end

  -- The last refusal, as a code and a reason string: what turns a negative integer into
  -- something that can go on the glass, the operator getting "-2" otherwise.
  function dsp.lastevent()
    if dsp.nevents < 1 then return nil end
    return dsp.events[1]
  end

  -- Which class an attribute is in is the whole of what a commit costs:
  --
  --   'tables'  fft.samples, fft.window, fft.beta, filter.decimate -- the window, the
  --             twiddles and the interpolation tables, or the size of the arena. 0.163 ms a
  --             sample, so a measured 2.667 s at 16384.
  --   'filter'  fft.samplerate, filter.state/lowcutoff/highcutoff/order -- no table depends
  --             on them, so a commit that only moved these builds nothing.
  --   'frame'   out.*, peaks.*, thd.* -- read per call, so a span gesture or a mains
  --             setting costs no rebuild at all.
  --
  -- A write that does not change the value dirties nothing, and fftsa.apply() rewrites every
  -- attribute unconditionally on every press and every adopted gesture: without that rule
  -- each of those forces the full rebuild above. The class is per attribute and not per
  -- namespace -- fft.samples and fft.samplerate cost two different things. One proxy a
  -- namespace, so a read crosses one metamethod and no more.
  local set_times
  local function group(settable, readback, classof)
    local store, req, p = {}, {}, {}
    local k, v
    for k, v in pairs(settable) do store[k] = v; req[k] = v end
    for k, v in pairs(readback) do store[k] = v end
    setmetatable(p, {
      __index = function(_, key) return store[key] end,
      __newindex = function(_, key, val)
        -- An unknown name is refused: a typo on a settings attribute is otherwise invisible
        -- until the spectrum looks wrong.
        if settable[key] == nil then
          post(dsp.EARG, 'not a settable attribute: ' .. tostring(key))
          return
        end
        -- Against the request, not the read-back: filter.decimate reads back the decimation
        -- chosen while the request is still 0, so comparing read-backs would make rewriting
        -- 0 look like a change from 4 and dirty the plan on every press.
        if req[key] == val then return end
        req[key] = val
        store[key] = val
        local class = classof
        if type(class) ~= 'string' then class = classof[key] end
        if class == 'frame' then
          dsp.capchecked = false    -- segments or peaks may no longer fit the buffers
        else
          if class == 'tables' then dsp.dirty_tables = true
          else dsp.dirty_filter = true end
          dsp.dirty = true
          set_times()
        end
      end,
    })
    return p, store, req
  end

  local fft_s, filter_s, out_s, peaks_s, thd_s, filter_req
  -- fft.samplerate is cheap: the rate places the taps and the band, reaching neither the
  -- window nor the twiddles. filter.decimate is expensive despite sitting among the
  -- filter's attributes, because it sizes the arena.
  dsp.fft, fft_s = group(
    {samples = 512, window = dsp.WINDOW_HANN, beta = 12, samplerate = 0},
    {srclength = 0, binwidth = 0, binzerohz = 0, binsense = 1, zone = 0,
     spectrumtime = 0, committime = 0},
    {samples = 'tables', window = 'tables', beta = 'tables', samplerate = 'filter'})
  dsp.filter, filter_s, filter_req = group(
    {state = dsp.OFF, lowcutoff = 0, highcutoff = 0, order = 0, decimate = 0},
    {ntaps = 0},
    {state = 'filter', lowcutoff = 'filter', highcutoff = 'filter', order = 'filter',
     decimate = 'tables'})
  -- dbfloor defaults to -140 because the default has to clear the quietest front end in the
  -- family: a DMM7510 measures -134 dBV on its 0.1 V range. The app sets it every frame
  -- from its own axis, so the default only matters to another caller.
  dsp.out, out_s = group({segments = 255, lowfreq = 10, highfreq = 50000,
                          dbfloor = -140, dbceil = 20, vfloor = 1e-9}, {}, 'frame')
  dsp.peaks, peaks_s = group({count = 6}, {}, 'frame')
  dsp.thd, thd_s = group({harmonics = 20, mains = dsp.MAINS_BOTH, bins = 1024}, {}, 'frame')

  dsp.dirty = true            -- no plan until commit() has run
  dsp.dirty_tables = true
  dsp.dirty_filter = true
  dsp.built = false           -- whether a plan exists at all, which release() takes away
  dsp.shortreads = 0          -- captures too short to transform, counted per the edge cases
  dsp.ran = false             -- whether a spectrum exists for peak() and distortion()
  dsp.builds = 0              -- table rebuilds a commit has done, for the cost tests

  -- 0.163 ms a sample, measured; docs/PERFORMANCE.md has it. Zero when the tables are
  -- already the ones in force, so a caller can tell a commit it must cover the screen for
  -- from one it need not.
  local function commit_cost(n)
    -- The tables are the interpreted transform's, and that module is not in the archive.
    if fftsa.fft_init == nil then return 0 end
    if dsp.dirty_tables or not dsp.built then return 0.163e-3 * (n or 0) end
    return 0
  end

  -- Seconds one spectrum() costs at the plan in force, the model docs/PERFORMANCE.md
  -- calibrates: 1.63 s at 16384 against 1.686 measured. The whole frame and not the
  -- transform alone, because that is what it was calibrated against.
  local function spectrum_cost(n)
    -- A model of the interpreted frame describes nothing without that module: zero, and
    -- frame_estimate falls through to its own floor. Modelled 0.407 s at 4096 against a
    -- compiled frame of 0.037.
    if fftsa.fft_init == nil then return 0 end
    if n == nil or n < 2 then n = 512 end
    local log2n = math.log(n) / 0.69314718055995
    return n * 46.6e-6 + 3.593e-6 * n * log2n + 0.04
  end

  set_times = function()
    fft_s.committime = commit_cost(fft_s.samples)
  end
  set_times()

  -- The enum back to the picker index: the other half of the map, fftsa.win_to_dsp, is in
  -- tsp/spectrum_app.tsp. That the two coincide today is a coincidence.
  local win_of = {}
  win_of[dsp.WINDOW_HANN] = 1
  win_of[dsp.WINDOW_BLACKMAN] = 2
  win_of[dsp.WINDOW_BLACKMAN_HARRIS] = 3
  win_of[dsp.WINDOW_KAISER] = 4

  -- One of the six betas the Lua window builder has tables for. The C library takes any
  -- beta in its range, so this is that implementation's limit and not the interface's.
  local function beta_index(b)
    local i
    for i = 1, table.getn(fftsa.kbetas) do
      if fftsa.kbetas[i] == b then return i end
    end
    return nil
  end

  local function is_pow2(n)
    if type(n) ~= 'number' or n < 4 or n > 32768 then return false end
    local t = 4
    while t < n do t = t * 2 end
    return t == n
  end

  -- The span, read per call rather than at commit, and passed to the bin-window arithmetic
  -- as arguments: fftsa.sg_window_bins is the single owner of the ceil/floor convention, so
  -- nothing about the display reaches in here and nothing here reaches back out.
  local function span_ok()
    local flo, fhi = out_s.lowfreq, out_s.highfreq
    return (fhi > flo) and (flo >= 0)
  end

  -- Build the window, the interpolation tables, the twiddles and the filter taps: the slow
  -- call, and the one a frame must never make.
  function dsp.commit()
    local n = fft_s.samples
    if not is_pow2(n) then
      return post(dsp.EPOW2, 'samples must be a power of two in 4..32768')
    end
    local kind = fft_s.window
    if kind == dsp.WINDOW_RECT then
      return post(dsp.EUNSUPPORTED, 'no rectangular window in the reference implementation')
    end
    local wi = win_of[kind]
    if wi == nil then return post(dsp.EARG, 'unknown window ' .. tostring(kind)) end
    local bi = 4
    if kind == dsp.WINDOW_KAISER then
      bi = beta_index(fft_s.beta)
      if bi == nil then return post(dsp.EBETA, 'beta ' .. tostring(fft_s.beta)) end
    end
    if not span_ok() then
      return post(dsp.EARG, 'out.lowfreq must be below out.highfreq')
    end
    if out_s.segments < 2 then return post(dsp.EARG, 'out.segments below 2') end
    if peaks_s.count < 1 then return post(dsp.EARG, 'peaks.count below 1') end

    -- The rate has to be known here: the decimation, the tap count and so srclength all
    -- follow from it, and the caller needs srclength before it acquires.
    local fs = fft_s.samplerate
    if type(fs) ~= 'number' or not (fs > 0) then
      return post(dsp.EARG, 'fft.samplerate is needed to place the band and the taps')
    end

    -- Refused rather than ignored: a filter silently left out reads as a flat passband that
    -- is really the unfiltered record aliased into the band.
    if filter_s.state ~= dsp.OFF and filter_s.state ~= false then
      return post(dsp.EUNSUPPORTED, 'no filter in this implementation')
    end
    local binhz = fs / n

    -- Set before fft_init, which keys its cache on them, and on every commit so the two
    -- cannot drift even when the rebuild below is skipped.
    fftsa.win_i, fftsa.kbeta_i = wi, bi
    -- The expensive call, and only when something it is built from moved. Guarded because
    -- tsp/fft_interp.tsp is not in the archive: a commit still has to settle srclength and
    -- the bin width for the caller about to acquire, transform or no transform.
    if (dsp.dirty_tables or not dsp.built) and fftsa.fft_init ~= nil then
      fftsa.fft_init(n)
      dsp.builds = dsp.builds + 1
    end
    -- With no filter the record the caller must acquire is the transform length itself.
    fft_s.srclength = n
    -- Provisional: spectrum() replaces it with the rate measured off the capture's own
    -- timestamps, which is the only timebase the instrument has.
    fft_s.binwidth = binhz
    fft_s.binzerohz, fft_s.binsense, fft_s.zone = 0, 1, 0
    fft_s.spectrumtime = spectrum_cost(n)
    -- Read back as no filter; the request is kept separately, so rewriting 0 is no change.
    filter_s.decimate, filter_s.ntaps = 1, 0
    dsp.nbins = n / 2
    dsp.dirty, dsp.dirty_tables, dsp.dirty_filter = false, false, false
    dsp.built = true
    dsp.ran = false
    dsp.capchecked = false
    set_times()
    return dsp.OK
  end


  -- Release the plan: the arena goes, the attributes keep their values, and nothing runs
  -- until commit() again. A plan-attribute write only marks the plan dirty, so nothing is
  -- freed outside this call and a commit that needs a different size -- which is what keeps
  -- a re-plan from opening a window with the smaller arena given back and the larger one
  -- not yet allocated. Natively the arena is one allocation, leaked for the rest of the
  -- power cycle if nobody releases it; fftsa.start() opens with the stop() that does.
  function dsp.release()
    -- Absent from the archive, so there is nothing of the interpreted arena to give back.
    if type(fftsa.dsp_release_math) == 'function' then fftsa.dsp_release_math() end
    dsp.st_v, dsp.st_f = nil, nil
    dsp.dirty, dsp.dirty_tables, dsp.dirty_filter = true, true, true
    dsp.built, dsp.ran, dsp.capchecked = false, false, false
    set_times()
    return dsp.OK
  end


  -- The transform, the peak search and the distortion figures are not in this archive:
  -- csrc/ does that work on the instrument, so package_tspa.py leaves tsp/fft_interp.tsp
  -- out and dsp.spectrum, dsp.peak and dsp.distortion are nil here -- which the app's
  -- callers test for. Bound when the harness has loaded that module, which is what keeps
  -- the arithmetic tools/test_tsp.lua pins pinned to a real implementation.
  if type(fftsa.dsp_install_math) == 'function' then
    fftsa.dsp_install_math(dsp, {post = post, span_ok = span_ok, fft_s = fft_s,
                                 out_s = out_s, peaks_s = peaks_s, thd_s = thd_s})
  end

  return dsp
end


-- ================= tsp/spectrum_app.tsp =================
-- spectrum_app.tsp -- interactive standalone spectrum analyser for the DMM6500
--
-- The touch options form and the run loop, over fft_core.tsp, spectrum_ui.tsp and
-- spectrum_graph.tsp. The stop frequency sets the sample rate -- smallest exact rate at
-- or above 2x stop, with a 100 kS/s floor -- and the start frequency only windows the
-- display.
--
-- Every screen and field is created once in start(), behind the loading cover, and
-- deleted once by stop(); a press only ever switches screens. A create/delete cycle risks
-- part of the 463-object pool for the rest of the power cycle, because a refused
-- display.delete raises nothing. The capture buffer and the frame timer are the exceptions.

fftsa = fftsa or {}   -- the single global this app exposes

-- The build, and the same figure the archive manifest carries. It heads the error page and the
-- native state on the About pages, because a failure report from a model we cannot test on is
-- worth nothing if it does not say which build produced it -- and the report arrives as a
-- screen grab, so the build has to be IN the grab. tools/check_version.py fails the build if
-- this and tools/package_tspa.py disagree.
fftsa.VERSION = '8.69'

-- Capability gate, fastest first:
--   1. the compiled PPC DSP. nl.ready is set by nl.init() from fftsa.start(), so it is
--      false here and the frame body starts on the slower path without waiting.
--   2. dsp.*, which clears sg_buf before each fill.
--
-- dsp_install may be nil, so the gate tests before calling: an instrument with neither
-- gets fftsa.dsp_absent and a refusal it can act on, not a -286 at load from calling nil.
fftsa.dsp_native = (dsp ~= nil and dsp.version ~= nil and dsp.version >= 1)
if not fftsa.dsp_native then
  if type(fftsa.dsp_install) == 'function' then
    fftsa.dsp_install()
    fftsa.dsp_native = (dsp ~= nil and dsp.version ~= nil and dsp.version >= 1)
  else
    fftsa.dsp_absent = true
  end
end

-- The window enum is not the picker index, so it is mapped both ways rather than assumed:
-- the options form and the settings line drive twenty-five sites off the index, and a
-- firmware numbering the enums differently would select the wrong window with nothing on
-- the glass to say so. Index-parallel to fftsa.win_names, so a window added to one and not
-- the other silently falls back to Hann -- the proto suite checks the lengths.
--
-- Guarded because this is load-time code and dsp can be nil: indexing it here raises -286
-- while the archive is still loading, so nothing below is ever defined and fftsa.start is
-- nil. The gate's refusal has to stay a refusal.
fftsa.win_dsp = {}
if not fftsa.dsp_absent then
  fftsa.win_dsp[1] = dsp.WINDOW_HANN
  fftsa.win_dsp[2] = dsp.WINDOW_BLACKMAN
  fftsa.win_dsp[3] = dsp.WINDOW_BLACKMAN_HARRIS
  fftsa.win_dsp[4] = dsp.WINDOW_KAISER
end

function fftsa.win_to_dsp(wi)
  local k = fftsa.win_dsp[wi or fftsa.win_i]
  if k == nil then k = fftsa.win_dsp[1] end
  return k
end

-- The app's harmonic rules, under their own names: fftsa.thd_hmax, thd_nsample and
-- thd_mains hold what the primitive reports having used.
fftsa.thd_hmax_want  = 20              -- harmonics counted; the window top usually stops first
fftsa.thd_bins_want  = 1024            -- bins sampled for the floor; 0 means every bin
-- -1 is dsp.MAINS_BOTH, written literally because dsp can be nil at load time.
fftsa.thd_mains_want = -1              -- hum discounted at 50 and at 60 Hz
if not fftsa.dsp_absent and dsp.MAINS_BOTH ~= nil then
  fftsa.thd_mains_want = dsp.MAINS_BOTH
end

-- A refusal as something that can go on the glass: the primitives post an event and return
-- a negative code, and "-2" tells an operator nothing. The code is compared as well as
-- read, because an older event still in the log is not this refusal's reason.
function fftsa.dsp_why(what, code)
  local msg = tostring(what) .. " refused (" .. tostring(code) .. ")"
  local e = dsp.lastevent()
  if e ~= nil and e.why ~= nil and e.code == code then
    msg = msg .. ": " .. tostring(e.why)
  end
  return msg
end

-- Every table, window and twiddle is sized from the selected power-of-two count.
--
-- Two defaults, chosen between in start(). Below 4096 the compiled path's frame rate is set
-- by per-frame work independent of the count, so 2048 buys twice the resolution of 1024 for
-- nothing. dsp.spectrum does scale with the count, so 1024 is what to open at without it.
--
-- 32768 is the largest the arena can serve: 26 segments against DSPN_MAX_SEGS of 32, and
-- 65536 does not lay out at all.
fftsa.n          = 1024
fftsa.n_compiled = 2048
fftsa.sample_counts = {1024, 2048, 4096, 8192, 16384, 32768}
fftsa.sample_labels = {"1024", "2048", "4096", "8192", "16384", "32768"}

-- Will the compiled path install here? It needs the blob, the sizes the generated module
-- carries, and the memory interface -- none of which depends on the firmware build, so
-- there is no version to consult. Necessary and not sufficient: the install can still
-- fail, and a boot that has spent one refuses a second. So this picks a default only, and
-- a wrong answer costs a slower first screen rather than a wrong spectrum.
function fftsa.native_likely()
  local nl = fftsa.nl
  if nl == nil then return false end
  if nl.SIZEOF_REAL == nil or nl.SIZEOF_REAL == 0 then return false end
  if nl._DSP_CODE_B64 == nil or nl._DSP_CODE_B64_LEN == 0 then return false end
  if ki == nil or ki.memwrite == nil or ki.poke32 == nil then return false end
  return true
end

-- A start of 0 would admit bin 1, which is DC and holds only window leakage once
-- fftsa.fft_load() has removed the mean.
fftsa.flomin  = 10          -- floor for the start frequency (Hz)
fftsa.flo     = 10          -- display start frequency (Hz)
fftsa.fhi     = 50000       -- display stop frequency (Hz)
fftsa.fhi_max = 500000      -- Nyquist at the fastest rate: the widest view available
fftsa.fhi_min = 500         -- well under the slowest rate, so it narrows the view, not the bin
-- A kilohertz under the stop's ceiling, so the form cannot be set to a span of nothing.
-- span_clamp holds a gesture to the same line, or a pinch high up the range could hand
-- Options a start its own field would refuse.
fftsa.flo_max = fftsa.fhi_max - 1000
fftsa.range   = 10          -- digitizer input range (V): 0.1 / 1 / 10
fftsa.fs      = 100000      -- sample rate (picked from fftsa.fhi, then measured)
fftsa.binhz   = 0           -- true bin width, from measured fs
fftsa.busy    = false       -- reentrancy guard (never preserved across a reload)
fftsa.stop_pending = false  -- a teardown deferred until the running frame ends
fftsa.retune_pending = false -- a gesture's span, waiting for its re-plan between frames
fftsa.halted  = false       -- frames suppressed after repeated failures
fftsa.lasterr = nil         -- last frame error, nil if none
fftsa.errcount = 0          -- count of dropped frames
fftsa.errrun  = 0           -- consecutive dropped frames
fftsa.errmax  = 20          -- give up (and say so) after this many in a row
fftsa.shortreads = 0        -- captures rejected for returning fewer than n samples

-- What Reset restores, captured from the assignments above rather than restating their
-- values, so a changed default cannot disagree with the button. Sound only because every
-- one of those assignments is unconditional: fftsa = fftsa or {} inherits the previous
-- launch's table, so an `or` on any of them would make this the last session's settings.
fftsa.defaults = {flo = fftsa.flo, fhi = fftsa.fhi, range = fftsa.range,
                  win_i = fftsa.win_i, kbeta_i = fftsa.kbeta_i, n = fftsa.n}

-- The legal span, for anything that asks for one: the Options form and an unlocked graph
-- gesture both come through here, or the form would offer a range a gesture could not
-- reach. Each end clamps to its own field's declared range, then the pair is ordered -- a
-- stop at or below the start holds no bins. The single repair settles the order whatever
-- the four clamps did only because fhi_min is wholly above flomin.
function fftsa.span_clamp(lo, hi)
  local nlo, nhi = lo, hi
  -- NaN first: every comparison below is false for one, so it would pass through neither
  -- in range nor ordered. Tested against itself, NaN being the only value not equal to
  -- itself, and repaired to the floors, which is the narrowest legal span.
  if nlo ~= nlo then nlo = fftsa.flomin end
  if nhi ~= nhi then nhi = fftsa.fhi_min end
  if nhi > fftsa.fhi_max then nhi = fftsa.fhi_max end
  if nhi < fftsa.fhi_min then nhi = fftsa.fhi_min end
  if nlo < fftsa.flomin then nlo = fftsa.flomin end
  if nlo > fftsa.flo_max then nlo = fftsa.flo_max end
  if nlo >= nhi then nlo = fftsa.flomin end
  return nlo, nhi
end

-- Firmware handles, initialised only on the first load: opening the App again in one power
-- session re-runs this body, and clearing a live handle would strand the previous launch's
-- objects. fftsa.start()'s opening fftsa.stop() reclaims them.
if fftsa.handles_inited == nil then
  fftsa.cap      = nil      -- acquisition buffer
  fftsa.cap_cap  = nil      -- readings it was made for
  fftsa.optbtn   = nil      -- Options (cog) button on the spectrum screen
  fftsa.optimg   = nil      -- cog image drawn over it
  fftsa.lockbtn  = nil      -- Lock button beside it
  fftsa.lockimg_c = nil     -- closed-padlock image over the Lock button
  fftsa.lockimg_o = nil     -- open-padlock image over it; one of the pair is visible
  fftsa.timer    = nil      -- periodic timer driving frames
  fftsa.errscr   = nil      -- error screen shown if startup fails
  fftsa.optscr   = nil      -- options form screen
  fftsa.opt_flo  = nil      -- Start Frequency edit field
  fftsa.opt_fhi  = nil      -- Stop Frequency edit field
  fftsa.opt_rng  = nil      -- Input Range edit-option field
  fftsa.opt_win  = nil      -- Window edit-option field
  fftsa.opt_beta = nil      -- Kaiser Beta edit-option field
  fftsa.opt_n    = nil      -- FFT sample-count edit-option field
  fftsa.opt_info = nil      -- read-back info line on the options screen
  fftsa.handles_inited = true
end

-- The span picks the rate, and a narrow span picks a slow one: bin width is fs/n, so the
-- rate is the only way to narrow a bin without changing the transform. The cost is
-- aliasing, and the aperture cannot mitigate it -- it clamps at 10 us, whose boxcar first
-- nulls at 100 kHz, so it attenuates nothing near the slowest rung's 6.25 kHz folding
-- frequency. Content above the chosen Nyquist folds in at full amplitude with nothing on
-- the glass to say so.
--
-- Each rate declares the highest stop it may serve and pick_fs takes the slowest that
-- covers the span. The ceilings are Nyquist on the four fast rungs and under it on the
-- three slow ones, which is where folding reaches ordinary signals.
--
-- Exact rates only: the delivered rate is 66e6/ceil(66e6/request), so only a divisor of
-- 66e6 arrives as asked, while 102400 is read back verbatim and delivered as 102325.5 --
-- every bin 0.073 % out. A gate holds the whole ladder to that division.
fftsa.rates    = {12500, 25000, 50000, 100000, 200000, 500000, 1000000}
fftsa.rate_fhi = { 5000, 12000, 25000,  50000, 100000, 250000,  500000}
fftsa.fs_min   = fftsa.rates[1]

-- A NaN stop compares false against every ceiling and lands on the fastest rate, which is
-- the one that cannot alias.
function fftsa.pick_fs(fhi)
  local r = fftsa.rates
  local n = table.getn(r)
  for i = 1, n do
    if fftsa.rate_fhi[i] >= fhi then return r[i] end
  end
  return r[n]
end

-- Does a new stop frequency need the hardware re-planned? A stop inside the rate in force
-- changes only which bins are plotted: one axis write, no capture. Planned rate against
-- planned rate, never against fs_acq, which is measured off the timestamps and so never
-- equals a rung exactly.
function fftsa.plan_changed(fhi_new)
  return fftsa.pick_fs(fhi_new) ~= fftsa.pick_fs(fftsa.fhi)
end

-- Boolean fields are an EDIT_OPTION of two, matching the rest of the form rather than
-- using display.OBJ_EDIT_CHECK. Index 1 is off, so a field the pool refused reads as off
-- through fftsa.getval's fallback.
fftsa.onoff_labels = {"Off", "On"}

function fftsa.onoff_to_idx(v)
  if v then return 2 end
  return 1
end

fftsa.ranges       = {0.1, 1, 10}
fftsa.range_labels = {"0.1 V", "1 V", "10 V"}

function fftsa.range_to_idx(r)
  for i = 1, table.getn(fftsa.ranges) do
    if fftsa.ranges[i] == r then return i end
  end
  return 3
end

-- getvalue() on an OBJ_EDIT_OPTION returns the 1-based index, but it can also come back as
-- the option's own label, so both are read. Anything outside the list clamps, an index
-- used raw fetching a nil option.
function fftsa.opt_index(v, labels, fallback)
  local n = table.getn(labels)
  if type(v) == "string" then
    for j = 1, n do
      if v == labels[j] then return j end
    end
    v = tonumber(v)
  end
  if v == nil then return fallback end
  v = math.floor(v + 0.5)
  if v < 1 then v = 1 end
  if v > n then v = n end
  return v
end

function fftsa.idx_to_range(v)
  local i = fftsa.opt_index(v, fftsa.range_labels, fftsa.range_to_idx(fftsa.range))
  return fftsa.ranges[i]
end

-- Falls back rather than raising. A count off the list can only arrive from a host
-- assignment, and both Options and Apply call this before they can show anything, so a
-- raise here leaves no way back but End App.
function fftsa.sample_to_idx(n)
  for i = 1, table.getn(fftsa.sample_counts) do
    if fftsa.sample_counts[i] == n then return i end
  end
  return 1
end

function fftsa.options_samples()
  local i = fftsa.opt_index(fftsa.getval(fftsa.opt_n), fftsa.sample_labels,
                           fftsa.sample_to_idx(fftsa.n))
  return fftsa.sample_counts[i]
end

-- The digitizer's rate, from the capture's own timestamps. The fallback is fs_acq, not
-- fftsa.fs: fftsa.fs is the decimated rate and returning it here would divide it twice.
function fftsa.measure_fs(buf)
  local back = fftsa.fs_acq or fftsa.fs
  local n = buf.n
  if n < 4 then return back end
  local t1, tN = buf.relativetimestamps[1], buf.relativetimestamps[n]
  if tN <= t1 then return back end
  return (n - 1) / (tN - t1)
end

-- The clamped frame-class counts, recomputed every frame so every knob stays live. Both
-- clamp to what build() made, being refused above it. The peak count is returned so the
-- display loops ask for the same number: a raised sg_npeak asks dsp.peak() for a peak it
-- never found, and that posts an event per peak per frame. No dsp.* attribute is written
-- here -- dsp_live_push does that, immediately before the one primitive that reads them.
function fftsa.dsp_live()
  local ncol = fftsa.sg_ncol
  local cap = nil
  if fftsa.sg_buf ~= nil then cap = fftsa.sg_points_max() end
  if cap ~= nil and ncol ~= nil and ncol > cap then ncol = cap end
  if ncol == nil or ncol < 2 then ncol = 2 end
  -- Kept for the native path, which has no dsp.out to read back. A second clamp elsewhere
  -- is how the trace and the primitive end up disagreeing about the point count.
  fftsa.live_ncol = ncol
  -- Ceiling is the rows build() made: a row that does not exist cannot be written.
  local npk = fftsa.sg_npeak
  local rows = nil
  if fftsa.sg_pk_f ~= nil then rows = table.getn(fftsa.sg_pk_f) end
  if rows ~= nil and rows > 0 and npk > rows then npk = rows end
  if npk == nil or npk < 1 then npk = 1 end
  fftsa.live_npk = npk
  return npk
end

-- dsp_live's counts and the plot's own limits, handed to the interpreted primitive at the
-- point of use: called from dsp_commit() and spectrum_interp(), so nothing reaches
-- dsp.spectrum or dsp.commit without them current.
function fftsa.dsp_live_push()
  dsp.out.segments = fftsa.live_ncol
  -- The plot's own axis, so trace, peak column and noise figure share one floor.
  dsp.out.dbfloor = fftsa.sg_dbmin
  dsp.out.dbceil  = fftsa.sg_dbmax
  dsp.out.vfloor  = fftsa.sg_vfloor
  dsp.peaks.count = fftsa.live_npk
  -- The harmonic rules, or a native dsp's own defaults move all three figures on switch day.
  dsp.thd.harmonics = fftsa.thd_hmax_want
  dsp.thd.bins      = fftsa.thd_bins_want
  dsp.thd.mains     = fftsa.thd_mains_want
end

-- The only route to the interpreted primitive, so the attributes it reads cannot be left
-- behind by a caller that forgot them. Every fallback in the frame goes through here.
function fftsa.spectrum_interp(cap, buf)
  -- There is nothing to fall back to: the archive ships no interpreted transform, so a
  -- demotion from the compiled path is the end of the line. Halt and say so once, or the
  -- frame carries on behind a panel that looks alive. Both terms, because they go absent
  -- for different reasons -- fft_init is the transform, dsp.spectrum the entry point bound
  -- to it, and the call below would index a nil rather than be refused.
  if fftsa.fft_init == nil or dsp.spectrum == nil then
    if not fftsa.halted then
      fftsa.lasterr = 'the compiled DSP stopped and this archive has no interpreted fallback'
      -- WHAT STOPPED IT, not that it stopped. fftsa.nl_lasterr is the demotion's own reason,
      -- set where nl.ready was cleared, and it is short: a refusal code and its name, or the
      -- count a reduce would not accept. The sentence above fills the 70 characters a settings
      -- line holds, which is how a DMM7510 report came back reading "...has no interpreted f".
      fftsa.halt('HALTED ' .. tostring(fftsa.nl_lasterr))
    end
    return nil
  end
  fftsa.dsp_live_push()
  fftsa.dsp_window()
  return dsp.spectrum(cap, buf, nil)
end

-- The plotted window, written per frame from the stored axis range the widget is pinned to.
-- An adopted gesture moves the axis without re-planning, so a window written only at Apply
-- would leave the trace, the peaks and the THD figures on the span before it, every
-- frequency on the plot mislabelled. Frame attributes, so this dirties nothing.
function fftsa.dsp_window()
  local lo, hi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if lo == nil or hi == nil or not (hi > lo) then return false end
  dsp.out.lowfreq  = lo
  dsp.out.highfreq = hi
  return true
end

-- ---------------------------------------------------------------------------
-- The native path's plumbing: where the two buffers keep their chunk storage, which bins
-- the plotted span covers, and the bin width this capture delivered.
-- ---------------------------------------------------------------------------

-- The largest count the native arena is built for, which is every count the app offers. No
-- array has to fit a chunk whole -- dsp_plan_init_segs slices one that does not, and the
-- transform reads the capture in place rather than de-striding it. What bounds the count is
-- the chunk count dsp_plan_segs reports, and nl.init refuses one the image cannot serve.
--
-- This is what nl.init is given, not fftsa.n: the arena is sized once per boot and
-- nl.reinit re-plans inside it for any count at or below, so a sample-count press costs one
-- call instead of an install.
fftsa.nl_nmax = 32768

-- The capacity floor for the acquisition buffer. At nl_nmax one allocation serves every
-- count, so the buffer's object identity never changes and the heap sweep that finds its
-- storage runs once per boot rather than at every step up to a longer record. The price is
-- 131,072 readings held for the life of the app, about 3.2 MB of a 200 MB window.
fftsa.cap_floor_n = fftsa.nl_nmax
fftsa.cap_cap_mult = 2       -- capacity is twice the longest record

-- The native path's switch. With it off every frame falls through to spectrum_interp,
-- which this archive has nothing to serve, so off is a halt and not a slower spectrum.
fftsa.nl_enable = true

-- dsp.MAINS_* across to DSP_THD_MAINS_*, which is 50, 60, 0 or BOTH. The first three are
-- the mains frequencies themselves, so they carry over however the enum is numbered;
-- anything else is taken as BOTH, which is this app's default.
function fftsa.mains_native(v)
  if v == 50 or v == 60 or v == 0 then return v end
  return fftsa.nl.MAINS_BOTH
end

-- Chunk storage for the capture, at Apply and never in a frame. describe() is called every
-- time, because the chunk vector lengthens as a longer record lands in the same allocation
-- and a chunk outside the window is refused on every frame. Calling again is cheap: both of
-- describe()'s sweeps are cached, one against the buffer and one against the storage
-- address, so only a replaced buffer pays either, and the capture buffer is never replaced.
--
-- The trace buffer is not scanned for. Its points reach the graph through
-- buffer.write.reading, which is what feeds the display task's own copy, so the primitive
-- has no reason to know where that buffer keeps its elements.
--
-- The second argument says whether the buffer stores extra values, and it is this code's
-- answer rather than something describe() may discover: the capture is STYLE_STANDARD, and
-- reading .extravalues on one posts event 4927, which the firmware shows as a modal dialog
-- over the running app. pcall is no defence where it posts rather than raises.
-- A member of nl, called only if it is there. nl is a separately loaded module and a relaunch
-- reloads them in an order this code has no business depending on, so reaching for a function
-- that may not be back yet turns a diagnostic into the fault it was meant to describe. The
-- offline suite caught exactly that: a stub nl with no windows_str raised inside the message
-- being built to explain a failed bind.
function fftsa.nl_call(name, arg, dflt)
  local nl = fftsa.nl
  if nl == nil or type(nl[name]) ~= 'function' then return dflt end
  local v = nl[name](arg)
  if v == nil then return dflt end
  return v
end

function fftsa.nl_bind()
  local nl = fftsa.nl
  -- Each failure says which term, or this reads as "the compiled DSP did not start" with no
  -- reason at all wherever nl_lasterr is reported.
  if nl == nil or not nl.ready or fftsa.cap == nil or fftsa.sg_buf == nil then
    fftsa.nl_cap = nil
    fftsa.nl_lasterr = 'bind: ready=' .. tostring(nl ~= nil and nl.ready)
                       .. ' cap=' .. tostring(fftsa.cap ~= nil)
                       .. ' trace=' .. tostring(fftsa.sg_buf ~= nil)
    return false
  end
  fftsa.nl_cap, fftsa.nl_cap_of = nil, nil
  local c = nl.describe(fftsa.cap, false)
  if c == nil then
    -- The sweep's own reason when it has one, or a short record, an unconfirmed stride and
    -- a missed descriptor all read alike.
    fftsa.nl_lasterr = 'bind: describe found no descriptor for the capture buffer -- '
                       .. tostring(nl._stor_why) .. ' raw=' .. tostring(nl._raw_n)
                       .. ' hits=' .. tostring(nl._hit_n)
                       .. ' inst=' .. string.format('%X', nl.inst or 0)
                       .. ' ' .. fftsa.nl_call('windows_str', nil, 'windows=?')
    return false
  end
  fftsa.nl_cap, fftsa.nl_cap_of = c, fftsa.cap
  -- describe()'s one cache slot holds the capture buffer only here: nl.init stashes as its
  -- last act, before this buffer has ever been described, so that stash carries the plan
  -- buffer's key. Re-taking it is what lets a relaunch re-read the descriptor words rather
  -- than sweep the heap for storage it has already found.
  if type(nl.stash) == 'function' then nl.stash() end
  return true
end

-- Is the native path usable for the plan in force? Tested every frame, so comparisons and
-- no work. nl.n is the count the arena was last planned for and only nl.reinit moves it,
-- so this catches a sample count the install cannot serve.
function fftsa.nl_usable()
  if not fftsa.nl_enable then return false end
  local nl = fftsa.nl
  if nl == nil or not nl.ready then return false end
  if nl.n ~= fftsa.n then return false end
  return fftsa.nl_cap ~= nil
end

-- The reduction, per frame, into a table allocated once: the house rule is to allocate at
-- Apply and never in a frame.
function fftsa.nl_reduction(binhz)
  local r = fftsa.nl_redt
  if r == nil then r = {}; fftsa.nl_redt = r end
  local kmin, kmax = fftsa.sg_window_bins(fftsa.sg_nbins, binhz,
                                          fftsa.sg_flo_hz, fftsa.sg_fhi_hz)
  -- One based there, zero based here: sg_window_bins counts bins from 1, dsp_reduce indexes
  -- from 0. Getting it wrong shifts the whole trace by one bin, which no plot would show.
  r.k0, r.k1 = kmin - 1, kmax - 1
  r.nseg   = fftsa.live_ncol
  r.npk    = fftsa.live_npk
  r.binhz  = binhz
  -- No decimation on this path, so bin k is at k * binhz and frequency rises with the
  -- index. sense is for an odd Nyquist zone, which dsp_reduce reverses itself.
  r.f0     = 0
  r.sense  = 1
  r.dbmin  = fftsa.sg_dbmin
  r.dbmax  = fftsa.sg_dbmax
  r.vfloor = fftsa.sg_vfloor
  r.mains  = fftsa.mains_native(fftsa.thd_mains_want)
  return r
end

-- Apply the current settings to the hardware and the graph. Safe to repeat: the capture
-- buffer is resized when needed and the graph keeps its original buffer. Every attribute
-- below is rewritten unconditionally, which costs nothing because a write that does not
-- change the value dirties nothing -- so an adopted gesture rebuilds no tables and only a
-- changed count, window or beta pays for the cover.
function fftsa.apply()
  -- fs_acq is the digitizer's rate and fftsa.fs the rate the transform sees. Equal with no
  -- filter in the path, and kept separate because everything downstream -- binhz, the
  -- settings line, the span arithmetic -- reads fftsa.fs.
  fftsa.fs_acq = fftsa.pick_fs(fftsa.fhi)
  dsp.fft.samples    = fftsa.n
  dsp.fft.window     = fftsa.win_to_dsp(fftsa.win_i)
  dsp.fft.beta       = fftsa.kbeta(fftsa.kbeta_i)
  -- The rate the digitizer is about to be set to: commit() needs it before any capture
  -- exists, the bin width and srclength following from it.
  dsp.fft.samplerate = fftsa.fs_acq
  -- Written every Apply, not left at the default: the app offers no filter, and something
  -- setting it over the socket would otherwise survive the next press.
  dsp.filter.state = dsp.OFF
  -- From fftsa.flo/fhi, not the stored axis dsp_window() reads: the pin below is what puts
  -- the axis on this pair, so the stored one still holds the previous span here.
  dsp.out.lowfreq  = fftsa.flo
  dsp.out.highfreq = fftsa.fhi
  -- The axis floor follows the range: a DMM7510 plots to -140 dBV on 1 V and 0.1 V, where
  -- its noise floor measures -129 and -134. Ahead of dsp_live(), whose floor dsp_live_push
  -- hands to the primitive. The pin is conditional because an axis write costs 60 ms.
  if fftsa.sg_dbmin_set(fftsa.range) then fftsa.sg_pin_y() end
  fftsa.dsp_live()
  -- dsp.commit() rebuilds from these, so they are pushed here rather than left to the first
  -- frame that needs the interpreted primitive.
  fftsa.dsp_live_push()
  local rc = dsp.commit()
  if rc ~= dsp.OK then error(fftsa.dsp_why("commit", rc), 0) end
  local need = dsp.fft.srclength
  fftsa.fs = fftsa.fs_acq
  -- Before the sg_set_xrange() below, which reads it: the settings line counts the bins
  -- inside the span, and that count is computed from sg_nbins.
  fftsa.sg_nbins = fftsa.n / 2
  -- Nothing about the instrument's state may be assumed here: an autoexec script runs before
  -- any of this and can leave the DMM on any function, with a trigger model running and a
  -- user buffer current. So the app takes the instrument rather than adjusting it -- abort
  -- first, because a model left running owns the digitizer, then the function, because
  -- measure and digitize are exclusive and every digitize attribute below is refused with
  -- event 2800 while a measure function is live. Both are quiet on an idle instrument, so
  -- neither needs a state test; a state test is the wrong shape anyway, the point being not
  -- to depend on the state.
  trigger.model.abort()
  dmm.digitize.func       = dmm.FUNC_DIGITIZE_VOLTAGE
  dmm.digitize.range      = fftsa.range
  dmm.digitize.samplerate = fftsa.fs_acq
  -- The bin width commits with the rate, not after the capture: a capture that fails
  -- between the two -- a trigger timeout is the obvious one -- would leave the hardware at
  -- the new rate and fftsa.binhz at the old one. The measurement below refines it by about
  -- 0.01 %.
  fftsa.binhz = fftsa.fs / fftsa.n
  -- The span is fftsa.flo/fhi, committed by options_apply(), so the axis is pinned before
  -- the capture rather than after it.
  fftsa.sg_set_xrange(fftsa.flo, fftsa.fhi)
  dmm.digitize.aperture   = 1e-6
  -- srclength read back rather than assumed to be fftsa.n: the primitive decides how long a
  -- record it consumes, and under-acquiring short-reads every frame.
  dmm.digitize.count      = need
  -- Capacity, never the record length, and floored at the longest record the app offers, so
  -- one allocation serves every count and the buffer is made once per boot. Replacing it is
  -- what moves its storage, and finding storage again is a heap sweep of seconds; the
  -- grow-and-never-shrink rule below is kept for a floor that is ever lowered.
  local want = need
  if want < fftsa.cap_floor_n then want = fftsa.cap_floor_n end
  want = want * fftsa.cap_cap_mult
  -- Unreachable after the first allocation while the floor is a constant, since want does
  -- not move with the count. Lowering the floor or the multiplier makes it live again, and
  -- it is then the one delete in the app that does not follow fftsa.del_scr's rule: this
  -- buffer may be the panel's current one, so it needs defbuffer1 restored and a yield
  -- before the delete.
  if fftsa.cap ~= nil and (fftsa.cap_cap == nil or fftsa.cap_cap < want) then
    fftsa.del_buf(fftsa.cap)
    fftsa.cap = nil
  end
  if fftsa.cap == nil then
    fftsa.cap     = buffer.make(want, buffer.STYLE_STANDARD)
    fftsa.cap_cap = want
  end
  fftsa.cap.clear()
  dmm.digitize.read(fftsa.cap)
  -- Measured from the capture's own timestamps: the samplerate read-back is unreliable.
  fftsa.fs_acq = fftsa.measure_fs(fftsa.cap)
  fftsa.fs     = fftsa.fs_acq
  fftsa.binhz  = fftsa.fs / fftsa.n
  -- Large transforms outrun the 2 s default, so the guard follows the measured frame cost
  -- with margin rather than a multiple of the sample count.
  fftsa.busy_max = math.max(2.0, 3.0 * fftsa.frame_estimate(fftsa.n))
  fftsa.work_peak, fftsa.work_seen, fftsa.plain_peak = nil, 0, nil
  -- The diagnostics with them, which is not cosmetic: every one is a worst-seen, and a
  -- worst-seen that outlives the count it was measured at reads as a figure for the count on
  -- screen. phases() is read to decide what to optimise, so a stale entry sends the work
  -- somewhere it is not.
  fftsa.ph_peak = {}
  fftsa.work_plain, fftsa.work_tick = nil, nil
  -- Dropped rather than carried across: the rate the previous count ran at is wrong for
  -- this one, and the line is written twice from here, so a stale figure would be on the
  -- glass before the first new frame.
  fftsa.fps, fftsa.fps_n, fftsa.fps_t0 = nil, 0, nil
  -- Re-armed only when the count moved, which is the only thing the period derives from.
  -- arm() deletes the timer and creates a replacement, so an adopted gesture would pay a
  -- frame of latency for an identical timer and throw away the period frame() measured.
  if fftsa.timer ~= nil and fftsa.armed_n ~= fftsa.n then
    fftsa.period = fftsa.frame_period(fftsa.n)
    fftsa.arm(fftsa.period)
    -- Set with the modelled arm and not beside it, or an Apply that leaves the count alone
    -- would have the next frame re-arm from a single frame's measurement.
    fftsa.period_modelled = true
  end
  fftsa.sg_pk_last, fftsa.sg_pk_lf, fftsa.sg_pk_lv = nil, {}, {}
  -- The native plan follows the same three attributes dsp.commit() rebuilds from, but the
  -- code and the arena are untouched -- one params write and one call -- so it is
  -- microseconds against commit()'s window rebuild. After the capture above, because
  -- nl_bind reads the capture buffer's own descriptor to find its storage.
  fftsa.nl_replan()
  -- The legend again, not the axis: what the measured rate refined is binhz, and so the bin
  -- count the legend reports for a narrow span. fftsa.flo and fftsa.fhi have not moved since
  -- the pin above, so re-pinning would be a second 60 ms write of identical limits.
  fftsa.sg_write_xunit()
end

-- Re-plan the native path for the settings in force, and find the buffers it writes.
-- Called from apply(), and from start() once the install exists. A count above what the
-- arena was sized for leaves nl.ready false, and nl_usable() then says no. Nothing here
-- raises: a failure is recorded and swallowed, and the frame reports it.
function fftsa.nl_replan()
  local nl = fftsa.nl
  if nl == nil or type(nl.reinit) ~= 'function' then return false end
  if nl.entry == nil or nl.entry == 0 then return false end
  if nl.nmax == nil or fftsa.n > nl.nmax then
    -- The descriptors stay: dropping them would throw away both of describe()'s cached
    -- sweeps on the way back down to a count the arena can serve.
    nl.ready = false
    return false
  end
  local ok = nl.reinit(fftsa.n, nl.win_to_native(fftsa.win_i),
                       fftsa.kbeta(fftsa.kbeta_i), 1, nl.FFT_FOURSTEP)
  if not ok then
    fftsa.nl_lasterr = 'reinit refused rc='
                       .. fftsa.nl_call('rc_name', nl.last_rc, tostring(nl.last_rc))
                       .. ' at n=' .. tostring(fftsa.n)
    return false
  end
  return fftsa.nl_bind()
end

-- The peaks the primitive reported, into two tables the display reads, allocated once.
-- Through dsp.peak() rather than an implementation's own arrays, which are not interface --
-- a native primitive has none to reach into -- and resolved once here for all three display
-- users.
function fftsa.dsp_peaks(count)
  if fftsa.pk_hz == nil then fftsa.pk_hz, fftsa.pk_v = {}, {} end
  local hz, v = fftsa.pk_hz, fftsa.pk_v
  local i
  -- On the native path the peaks come out of the results block the same call filled: no
  -- dsp.spectrum ran, so that implementation never set its "a spectrum exists" flag and
  -- every dsp.peak() would refuse, one posted event per peak per frame. Keyed on nl_frame
  -- and not nl_res, so a native frame whose results did not read back answers no peaks
  -- rather than putting the question to a primitive that cannot answer it.
  if fftsa.nl_frame then
    local res = fftsa.nl_res
    for i = 1, count do
      if res == nil then hz[i], v[i] = nil, nil
      else hz[i], v[i] = res.hz[i], res.v[i] end
    end
    return hz, v
  end
  -- Absent, not merely unable to answer: the interpreted peak search is not in this archive,
  -- so a frame that did not come from the compiled path found nothing to report.
  if dsp.peak == nil then
    for i = 1, count do hz[i], v[i] = nil, nil end
    return hz, v
  end
  for i = 1, count do
    hz[i], v[i] = dsp.peak(i)
  end
  return hz, v
end

-- Distortion, signal-to-noise and the noise floor, from whichever path produced the
-- spectrum on screen. thd is a fraction, as dsp.distortion() reports it; the THD line
-- turns it into a percentage. Each figure is nil where the measurement did not apply, and
-- all three are nil on a native frame whose results block did not read back.
function fftsa.distortion()
  if fftsa.nl_frame then
    local res = fftsa.nl_res
    if res == nil then return nil, nil, nil end
    return res.thd, res.snr, res.noise
  end
  if dsp.distortion == nil then return nil, nil, nil end
  return dsp.distortion()
end

-- The sample count the spectrum on screen was computed from, which the THD line picks its
-- decimal places off. On the native path dsp.fft.samples describes a transform nothing ran.
function fftsa.plan_n()
  if fftsa.nl_frame then return fftsa.n end
  return dsp.fft.samples
end

-- One frame: acquire, one primitive call, plot. Runs under pcall from fftsa.frame().
-- docs/PERFORMANCE.md has the measured phase costs.
function fftsa.frame_body()
  -- A frame can be dispatched while the app is half-built (a failed startup) or
  -- half-torn-down (End App, a host reload); bail out rather than index a nil.
  if fftsa.cap == nil or fftsa.sg_buf == nil or fftsa.sg_graph == nil
     or fftsa.sg_pk_f == nil then
    return
  end
  -- Diagnostic: FFTSA_FREEZE, set before launch, runs one frame then stops touching the
  -- trace buffer, so dropouts that continue are the widget's and not ours. A bare global
  -- because a socket command aborts a running app.
  if FFTSA_FREEZE and fftsa.froze then return end
  local t_a = os.clock()
  fftsa.cap.clear()
  dmm.digitize.read(fftsa.cap)
  -- Asked of the capture before anything is computed from it, and free: the firmware keeps
  -- the buffer's min and max current as readings land, so this is a read and not a pass.
  fftsa.overrange = fftsa.cap_overrange(fftsa.cap)
  local t_b = os.clock()
  -- The counts only. The attributes the interpreted primitive reads, the plotted window
  -- among them, are pushed by spectrum_interp at the point of use.
  local npk = fftsa.dsp_live()
  -- Native path: the compiled DSP computes, Lua writes the trace, because the display task
  -- feeds from buffer.write.reading only. The clear and refill below is the window the trace
  -- drops out in.
  --
  -- Two flags, cleared first and set only on success, so the peak table, the THD line and
  -- plan_n are all reading this frame or nothing. nl_frame says which primitive produced the
  -- spectrum, nl_res holds the figures that came with it, and they can disagree -- a trace
  -- written while the results block fails to read back.
  local nseg
  fftsa.nl_frame = false
  fftsa.nl_res = nil
  local native = fftsa.nl_usable()
  -- A wrapped capture comes back rotated: readings[1] is the ring's physical slot 1 and the
  -- oldest reading sits at startindex, so a linear walk over the storage transforms the
  -- record in the wrong order -- every frequency wrong, and nothing on the plot to say so.
  -- Only a full buffer can have wrapped and this one holds twice the record, so this is one
  -- attribute read against a silent failure that should never arrive. Not a demotion: the
  -- next capture may be in order, so the frame falls back and the occurrence is counted.
  if native and fftsa.cap.startindex ~= nil and fftsa.cap.startindex ~= 1 then
    fftsa.nl_rotated = (fftsa.nl_rotated or 0) + 1
    native = false
  end
  if native then
    -- A short record is refused rather than transformed: zero-padding the tail gives a
    -- convincing and false broadband spectrum, and a trigger timeout is the ordinary cause.
    if fftsa.cap.n == nil or fftsa.cap.n < fftsa.n then
      -- Counted on its own name and then mirrored, because the other path keeps an absolute
      -- total of its own and the shared figure would jump at a demotion.
      fftsa.nl_shortreads = (fftsa.nl_shortreads or 0) + 1
      fftsa.shortreads = fftsa.nl_shortreads
      return
    end
    -- The bin width this capture delivered, off its own timestamps: the samplerate
    -- read-back does not match what arrives, so it is never the source.
    local binhz = fftsa.measure_fs(fftsa.cap) / fftsa.n
    -- nil for the output: the primitive reduces and touches no reading buffer.
    nseg = fftsa.nl.call_dsp(fftsa.nl_cap, nil, fftsa.nl_reduction(binhz))
    if nseg == nil then
      -- Demoted for the rest of the session rather than raising once a frame. last_rc
      -- carries the reason; fftsa.nl.RC names it.
      fftsa.nl.ready = false
      fftsa.nl_lasterr = 'call_dsp rc='
                         .. fftsa.nl_call('rc_name', fftsa.nl.last_rc,
                                          tostring(fftsa.nl.last_rc))
      nseg = fftsa.spectrum_interp(fftsa.cap, fftsa.sg_buf)
    else
      -- The trace reaches the graph through buffer.write.reading, from the values the same
      -- call reduced: the display task works from its own copy of a bound buffer and that
      -- write is what feeds it, so a write into the buffer's chunk storage draws nothing
      -- and no notify call rescues it. nl.reduce says more.
      local rd = fftsa.nl.reduce(nseg)
      if rd == nil then
        fftsa.nl.ready = false
        fftsa.nl_lasterr = 'reduce returned nil for nseg=' .. tostring(nseg)
        nseg = fftsa.spectrum_interp(fftsa.cap, fftsa.sg_buf)
      else
        fftsa.binhz = binhz
        fftsa.nl_frame = true
        fftsa.nl_res = fftsa.nl.results()
        -- buffer.write.reading is the only way points reach the glass. The display task
        -- paints from its own copy and that copy is fed one point per call: measured by
        -- replacing all 255 elements in place with the descriptor untouched, which the
        -- buffer read back correctly and the trace ignored, then appending once, which drew
        -- that one point and nothing else. So the cost is nseg appends at ~80 us, and the
        -- argument count does not change it -- five args 19.7 ms against two args 25.0 ms
        -- for 255 points, because the cost is the IPC round trip.
        --
        -- Under FILL_ONCE that means a clear first, and the buffer then holds fewer than
        -- nseg points for the length of the fill: 20.75 ms of a 105 ms frame at 255 points.
        -- A paint landing in there draws a truncated trace, which is the flicker, at a rate
        -- of about fps * window / period.
        --
        -- fftsa.sg_ring is the way out that does not shrink the window but removes it.
        fftsa.sg_fill(rd.db, rd.hz, nseg)
      end
    end
  else
    -- The other path: dsp.spectrum clears sg_buf internally before filling it.
    nseg = fftsa.spectrum_interp(fftsa.cap, fftsa.sg_buf)
  end
  if nseg == nil or nseg < 0 then error(fftsa.dsp_why("spectrum", nseg), 0) end
  -- Zero segments is a short record and not a failure: nothing was written and the previous
  -- spectrum is still on screen. Counted by the primitive, mirrored here because the
  -- settings line and the suite read this name.
  if nseg == 0 then
    fftsa.shortreads = dsp.shortreads
    return
  end
  -- On the native path binhz is set above from the capture's timestamps and is the figure
  -- dsp_reduce was given, so the markers and the trace cannot describe different
  -- frequencies. From the primitive's own read-back otherwise.
  if not fftsa.nl_frame then
    fftsa.binhz = dsp.fft.binwidth
  end
  -- Segments the widget was handed, from the primitive's own count rather than inferred
  -- from the buffer: clamped or overrun, the buffer's n ends at capacity either way.
  fftsa.sg_nwrote = nseg
  local t_c = os.clock()
  local pk_hz, pk_v = fftsa.dsp_peaks(npk)
  -- After the trace, because the peaks come out of the same call that writes it. The yield
  -- below is still the first paint after both buffers are complete, and the window where
  -- one of them is incomplete is the 18 marker points rather than 255 trace points.
  fftsa.sg_update_markers(nil, nil, npk, fftsa.binhz, pk_hz, pk_v)
  local t_d = os.clock()
  -- Display work the primitive does not do: outside any write window, then the paint.
  -- ph_tick takes the second answer, whether the one-a-second block ran, because the timer
  -- period follows the peak frame and that block is in one frame of every window. The first
  -- answer is whether any of sg_slow_tick ran, which its 0.15 s gesture clock makes true on
  -- every frame from 4096 up -- so keying on it records no plain frame at all at the counts
  -- pacing from the plain frame is aimed at.
  local sg_ran, sg_heavy = fftsa.sg_slow_tick()
  fftsa.ph_tick = sg_heavy
  local t_e = os.clock()
  delay(fftsa.sg_yield)
  local t_f = os.clock()
  -- Dashes rather than the figures, which are all arithmetic about the sentinel: the peak
  -- frequencies in particular are arbitrary picks from a spectrum whose bins are equal.
  if fftsa.overrange then
    fftsa.sg_show_peaks_over()
  else
    fftsa.sg_show_peaks(nil, nil, npk, fftsa.binhz, pk_hz, pk_v)
  end
  -- Phase costs, last frame and the worst seen. Seven clock reads, about 15 us, against a
  -- frame of tens of milliseconds; fftsa.phases() formats them.
  local ph, pk = fftsa.ph, fftsa.ph_peak
  ph.acq  = t_b - t_a
  -- acq split by whether the previous frame carried the one-a-second display block: the
  -- display task runs only while Lua is blocked and digitize.read is the longest block in
  -- the frame, so painting absorbed by acq shows up here. The previous frame, because the
  -- display block runs after acq within a frame. Per sample count, or the means mix the
  -- sizes and say nothing.
  if fftsa.acq_for ~= fftsa.n then
    fftsa.acq_for = fftsa.n
    fftsa.acq_after_tick, fftsa.acq_after_plain = nil, nil
    fftsa.acq_tick_n, fftsa.acq_tick_s = 0, 0
    fftsa.acq_plain_n, fftsa.acq_plain_s = 0, 0
  end
  if fftsa.prev_tick then
    if fftsa.acq_after_tick == nil or ph.acq > fftsa.acq_after_tick then
      fftsa.acq_after_tick = ph.acq
    end
    fftsa.acq_tick_n = (fftsa.acq_tick_n or 0) + 1
    fftsa.acq_tick_s = (fftsa.acq_tick_s or 0) + ph.acq
  else
    if fftsa.acq_after_plain == nil or ph.acq > fftsa.acq_after_plain then
      fftsa.acq_after_plain = ph.acq
    end
    fftsa.acq_plain_n = (fftsa.acq_plain_n or 0) + 1
    fftsa.acq_plain_s = (fftsa.acq_plain_s or 0) + ph.acq
  end
  ph.spec = t_c - t_b
  ph.mark = t_d - t_c
  ph.tick = t_e - t_d
  ph.yld  = t_f - t_e
  ph.show = os.clock() - t_f
  local k, v
  for k, v in pairs(ph) do
    if pk[k] == nil or v > pk[k] then pk[k] = v end
  end
  -- One full frame has drawn a trace, so the freeze diagnostic above can stand everything
  -- down. Set unconditionally, at one store, so the flag can be raised from a socket
  -- between launches without rebuilding the app for it.
  fftsa.froze = true
  fftsa.prev_tick = fftsa.ph_tick
end

-- The per-phase costs as one line, for a probe. Milliseconds, last frame then the worst.
function fftsa.phases()
  local ph, pk = fftsa.ph, fftsa.ph_peak
  local names = {'acq', 'spec', 'mark', 'tick', 'yld', 'show'}
  local out, i = '', nil
  for i = 1, table.getn(names) do
    local k = names[i]
    out = out .. string.format('%s %.1f/%.1f  ', k, 1000 * (ph[k] or 0),
                               1000 * (pk[k] or 0))
  end
  return string.format('%sframe %.1f  plain %.1f  tick %.1f', out,
                       1000 * (fftsa.frame_work or 0),
                       1000 * (fftsa.work_plain or 0), 1000 * (fftsa.work_tick or 0))
end

-- Reentrancy-guarded frame. The body runs under pcall so an error cannot leave fftsa.busy
-- set, which would make every later frame return at the top. A host abort (event 1409)
-- mid-frame is outside the pcall and does leave it set, so a guard held longer than
-- fftsa.busy_max is broken and the break counted.
fftsa.busy_since = nil
fftsa.busy_max   = 2.0      -- seconds a guard may be held before it is judged stuck


-- Seconds one frame costs at a given count and rate. The transform term is the primitive's
-- own figure, dsp.fft.spectrumtime, so its coefficients belong to whichever implementation
-- is bound and it reads zero where the archive carries no interpreted transform. busy_max
-- is three times this, which clears a legitimate frame at every count and rate without
-- leaving the app looking dead; a multiple of the sample count does neither.
function fftsa.frame_estimate(n, fs)
  if n == nil or n < 2 then n = 512 end
  local est = 0.05
  if dsp.fft.samples == n then
    local t = dsp.fft.spectrumtime
    if type(t) == "number" and t > 0 then est = t end
  end
  -- The capture is a floor on any estimate and the only term known exactly. It dominates at
  -- the slow rates: 32768 samples at 25 kS/s is 1.31 s, which alone outruns the 2 s guard.
  if type(fs) ~= "number" or fs <= 0 then fs = fftsa.fs_acq or fftsa.fs or fftsa.fs_min end
  local acq = n / fs
  if est < acq then est = acq end
  return est
end
fftsa.busy_stuck = 0        -- how many times the guard had to be broken

-- Frame rate, measured over a window of completed frames and shown on the settings line.
fftsa.fps_window = 1.0      -- seconds a measurement spans
fftsa.fps        = nil      -- frames a second, nil until the first window closes
fftsa.fps_n      = 0        -- frames counted in the window
fftsa.fps_t0     = nil      -- when the window opened
fftsa.fps_show   = false    -- a fresh figure is waiting for the line

-- Per-phase frame costs, last frame and the worst seen, written by frame_body.
fftsa.ph       = {}
fftsa.ph_peak  = {}
fftsa.ph_tick  = false      -- the one-a-second display block ran in the last frame
-- The worst frame of each kind. One frame of every eight carries the one-a-second block, so
-- a single number cannot say whether the period is set by the spectrum or by the display.
fftsa.work_plain = nil
fftsa.work_tick  = nil
-- The worst plain frame of the window in force, which is what the period follows. work_plain
-- never decays, so pacing from it would pin the period to one slow frame for the life of
-- the setting.
fftsa.plain_peak = nil
-- The period in force came from frame_estimate and no frame has been timed against it yet,
-- so the first one that is may replace it outright.
fftsa.period_modelled = false

function fftsa.frame()
  if fftsa.halted then return end
  if fftsa.busy then
    local since = fftsa.busy_since
    if since == nil or (os.clock() - since) < (fftsa.busy_max or 2.0) then return end
    fftsa.busy_stuck = (fftsa.busy_stuck or 0) + 1
  end
  fftsa.busy_since = os.clock()
  fftsa.busy = true
  -- Timed, because the timer period is set from what a frame actually costs.
  local entry = os.clock()
  local ok, err = pcall(fftsa.frame_body)
  fftsa.frame_work = os.clock() - entry
  -- The delivered interval between frames, which is where the rate actually goes and is not
  -- frame_work: the firmware's timer and the display task both live in the gap between
  -- frames, and the display task runs only while Lua is blocked. Measured at 4096, the app
  -- armed 0.15 s and delivered 0.20 s with frame_work at 0.125, so 50 ms a frame went where
  -- frame_work cannot see it. The rate below is completed frames against the wall clock,
  -- counted over a window because a rate from one interval dithers by a tick.
  if fftsa.last_entry ~= nil then
    local gap = entry - fftsa.last_entry
    if fftsa.gap_peak == nil or gap > fftsa.gap_peak then fftsa.gap_peak = gap end
  end
  fftsa.last_entry = entry
  fftsa.fps_n = (fftsa.fps_n or 0) + 1
  if fftsa.fps_t0 == nil then fftsa.fps_t0 = entry end
  local span = os.clock() - fftsa.fps_t0
  if span >= fftsa.fps_window then
    fftsa.fps = fftsa.fps_n / span
    fftsa.fps_n, fftsa.fps_t0 = 0, os.clock()
    fftsa.fps_show = true
    -- A census per sample count, in a bare global because a socket command aborts the
    -- running app: a size sweep can be neither driven nor read from outside, so the app
    -- records its own and one read afterwards gives the whole curve. A formatted string, so
    -- that read is a single print.
    if FFTSA_CENSUS == nil then FFTSA_CENSUS = {} end
    local ph = fftsa.ph
    FFTSA_CENSUS[fftsa.n] = string.format(
      'per=%.3f fps=%.2f gap=%.1f wp=%.1f wt=%.1f acq=%.1f spec=%.1f yld=%.1f nl=%s',
      fftsa.period or 0, fftsa.fps or 0, 1000 * (fftsa.gap_peak or 0),
      1000 * (fftsa.work_plain or 0), 1000 * (fftsa.work_tick or 0),
      1000 * (ph.acq or 0), 1000 * (ph.spec or 0), 1000 * (ph.yld or 0),
      tostring(fftsa.nl_frame))
    -- The acq split, where a paint absorbed by the capture would show.
    local pn, tn = fftsa.acq_plain_n or 0, fftsa.acq_tick_n or 0
    FFTSA_ACQ = string.format(
      'n=%d after-plain mean=%.1f peak=%.1f (%d) | after-tick mean=%.1f peak=%.1f (%d)',
      fftsa.n,
      1000 * (pn > 0 and (fftsa.acq_plain_s / pn) or 0),
      1000 * (fftsa.acq_after_plain or 0), pn,
      1000 * (tn > 0 and (fftsa.acq_tick_s / tn) or 0),
      1000 * (fftsa.acq_after_tick or 0), tn)
  end
  -- Re-armed from measured work, because frame_estimate() is a model and an error of a few
  -- ms lands either side of a tick boundary, a 50 % swing in displayed rate. From the peak
  -- over a window and not the mean: the period has to cover the slowest frame or ticks drop
  -- and the rate halves.
  if ok then
    if fftsa.work_peak == nil or fftsa.frame_work > fftsa.work_peak then
      fftsa.work_peak = fftsa.frame_work
    end
    if fftsa.ph_tick then
      if fftsa.work_tick == nil or fftsa.frame_work > fftsa.work_tick then
        fftsa.work_tick = fftsa.frame_work
      end
    else
      if fftsa.work_plain == nil or fftsa.frame_work > fftsa.work_plain then
        fftsa.work_plain = fftsa.frame_work
      end
      if fftsa.plain_peak == nil or fftsa.frame_work > fftsa.plain_peak then
        fftsa.plain_peak = fftsa.frame_work
      end
    end
    fftsa.work_seen = (fftsa.work_seen or 0) + 1
    -- One frame replaces a modelled period, eight replace a measured one. The model is the
    -- interpreted primitive's cost for the count and the compiled path runs a fraction of
    -- it, so at the large counts a window of eight would hold the app at several times the
    -- real frame for most of a minute. Nothing is lost by replacing it early: the peak
    -- governs again from the next window on.
    local win = 8
    if fftsa.period_modelled then win = 1 end
    if fftsa.work_seen >= win and fftsa.timer ~= nil then
      -- Paced from the worst frame that did not carry the one-a-second display block. That
      -- block lands in one frame of every eight, so a period covering it holds every other
      -- frame idle for the difference, where letting it overrun drops a tick once a second
      -- and buys that difference back on the other seven -- and the tick frame is still
      -- bounded by busy_max. work_peak is the basis until a plain frame has been seen, which
      -- is the state in the first window after a size change.
      local want = fftsa.tick_period(fftsa.plain_peak or fftsa.work_peak)
      -- The delivered gap is measured and not acted on: flooring the period at it ratchets,
      -- because arm() delays the frame it then measures, so the period only climbs. Using it
      -- needs the frame after a re-arm excluded.
      --
      -- The deadband, asymmetric and biased towards rate: on a 10 ms grid every step is a
      -- timer delete and create, so a converged period must stop re-arming, and arming a
      -- step short costs an occasional missed tick where arming a step long costs every
      -- frame. At 4096 the work straddles the 0.12/0.15 boundary -- acq alone varies 42 to
      -- 74 ms -- so a symmetric deadband chases that jitter and the rate swings between 8.2
      -- and 6.7 fps. Dropping takes one grid step and raising takes tick_rise, so it settles
      -- at the fast end and still follows a size change, which moves the period far more.
      local move = want - (fftsa.period or 0)
      local need = fftsa.tick_rise
      if move < 0 then
        move, need = -move, fftsa.tick_grid
      end
      if fftsa.period == nil or move >= need then
        fftsa.period = want
        fftsa.arm(want)
      end
      fftsa.period_modelled = false
      -- Decay the peaks so a size change downwards is noticed: they are re-earned over the
      -- next window rather than remembered for the life of the app.
      fftsa.work_peak = fftsa.frame_work
      fftsa.plain_peak = nil
      if not fftsa.ph_tick then fftsa.plain_peak = fftsa.frame_work end
      -- The delivered gap decays with the work peaks and for the same reason. Cleared here
      -- and not in the census above, which runs once a second and would wipe it before this
      -- window closed.
      fftsa.gap_peak = nil
      fftsa.work_seen = 0
    end
  end
  if not ok then
    -- Re-bind the trace after a failure so the graph is never left without one, and only
    -- while the bound buffer still holds points: adding over an empty one binds nothing and
    -- never draws again. Once per run of failures, because each add allocates an
    -- 82,464-byte display-side trace object against a ceiling of 30 across all graphs, and
    -- the axis re-pin in every one of them is visible as the scales walking across the
    -- screen. errrun still holds the previous value here, so zero is the run's first.
    if fftsa.errrun == 0 and fftsa.sg_graph ~= nil and fftsa.sg_buf ~= nil
       and fftsa.sg_buf.n > 0 then
      fftsa.sg_rebind()
    end
    fftsa.lasterr  = tostring(err)
    fftsa.errcount = (fftsa.errcount or 0) + 1
    fftsa.errrun   = (fftsa.errrun or 0) + 1
    -- After a run of failures stop retrying and say so on screen: a trace that
    -- stopped updating looks like a working analyser on a dead signal.
    if fftsa.errrun >= (fftsa.errmax or 20) then
      -- Through fftsa.halt, so a run of failed frames puts the same paged diagnostic on the
      -- glass that a stopped compiled DSP does. Both are terminal and both are reported by a
      -- photograph of whatever the instrument was showing.
      fftsa.halt("HALTED after " .. fftsa.errrun .. " frames: " ..
                 string.sub(tostring(fftsa.lasterr), 1, 40))
    end
  else
    fftsa.errrun = 0
  end
  -- Once a second, when the window above closed, so the line carries the rate just
  -- measured. Never over a halt message.
  if fftsa.fps_show and not fftsa.halted then
    fftsa.fps_show = false
    fftsa.sg_write_xunit()
  end
  -- An unlocked gesture's span is installed here, between frames: fftsa.apply() re-plans
  -- the digitizer and takes its own capture, so it cannot run inside a frame using the
  -- buffers. halted keeps the timer out of frame_body meanwhile and the guard above is
  -- still held. Skipped when a teardown waits, and when the frame above gave up: halted is
  -- cleared at the end of this block, so retuning through a halt would restart that loop.
  if fftsa.retune_pending and not fftsa.stop_pending and not fftsa.halted then
    fftsa.retune_pending = false
    -- Reconfigures the digitizer and takes one capture, with the trace frozen for it. No
    -- window tables are rebuilt: fft_init() is keyed on the count and the window, and a
    -- gesture changes neither. The line says why, and apply() rewrites it at the end.
    fftsa.say(string.format("retuning to %.0f - %.0f Hz", fftsa.flo, fftsa.fhi))
    fftsa.halted = true
    local rok, rerr = pcall(function() fftsa.apply() end)
    fftsa.halted = false
    if not rok then
      fftsa.lasterr = tostring(rerr)
      fftsa.say("RETUNE FAILED: " .. tostring(rerr))
      -- sg_adopt_x leaves the pin to apply(), so a failure before apply's own pin strands
      -- the axis on the gesture's unclamped limits with the trace in the clamped window,
      -- and nothing re-pins until the next gesture.
      fftsa.sg_pin_x()
    end
  end
  fftsa.busy = false
  -- A teardown that arrived mid-frame waits here, where nothing is in flight.
  if fftsa.stop_pending then
    fftsa.stop_pending = false
    fftsa.stop()
  end
end

-- The firmware frees the fields with their screen; the Lua handles still need clearing.
function fftsa.destroy_options()
  -- Never delete the screen on show, and the switch away needs a yield to land: see
  -- fftsa.del_scr, which reads a nil target as the home screen.
  fftsa.del_scr(fftsa.optscr, fftsa.sg_scr)
  fftsa.optscr, fftsa.opt_flo, fftsa.opt_fhi, fftsa.opt_rng, fftsa.opt_info =
    nil, nil, nil, nil, nil
  fftsa.opt_win, fftsa.opt_beta, fftsa.opt_n = nil, nil, nil
  fftsa.opt_mk = nil
  fftsa.opt_info_last = nil
end

-- Form geometry, two columns: six fields become three rows, and the gap that buys is what
-- makes each box a touch target. display.create takes no width for an OBJ_EDIT_*, so the
-- second column's x is the one number to check on the glass. Labels are right-aligned and
-- end at the column x. Six because Peak Markers is withheld -- see fftsa.opt_mk.
fftsa.opt_nf      = 6
fftsa.opt_cols    = 2
fftsa.opt_x       = 185
fftsa.opt_x_c2    = 552
fftsa.opt_y0      = 8
fftsa.opt_dy      = 100     -- preferred pitch; clamped to what fits
fftsa.opt_edit_h  = 50      -- box height, measured
fftsa.opt_edit_dy = 4       -- offset of the box inside the object
fftsa.opt_y_adj   = 0       -- nudge of the centred block, negative being up
fftsa.opt_btn_y   = 360
fftsa.opt_info_y  = 323     -- readback line; its ink lands about 37 px below this
fftsa.opt_info_h  = 20      -- its height above that baseline, so the fields clear it

-- Rows, pitch and top for the field block. The pitch is the preferred one, clamped if a
-- field count needs it; at six fields, three rows at 100 leave the clamp inert.
function fftsa.opt_layout()
  local nrows = math.ceil(fftsa.opt_nf / fftsa.opt_cols)
  local eh, edy = fftsa.opt_edit_h, fftsa.opt_edit_dy
  local y0, dy  = fftsa.opt_y0, fftsa.opt_dy
  -- The last box has to end above the readback line, which sits above the buttons: at
  -- seven fields the button row alone leaves the bottom box over the top of it.
  local floor_y = fftsa.opt_info_y - fftsa.opt_info_h
  if nrows > 1 then
    local maxdy = math.floor((floor_y - y0 - edy - eh) / (nrows - 1))
    if dy > maxdy then dy = maxdy end
  end
  -- Centred, because three rows do not fill the form, then nudged by what is spare. The
  -- nudge is separate from y0, or the centring would give back half of it.
  local spare = floor_y - ((nrows - 1) * dy + eh + edy) - y0
  if spare > 0 then y0 = y0 + math.floor(spare / 2) end
  if y0 + fftsa.opt_y_adj >= 0 then y0 = y0 + fftsa.opt_y_adj end
  fftsa.opt_nrows, fftsa.opt_dy_used, fftsa.opt_y0_used = nrows, dy, y0
  return nrows, dy, y0
end

function fftsa.build_options()
  fftsa.destroy_options()

  local create = display.create
  -- A screen title over 31 characters is truncated by the firmware (event 1707).
  fftsa.optscr = create(display.ROOT, display.OBJ_SCREEN, "FFT ANALYSER OPTIONS")
  if fftsa.optscr == nil then
    fftsa.lasterr = "OBJPOOL exhausted building the options screen"
    return false, fftsa.lasterr
  end
  fftsa.loading_front()

  -- Columns fill top to bottom, left column first.
  local nrows, dy, y0 = fftsa.opt_layout()
  local row = 0
  local function nextpos()
    local c = math.floor(row / nrows)
    if c > fftsa.opt_cols - 1 then c = fftsa.opt_cols - 1 end
    local fx = fftsa.opt_x
    if c > 0 then fx = fftsa.opt_x_c2 end
    local fy = y0 + (row - c * nrows) * dy
    row = row + 1
    return fx, fy
  end

  local x1, y1 = nextpos()
  fftsa.opt_flo = create(fftsa.optscr, display.OBJ_EDIT_NUMBER, x1, y1,
                       "Start Freq", "low edge",
                       display.NFORMAT_PREFIX, fftsa.flo, fftsa.flomin, fftsa.flo_max, "Hz")
  local x2, y2 = nextpos()
  fftsa.opt_fhi = create(fftsa.optscr, display.OBJ_EDIT_NUMBER, x2, y2,
                       "Stop Freq", "display top",
                       display.NFORMAT_PREFIX, fftsa.fhi, fftsa.fhi_min, fftsa.fhi_max, "Hz")
  local x3, y3 = nextpos()
  fftsa.opt_rng = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x3, y3,
                       "Input Range", "full-scale",
                       fftsa.range_labels[1], fftsa.range_labels[2], fftsa.range_labels[3])
  -- Spelled out rather than built from the table: display.create takes the options as
  -- separate arguments and Lua 5.0.2 has no unpack() worth using here.
  local x5, y5 = nextpos()
  fftsa.opt_win = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x5, y5,
                       "Window", "lobe vs sidelobe",
                       fftsa.win_names[1], fftsa.win_names[2], fftsa.win_names[3],
                       fftsa.win_names[4])
  -- Always built, not only when Kaiser is selected: a field created on a press is a
  -- create on a visible screen, and this one is inert for the other three windows.
  local x6, y6 = nextpos()
  fftsa.opt_beta = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x6, y6,
                       "Kaiser Beta", "sidelobe level",
                       fftsa.kbeta_labels[1], fftsa.kbeta_labels[2], fftsa.kbeta_labels[3],
                       fftsa.kbeta_labels[4], fftsa.kbeta_labels[5], fftsa.kbeta_labels[6])
  local x7, y7 = nextpos()
  fftsa.opt_n = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x7, y7,
                       "FFT Samples", "resolution vs speed",
                       fftsa.sample_labels[1], fftsa.sample_labels[2], fftsa.sample_labels[3],
                       fftsa.sample_labels[4], fftsa.sample_labels[5], fftsa.sample_labels[6])
  -- Peak markers is not offered, so that field is never created and fftsa.opt_mk stays nil;
  -- getval answers the fallback for a nil handle, so apply sees "off". What is missing is
  -- the second trace's scaling: the firmware does not honour a pin applied with that trace
  -- selected, so its six points auto-scale and land nowhere near the spectrum.

  fftsa.opt_info = create(fftsa.optscr, display.OBJ_TEXT, 400, fftsa.opt_info_y, "",
                        56575, display.FONT_SMALL, display.JUST_CENTER)   -- cyan 00DCFF
  -- A timer on the options screen previews edits without configuring acquisition.
  local preview = create(fftsa.optscr, display.OBJ_TIMER, fftsa.opt_tick_period,
                         display.TIMER_FOREVER)
  display.setevent(preview, display.EVENT_PRESS,
                  "if fftsa ~= nil then fftsa.guard(fftsa.opt_tick) end")

  local b_apply = create(fftsa.optscr, display.OBJ_BUTTON, 470, fftsa.opt_btn_y, "Apply", 140)
  display.setevent(b_apply, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.options_apply) end")
  local b_cancel = create(fftsa.optscr, display.OBJ_BUTTON, 630, fftsa.opt_btn_y, "Cancel", 140)
  display.setevent(b_cancel, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.options_cancel) end")
  local b_about = create(fftsa.optscr, display.OBJ_BUTTON, 8, fftsa.opt_btn_y, "About", 140)
  display.setevent(b_about, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.about) end")
  -- Left of centre, 20 px off About and well clear of Apply at 470: the two that change
  -- what is measured stay together on the right, away from a thumb reaching for About.
  local b_rst = create(fftsa.optscr, display.OBJ_BUTTON, 168, fftsa.opt_btn_y, "Reset", 140)
  display.setevent(b_rst, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.options_reset) end")
  -- End App is hooked on this screen too: the firmware may deliver EVENT_ENDAPP to
  -- the visible screen, and leaving from the form must still tear down.
  display.setevent(fftsa.optscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  return fftsa.optscr
end

-- ==================== About ====================
-- An OBJ_TEXT y sits above its ink, by 37 px in the small fonts against a button's 50, so
-- these are lower than a button's y for the same apparent position.
--
-- The fonts, measured on the panel because the numbered ones are absent from the display API
-- reference and their order is not the SMALL/MEDIUM/LARGE one. Ink height, width of one
-- fixed string, and how far the ink starts below the y given:
--
--   FONT_1  17 px  202 px  37 below      FONT_SMALL   17 px  244 px  37 below
--   FONT_2  19 px  230 px  36 below      FONT_MEDIUM  24 px  380 px  32 below
--   FONT_3  21 px  264 px  34 below      FONT_LARGE   29 px  434 px  28 below
fftsa.about_x        = 12
fftsa.about_title_x  = 400        -- centred, so the x is the screen's middle
fftsa.about_title_y  = 30
fftsa.about_body_y   = 70
-- FONT_1's line pitch, measured on the panel: the numbered fonts are in the firmware's
-- registration table but not in the display API reference. Eleven rows at this pitch end
-- clear of the button row at opt_btn_y.
fftsa.about_body_dy  = 20
-- Rows a page. 14 splits the licence after the blank line below the copyright notice, so
-- the second page starts flush with the warranty block rather than with a blank row.
fftsa.about_rows     = 14
fftsa.about_page     = 1
fftsa.about_c_title  = 56575      -- cyan 00DCFF
fftsa.about_c_body   = 16777215   -- white

-- The licence, verbatim from LICENSE and wrapped there: OBJ_TEXT does not wrap, so one
-- line is one row, and a blank line is a row of its own.
fftsa.about_text = {
  "MIT License",
  "",
  "Copyright (c) 2026 Ian Ameline",
  "",
  "Permission is hereby granted, free of charge, to any person obtaining a copy",
  'of this software and associated documentation files (the "Software"), to deal',
  "in the Software without restriction, including without limitation the rights",
  "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell",
  "copies of the Software, and to permit persons to whom the Software is",
  "furnished to do so, subject to the following conditions:",
  "",
  "The above copyright notice and this permission notice shall be included in",
  "all copies or substantial portions of the Software.",
  "",
  'THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR',
  "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,",
  "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE",
  "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER",
  "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,",
  "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE",
  "SOFTWARE.",
}

-- Columns an About row holds. x is 12 and FONT_1 runs about 7.8 px a character, so 96 fit
-- across 800; 92 leaves the margin the error page leaves.
fftsa.about_cols = 92

function fftsa.destroy_about()
  fftsa.del_scr(fftsa.aboutscr, fftsa.sg_scr)
  fftsa.aboutscr, fftsa.about_name, fftsa.about_lines = nil, nil, nil
  fftsa.about_pageno, fftsa.about_page = nil, 1
end

-- The native path's state appended to the About pages.
--
-- The error page only exists when the app did NOT start. What a model we have never run on
-- did in order to start -- which window answered, whether the descriptor offsets had to be
-- derived from the data, how much of the sweep reached memory -- is exactly what the next fix
-- needs, and on a working instrument there is nowhere else to read it. The channel is a
-- screen grab from another continent, so it is on the glass or it does not exist.
--
-- Appended from a marker rather than pushed, because fftsa.start() runs again on every launch
-- while the module's load-time table does not: without the marker a second launch would carry
-- two copies of the state and a tenth would carry ten.
-- Everything a report needs, as one string, composed in ONE place.
--
-- Three readers want it -- the error screen a halt puts up, the About pages an operator can
-- open, and the console -- and they were each building their own. A diagnostic that differs
-- between the screen it lands on and the page it is grabbed from is worse than none: the
-- report that arrives cannot be compared with the report that was expected.
--
-- The app's own state comes first. nl.diag() describes how the native path was DISCOVERED;
-- what a frame then did with it is in fftsa.nl_lasterr and nowhere else, and that is the
-- string that names a compiled DSP which started and then stopped.
function fftsa.diag_str()
  local app = 'halt=' .. tostring(fftsa.halted)
              .. ' err=' .. tostring(fftsa.lasterr)
              .. ' nlerr=' .. tostring(fftsa.nl_lasterr)
              .. ' rc=' .. tostring(fftsa.nl ~= nil and fftsa.nl.last_rc)
              .. ' nerr=' .. tostring(fftsa.errcount)
              .. ' short=' .. tostring(fftsa.shortreads)
              .. ' rot=' .. tostring(fftsa.nl_rotated)
              .. ' n=' .. tostring(fftsa.n)
              .. ' ncol=' .. tostring(fftsa.sg_ncol)
  local d = nil
  if fftsa.nl ~= nil and fftsa.nl.diag ~= nil then
    local ok, got = pcall(fftsa.nl.diag)
    if ok then d = got end
  end
  if d == nil then d = 'no native path: nl=' .. tostring(fftsa.nl ~= nil) end
  local px = ''
  if fftsa.nl ~= nil and fftsa.nl.px_str ~= nil then
    local okp, gotp = pcall(fftsa.nl.px_str)
    if okp then px = ' | ' .. tostring(gotp) end
  end
  return app .. ' | ' .. tostring(d) .. px
end

-- Stop, and put the reason on the glass where it can be photographed.
--
-- THE ERROR SCREEN HAS TO APPEAR BY ITSELF. A DMM7510 halted with the cause in a status line
-- that holds 70 characters and in About pages nobody had been told to open, so the report that
-- came back was a flat trace and a truncated sentence -- which said nothing the source did not
-- already say. The only channel is a screen grab from another continent, so a halt shows the
-- paged diagnostic without being asked.
--
-- The short line goes on the settings line as well, for the case where the screen cannot be
-- built: an exhausted object pool is exactly the kind of failure that gets this far.
function fftsa.halt(short)
  fftsa.halted = true
  pcall(fftsa.say, short)
  pcall(fftsa.show_error, fftsa.diag_str(), true)
  return nil
end

function fftsa.about_add_diag()
  if fftsa.about_text == nil then return false end
  if fftsa.about_diag_at == nil then
    fftsa.about_diag_at = table.getn(fftsa.about_text) + 1
  end
  local i
  for i = table.getn(fftsa.about_text), fftsa.about_diag_at, -1 do
    fftsa.about_text[i] = nil
  end
  local body = fftsa.err_wrap('v' .. tostring(fftsa.VERSION) .. ' ' .. fftsa.node_str()
                              .. ' | ' .. fftsa.diag_str(), fftsa.about_cols)
  -- A page boundary first, so the state starts at the top of a page and the licence is never
  -- half overwritten by it: a grab of that page is then the whole of what it reports.
  local at = fftsa.about_diag_at
  local pad = math.mod(at - 1, fftsa.about_rows)
  if pad > 0 then
    for i = 1, fftsa.about_rows - pad do
      fftsa.about_text[at] = ''
      at = at + 1
    end
  end
  for i = 1, table.getn(body) do
    fftsa.about_text[at] = body[i]
    at = at + 1
  end
  -- The row objects already exist and about_pages() counts the table, so a page that was not
  -- there when the screen was built is reachable the moment this returns.
  if fftsa.about_pageno ~= nil then fftsa.about_show_page(fftsa.about_page or 1) end
  return true
end

function fftsa.about_pages()
  local rows = fftsa.about_rows
  return math.ceil(table.getn(fftsa.about_text) / rows)
end

-- Page p into the row objects, which are made once and rewritten. A row past the end of
-- the licence is blanked rather than left holding the previous page.
function fftsa.about_show_page(p)
  if fftsa.about_lines == nil then return false end
  local last = fftsa.about_pages()
  if p < 1 then p = 1 end
  if p > last then p = last end
  fftsa.about_page = p
  local base, i = (p - 1) * fftsa.about_rows, nil
  for i = 1, fftsa.about_rows do
    local s = fftsa.about_text[base + i]
    if s == nil then s = "" end
    fftsa.settxt(fftsa.about_lines[i], s)
  end
  fftsa.settxt(fftsa.about_pageno, string.format("page %d of %d", p, last))
  return true
end

function fftsa.about_pgup()
  return fftsa.about_show_page(fftsa.about_page - 1)
end

function fftsa.about_pgdn()
  return fftsa.about_show_page(fftsa.about_page + 1)
end

-- 100 ms against the firmware's 0.05 s floor, and it costs nothing elsewhere: a display
-- timer fires only while its own screen is on show, and the frame loop is frozen for as
-- long as this form is up.
fftsa.opt_tick_period = 0.1

function fftsa.opt_tick()
  fftsa.options_preview()
  return true
end

-- Built at launch with every other screen. A create on a visible screen is what strands
-- objects, and the only screen visible during a build is the loading cover.
function fftsa.build_about()
  fftsa.destroy_about()
  local create = display.create
  fftsa.aboutscr = create(display.ROOT, display.OBJ_SCREEN, "FFT Analyser - About")
  if fftsa.aboutscr == nil then
    fftsa.lasterr = "OBJPOOL exhausted building the about screen"
    return false, fftsa.lasterr
  end
  fftsa.loading_front()
  -- Outside the paged rows, so it stays put whichever page is showing.
  fftsa.about_name = create(fftsa.aboutscr, display.OBJ_TEXT, fftsa.about_title_x,
                            fftsa.about_title_y, "Author: Ian Ameline",
                            fftsa.about_c_title, display.FONT_4, display.JUST_CENTER)
  fftsa.about_lines = {}
  local y, i = fftsa.about_body_y, nil
  for i = 1, fftsa.about_rows do
    fftsa.about_lines[i] = create(fftsa.aboutscr, display.OBJ_TEXT, fftsa.about_x, y, "",
                                  fftsa.about_c_body, display.FONT_1, display.JUST_LEFT)
    y = y + fftsa.about_body_dy
  end
  fftsa.about_pageno = create(fftsa.aboutscr, display.OBJ_TEXT, fftsa.about_title_x,
                              fftsa.opt_btn_y - 8, "", fftsa.about_c_title,
                              display.FONT_SMALL, display.JUST_CENTER)
  local b_up = create(fftsa.aboutscr, display.OBJ_BUTTON, 8, fftsa.opt_btn_y, "PgUp", 140)
  display.setevent(b_up, display.EVENT_PRESS,
                   "if fftsa ~= nil then fftsa.guard(fftsa.about_pgup) end")
  local b_dn = create(fftsa.aboutscr, display.OBJ_BUTTON, 168, fftsa.opt_btn_y,
                      "PgDn", 140)
  display.setevent(b_dn, display.EVENT_PRESS,
                   "if fftsa ~= nil then fftsa.guard(fftsa.about_pgdn) end")
  local b_back = create(fftsa.aboutscr, display.OBJ_BUTTON, 630, fftsa.opt_btn_y,
                        "Back", 140)
  display.setevent(b_back, display.EVENT_PRESS,
                   "if fftsa ~= nil then fftsa.guard(fftsa.about_back) end")
  -- End App is delivered to the visible screen, and this one can be it.
  display.setevent(fftsa.aboutscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  fftsa.about_show_page(1)
  return fftsa.aboutscr
end

-- A press only switches, like Options: a nil handle means the pool refused at build.
-- Always from the first page, so the screen reads the same every time it is opened.
function fftsa.about()
  if fftsa.aboutscr == nil then return false end
  -- REBUILT HERE, not only at launch. fftsa.start() adds the state once, which describes the
  -- instrument as it was before the first frame ran -- and the failure worth reporting is a
  -- demotion that happens later. Re-appending costs nothing: about_add_diag truncates from its
  -- own marker first, so this is idempotent however many times About is opened, and the row
  -- objects it writes into were built with the screen.
  pcall(fftsa.about_add_diag)
  fftsa.about_show_page(1)
  display.changescreen(fftsa.aboutscr)
  return true
end

-- Back to the form it was opened from, or to the spectrum if the form is gone.
function fftsa.about_back()
  if fftsa.optscr == nil then return fftsa.show_main() end
  display.changescreen(fftsa.optscr)
  return true
end

-- Which pair of terminals the ADC is on. FRONT/REAR is a front-panel button the app cannot
-- refuse, and the pair not selected is an open input, so a signal on the front with the
-- switch on REAR reads as a dead signal and not as a wrong setting. Named on the settings
-- line and watched by the tick, so a press mid-session shows up without an Apply. Total,
-- like every other builder feeding that line.
function fftsa.terminal_text()
  local t = dmm.terminals
  if t == dmm.TERMINALS_REAR then return "REAR" end
  if t == dmm.TERMINALS_FRONT then return "FRONT" end
  return "TERM?"
end

-- Total by construction: this feeds the settings line and the Options readback, both built
-- inside apply() after the hardware is configured, so a rate that is not a number has to
-- read as a gap rather than abort the Apply around it.
function fftsa.sample_rate_text(fs)
  if type(fs) ~= "number" then return "?" end
  if fs >= 1000000 then return string.format("%g MS/s", fs / 1000000) end
  if fs >= 1000 then return string.format("%g kS/s", fs / 1000) end
  return string.format("%g S/s", fs)
end

-- Acquisition duration is N/fs, not the first-to-last interval (N-1)/fs.
function fftsa.opt_info_text(fs, n, wi, bi, acq)
  fs, n = fs or fftsa.fs, n or fftsa.n
  if acq == nil then acq = fftsa.fs_acq or fs end
  -- Every input can be nil or zero while the app is part-built or part-torn-down, and a
  -- raise here aborts an Apply over a text line. The bin and record length need arithmetic,
  -- so they are what is withheld; tostring() covers the window label's table lookup.
  local wl = tostring(fftsa.win_label(wi, bi))
  if type(fs) ~= "number" or type(n) ~= "number" or n == 0 or fs == 0 then
    return string.format("fs %s   bin ? Hz   acq ? ms   %s",
                         fftsa.sample_rate_text(acq), wl)
  end
  return string.format("fs %s   bin %.2f Hz   acq %.2f ms   %s",
                       fftsa.sample_rate_text(acq), fs / n, 1000 * n / fs, wl)
end

-- Read a field, or answer the fallback if the handle was never built. display.create
-- returns nil on an exhausted object pool, so a field handle can legitimately be nil, and
-- getvalue on nil raises in this code rather than being refused by the firmware: the test
-- is what keeps a missing field from taking Options and Apply down with it.
function fftsa.getval(h, fallback)
  if h == nil then return fallback end
  return display.getvalue(h)
end

-- Set a field, or do nothing if the handle was never built. See fftsa.options().
function fftsa.setval(h, v)
  if h == nil then return false end
  display.setvalue(h, v)
  return true
end

-- Set a text, or do nothing if the handle was never built.
function fftsa.settxt(h, t)
  if h == nil then return false end
  display.settext(h, t)
  return true
end

-- wi and bi are optional, and passing them is what keeps the Options button quick.
--
-- A display.getvalue WAITS for the display task to answer, and that task is busy painting the
-- trace, so each read-back costs whatever is left of the current paint and gives up after two
-- seconds. opt_fill has just written both fields, so it knows them and reads back nothing: on
-- the press path that removes the two most expensive calls of the eight. A field edit still
-- calls this with no arguments, where reading back is the whole point.
function fftsa.options_preview(wi, bi)
  local lo, hi = fftsa.options_span()
  local n = fftsa.options_samples()
  local fs = fftsa.pick_fs(hi)
  -- Reuse the timestamp-measured rate when previewing the active acquisition rate.
  if fs == fftsa.pick_fs(fftsa.fhi) then fs = fftsa.fs_acq or fftsa.fs end
  local acq = fs
  -- The window comes from the fields too, or three quarters of the line would track
  -- the edit and the fourth would silently show the applied window.
  if wi == nil then
    wi = fftsa.opt_index(fftsa.getval(fftsa.opt_win), fftsa.win_names, fftsa.win_i)
  end
  if bi == nil then
    bi = fftsa.opt_index(fftsa.getval(fftsa.opt_beta), fftsa.kbeta_labels,
                         fftsa.kbeta_i)
  end
  local text = fftsa.opt_info_text(fs, n, wi, bi, acq)
  if text ~= fftsa.opt_info_last then
    fftsa.settxt(fftsa.opt_info, text)
    fftsa.opt_info_last = text
  end
end

-- Every button press goes through here. A press is dispatched by the firmware evaluating
-- the command string setevent was given, and an error raised inside that string arrives as
-- a dialog over the app rather than as a return value, so this is the last place to catch it.
function fftsa.guard(f)
  if f == nil then return false end
  local ok, err = pcall(f)
  if not ok then
    fftsa.lasterr = "button handler failed: " .. tostring(err)
    fftsa.say(fftsa.lasterr)
  end
  return ok
end

-- Put a line on the glass, on the settings line under the peak rows: a failure recorded
-- only in fftsa.lasterr is invisible, leaving a press that did nothing and a previous
-- spectrum still running. The next fftsa.sg_set_xrange() rewrites the line.
function fftsa.say(msg)
  if fftsa.sg_xunit ~= nil then
    display.settext(fftsa.sg_xunit, string.sub(tostring(msg), 1, 70))
  end
end

-- Back to the spectrum screen, which is also what lets the frame timer run again.
function fftsa.show_main()
  if fftsa.sg_scr ~= nil then
    display.changescreen(fftsa.sg_scr)
    return true
  end
  display.changescreen(display.SCREEN_HOME)
  return false
end

-- The six fields from one set of values, and the readback line that follows: the single
-- filler, so what Options shows and what Reset offers cannot drift apart. Every field goes
-- through the nil-testing setters, so an exhausted pool costs the fields it refused rather
-- than the Options button and Apply together. Callers run under fftsa.guard for the same
-- reason.
function fftsa.opt_fill(flo, fhi, range, win_i, kbeta_i, n)
  fftsa.setval(fftsa.opt_flo, flo)
  fftsa.setval(fftsa.opt_fhi, fhi)
  fftsa.setval(fftsa.opt_rng, fftsa.range_to_idx(range))
  fftsa.setval(fftsa.opt_win, win_i)
  fftsa.setval(fftsa.opt_beta, kbeta_i)
  fftsa.setval(fftsa.opt_n, fftsa.sample_to_idx(n))
  fftsa.options_preview(win_i, kbeta_i)
end

-- A press only switches. Everything is built in fftsa.start(), so a nil handle
-- means the object pool refused and building it now would fail the same way.
function fftsa.options()
  if fftsa.optscr == nil then return false end
  -- SWITCH FIRST, then fill. The frame timer is parented to the spectrum screen, so changing
  -- screen is what stops frames -- and filling the form before that means six setvalue calls
  -- queued behind a display task painting the trace. Measured from the glass: 7 to 8 seconds
  -- on the first press and 1 to 2 after, which reads as a broken button. Switching first
  -- leaves the task idle for the writes.
  --
  -- The form holds the previous open's values for the moment before the fill lands, which is
  -- a flicker of stale text against seconds of apparent hang. The yield is what lets the
  -- switch take effect before the writes, as for every other screen in this app.
  display.changescreen(fftsa.optscr)
  delay(fftsa.sg_yield)
  fftsa.opt_fill(fftsa.flo, fftsa.fhi, fftsa.range, fftsa.win_i, fftsa.kbeta_i, fftsa.n)
  -- Counted so the remaining first-press lag can be measured rather than described. It is
  -- only the FIRST open that is slow, which rules out the press and the fill -- both cost the
  -- same every time -- and points at work the display task does once per screen. A probe
  -- timing that has to know whether this open is the first, and asking is cheaper than
  -- arranging a launch and trusting it.
  fftsa.opt_opens = (fftsa.opt_opens or 0) + 1
  return true
end

-- The shipped settings back into the form and nothing else: Apply commits them and Cancel
-- abandons them, so a mis-press costs a press. Acquisition is untouched until Apply, which
-- keeps a button nobody meant to hit off the commit a changed sample count would charge.
function fftsa.options_reset()
  if fftsa.optscr == nil then return false end
  local d = fftsa.defaults
  fftsa.opt_fill(d.flo, d.fhi, d.range, d.win_i, d.kbeta_i, d.n)
  return true
end

-- The form's span: the two fields, clamped through fftsa.span_clamp, which is also where a
-- graph gesture lands. A field the pool refused reads nil through getval's fallback, and
-- anything the form could not have produced keeps what is in force rather than clamping.
function fftsa.options_span()
  local nlo, nhi = fftsa.flo, fftsa.fhi
  local lo = fftsa.getval(fftsa.opt_flo, fftsa.flo)
  local hi = fftsa.getval(fftsa.opt_fhi, fftsa.fhi)
  if hi ~= nil and hi > 0 then nhi = hi end
  if lo ~= nil and lo >= 0 then nlo = lo end
  return fftsa.span_clamp(nlo, nhi)
end

function fftsa.options_apply()
  -- Every field is read before anything is committed, so a raise in here leaves the applied
  -- state untouched. A raise after the first commit would leave the span changed with the
  -- axis, the cover and the message describing the old one, and say() writes the spectrum
  -- screen, which is not on show yet.
  local ri = fftsa.getval(fftsa.opt_rng)
  local wi = fftsa.getval(fftsa.opt_win)
  local bi = fftsa.getval(fftsa.opt_beta)
  local mki = fftsa.opt_index(fftsa.getval(fftsa.opt_mk),
                              fftsa.onoff_labels,
                              fftsa.onoff_to_idx(fftsa.sg_markers))
  local nnew = fftsa.options_samples()
  local nlo, nhi = fftsa.options_span()
  fftsa.flo, fftsa.fhi = nlo, nhi
  local nold    = fftsa.n
  fftsa.n       = nnew
  fftsa.range   = fftsa.idx_to_range(ri)
  fftsa.win_i   = fftsa.opt_index(wi, fftsa.win_names, fftsa.win_i)
  fftsa.kbeta_i = fftsa.opt_index(bi, fftsa.kbeta_labels, fftsa.kbeta_i)
  -- Rebound only on a change: sg_bind() calls removeall, which repaints the whole widget
  -- including its axis labels, and this is the one moment that is already a repaint.
  local mknew = (mki == 2)
  local mkchanged = (mknew ~= fftsa.sg_markers)
  fftsa.sg_markers = mknew
  -- Under the cover: fftsa.apply() rebuilds the window tables and takes a capture, and the
  -- frame timer does not run while its screen is off show, so no frame meets half-rebuilt
  -- tables.
  fftsa.loading_front()
  -- A failed resize must not resume frames with mismatched FFT and buffer sizes. An
  -- unchanged size cannot desync them, and halting there would freeze the trace on any
  -- failed capture -- a trigger timeout being exactly the case frames should run through.
  fftsa.halted = (fftsa.n ~= nold)
  local ok, err = pcall(function() fftsa.apply() end)
  -- A failure with the count changed can leave the FFT tables and the capture buffer sized
  -- apart, which is what halted above guards -- but leaving it set is an app that never
  -- draws again and only another Apply can revive. So the count goes back, apply() runs
  -- again on the pair in force a moment ago, and frames resume if that works. Still
  -- reported as failed, the setting asked for not having taken, and fftsa.n holds what did.
  if not ok and fftsa.n ~= nold then
    fftsa.n = nold
    if pcall(function() fftsa.apply() end) then
      err = tostring(err) .. "  [kept " .. tostring(nold) .. " samples]"
      fftsa.halted, fftsa.errrun = false, 0
      if mkchanged then fftsa.sg_bind() end
    end
  end
  fftsa.show_main()
  if not ok then
    fftsa.lasterr = tostring(err)
    fftsa.say("APPLY FAILED: " .. tostring(err))
  else
    fftsa.halted, fftsa.errrun = false, 0
    -- Apply supersedes a gesture waiting to be re-planned: it has just re-planned from the
    -- same fftsa.flo/fhi, so leaving the flag set buys an identical apply next frame.
    fftsa.retune_pending = false
    if mkchanged then fftsa.sg_bind() end
    -- Through the guarded writer, like the two inside apply(): this is past every commit and
    -- outside the pcall above, so a raise building the text would escape options_apply
    -- altogether and report a failed Apply that had in fact succeeded.
    fftsa.sg_write_xunit()
  end
  return ok
end

function fftsa.options_cancel()
  fftsa.show_main()
end

-- Lock and Options, two icon buttons. A button carries no image and display.settext does
-- not accept one, so an icon is an OBJ_IMAGE child created after its button, which puts it
-- on top; a press on the icon reaches the button underneath.
fftsa.btn_y      = 350
fftsa.btn_h      = 60       -- measured off a panel capture
fftsa.btn_lock_x = 660
fftsa.btn_lock_w = 60
fftsa.btn_opt_x  = 730
fftsa.btn_opt_w  = 60
fftsa.lock_img_w = 28       -- fftlockc and fftlocko are 28x34
fftsa.lock_img_h = 34
fftsa.cog_img_w  = 34       -- fftcog is 34x34
fftsa.cog_img_h  = 34

-- tools/package_tspa.py reads these out of the source to decide which assets/<name>.png
-- to embed, so inlining one of them stops its image shipping.
fftsa.img_lock_c = "fftlockc"
fftsa.img_lock_o = "fftlocko"
fftsa.img_cog    = "fftcog"

-- The lock state on the glass is which of the padlock pair is visible.
function fftsa.lock_icon()
  local on, off = fftsa.lockimg_o, fftsa.lockimg_c
  if fftsa.sg_lock then on, off = fftsa.lockimg_c, fftsa.lockimg_o end
  if off ~= nil then display.setstate(off, display.STATE_INVISIBLE) end
  fftsa.icon_redraw(on)
end

-- Force an icon to paint. Setting a state the object already holds is 0.020 ms and may
-- be taken as nothing to do, so the pair is what guarantees the draw, at 0.034 ms.
function fftsa.icon_redraw(h)
  if h == nil then return false end
  display.setstate(h, display.STATE_INVISIBLE)
  display.setstate(h, display.STATE_ENABLE)
  return true
end

-- Called from fftsa.sg_slow_tick(), which is where the cadence is explained. Re-asserting
-- from a press handler instead does not work: the firmware's repaint comes after it.
function fftsa.icons_reassert()
  fftsa.lock_icon()
  fftsa.icon_redraw(fftsa.optimg)
  return true
end

-- The icon goes before the settle, so a settle that fails cannot leave the padlock showing
-- the opposite of fftsa.sg_lock for the rest of the session. Locking settles at once, which
-- is also the only settle a halted app gets; unlocking settles nothing.
function fftsa.toggle_lock()
  fftsa.sg_lock = not fftsa.sg_lock
  fftsa.lock_icon()
  if fftsa.sg_lock then fftsa.sg_settle() end
  return fftsa.sg_lock
end

-- A button whose icon did not load is blank but still works, so a nil here is recorded
-- rather than failing the start. Always a child of the spectrum screen, where the buttons are.
function fftsa.icon_at(x, y, name)
  if name == nil then return nil end
  local img = display.create(fftsa.sg_scr, display.OBJ_IMAGE, x, y, name)
  if img == nil then
    fftsa.lasterr = "image " .. tostring(name) .. " did not load"
    fftsa.say(fftsa.lasterr)
  end
  return img
end

-- A button with one or two icons centred over it, two being the padlock pair. The icons are
-- skipped without their button, an icon alone looking pressable and doing nothing.
function fftsa.icon_button(x, w, cmd, iw, ih, name1, name2)
  local b = display.create(fftsa.sg_scr, display.OBJ_BUTTON, x, fftsa.btn_y, " ", w)
  if b == nil then
    fftsa.lasterr = "button at x=" .. tostring(x) .. " could not be created"
    fftsa.say(fftsa.lasterr)
    return nil, nil, nil
  end
  display.setevent(b, display.EVENT_PRESS, cmd)
  local ix = x + math.floor((w - iw) / 2)
  local iy = fftsa.btn_y + math.floor((fftsa.btn_h - ih) / 2)
  return b, fftsa.icon_at(ix, iy, name1), fftsa.icon_at(ix, iy, name2)
end

-- Everything the app ever displays, created here and nowhere else. The cover comes
-- first so that no screen is ever assembled in view.
function fftsa.build()
  fftsa.loading_build()
  fftsa.loading_front()
  -- The trace buffer at sg_maxpts and not at sg_ncol, so the point count stays adjustable
  -- upwards while running without anything being resized or reallocated.
  local scr, why = fftsa.sg_build("FFT SPECTRUM ANALYSER", fftsa.n / 2,
                                  fftsa.sg_capacity())
  if scr == nil then return false, why end
  -- The buttons died with the screen fftsa.sg_build() just destroyed: clear the stale
  -- handles rather than deleting them.
  fftsa.optbtn, fftsa.optimg = nil, nil
  fftsa.lockbtn, fftsa.lockimg_c, fftsa.lockimg_o = nil, nil, nil
  fftsa.lockbtn, fftsa.lockimg_c, fftsa.lockimg_o = fftsa.icon_button(
    fftsa.btn_lock_x, fftsa.btn_lock_w,
    "if fftsa ~= nil then fftsa.guard(fftsa.toggle_lock) end",
    fftsa.lock_img_w, fftsa.lock_img_h, fftsa.img_lock_c, fftsa.img_lock_o)
  fftsa.lock_icon()
  fftsa.optbtn, fftsa.optimg = fftsa.icon_button(
    fftsa.btn_opt_x, fftsa.btn_opt_w,
    "if fftsa ~= nil then fftsa.guard(fftsa.options) end",
    fftsa.cog_img_w, fftsa.cog_img_h, fftsa.img_cog)
  local optok, optwhy = fftsa.build_options()
  if optok == false then return false, optwhy end
  local aboutok, aboutwhy = fftsa.build_about()
  if aboutok == false then return false, aboutwhy end
  return fftsa.sg_scr
end

-- The timer period is the frame plus fftsa.tick_idle of slack, rounded up to the grid
-- below. The one place the occupancy rule lives, so the modelled first arm and the measured
-- re-arms agree.
--
-- The idle is what dispatches a touch: delay() lets the display task paint, but a press
-- needs the interpreter and a tick landing during a frame is dropped. At the 0.05 s floor
-- that leaves 12 ms of 500 at 4096 samples, where Options is unreachable.
--
-- An amount and not a fraction, because dispatching a press costs about the same however
-- long the frame was, so a proportional reserve over-provisions the long counts and
-- under-provisions the short ones. It is also the display task's budget, with
-- fftsa.sg_yield, that task running only while Lua is blocked. 20 ms rather than more
-- because of where the tick boundaries fall: a larger reserve pushes the 80 ms frame and
-- 2048 samples over a multiple of 50 ms while buying nothing at the long counts. A live
-- knob -- raise it from the socket if a press gets swallowed, with no reinstall.
fftsa.tick_idle = 0.020
-- The period granularity. 0.05 is the firmware's minimum, not its resolution: on a 50 ms
-- grid a frame needing 205 ms is armed at 250, where a finer grid costs nothing.
--
-- A MID-FRAME TICK IS NOT LOST, measured 2026-11-09: a fixed 0.05 period against a 100 ms
-- frame delivered 9.92 fps, which is one frame per 100 ms and not one per 150. The firmware
-- holds one pending, so the loop self-paces at whatever the work costs, rounded up to the
-- grid. That is why tick_floor above is needed and why the period may be inaccurate but never
-- absent.
--
-- A period off the 50 ms grid posts event 1727 and is still honoured. Measured both ways:
-- 1727 fires exactly when the period is not a multiple of 0.05 -- ten periods, the seven
-- non-multiples warned and 0.05/0.10/0.25 did not -- and at 1024 an armed 0.07 delivers 13
-- to 15 fps, which is 0.07 and neither 0.05 nor 0.10. So the event says the resolution
-- cannot be relied on below 50 ms, not that the value was refused. Do not quantise this to
-- 0.05 to silence the log: it would arm 1024 at 0.10 and cost about a third of the frame
-- rate. The floor is real -- arm(0.045) is refused with event 1131.
fftsa.tick_grid = 0.010
-- EXCEPT ON A DMM7510, WHERE 1727 IS A MODAL DIALOG.
--
-- The paragraph above is a DMM6500 measurement: there the event goes to the log and the app
-- runs on. On a DMM7510 the same warning is put on the glass as a prompt with Details,
-- Suppress and OK -- over the running app, where it covers the trace, waits for a press, and
-- makes the control socket refuse every statement while it is up. Seen on two of three screen
-- grabs from a 7510 on 8.62, and the timer re-arms whenever measured work moves, so it comes
-- back.
--
-- So that model takes the 50 ms grid and the frame rate that goes with it. eventlog.suppress
-- exists in the firmware's registration table and would be the better fix -- it is what the
-- dialog's own Suppress button must reach -- but it is undocumented, with no signature and no
-- argument types recorded, and the instrument it would be guessed at on is on another
-- continent. Not raising the event needs nothing undocumented.
fftsa.tick_grid_7510 = 0.050
fftsa.tick_min  = 0.050
-- How far the period must move before a re-arm is worth it: every re-arm is a display timer
-- deleted and created against a 463-object pool, and on a 10 ms grid a period that dithers
-- by one step would re-arm for the life of the app.
fftsa.tick_rearm = 0.020
-- How far the period must rise before it is re-armed, against one grid step to fall. Wider
-- than the jitter it is meant to ignore and narrower than a size change.
fftsa.tick_rise = 0.050

-- The grid in force, which is a property of the instrument and not of the build.
function fftsa.tick_grid_now()
  if fftsa.is_7510 ~= nil and fftsa.is_7510() then return fftsa.tick_grid_7510 end
  return fftsa.tick_grid
end

-- THE PERIOD MUST EXCEED THE WORK, AND THIS IS WHERE THAT IS ENFORCED.
--
-- fftsa.tick_grid and fftsa.tick_idle are live knobs, so the period is a function of two
-- numbers a socket can set to anything. Set so that the period does not exceed the work, the
-- frame loop runs back to back and leaves NO idle -- and every button handler and every socket
-- statement is Lua, so nothing can get in at all. Measured 2026-11-09 at n=8192 by replacing
-- this function with a constant 0.05: 733 statements refused in four minutes, End App dead,
-- the hardware keys dead. ABORT freed the interpreter and took the app with it; nothing softer
-- worked.
--
-- A yield at the end of the frame is NOT the same thing and does not help: delay() blocks the
-- Lua thread, so the display task runs and the interpreter still does not.
--
-- So whatever the knobs say, the answer leaves at least tick_floor of room. Belt and braces
-- against a setting, not against a bug.
fftsa.tick_floor = 0.010

function fftsa.tick_period(busy)
  if busy == nil or busy <= 0 then return fftsa.tick_min end
  local g = fftsa.tick_grid_now()
  local ticks = math.ceil((busy + fftsa.tick_idle) / g - 0.05)
  if ticks < 1 then ticks = 1 end
  local p = ticks * g
  if p < fftsa.tick_min then p = fftsa.tick_min end
  -- Up the grid until there is room, rather than to an off-grid value: a period that is not a
  -- multiple of 0.05 posts event 1727, which is a modal prompt on a DMM7510.
  while p < busy + fftsa.tick_floor do p = p + g end
  return p
end

-- The first arm, before any frame has been timed. From here on frame() re-arms from
-- measured work.
function fftsa.frame_period(n)
  return fftsa.tick_period(fftsa.frame_estimate(n))
end

-- Arm the frame timer. It is active only while its parent screen is visible, which is
-- what stops frames while Options or About is on show. One frame per tick: back-to-back
-- frames keep the interpreter out of its event loop.
function fftsa.arm(period_s)
  if period_s == nil then period_s = 0.05 end
  if fftsa.timer ~= nil then
    fftsa.del_obj(fftsa.timer)
    fftsa.timer = nil
  end
  if fftsa.sg_scr == nil then return nil end
  -- The count the live timer was armed for, so fftsa.apply() can tell a press that needs a
  -- new period from one that does not.
  fftsa.armed_n = fftsa.n
  fftsa.timer = display.create(fftsa.sg_scr, display.OBJ_TIMER, period_s, display.TIMER_FOREVER)
  display.setevent(fftsa.timer, display.EVENT_PRESS, "if fftsa ~= nil and fftsa.frame ~= nil then fftsa.frame() end")
  return fftsa.timer
end

-- End App tears the screen set down and nils every handle, so nothing is carried across a
-- launch. A handle does not survive one: reusing one answers 1703, object ID is invalid,
-- and this teardown is what makes the next launch safe by leaving nothing to reach for.
-- Nor can a launch check first -- every display call on a dead handle posts that same 1703
-- and raises a modal dialog over a half-built app, so no probe costs less than the fault.
function fftsa.cleanup()
  fftsa.stop()
end

-- Hooked as soon as the spectrum screen exists, so a later startup failure still
-- leaves a way out that cleans up.
function fftsa.install_cleanup()
  if fftsa.sg_scr == nil then return false end
  local ok, err = pcall(function()
    display.setevent(fftsa.sg_scr, display.EVENT_ENDAPP, "if fftsa ~= nil then fftsa.cleanup() end")
  end)
  if not ok then fftsa.lasterr = "ENDAPP hook failed: " .. tostring(err) end
  return ok
end

-- One cleanup path for a failed start, so the two ways of failing cannot drift apart.
function fftsa.start_failed(why)
  fftsa.lasterr = tostring(why)
  fftsa.stop()
  print("fftsa start FAILED (cleaned up): " .. tostring(why))
  -- No console as an installed App, so the failure goes on the panel.
  fftsa.show_error(tostring(why))
  return false
end

-- Startup, guarded end to end so a failure part-way leaves nothing without a teardown.
-- The opening fftsa.stop() reclaims a previous launch's handles: as an installed App the
-- script re-runs on every open, and an exit that skipped EVENT_ENDAPP (the Home screen,
-- another App) leaves them behind. fftsa.cleanup() says why they are never reused.
function fftsa.start()
  fftsa.stop()
  fftsa.halted, fftsa.errrun, fftsa.stop_pending = false, 0, false
  -- Cleared per launch, because fftsa survives one: left set, the freeze diagnostic would
  -- bail out of the next launch's first frame and nothing would ever be drawn.
  fftsa.froze = false

  -- The refusal the capability gate promised, before anything is built: otherwise the first
  -- dsp.* write is inside apply(), so the whole screen set is created and torn down again
  -- by start_failed, and that cycle risks part of the 463-object pool until a power cycle.
  if fftsa.dsp_absent then
    return fftsa.start_failed("no DSP implementation: the archive was built without "
                              .. "dsp_lua.tsp and this instrument has no dsp module")
  end

  -- The display object pool running out is a return and not a raise: display.create answers
  -- nil and posts one event, and build() passes that up as false and a reason. Handled here
  -- rather than raised into the boundary below, which would report a condition to itself.
  local built, why = fftsa.build()
  if built == false then return fftsa.start_failed(why or "build failed") end

  local hooked = fftsa.install_cleanup()
  -- The opening count, chosen before the only Apply start() runs, so it costs no second
  -- capture. Both names move together or Reset would restore a count this never opened at.
  if fftsa.native_likely() then
    fftsa.n = fftsa.n_compiled
    fftsa.defaults.n = fftsa.n_compiled
  end
  -- The boundary that remains: apply() is arithmetic over tables fft_init builds, so a
  -- defect in this code raises here, and a raise escaping a timer or button callback posts
  -- -286 and leaves the app on screen and dead. The period is settled here and the timer
  -- created at the end of start(), after the screen is on show.
  local ok, err = pcall(function()
    fftsa.apply()
    fftsa.period = fftsa.frame_period(fftsa.n)
  end)
  if not ok then return fftsa.start_failed(tostring(err)) end

  -- Initialise the native DSP path. nl.ready stays false if the binary is not in the
  -- archive, if the install fails, or if this boot has already installed heap code: a second
  -- install wedges the interpreter, so nl.init refuses one, and start() runs on every app
  -- start. Every one of those leaves the app with no transform at all.
  --
  -- Sized for fftsa.nl_nmax and not fftsa.n: the arena is built once per boot and nl.reinit
  -- re-plans inside it, so a sample-count press costs one call rather than another install.
  -- nl_replan() below plans for the count actually selected.
  --
  -- The window and beta are passed anyway, because a refusal between here and that replan
  -- would leave the plan on its defaults -- n = 512 and DSP_WINDOW_HANN, a spectrum of the
  -- wrong length with the wrong taper while the panel shows the operator's choices.
  -- win_to_native is the native enum map, not fftsa.win_to_dsp.
  --
  -- The trace point ceiling is sg_maxpts rather than the count in force, so raising sg_ncol
  -- while the app runs needs no reinstall either.
  --
  -- nil for the barrier buffer: nl.init barriers on a buffer it fills itself, and fftsa.cap
  -- holds no readings until the first capture, where buffer.getstats need not make the
  -- service-task call the barrier depends on -- which bluescreens from this call site.
  --
  -- Inside the same boundary as apply() above, for the same reason and not as a new habit:
  -- init is several hundred lines of our own arithmetic over tables, byte offsets and
  -- strings, so a defect in it raises rather than returning. Outside a boundary that raise
  -- leaves the app dead with nothing on the glass; inside one the error page names it, and on
  -- a model nobody here can run that is the difference between a report and a shrug. One such
  -- defect was real -- a negative byte reaching string.char in the ring finder -- and it was
  -- found by reading the code rather than by a photograph of a blank screen.
  if fftsa.nl ~= nil and type(fftsa.nl.init) == 'function' then
    local iok, ierr = pcall(function()
      fftsa.nl.init(nil, fftsa.nl_nmax, fftsa.nl.win_to_native(fftsa.win_i),
                    fftsa.kbeta(fftsa.kbeta_i), 1, fftsa.nl.FFT_FOURSTEP,
                    fftsa.sg_maxpts)
      fftsa.nl_replan()
    end)
    -- Refused rather than run: a raise part-way through the plan leaves the arena in a state
    -- nothing has checked, and a wrong plan is a wrong spectrum drawn confidently. NLBOOT is
    -- already claimed by then, so there is no install to protect either.
    if not iok then
      fftsa.nl.ready = false
      fftsa.nl.why = 'init raised: ' .. tostring(ierr)
    end
  end
  -- No implementation at all is a refusal, not twenty error frames a second: the archive
  -- ships no interpreted transform, so without the compiled path every frame would post
  -- EUNSUPPORTED behind a panel that looks like it is working.
  --
  -- What counts as not having come up is an installed and planned image -- nl.ready and a
  -- resolved entry point -- and not fftsa.nl_usable(), which is the per-frame test and
  -- includes the cached capture descriptor. nl_bind() rebuilds that on every Apply, so a
  -- cold one is recoverable and refusing the launch over it throws away a working install.
  -- Every term is in the message, nl_lasterr alone reading "nil" on the one failure it is
  -- there to explain.
  if fftsa.fft_init == nil
     and (fftsa.nl == nil or not fftsa.nl.ready
          or fftsa.nl.entry == nil or fftsa.nl.entry == 0) then
    local nl = fftsa.nl
    local why = "nl absent"
    if nl ~= nil then
      -- nl.diag() carries the whole native-path state: model, firmware, which refusal fired,
      -- the heap anchor and swept windows, the glue census and all six libm entries by name.
      -- A model we cannot test on reports by photographing this screen, so everything needed
      -- to place the failure has to be on it.
      why = nl.diag()
      if fftsa.nl_lasterr ~= nil then why = why .. " | bind=" .. tostring(fftsa.nl_lasterr) end
    end
    -- No prose and no instruction. The page is a diagnostic read by whoever fixes the app,
    -- 119 characters of sentence here cost a line and a half of the figures that place the
    -- fault, and "power cycle and try again" does not help a model the app has never run on.
    return fftsa.start_failed("NODSP nofallback " .. why)
  end
  if not hooked then
    print("fftsa WARNING: End App cleanup not hooked -- " .. tostring(fftsa.lasterr))
    display.settext(fftsa.sg_xunit, "WARNING: End App will not clean up")
  end
  print("fftsa started fs=" .. fftsa.fs .. " bin=" .. fftsa.binhz ..
        " range=" .. fftsa.range .. " window=" .. fftsa.win_label())
  -- Here and not earlier: the native path is settled by now, so what goes on the About pages
  -- is the state the app is actually running with. Under pcall because this is reporting and
  -- a failure in it must not fail a start that otherwise succeeded.
  pcall(fftsa.about_add_diag)
  -- Switching away from the cover is what starts the frames: the timer only runs
  -- while the screen it is parented to is the one on show. The cover itself stays
  -- allocated until fftsa.stop(), since Apply raises it again.
  fftsa.show_main()
  -- The widget's first draw of this trace gets a window of its own before any frame can
  -- clear the buffer under it: the switch above is that draw, and a frame opens with
  -- tb.clear(). Creating the timer after the yield rather than only yielding keeps the
  -- ordering independent of whether delay() dispatches timer callbacks. Under pcall because
  -- display.create answers nil on an exhausted pool and the setevent would then raise.
  delay(fftsa.sg_first_paint)
  local aok, aerr = pcall(function() fftsa.arm(fftsa.period) end)
  if not aok then return fftsa.start_failed(tostring(aerr)) end
  return true
end

function fftsa.stop()
  -- Not underneath a running frame, which would be left writing into a deleted
  -- buffer: defer once (fftsa.frame() runs the pending stop as it finishes), then
  -- proceed regardless, so a stuck guard cannot make the app impossible to stop.
  if fftsa.busy and not fftsa.stop_pending then
    fftsa.stop_pending = true
    return false
  end
  fftsa.stop_pending = false
  -- Timer first: stop frames before removing what the frames use.
  if fftsa.timer ~= nil then fftsa.del_obj(fftsa.timer) end
  fftsa.timer = nil
  fftsa.optbtn, fftsa.optimg = nil, nil       -- children of the spectrum screen
  fftsa.lockbtn, fftsa.lockimg_c, fftsa.lockimg_o = nil, nil, nil
  -- The plan goes with the app. Natively it is one arena and the app is relaunchable, so an
  -- arena nobody releases is leaked per launch for the rest of the power cycle. Under pcall
  -- for the same reason sg_destroy is: a stop that raises leaves the rest of the teardown
  -- undone. The cost is that the next launch rebuilds the tables, paid behind the loading
  -- cover because start() runs apply() before it switches away.
  pcall(function() dsp.release() end)
  -- release: the trace buffers are deleted and defbuffer1 made current again, rather than
  -- handed to a next launch. sg_destroy() says why the two callers differ.
  pcall(function() fftsa.sg_destroy(true) end)   -- screen, graph, texts, trace buffers
  fftsa.destroy_options()
  fftsa.destroy_about()
  fftsa.loading_destroy(display.SCREEN_HOME)
  fftsa.del_scr(fftsa.errscr)
  fftsa.errscr = nil
  -- The capture buffer is kept, for the life of the power cycle and across every launch:
  -- apply() reuses it whenever its capacity serves, and the floor makes that every count,
  -- so one allocation is all the app ever makes. A new buffer has new storage, so
  -- nl.describe() could not answer from its cache and would sweep the heap again. The price
  -- is 65,536 readings held until the power cycle, the same trade sg_destroy() makes for the
  -- trace pair.
  --
  -- The pending re-plan goes with the app. Two stops under one frame reach the teardown from
  -- the second call, which clears stop_pending, and fftsa.frame() would then find the flag
  -- set with nothing left to retune -- where apply() strands a fresh capture buffer on a
  -- screen that is already gone. It also keeps a gesture from the previous launch off the
  -- next one's first frame, fftsa.start() opening with a stop().
  fftsa.busy, fftsa.halted, fftsa.errrun = false, false, 0
  fftsa.retune_pending, fftsa.armed_n = false, nil
  return true
end

-- The error page's text block.
--
-- A SCREEN GRAB IS THE ONLY CHANNEL. The operator reporting a DMM7510 failure is on another
-- continent, so everything needed to place the fault has to be legible on the glass, and a
-- round trip to ask for one more figure costs a day. That is what sets this layout.
--
-- Laid out against the panel geometry measured in notes/HANDOFF-2026-10-31.md, not against
-- the display reference, which omits all of it:
--
--   an OBJ_TEXT y is NOT the baseline -- the ink starts 37 px BELOW it for a 17 px font
--   a button's y is 50 px ABOVE its face, so opt_btn_y 360 renders at 410..469
--   FONT_1 is 17 px ink at about 7.8 px a character, FONT_SMALL 17 px at about 9.4
--
-- So FONT_1 holds 92 columns where FONT_SMALL holds 80, at the same height. Thirteen rows
-- from y=103 at a pitch of 20 put their ink in 140..397, which clears the More button's face
-- below them and the headline above. 1196 characters a page against the 1040 the old single
-- pass showed before dropping the rest in silence.
fftsa.err_y0, fftsa.err_dy, fftsa.err_rows, fftsa.err_cols = 103, 20, 13, 92
fftsa.err_foot_y = 420

-- The instrument, for the error page's headline. Both attributes are read behind a guard and
-- neither is allowed to stop the page being built: an instrument that will not say which
-- model it is still has to be able to report why the app would not start.
function fftsa.node_str()
  local m, v = nil, nil
  if localnode ~= nil then m, v = localnode.model, localnode.version end
  if m == nil then m = '?model' end
  if v == nil then v = '?fw' end
  return tostring(m) .. ' ' .. tostring(v)
end

-- Wrap a diagnostic into lines of at most cols characters, broken only on spaces.
--
-- The message is mostly addresses and key=value pairs, and a value split across two lines is
-- the one that gets transcribed wrong -- so a break lands on a space unless the window holds
-- none, which is a single long run and has to be cut somewhere. Returns every line: what to
-- do about a message longer than the glass is the caller's decision, and making it here is
-- how the old version came to drop 11 lines of a 7510 report without saying so.
function fftsa.err_wrap(msg, cols)
  local m = tostring(msg)
  if cols == nil or cols < 8 then cols = 8 end
  local out, n = {}, 0
  local i, len = 1, string.len(m)
  while i <= len do
    local stop = i + cols - 1
    if stop < len then
      -- The character past the window counts: a space there means the window is exactly a
      -- whole number of words and the full width is usable.
      local cut, k = nil, stop + 1
      while k > i do
        if string.sub(m, k, k) == ' ' then cut = k break end
        k = k - 1
      end
      if cut ~= nil then stop = cut - 1 end
    else
      stop = len
    end
    n = n + 1
    out[n] = string.sub(m, i, stop)
    i = stop + 1
    -- The run of spaces at the break is the break. Carrying one onto the next line would
    -- shift the whole page right by a character.
    while i <= len and string.sub(m, i, i) == ' ' do i = i + 1 end
  end
  return out
end

-- Show one page of the wrapped message. settext rather than create, because the objects were
-- built with page 1's text while the screen was still being assembled: this only ever runs
-- from the More button, long after the screen became current and painted.
function fftsa.err_show_page(p)
  local lines = fftsa.err_text
  if lines == nil or fftsa.err_row == nil then return false end
  local rows = fftsa.err_rows
  local npg = math.floor((table.getn(lines) + rows - 1) / rows)
  if npg < 1 then npg = 1 end
  if p == nil or p < 1 or p > npg then p = 1 end
  fftsa.err_page = p
  local i
  for i = 1, rows do
    local t = lines[(p - 1) * rows + i]
    display.settext(fftsa.err_row[i], t or '')
  end
  if fftsa.err_pageno ~= nil then
    display.settext(fftsa.err_pageno, 'page ' .. tostring(p) .. ' of ' .. tostring(npg))
  end
  return true
end

-- One button, wrapping back to page 1 at the end, so the whole report is reachable without
-- two more objects on a screen that exists because the pool may already be short.
function fftsa.err_more()
  return fftsa.err_show_page((fftsa.err_page or 1) + 1)
end

-- Startup failure on the panel. End App is hooked here too and the handle kept, so stop()
-- can delete the screen.
--
-- The commonest reason startup fails is an exhausted pool, and display.create then answers
-- nil here too: unguarded, every child is built against a nil parent and changescreen(nil)
-- raises, leaving a blank panel in the one case this screen exists for. Nothing can be
-- drawn then, so it goes to the console instead.
--
-- These children are created on a visible screen, which nothing else in the app does: it
-- runs once, after startup has failed, and the cover is gone by then.
-- stay says the caller still has a screen worth leaving on the glass.
--
-- A build that fails here has nowhere to put the report, and for a STARTUP failure the only
-- coherent move is the home screen -- the app's own screens are half built or absent. For a
-- MID-RUN halt it is the opposite: the spectrum screen is intact and showing, the settings
-- line already carries the short reason, and the home screen is a live measurement whose
-- reading explains nothing. So the caller says which it is rather than this guessing from
-- whichever handles happen to be non-nil.
function fftsa.show_error(msg, stay)
  -- The build, then the diagnostic, and no prose in between. This page is read by whoever is
  -- fixing the app and not by whoever is standing in front of the instrument, so a sentence
  -- here costs characters that a hex word would have used -- and the version is the one thing
  -- that cannot be recovered from the rest, a report being matched to a fix by it alone.
  local full = 'v' .. tostring(fftsa.VERSION) .. ' ' .. tostring(msg)
  local shown = pcall(function()
    if fftsa.errscr ~= nil then
      fftsa.del_obj(fftsa.errscr)
      fftsa.errscr = nil
    end
    fftsa.errscr = display.create(display.ROOT, display.OBJ_SCREEN, "FFT ANALYSER ERROR")
    if fftsa.errscr == nil then
      -- No screen to report on, so the console is all there is. Returning rather than
      -- raising, the caller already handling a failure.
      print("fftsa: object pool exhausted; no error screen")
      return false
    end
    -- The headline is three facts, not a sentence: the app build, the model and the firmware.
    -- Those three place every report, and they go here rather than only inside the native
    -- path's own diagnostic because startup can fail where that diagnostic is never built --
    -- an exhausted object pool, a refused capture -- and a report with no firmware version on
    -- it cannot be compared against the images on disk.
    display.create(fftsa.errscr, display.OBJ_TEXT, 20, 68,
                   "FFT " .. tostring(fftsa.VERSION) .. "  " .. fftsa.node_str(),
                   16736352,                                    -- red FF6060
                   display.FONT_MEDIUM, display.JUST_LEFT)
    fftsa.err_text = fftsa.err_wrap(full, fftsa.err_cols)
    fftsa.err_page = 1
    fftsa.err_row = {}
    local y, i = fftsa.err_y0, nil
    for i = 1, fftsa.err_rows do
      fftsa.err_row[i] = display.create(fftsa.errscr, display.OBJ_TEXT, 20, y,
                                        fftsa.err_text[i] or '',
                                        14737632,               -- light grey E0E0E0
                                        display.FONT_1, display.JUST_LEFT)
      y = y + fftsa.err_dy
    end
    -- What the old page did silently: a report longer than the glass left no sign that it
    -- had been cut, so a 7510 screen grab was a diagnostic with the end missing and no way
    -- to tell it was missing. Now the count is on the glass and the button reaches the rest.
    local npg = math.floor((table.getn(fftsa.err_text) + fftsa.err_rows - 1)
                           / fftsa.err_rows)
    local foot = "End App exits"
    if npg > 1 then
      fftsa.err_pageno = display.create(fftsa.errscr, display.OBJ_TEXT, 470, 76,
                                        'page 1/' .. tostring(npg), 9474192,
                                        display.FONT_1, display.JUST_LEFT)
      local b = display.create(fftsa.errscr, display.OBJ_BUTTON, 630, fftsa.opt_btn_y,
                               "More", 140)
      display.setevent(b, display.EVENT_PRESS,
                       "if fftsa ~= nil then fftsa.err_more() end")
      -- Said explicitly, because the report comes back as a grab of whatever was on the
      -- glass: an operator who does not know there are more pages sends one of three.
      foot = "More -> next page, and grab every page.  " .. foot
    end
    display.create(fftsa.errscr, display.OBJ_TEXT, 20, fftsa.err_foot_y, foot,
                   9474192,                                        -- grey 909090
                   display.FONT_1, display.JUST_LEFT)
    display.setevent(fftsa.errscr, display.EVENT_ENDAPP, "if fftsa ~= nil then fftsa.cleanup() end")
    display.changescreen(fftsa.errscr)
  end)
  if not shown or fftsa.errscr == nil then
    fftsa.errscr = nil
    -- HOME only when there is no screen of this app's to stay on, which means a failure during
    -- the build. The home screen is a LIVE MEASUREMENT: switching a running app to it hands
    -- the measurement subsystem back to the front panel, which reconfigures the digitizer, and
    -- the app's next capture fails. Doing that to report a halt would replace a diagnostic the
    -- operator could photograph with a reading that explains nothing.
    if not stay then display.changescreen(display.SCREEN_HOME) end
    print("fftsa: could not build the error screen either -- " .. full)
  end
  return fftsa.errscr
end


-- ==================== TTI App entry point ====================
-- fftsa.start() builds the screens, hooks End App (EVENT_ENDAPP -> fftsa.cleanup)
-- as soon as the spectrum screen exists, configures the hardware and arms the
-- frame timer -- all under pcall, so a failure part-way through tears its own
-- display objects back down instead of stranding them until the next power cycle.
fftsa.start()
endscript
loadimage fft_icon FFT_Spectrum
