loadscript FFT_Spectrum
-- $Title: FFT Spectrum Analyser
-- $Product: DMM6500, DAQ6510, DMM7510
-- $Tag: FFT, Spectrum, Digitize, Audio
-- $Description: On-instrument FFT spectrum analyser: digitize mode + FFT with a live graph, top-6 peaks, and a touch options form (start/stop frequency, input range).
-- $Version: 2.1
-- $Requires: 1.7.0
-- $Icon: fft_icon

-- ================= tsp/fft_core.tsp =================
-- fft_core.tsp -- real-input FFT for the DMM6500's TSP (Lua 5.0.2)
--
-- fftsa.fft_init() builds everything loop-invariant once: the analysis window, the
-- bit-reversal swap list, the butterfly twiddles, the untangle twiddles and the two
-- peak-interpolation tables. The real input is packed into N/2 complex points,
-- z[k] = x[2k-1] + i*x[2k], an N/2-point transform runs on those, and one untangle
-- pass recovers the N/2 bins as power (|X|^2, volts-squared peak). The display works
-- in dB, so anything that wants volts takes the square root at the point of use.
-- tools/test_tsp.lua checks the result against a direct DFT.
--
-- Lua 5.0.2: no '#' operator (table.getn), no hex literals, no bitwise operators.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.fft_n      = 0      -- number of samples N (power of two)
fftsa.fft_m      = 0      -- N/2: the complex transform size, and the number of bins
fftsa.fft_x      = nil    -- raw samples 1..N, staged between the two load passes
fftsa.fft_re     = nil    -- packed complex working array, real parts, 1..M
fftsa.fft_im     = nil    -- imaginary parts, 1..M
fftsa.fft_win    = nil    -- analysis window, 1..N
fftsa.fft_pwr    = nil    -- power output, 1..M, volts-squared (peak)
fftsa.fft_swp_a  = nil    -- bit-reversal swap pairs over 1..M
fftsa.fft_swp_b  = nil
fftsa.fft_nswp   = 0
fftsa.fft_twr    = nil    -- flattened butterfly twiddles, stage-major
fftsa.fft_twi    = nil
fftsa.fft_utr    = nil    -- untangle twiddles e^(-2*pi*i*k/N), k = 0..M-1
fftsa.fft_uti    = nil
-- Coherent gain, the mean window sample. A window identity worth pinning, and
-- tools/test_tsp.lua and tools/make_refs.lua do; no shipped module reads it. The
-- amplitude calibration is fftsa.fft_ksq, from the window sum.
fftsa.fft_cg     = 0.5
fftsa.fft_ksq    = 0      -- power scale applied to the untangled |2X|^2

-- ============================ analysis windows ============================
-- Every entry is a generalised cosine sum except Kaiser, which is the one with a
-- knob: beta trades main-lobe width against sidelobe level, so it spans the named
-- windows and goes past them. Rectangular is deliberately absent -- its transform
-- has a null one bin from the peak, which leaves the three-bin interpolation below
-- ill-conditioned, so the peak readings would be wrong in a way the trace does not
-- show.
-- No Hamming: it exits the app on the instrument and the mechanism was never found.
-- Kaiser at beta 6 covers it to within a dB of sidelobe level and a fraction of a bin of
-- main-lobe width.
fftsa.win_names = {"Hann", "Blackman", "Blk-Harris", "Kaiser"}
-- Index-parallel to fftsa.win_names, coefficients a0 - a1*cos + a2*cos2 - a3*cos3.
-- Kaiser has no entry, which is how fftsa.win_build() tells it apart.
fftsa.win_cos = {
  {0.5, 0.5},
  {0.42, 0.5, 0.08},
  {0.35875, 0.48829, 0.14128, 0.01168},
}
fftsa.win_i = 1             -- index into fftsa.win_names

-- Kaiser beta as a fixed list rather than a typed number: every value here is
-- verified for peak frequency and amplitude in tools/test_tsp.lua, and a typed beta
-- would admit shapes nothing has measured. The floor is 4 because the first null
-- sits at sqrt(1 + (beta/pi)^2) bins, which has to stay outside 1.5 bins for the
-- interpolation to read main lobe rather than sidelobe: beta 3.5 is the boundary.
-- Labels carry the measured peak sidelobe level, that being what beta buys.
fftsa.kbetas       = {4, 6, 9, 12, 15, 18}
fftsa.kbeta_labels = {"4  -30dB", "6  -44dB", "9  -66dB",
                      "12  -90dB", "15  -114dB", "18  -139dB"}
fftsa.kbeta_i      = 4      -- index into fftsa.kbetas

function fftsa.kbeta(bi)
  local b = fftsa.kbetas[bi or fftsa.kbeta_i]
  if b == nil then b = fftsa.kbetas[1] end
  return b
end

function fftsa.win_name(wi)
  wi = wi or fftsa.win_i
  return fftsa.win_names[wi] or fftsa.win_names[1]
end

-- Window name for a readback line, with beta where beta applies.
-- Defaults to the applied window; the options preview passes the field values so the
-- whole line describes one state rather than two.
function fftsa.win_label(wi, bi)
  wi = wi or fftsa.win_i
  if fftsa.win_cos[wi] ~= nil then return fftsa.win_name(wi) end
  return fftsa.win_name(wi) .. " b=" .. tostring(fftsa.kbeta(bi))
end

-- I0 by its power series, sum of ((x/2)^k / k!)^2. The term ratio is (x/2)^2/k^2, so
-- beta 18 converges inside 40 terms. Evaluated N/2 times per fftsa.fft_init() and
-- never per frame.
function fftsa.bessel_i0(x)
  local hh = (x / 2) * (x / 2)
  local t, s = 1, 1
  for k = 1, 40 do
    t = t * hh / (k * k)
    s = s + t
    if t < s * 1e-17 then return s end
  end
  return s
end

-- Build fftsa.fft_win and the amplitude scale from it. Symmetric, so only half the
-- samples are computed. The scale comes from the window sum, and assuming N/2 for
-- Hann rather than summing it reads every amplitude 0.2 % low at N = 512.
function fftsa.win_build(N)
  local cos, sqrt, floor, pi = math.cos, math.sqrt, math.floor, math.pi
  local w    = {}
  local c    = fftsa.win_cos[fftsa.win_i]
  local half = floor((N + 1) / 2)
  if c ~= nil then
    local a0, a1, a2, a3 = c[1], c[2] or 0, c[3] or 0, c[4] or 0
    local step = 2 * pi / (N - 1)
    for i = 1, half do
      local t = step * (i - 1)
      local v = a0 - a1*cos(t) + a2*cos(2*t) - a3*cos(3*t)
      w[i] = v
      w[N + 1 - i] = v
    end
  else
    local b   = fftsa.kbeta()
    local i0b = fftsa.bessel_i0(b)
    for i = 1, half do
      local u = 2*(i-1)/(N-1) - 1
      local s = 1 - u*u
      if s < 0 then s = 0 end
      local v = fftsa.bessel_i0(b * sqrt(s)) / i0b
      w[i] = v
      w[N + 1 - i] = v
    end
  end
  fftsa.fft_win = w
  local wsum = 0
  for i = 1, N do wsum = wsum + w[i] end
  fftsa.fft_wsum = wsum           -- fftsa.fft_load() divides by it to weight the mean
  fftsa.fft_cg = wsum / N
  -- Volts would be 2/(N*cg); the untangle leaves every bin doubled, so 1/(N*cg),
  -- squared because the output is power.
  local k = 1 / wsum
  fftsa.fft_ksq = k * k
  return w
end

-- ===================== peak interpolation, per window =====================
-- A tone at bin k+d puts the three bins around the peak at -d, 1-d and 1+d on the
-- window's own transform, so with
--   G(x) = |sum w[i]*cos(2*pi*x*(i-c)/N)| / sum w[i],    c = (N+1)/2
-- the normalised main lobe, the ratio r = (R-L)/(L+2C+R) is a fixed odd function of
-- d, and the scalloping loss is exactly G(d). fftsa.fft_gtab samples G out to 1.5
-- bins and fftsa.fft_dtab is r -> d, inverted from it at init.
--
-- Both come from the window samples in use, so a window change needs no new
-- constants and the symmetric-window correction falls out instead of being assumed.
-- The grids are chosen so that d, 1-d and 1+d all land on gtab nodes.
fftsa.fft_ghx  = 0.025    -- gtab step, in bins
fftsa.fft_gn   = 60       -- gtab spans 0 .. fft_gn*fft_ghx = 1.5 bins
fftsa.fft_dn   = 40       -- dtab nodes, spaced uniformly in r
fftsa.fft_gtab = nil
fftsa.fft_dtab = nil
fftsa.fft_dhr  = 0        -- dtab step in r; 0 means there is no usable table
fftsa.win_mono = false    -- r(d) rose all the way to half a bin

-- Bins above DC that the mean removal in fftsa.fft_load() makes unreportable, and
-- the amplitude error that decides which they are. Set by fftsa.win_tables(), read
-- by fftsa.find_peaks(). 0 before the first fftsa.fft_init().
fftsa.fft_dctol = 0.05    -- 5 % of amplitude, 0.45 dB
fftsa.fft_kdc   = 0
fftsa.fft_kdcn  = 6       -- bins scanned; covers Kaiser b=18's 5.82-bin main lobe

-- Costs (fft_gn+1)*N/2 cosines at init and nothing per frame.
function fftsa.win_tables(N)
  local cos, floor = math.cos, math.floor
  local w   = fftsa.fft_win
  local M2  = floor(N / 2)            -- N is a power of two, so every sample pairs
  local ctr = (N + 1) / 2
  local hx  = fftsa.fft_ghx
  local nx  = fftsa.fft_gn
  local wsum = 0
  for i = 1, M2 do wsum = wsum + w[i] end
  wsum = 2 * wsum

  local g = {}
  local twopi_N = 2 * math.pi / N
  for j = 0, nx do
    local a = twopi_N * j * hx
    local s = 0
    for i = 1, M2 do s = s + w[i] * cos(a * (i - ctr)) end
    s = 2 * s / wsum
    if s < 0 then s = -s end
    g[j+1] = s
  end
  fftsa.fft_gtab = g

  -- r at every d node. one and nd are node counts, not lengths: 1 bin and half a bin.
  local one = floor(1/hx + 0.5)
  local nd  = floor(0.5/hx + 0.5)
  -- The grid has to reach 1 + 0.5 bins, and at the shipped values it reaches exactly
  -- that. Shrinking fft_gn without raising fft_ghx would read past the end of gtab
  -- and do arithmetic on a nil, so it fails here instead.
  if one + nd > nx then
    error("fft_gn " .. nx .. " is too small for fft_ghx " .. hx
          .. ": the gain table must reach 1.5 bins", 0)
  end
  local rt  = {}
  for jd = 0, nd do
    local C, R, L = g[jd+1], g[one-jd+1], g[one+jd+1]
    rt[jd+1] = (R - L) / (L + 2*C + R)
  end

  -- Invert onto a grid uniform in r, so a lookup is an index rather than a search.
  local mono = true
  for jd = 1, nd do
    if rt[jd+1] <= rt[jd] then mono = false end
  end
  fftsa.win_mono = mono
  local nr   = fftsa.fft_dn
  local rmax = rt[nd+1]
  local dt   = {}
  if mono and rmax > 0 then
    local hr = rmax / nr
    local jd = 0
    for m = 0, nr do
      local target = m * hr
      while jd < nd - 1 and rt[jd+2] < target do jd = jd + 1 end
      local r0, r1 = rt[jd+1], rt[jd+2]
      local f = 0
      if r1 > r0 then f = (target - r0) / (r1 - r0) end
      dt[m+1] = (jd + f) * hx
    end
    dt[nr+1] = nd * hx                -- the top of the table is exactly half a bin
    fftsa.fft_dhr = hr
  else
    fftsa.fft_dhr = 0
  end
  fftsa.fft_dtab = dt

  -- How far up from DC fftsa.fft_load()'s mean removal reaches, which is where
  -- fftsa.find_peaks() stops reporting. Removing a weighted mean of
  -- D + A*G(b)*cos(phase) takes 2*A*G(b)^2 out of the tone's own bin: at bin 1 a
  -- 1.000 V tone reads 0.589 V under Hann. The largest b, not the first, since G is
  -- not monotonic.
  local kdc = 0
  for b = 1, fftsa.fft_kdcn do
    local a = twopi_N * b
    local s = 0
    for i = 1, M2 do s = s + w[i] * cos(a * (i - ctr)) end
    s = 2 * s / wsum
    if 2 * s * s > fftsa.fft_dctol then kdc = b end
  end
  fftsa.fft_kdc = kdc
  return g, dt
end

-- Scalloping loss at offset d: the factor a tone's amplitude is read low by.
function fftsa.win_gain(d)
  local g = fftsa.fft_gtab
  if g == nil then return 1 end
  if d < 0 then d = -d end
  local t = d / fftsa.fft_ghx
  local m = math.floor(t)
  if m >= fftsa.fft_gn then return g[fftsa.fft_gn + 1] end
  local a = g[m+1]
  return a + (t - m) * (g[m+2] - a)
end

-- Sub-bin offset from the three-bin ratio r, by table inversion. Past the end of the
-- table the three bins are not one tone, and the offset saturates at half a bin.
function fftsa.win_offset(r)
  local hr = fftsa.fft_dhr
  if hr == nil or hr <= 0 then return nil end
  local neg = false
  if r < 0 then r = -r; neg = true end
  local nr = fftsa.fft_dn
  local d
  local t = r / hr
  local m = math.floor(t)
  if m >= nr then
    d = fftsa.fft_dtab[nr+1]
  else
    local a = fftsa.fft_dtab[m+1]
    d = a + (t - m) * (fftsa.fft_dtab[m+2] - a)
  end
  if neg then return -d end
  return d
end

function fftsa.fft_init(N)
  local floor, sin, cos, pi = math.floor, math.sin, math.cos, math.pi
  local M = floor(N / 2)
  fftsa.fft_n   = N
  fftsa.fft_m   = M
  fftsa.fft_x   = {}
  fftsa.fft_re  = {}
  fftsa.fft_im  = {}
  fftsa.fft_pwr = {}

  fftsa.win_build(N)
  fftsa.win_tables(N)

  -- Bit-reversal as a swap list; only the pairs that move are kept.
  fftsa.fft_swp_a = {}
  fftsa.fft_swp_b = {}
  local n = 0
  local j = 0
  for i = 0, M-2 do
    if i < j then
      n = n + 1
      fftsa.fft_swp_a[n] = i + 1
      fftsa.fft_swp_b[n] = j + 1
    end
    local kk = floor(M/2)
    while kk <= j do j = j - kk; kk = floor(kk/2) end
    j = j + kk
  end
  fftsa.fft_nswp = n

  -- Butterfly twiddles for every stage, flattened: the stage with half-length h
  -- occupies the next h entries.
  fftsa.fft_twr = {}
  fftsa.fft_twi = {}
  local idx = 0
  local len = 4                  -- stage 1 (len=2) needs no twiddles
  while len <= M do
    local half = floor(len/2)
    local ang  = -2*pi/len
    for m = 0, half-1 do
      idx = idx + 1
      fftsa.fft_twr[idx] = cos(ang*m)
      fftsa.fft_twi[idx] = sin(ang*m)
    end
    len = len * 2
  end

  fftsa.fft_utr = {}
  fftsa.fft_uti = {}
  local ang = -2*pi/N
  for jj = 1, M do
    fftsa.fft_utr[jj] = cos(ang*(jj-1))
    fftsa.fft_uti[jj] = sin(ang*(jj-1))
  end
end

-- Load N samples from a reading buffer, remove DC, window, and pack sample pairs
-- into the M complex points. Two passes, because the mean must be known before it
-- is subtracted; the samples are staged in fftsa.fft_x since a buffer element costs
-- far more to read than a table entry. Returns the mean (DC level).
--
-- The mean is window-weighted, sum(w*x)/sum(w). What has to be zero is the DC of
-- the sequence the transform sees, sum(w*(x-m)) = sum(w*x) - m*sum(w), and only the
-- weighted mean makes it vanish. The arithmetic mean zeroes the true DC instead,
-- leaving the window's own DC response spread over the first few bins as G(k):
-- measured, a 1.000 V tone at bin 10.5 leaves a -27 dBc line at bin 1 under every
-- window, against -147 here, and Kaiser b=18's sidelobes are at -139.
--
-- The price is that near DC the estimate is the tone. fftsa.win_tables() measures
-- how far that reaches and fftsa.find_peaks() stops reporting there; nothing
-- separates a pedestal from a tone inside one lobe of DC.
-- The display task shares this core with the interpreter and runs only while Lua is
-- blocked, so a stretch of Lua with no delay() in it is a stretch in which a touch cannot
-- be dispatched -- and at 16384 samples fft_load and fft_run are 0.5 s and 0.8 s of
-- arithmetic. Hence many yield points rather than one long one: each costs fft_yield plus
-- a call, and they sit where the enclosing loop is cheap -- per chunk in fft_load, per
-- stage in fft_run -- so the per-sample inner loops are untouched. Both gates are sized
-- so the default 512 samples reaches neither.
fftsa.fft_yield     = 0.005   -- seconds blocked at a yield point
fftsa.fft_yield_n   = 2048    -- fft_load samples between yields
fftsa.fft_yield_m   = 1024    -- fft_run yields per stage only above this half-length

-- ---------- band-pass: low-pass the capture and decimate to the span ----------
--
-- WHAT IT BUYS IS BIN WIDTH. Acquire M samples at the hardware rate, filter, keep every
-- Dth: the result is N samples at fs/D, so the bin is fs/M rather than fs/N and a narrow
-- span reaches a resolution that would otherwise need a transform D times longer. A
-- 2 kHz span at 512 samples goes from 195 Hz bins to 12.2 Hz for the cost of the reads.
--
-- The filter is what makes the decimation safe: keeping every Dth sample of an unfiltered
-- record folds everything above fs/2D into the band, which is the one thing a spectrum
-- analyser must not do quietly. It cannot undo the folding that happened at the ADC --
-- content above the hardware Nyquist is already in the record.
fftsa.bp_d     = 1        -- decimation in force; 1 means the filter is not in the path
fftsa.bp_h     = nil      -- taps, 1..bp_l
fftsa.bp_l     = 0        -- tap count, always odd so the delay is a whole sample
fftsa.bp_out   = nil      -- the N decimated samples fft_load_rd() reads
-- Samples the capture must hold for one record: fft_n when the filter is not decimating,
-- (n-1)*d + l when it is. Seeded at the default count because fftsa.frame_body() rejects a
-- capture shorter than this, and at zero that test would pass anything.
fftsa.bp_m     = 512
-- Read-cost ceiling. A buffer reading costs about 22 us (docs/PERFORMANCE.md), so 8192
-- of them is about 180 ms -- already the dominant term in a frame at the small counts
-- this feature is for. The decimation is capped to keep M under it, which is why a large
-- sample count leaves no room to decimate at all.
fftsa.bp_maxm  = 8192
-- TAPS COME FROM THE TRANSITION WIDTH, not from the decimation. A Hamming-windowed FIR
-- needs about 3.3/transition taps for its stopband, where the transition is measured as a
-- fraction of the sample rate -- and getting this wrong is not a subtle fault: at a 20 kHz
-- span and /3 the old "4 taps per unit of decimation" gave 13 taps where the transition
-- needed 50, and the result read 3.5 dB LOW at 16.6 kHz and 1.9 dB low at 12.5 kHz,
-- measured against the same stimulus with the filter off.
fftsa.bp_tapk  = 3.3      -- Hamming's transition constant
fftsa.bp_lmax  = 65       -- tap ceiling: N*L multiply-accumulates land in the frame

-- Largest decimation that leaves the stop frequency inside the decimated Nyquist with
-- room for the filter's transition, capped by what the read can afford. 2.56 is the usual
-- margin over 2: at D exactly fs/(2*fhi) the transition band would have zero width.
-- The transition a given decimation leaves, as a fraction of the sample rate: from the
-- stop frequency up to the decimated Nyquist. Negative or zero means the span does not
-- fit under that decimation at all.
function fftsa.bp_transition(fs, fhi, d)
  return 1 / (2 * d) - fhi / fs
end

-- Taps that transition needs, odd, and nil when it needs more than the ceiling.
function fftsa.bp_taps_for(fs, fhi, d)
  local w = fftsa.bp_transition(fs, fhi, d)
  if w <= 0 then return nil end
  local l = math.ceil(fftsa.bp_tapk / w)
  if math.mod(l, 2) == 0 then l = l + 1 end
  if l > fftsa.bp_lmax then return nil end
  if l < 3 then l = 3 end
  return l
end

-- The decimation is limited by TWO things, and the filter is usually the tighter of them:
-- the read budget, and whether a filter short enough to run can hold the transition that
-- decimation leaves. Stepping down until both fit is what keeps the passband flat across
-- the displayed span -- decimating harder than the taps can support is how the amplitudes
-- came out low.
function fftsa.bp_pick_d(fs, fhi, n)
  if fs == nil or fhi == nil or n == nil or fhi <= 0 or n < 2 then return 1 end
  local dmax = math.floor((fftsa.bp_maxm - fftsa.bp_lmax) / (n - 1))
  local d = math.floor(fs / (2.56 * fhi))
  if d > dmax then d = dmax end
  while d > 1 and fftsa.bp_taps_for(fs, fhi, d) == nil do d = d - 1 end
  if d < 1 then d = 1 end
  return d
end

-- WHY a decimation of 1 came out, for the readback line. Three different reasons land on
-- the same answer and the operator cannot tell them apart otherwise: at a 4096-sample
-- count the read budget leaves no room whatever the span, which reads as nothing to do
-- with the span at all.
function fftsa.bp_why(fs, fhi, n)
  if fs == nil or fhi == nil or n == nil then return "off" end
  if math.floor(fs / (2.56 * fhi)) < 2 then return "span too wide" end
  if math.floor((fftsa.bp_maxm - fftsa.bp_lmax) / (n - 1)) < 2 then
    return "too many samples"
  end
  if fftsa.bp_taps_for(fs, fhi, 2) == nil then return "filter will not fit" end
  return "no room"
end

-- Windowed-sinc low-pass, cutoff at the stop frequency, Hamming-windowed and normalised
-- to unit DC gain so the filter cannot change a reading's amplitude. Built once per Apply,
-- which costs L terms against fft_init's thousands.
function fftsa.bp_build(fs, fhi, n, d)
  fftsa.bp_d = d
  if d < 2 then
    fftsa.bp_l, fftsa.bp_h, fftsa.bp_m = 0, nil, n
    return 1
  end
  local l = fftsa.bp_taps_for(fs, fhi, d)
  if l == nil then l = fftsa.bp_lmax end
  -- THE CUTOFF SITS BETWEEN THE SPAN TOP AND THE DECIMATED NYQUIST, not on the span top:
  -- a filter's roll-off starts before its cutoff, so a cutoff at fhi puts the whole
  -- displayed band inside the roll-off and reads every peak low. Halfway leaves the
  -- passband flat to fhi and the stopband begun by the Nyquist.
  local fc = 0.5 * (fhi / fs + 0.5 / d)
  if fc > 0.5 / d then fc = 0.5 / d end
  local c = (l - 1) / 2
  local h, sum = {}, 0
  local i
  for i = 1, l do
    local m = (i - 1) - c
    local v
    if m == 0 then
      v = 2 * fc
    else
      v = math.sin(2 * math.pi * fc * m) / (math.pi * m)
    end
    -- Hamming, which holds the first sidelobe near -43 dB for a tap count this small.
    v = v * (0.54 - 0.46 * math.cos(2 * math.pi * (i - 1) / (l - 1)))
    h[i] = v
    sum = sum + v
  end
  for i = 1, l do h[i] = h[i] / sum end
  fftsa.bp_h, fftsa.bp_l = h, l
  fftsa.bp_m = (n - 1) * d + l
  -- Allocated once per Apply, never per frame, and only when the size changes.
  if fftsa.bp_out == nil or fftsa.bp_n ~= n then
    fftsa.bp_out, fftsa.bp_n = {}, n
    for i = 1, n do fftsa.bp_out[i] = 0 end
  end
  return d
end

-- One decimated record: output j is the filter centred on input (j-1)*d + 1, so the
-- inputs this needs are 1 .. (n-1)*d + l, which is fftsa.bp_m. No nil test in the inner
-- loop -- fftsa.frame_body() rejects a capture shorter than bp_m before calling this --
-- and the yield is per output chunk, like fft_load's.
function fftsa.bp_filter(rd)
  local n, d, l = fftsa.fft_n, fftsa.bp_d, fftsa.bp_l
  local h, out = fftsa.bp_h, fftsa.bp_out
  if d < 2 or h == nil or out == nil then return nil end
  local chunk = fftsa.fft_yield_n
  local lo = 1
  while lo <= n do
    local hi = lo + chunk - 1
    if hi > n then hi = n end
    local j
    for j = lo, hi do
      local base = (j - 1) * d
      local acc, t = 0, nil
      for t = 1, l do
        acc = acc + rd[base + t] * h[t]
      end
      out[j] = acc
    end
    lo = hi + 1
    if lo <= n then delay(fftsa.fft_yield) end
  end
  return out
end

function fftsa.fft_load(buf)
  return fftsa.fft_load_rd(buf.readings)
end

-- The same load from a plain array, which is what the band-pass path produces. Extracted
-- rather than copied: the weighted-mean removal and the windowing are subtle enough that
-- two versions of them would drift.
function fftsa.fft_load_rd(rd)
  local N   = fftsa.fft_n
  local M   = fftsa.fft_m
  local x   = fftsa.fft_x
  local re  = fftsa.fft_re
  local im  = fftsa.fft_im
  local win = fftsa.fft_win

  local wsx = 0
  -- Chunked so the yield is per chunk, not per sample: a test inside this loop would
  -- cost more than the yields save. One chunk means no yield, which is the 512 case.
  local chunk = fftsa.fft_yield_n
  local lo = 1
  while lo <= N do
    local hi = lo + chunk - 1
    if hi > N then hi = N end
    local i
    for i = lo, hi do
      local v = rd[i]
      -- A sparse buffer must not put nils into the arithmetic; fftsa.frame_body()
      -- rejects a short capture before it gets here.
      if v == nil then v = 0 end
      x[i] = v
      wsx = wsx + v * win[i]
    end
    lo = hi + 1
    if lo <= N then delay(fftsa.fft_yield) end
  end
  local mean = wsx / fftsa.fft_wsum

  local i = 1
  for k = 1, M do
    re[k] = (x[i] - mean) * win[i]
    im[k] = (x[i+1] - mean) * win[i+1]
    i = i + 2
  end
  return mean
end

function fftsa.fft_run()
  local M     = fftsa.fft_m
  local re    = fftsa.fft_re
  local im    = fftsa.fft_im
  local swp_a = fftsa.fft_swp_a
  local swp_b = fftsa.fft_swp_b
  local twr   = fftsa.fft_twr
  local twi   = fftsa.fft_twi
  local floor = math.floor

  for s = 1, fftsa.fft_nswp do
    local a, b = swp_a[s], swp_b[s]
    re[a], re[b] = re[b], re[a]
    im[a], im[b] = im[b], im[a]
  end

  -- Stage 1: len = 2, twiddle == 1+0i, so pure add/sub.
  for i = 1, M, 2 do
    local ar, ai, br, bi = re[i], im[i], re[i+1], im[i+1]
    re[i]   = ar + br
    im[i]   = ai + bi
    re[i+1] = ar - br
    im[i+1] = ai - bi
  end

  local len  = 4
  local base = 0
  while len <= M do
    local half = floor(len/2)
    for i = 0, M-1, len do
      local ti = base
      for m = 1, half do
        ti = ti + 1
        local a  = i + m
        local b  = a + half
        local wr, wi = twr[ti], twi[ti]
        local xr, xi = re[b], im[b]
        local vr = xr*wr - xi*wi
        local vi = xr*wi + xi*wr
        local ar, ai = re[a], im[a]
        re[b] = ar - vr
        im[b] = ai - vi
        re[a] = ar + vr
        im[a] = ai + vi
      end
    end
    base = base + half
    len  = len * 2
    if M > fftsa.fft_yield_m then delay(fftsa.fft_yield) end
  end
end

-- Untangle the half-size transform into the N/2 real-input bins and write their
-- power, scaled to volts-squared peak, into fftsa.fft_pwr[1..M]. Bin j (1-based)
-- is the frequency (j-1)*fs/N.
--
-- With Z the M-point transform of the packed input and Zc the conjugate of Z at
-- the mirror index (M-k) mod M,
--   X[k] = (Z + Zc)/2 + e^(-2*pi*i*k/N) * (Z - Zc)/(2i)
-- The halves are folded into fftsa.fft_ksq. Bins k and M-k share the same four
-- loads, so the pass walks mirror pairs; bin 0 and bin M/2 are their own mirrors.
function fftsa.fft_power()
  local M    = fftsa.fft_m
  local re   = fftsa.fft_re
  local im   = fftsa.fft_im
  local pwr  = fftsa.fft_pwr
  local utr  = fftsa.fft_utr
  local uti  = fftsa.fft_uti
  local ksq  = fftsa.fft_ksq
  local half = M / 2
  -- j = 1 is bin 0: X = Re Z[0] + Im Z[0], real
  local a, b = re[1], im[1]
  local s = 2 * (a + b)
  pwr[1] = s * s * ksq
  -- j = half+1 is bin M/2: its own mirror with twiddle -i, X = Re Z - i Im Z
  a, b = re[half+1], im[half+1]
  pwr[half+1] = 4 * (a*a + b*b) * ksq
  local pj = M + 1                 -- mirror of j is M - j + 2
  for j = 2, half do
    pj = pj - 1
    local a, b = re[j], im[j]
    local c, d = re[pj], im[pj]
    local wr, wi = utr[j], uti[j]
    local s1, s2, d1, d2 = a + c, b + d, a - c, b - d
    local t1 = wr*s2 + wi*d1
    local t2 = wi*s2 - wr*d1
    local xr, xi = s1 + t1, d2 + t2
    pwr[j] = (xr*xr + xi*xi) * ksq
    xr, xi = s1 - t1, t2 - d2
    pwr[pj] = (xr*xr + xi*xi) * ksq
  end
  return M
end

-- Sub-bin peak estimate from the peak bin and its two neighbours. Read from the peak
-- bin alone, a tone between bin centres is off by up to half a bin and low by the
-- scalloping loss -- 1.42 dB with Hann, 0.82 dB with Kaiser at beta 12. Both come
-- back from the window's own main lobe, through the tables fftsa.win_tables() built.
--
-- Returns d (-0.5..0.5) and the amplitude in volts, or 0 and nil when there is no
-- estimate (a spectrum edge, a sparse power array); callers fall back to the bin.
function fftsa.peak_interp(k, nb)
  local pwr = fftsa.fft_pwr
  if k == nil or k < 2 then return 0, nil end
  if nb ~= nil and k >= nb then return 0, nil end
  local pc = pwr[k]
  local pl = pwr[k-1]
  local pr = pwr[k+1]
  if pc == nil or pl == nil or pr == nil or pc <= 0 then return 0, nil end
  local sqrt = math.sqrt
  local C, L, R = sqrt(pc), sqrt(pl), sqrt(pr)
  local den = L + 2*C + R
  if den <= 0 then return 0, nil end
  local d = fftsa.win_offset((R - L) / den)
  if d == nil then return 0, nil end           -- no table: no estimate
  local g = fftsa.win_gain(d)
  if g <= 0 then return d, C end
  return d, C / g
end


-- ================= tsp/spectrum_ui.tsp =================
-- spectrum_ui.tsp -- the loading cover and the peak finder.

fftsa = fftsa or {}   -- the single global this app exposes

-- ---------- loading cover ----------
-- A screen with nothing on it but a line of text, held in front while the real screens
-- are built and while Apply rebuilds the window tables. Creating a screen makes it
-- active, so every screen build raises this again before its first child, or the operator
-- watches the screen assemble itself one create at a time.
--
-- Created once by fftsa.loading_build() and deleted once by fftsa.stop(). Raising it is a
-- changescreen and nothing else: a cover created and deleted per raise would put two of
-- the 463-object pool through a create/delete cycle every time, and a refused delete
-- raises nothing.
if fftsa.load_handles_inited == nil then
  fftsa.loadscr = nil
  fftsa.loadtxt = nil
  fftsa.load_handles_inited = true
end
-- x for the string below on FONT_MEDIUM, measured on the panel.
fftsa.load_x = 261
fftsa.load_y = 214

function fftsa.loading_build()
  if fftsa.loadscr ~= nil then return fftsa.loadscr end
  fftsa.loadscr = display.create(display.ROOT, display.OBJ_SCREEN, "FFT SPECTRUM ANALYSER")
  if fftsa.loadscr == nil then return nil end     -- pool exhausted; a visible build is the cost
  fftsa.loadtxt = display.create(fftsa.loadscr, display.OBJ_TEXT, fftsa.load_x, fftsa.load_y,
                                 "Loading, please wait...", 16777215, display.FONT_MEDIUM)
  -- End App is hooked here too: the firmware may deliver EVENT_ENDAPP only to the
  -- visible screen, and this is the visible one while Apply rebuilds the tables.
  display.setevent(fftsa.loadscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  return fftsa.loadscr
end

function fftsa.loading_front()
  if fftsa.loadscr == nil then return false end
  display.changescreen(fftsa.loadscr)
  return true
end

-- Put a real screen in front, then take the cover away. Switch first, delete
-- second: deleting the screen on show leaves the panel black.
function fftsa.loading_destroy(showscr)
  if showscr == nil then showscr = display.SCREEN_HOME end
  display.changescreen(showscr)
  if fftsa.loadscr == nil then return false end
  fftsa.del_obj(fftsa.loadtxt)
  fftsa.del_obj(fftsa.loadscr)
  fftsa.loadtxt, fftsa.loadscr = nil, nil
  return true
end

-- ---------- peak finder ----------

-- Top `count` local maxima of fftsa.fft_pwr, strongest first, as two 1..count
-- arrays: bin indices and power (volts-squared). kmin/kmax restrict the search to
-- the bins the graph shows, so the table never reports a tone that is absent from
-- the trace.
-- Index 1 is DC and the fftsa.fft_kdc bins above it carry the mean removal's own
-- error rather than signal (fft_core.tsp measures how far that reaches), so neither
-- is a candidate whatever kmin says. The trace still draws them.
function fftsa.find_peaks(nbins, count, kmin, kmax)
  local pwr = fftsa.fft_pwr
  -- Reused, not rebuilt: two tables a frame was the only allocation left in the frame
  -- path, and the house rule is to allocate once. Callers read them immediately.
  if fftsa.pk_bi == nil then fftsa.pk_bi, fftsa.pk_bv = {}, {} end
  local bi, bv = fftsa.pk_bi, fftsa.pk_bv
  for s = 1, count do bi[s] = 0; bv[s] = -1 end
  local k0 = 2 + (fftsa.fft_kdc or 0)
  if kmin == nil or kmin < k0 then kmin = k0 end
  if kmax == nil or kmax > nbins then kmax = nbins end
  for k = kmin, kmax do
    local m = pwr[k]
    -- A partial fftsa.fft_pwr (after a short read) can hold nils, and comparing
    -- a nil raises.
    if m ~= nil then
      local ml = pwr[k-1]
      local mr = pwr[k+1]
      -- A missing neighbour is the end of the spectrum and counts as lower. Inside
      -- a zoom window the neighbours are real bins even when off-screen, so the
      -- flank of an out-of-window tone does not read as a peak.
      if ml == nil then ml = -1 end
      if mr == nil then mr = -1 end
      if m > ml and m >= mr then
        -- A tone inside the DC region leaks enough into the first reportable bin
        -- to make it a local maximum, and that bin then reports the tone a whole
        -- bin and 16 dB out. The estimator already knows: it saturates at -0.5,
        -- the end of its table, which says the three bins are not one tone
        -- centred here. So refuse a peak whose own estimate lands a quarter bin
        -- or more below the lowest reportable bin. Measured, a genuine tone there
        -- estimates within 0.017 bins of it, against the leak's 0.500, so the
        -- quarter-bin margin sits in the middle of the gap. Only k0 can trigger
        -- it, since the offset cannot reach half a bin.
        local keep = true
        if k == k0 then
          local d = fftsa.peak_interp(k, nbins)
          if (k - 1) + d < (k0 - 1) - 0.25 then keep = false end
        end
        if keep and m > bv[count] then
          local s = count
          while s > 1 and m > bv[s-1] do
            bv[s] = bv[s-1]; bi[s] = bi[s-1]; s = s - 1
          end
          bv[s] = m; bi[s] = k
        end
      end
    end
  end
  return bi, bv
end


-- ================= tsp/spectrum_graph.tsp =================
-- spectrum_graph.tsp -- spectrum display built on the instrument's own graph object
--
-- The graph draws a whole trace from a reading buffer in one repaint, so a frame
-- is a buffer refill; per-point line objects or setpixel flood the display queue.
--
-- X IS THE READING'S EXTRA FIELD, NOT ITS TIMESTAMP, which makes this the firmware's
-- numeric x-y plot rather than a time plot: the axis takes its limits in real hertz and
-- the firmware labels them itself, SI prefix and all -- +00.00kHz, +10.00kHz.
--
-- Nothing can be drawn over the firmware's axis row: a child object inside the graph's
-- rectangle is painted over by the widget's per-frame repaint, whatever the creation
-- order. docs/PERFORMANCE.md has that measurement and the dead ends it closes.
--
-- Y is dBV computed in Lua, carried on a fixed linear axis under a two-character custom
-- buffer unit, which is what gets the axis labelled in dB.
--
-- Every object and buffer here is deleted and its handle cleared by
-- fftsa.sg_destroy() before anything is created again; creating over a live handle
-- drops the only reference to the old object, which stays alive until a power cycle.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.sg_nbins   = 256
fftsa.sg_npeak   = 6       -- number of peaks reported (shown in a 2x3 grid)

-- Trace columns, and the only number that sets the graph widget's work per frame.
--
-- The plotted area is sg_plotpx wide, so one point per pixel is 680 and one per two 340.
--
-- One point a column, carrying the column's MAXIMUM. Rasterising costs per segment
-- length, and a min/max pair doubles the points and makes every second segment span the
-- noise band, about 45 px, where a single-valued trace moves a few px between
-- neighbours. The cost is that max alone reads the floor about 6 dB high.
--
-- Fixed, not sized to the span: a frame then always writes exactly this many points and
-- the widget's load is constant and predictable whatever the sample count or span.
--
-- 255 points, in a buffer ALLOCATED AT 680 and freed only when the app ends. Not one
-- point per pixel: 680 points cost 77 ms a fill against about 28 ms at 255, and the frame
-- is what the operator feels. sg_ncol is settable while the app runs, up to sg_maxpts,
-- because the buffer is FILL_ONCE and cleared -- n follows the writes, so a smaller count
-- simply draws fewer points and reallocates nothing.
fftsa.sg_ncol    = 255

-- PEAK MARKERS, off by default. A second trace of one point a peak, carrying the
-- interpolated frequency and amplitude the peak table reports -- so a marker sits where
-- the peak really is, which is up to half a bin off the column the trace draws there.
-- Switching it on rebinds the graph, which repaints the axes, so it only happens on Apply.
fftsa.sg_markers = false
-- NEEDLES, NOT DOTS. drawstyle is per GRAPH, so asking for markers on the peak trace puts
-- one on all 255 points of the spectrum as well -- line-and-points mode, which is not
-- wanted. So the peak trace is drawn as a line too, carrying three points a peak: the
-- floor, the peak, the floor again, a pixel of plot either side. That draws a vertical
-- needle from the bottom rule up to each peak, with the run between needles hidden along
-- the rule.
fftsa.sg_mk_per  = 3       -- points a needle: floor, peak, floor
-- The firmware's floor on a reading buffer: "capacity must be between 10 and 5311488
-- readings", event 4920. Six peaks is under it, and buffer.make then RETURNS NIL -- so the
-- marker buffer was never created, every call on it took a 1138, and the marker trace drew
-- nothing. A frame still writes only the peaks it found; n follows the writes.
fftsa.sg_bufmin  = 10
fftsa.sg_maxpts  = 680

-- Firmware handles, initialised only on the first load: opening the App again
-- re-runs this body and `fftsa = fftsa or {}` keeps the table, so nil-ing a live
-- handle here would strand the previous launch's objects. fftsa.sg_destroy()
-- reclaims them on the next start.
if fftsa.sg_handles_inited == nil then
  fftsa.sg_buf   = nil     -- WRITABLE_FULL buffer holding the spectrum
  fftsa.sg_scr   = nil     -- custom screen
  fftsa.sg_graph = nil     -- OBJ_GRAPH object
  fftsa.sg_pk_f  = nil     -- per-peak frequency text (own field, fixed x)
  fftsa.sg_pk_v  = nil     -- per-peak voltage text  (own field, fixed x)
  fftsa.sg_pk_d  = nil     -- per-peak dB text       (own field, fixed x)
  fftsa.sg_xunit = nil     -- settings line under the peak rows
  fftsa.sg_stat  = nil
  fftsa.sg_mk    = nil
  fftsa.sg_handles_inited = true
end

-- Visible frequency window (Hz): fftsa.sg_update() writes only the bins inside it
-- and fftsa.sg_pin_x() pins the axis to it. fftsa.apply() narrows the defaults.
fftsa.sg_flo_hz  = 0
fftsa.sg_fhi_hz  = 1e9

-- The X scale method sg_pin_x() asks for, settable over the socket while the app runs.
--
-- XSCALE_OFF, the pinned window, MEASURED AS THE ONLY STABLE CHOICE. XSCALE_ALL reads
-- the whole buffer and so does notice new writes -- the trace redraws -- but it derives
-- the X range from the buffer's own timestamps, and those move while a frame refills: a
-- paint landing mid-fill computes the range from however much of the trace is there. The
-- axis then walks frame to frame, which on the glass reads as the trace sliding left and
-- right as though the point count were changing. The axis does not need to follow
-- anything: the span is known, and pinning it leaves the redraw to the notify below.
fftsa.sg_xmethod = display.XSCALE_OFF
-- Notify candidates that are NOT used, so none of them is reached for again on the same
-- reasoning: select, scaletrace(TRACE_ACTIVE), drawstyle and re-asserting scalex all make
-- the task re-read a buffer it is already bound to, and scalex was confirmed doing it on
-- the glass. Every one of them needs the bound buffer overwritten in place, which needs
-- FILL_CONTINUOUS, which draws the wrap line. The clear is the only notify compatible
-- with FILL_ONCE.


-- Geometry on the 800x480 panel, in object coordinates, which start below the
-- 49-pixel title bar: a child at y=350 lands on panel row 399.
--
-- The graph takes the full height above the peak table, which starts 38 px below its
-- bottom edge. The firmware labels the axis inside that rectangle, so no row is reserved.
fftsa.sg_gx      = 8
fftsa.sg_gy      = 0
fftsa.sg_gw      = 784
fftsa.sg_gh      = 312

-- -120 dBV is the floor because the DMM7510's front end sits 12 to 14 dB below the
-- DMM6500's, and at -100 its noise floor was off the bottom of the plot.
fftsa.sg_dbmin   = -120
fftsa.sg_dbmax   = 20
fftsa.sg_vfloor  = 1e-9

-- Plotted width in pixels, measured off a panel capture: the vertical grid rules land at
-- x = 100, 168 ... 780, eleven of them 68 px apart. Used to decide when an axis limit can
-- be moved without it showing.
fftsa.sg_plotpx  = 680

-- fftsa.sg_fhi_hz starts at a sentinel meaning "every bin". A span wider than this is
-- not a plottable axis, so sg_pin_x() makes no call until fftsa.apply() narrows it.
fftsa.sg_fmax_real = 1e6

-- Peak table: 6 rows as two columns of three. freq/volt/dB are separate objects at
-- fixed x, so the volt and dB columns do not jitter as the proportional-font
-- frequency text changes width. The Options button sits in the right margin beside the
-- first row.
fftsa.sg_pky     = 350     -- first peak row baseline
fftsa.sg_pkdy    = 20      -- row pitch
fftsa.sg_pk_colx_f = {8,   360}   -- frequency field x, per column
fftsa.sg_pk_colx_v = {118, 470}   -- voltage field x,   per column
fftsa.sg_pk_colx_d = {200, 552}   -- dB field x,        per column
fftsa.sg_pk_cf   = 14745568  -- freq colour (pale green)
fftsa.sg_pk_cv   = 13166335  -- volt colour (pale blue)
fftsa.sg_pk_cd   = 16769184  -- dB colour   (pale amber)
fftsa.sg_xunit_x = 8
fftsa.sg_xunit_y = 410       -- settings line, below the peak rows
fftsa.sg_xunit_c = 56575     -- cyan 00DCFF, the colour of the Options preview line

-- Delete, nil handle or not. No pcall: the firmware refuses by posting an event and
-- returning, so a wrapper can never be false. A refused delete shows up in the only place
-- it can -- the live-object and live-buffer counts the suite takes around a teardown, and
-- the event log on the instrument.
--
-- The nil test is the part that matters. A handle is nil when display.create could not
-- give us one, and the app module deletes handles it may never have built.
function fftsa.del_obj(h)
  if h == nil then return true end
  display.delete(h)
  return true
end

function fftsa.del_buf(b)
  if b == nil then return true end
  buffer.delete(b)
  return true
end

-- Pin the X axis to the window: auto-range rounds outward to tidy tick values, so
-- the pixel of a given frequency would be unknowable and the firmware's labels would not
-- describe the span.
function fftsa.sg_pin_x()
  if fftsa.sg_graph == nil then return false end
  local lo, hi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if hi > fftsa.sg_fmax_real or hi <= lo then return false end
  -- START THE AXIS AT DC WHEN MOVING IT THERE IS INVISIBLE -- under one pixel of plot.
  -- The firmware steps its ticks from the lower limit, so a 10 Hz Start on a 50 kHz span
  -- put them at 10, 10010, 20010 Hz and the row read +00.01kHz, +10.01kHz; from 0 it
  -- reads +00.00kHz. Conditional because a real zoom must keep its own limits, or an 8 to
  -- 16 kHz window would draw in the last sixth of the plot.
  --
  -- The test is against the PLOT WIDTH, not the bin width: a bin-width test holds only
  -- where Start falls inside bin one, which is the default and not 16384.
  if lo > 0 and lo * fftsa.sg_plotpx < (hi - lo) then lo = 0 end
  local m = fftsa.sg_xmethod
  if m == nil then m = display.XSCALE_OFF end
  -- IN HERTZ, not scaled. The trace is bound as a numeric x-y plot, X from the reading's
  -- extra field, which carries the bin's real frequency -- so the axis limits are the
  -- real span and the firmware labels them itself, with an SI prefix: +00.00kHz and so
  -- on. No pcall: the call does not raise, it posts an event, so a wrapper buys nothing
  -- and costs a closure and a frame per call.
  display.graph.scalex(fftsa.sg_graph, m, display.AXIS_NORMAL, lo, hi)
  return true
end

-- The settings line, under the peak rows: everything in Options that the axes do not
-- already show. The span is the X axis and the dB range is the Y axis, so neither is
-- repeated; sample count, rate, bin width, record length, window and input range are.
--
-- Written twice per Apply, by sg_set_xrange() before the capture and again after it, so
-- the rate and bin width it ends up showing are the measured ones.
function fftsa.sg_xunit_text()
   local t = string.format("%d pts   %s   %s   %s", fftsa.n,
                          fftsa.opt_info_text(fftsa.fs, fftsa.n),
                          fftsa.range_labels[fftsa.range_to_idx(fftsa.range)],
                          fftsa.bp_text())
  -- Start 1999 / Stop 2000 is a legal pair and one plotted point at 195.3 Hz bins: the
  -- trace is a dot, five peak rows read ---, and this count is the only thing that says
  -- why. The width is already in the line, so the count alone is enough.
  local b = fftsa.binhz
  if b ~= nil and b > 0 then
    local k0, k1 = fftsa.sg_window_bins(fftsa.sg_nbins, b)
    local n = k1 - k0 + 1
    if n < 3 then
      local plural = "s"
      if n == 1 then plural = "" end
      t = t .. string.format("   only %d bin%s in the span", n, plural)
    end
  end
  return t
end

-- The trace buffer. WRITABLE_FULL carries value, extra and timestamp per point: the value
-- is dB under a two-character custom unit, the extra is the bin's frequency in hertz.
--
-- MADE ONCE, WHEN THE APP STARTS, AND FREED ONLY BY fftsa.sg_destroy() WHEN IT ENDS.
-- Capacity is sg_maxpts -- the ceiling, not the current sg_ncol -- whatever the sample
-- count, so neither a size change nor a change of point count needs a new buffer: this
-- writes sg_nbins and returns. Nothing allocates or frees while frames are running.
--
-- FILL_ONCE, cleared and refilled by every frame from arrays it stages first, so nothing
-- but buffer.write.reading is inside the window where the buffer is short of a trace.
-- The clear is also the notify: the display task keeps its own copy of the readings
-- (serial-decode docs/FIRMWARE_API.md, "a trace is a copy in another task") and re-reads
-- a buffer only when it is handed one, so writing over a bound buffer in place changes
-- nothing on the glass. This is the one place that mechanism is stated.
function fftsa.sg_make_buffer(nbins, npoints)
  fftsa.sg_nbins = nbins
  local want = npoints or fftsa.sg_maxpts
  -- Already built at the right size: keep it, and write nothing but sg_nbins. sg_build()
  -- is the only caller and start() the only caller of that, so this is the one place the
  -- no-reallocation rule is stated in code rather than left implicit in the call graph.
  if fftsa.sg_buf ~= nil and fftsa.sg_mk ~= nil and fftsa.sg_buf.capacity == want then
    return fftsa.sg_buf
  end
  -- DETACH BEFORE DELETING. The firmware refuses to delete a buffer that is still
  -- bound to a graph, so remaking one while attached leaves the old buffer alive AND
  -- STILL BOUND: the widget then draws both, which on the glass is a second trace
  -- overlaid on the first at the old resolution. Reached only by a relaunch, where
  -- fftsa.sg_build() has already called sg_destroy(), but the graph handle survives a
  -- reload and the cost of being wrong here is a stranded buffer.
  if fftsa.sg_graph ~= nil then
    display.graph.removeall(fftsa.sg_graph)
  end
  if fftsa.sg_buf ~= nil then
    fftsa.del_buf(fftsa.sg_buf)
    fftsa.sg_buf = nil
  end
  fftsa.sg_buf = fftsa.sg_mkbuf(want)
  -- The marker trace, one point a peak. Made here with the trace buffer and freed with it,
  -- whether or not markers are switched on: allocating it when the option is set would be
  -- an allocation while frames are running.
  if fftsa.sg_mk ~= nil then
    fftsa.del_buf(fftsa.sg_mk)
    fftsa.sg_mk = nil
  end
  local mkcap = fftsa.sg_npeak * fftsa.sg_mk_per
  if mkcap < fftsa.sg_bufmin then mkcap = fftsa.sg_bufmin end
  fftsa.sg_mk = fftsa.sg_mkbuf(mkcap)
  -- The staging arrays sg_update() fills before it clears the buffer. Made here, once,
  -- at the ceiling and never resized: a frame writes slots 1..sg_ncol and reads back the
  -- same, so growing a table mid-frame would allocate inside the window it exists to
  -- shrink. Seeded so every slot is a store rather than a rehash on the first frame.
  fftsa.sg_st_db, fftsa.sg_st_hz = {}, {}
  local j
  for j = 1, want do
    fftsa.sg_st_db[j], fftsa.sg_st_hz[j] = fftsa.sg_dbmin, 0
  end
  -- The marker sort's own slots, one more than the peak count because the insertion
  -- writes j+1 before n has grown.
  fftsa.sg_mk_db, fftsa.sg_mk_hz = {}, {}
  for j = 1, fftsa.sg_npeak + 1 do
    fftsa.sg_mk_db[j], fftsa.sg_mk_hz[j] = fftsa.sg_dbmin, 0
  end
  return fftsa.sg_buf
end

-- One trace buffer: FILL_ONCE, formatted, seeded full. Capacity is sg_maxpts, so a frame
-- writing sg_ncol points always fits and sg_update's clamp is what keeps a raised sg_ncol
-- from writing past it -- one write past capacity is event 4915. Seeded because an empty buffer binds no trace at all, and sg_build() binds this
-- before the first frame has run.
function fftsa.sg_mkbuf(want)
  local b = buffer.make(want, buffer.STYLE_WRITABLE_FULL)
  -- Left at FILL_ONCE deliberately. See sg_make_buffer: FILL_CONTINUOUS works exactly
  -- as documented and still draws a line from the newest point to the oldest.
  --
  -- The Y values are decibels, and a custom unit is how the axis gets to say so. NOT
  -- buffer.UNIT_DECIBEL, which panics the instrument during build -- the custom units
  -- are a different path, and the firmware truncates their label to two characters
  -- (event 4933), which is exactly "dB". Without this the axis labels read "+020.0V" on
  -- numbers that are not volts.
  buffer.unit(buffer.UNIT_CUSTOM1, "dB")
  buffer.write.format(b, buffer.UNIT_CUSTOM1, buffer.DIGITS_4_5,
                         buffer.UNIT_HERTZ,   buffer.DIGITS_6_5)
  local k
  for k = 1, want do
    fftsa.sg_write_point(b, fftsa.sg_dbmin, (k - 1) * 1.0, k)
  end
  return b
end

-- One point: value dB, extra the bin's frequency in Hz, timestamp a plain counter.
--
-- The timestamp carries no information -- X is bound to the extra field -- but it still
-- has to be supplied and still has to increase, because buffer.write.reading documents
-- chronological order. The slot number serves, and being an integer it cannot reach the
-- fractional-seconds refusal at 0.9999999 (event 1131, a modal dialog per point).
function fftsa.sg_write_point(buf, db, f, slot)
  if slot == nil then slot = 1 end
  buffer.write.reading(buf, db, f, slot, 0)
end


-- Build the screen once, at launch: graph, peak table, settings line. The frame loop only
-- refills the buffer and updates text.
function fftsa.sg_build(title, nbins, npoints)
  fftsa.sg_destroy()

  fftsa.sg_make_buffer(nbins, npoints)
  local create = display.create
  local small  = display.FONT_SMALL
  fftsa.sg_scr = create(display.ROOT, display.OBJ_SCREEN, title)
  -- create() returns nil when the pool is exhausted, posting one event and not raising.
  -- Without this test every child is built against a nil parent, which DOES raise -- in
  -- our code, not the firmware's. Answering nil and a reason is the same protection
  -- without raising: fftsa.build() passes it to fftsa.start(), which reports it.
  if fftsa.sg_scr == nil then
    fftsa.lasterr = "display object pool exhausted building the spectrum screen -- "
                    .. "power cycle the instrument."
    return nil, fftsa.lasterr
  end
  -- Creating a screen makes it active, so the cover goes back in front before the
  -- first child: otherwise the operator watches the screen assemble itself.
  fftsa.loading_front()

  fftsa.sg_graph = create(fftsa.sg_scr, display.OBJ_GRAPH, fftsa.sg_gx, fftsa.sg_gy, fftsa.sg_gw, fftsa.sg_gh)
  -- X is ELEMENT_EXTRA (the bin's frequency in Hz); Y is ELEMENT_DATA (dB).
  fftsa.sg_bind()

  fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d = {}, {}, {}
  for p = 1, fftsa.sg_npeak do
    local col, row = 1, p - 1
    if p > 3 then col = 2; row = p - 4 end
    local y = fftsa.sg_pky + row * fftsa.sg_pkdy
    if y > 418 then y = 418 end
    fftsa.sg_pk_f[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_f[col], y,
                        string.format("%d  ---", p), fftsa.sg_pk_cf, small, display.JUST_LEFT)
    fftsa.sg_pk_v[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_v[col], y, "", fftsa.sg_pk_cv, small, display.JUST_LEFT)
    fftsa.sg_pk_d[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_d[col], y, "", fftsa.sg_pk_cd, small, display.JUST_LEFT)
  end

  fftsa.sg_xunit = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_xunit_x, fftsa.sg_xunit_y,
                          fftsa.sg_xunit_text(), fftsa.sg_xunit_c, small, display.JUST_LEFT)

  fftsa.sg_stat = nil     -- no on-screen status object
  return fftsa.sg_scr
end

-- Tear down in dependency order: detach the trace, drop the screen and its
-- children, then free the buffer the trace referenced. Nils every handle.
function fftsa.sg_destroy()
  if fftsa.sg_graph ~= nil then
    display.graph.removeall(fftsa.sg_graph)
  end
  if fftsa.sg_scr ~= nil then
    display.changescreen(display.SCREEN_HOME)
    fftsa.del_obj(fftsa.sg_scr)
  end
  fftsa.sg_scr, fftsa.sg_graph, fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d,
    fftsa.sg_xunit, fftsa.sg_stat = nil, nil, nil, nil, nil, nil, nil
  -- Deleted, not just dropped: a buffer whose handle is dropped is stranded and still
  -- counts against the instrument's capacity.
  if fftsa.sg_buf ~= nil then
    fftsa.del_buf(fftsa.sg_buf)
  end
  if fftsa.sg_mk ~= nil then
    fftsa.del_buf(fftsa.sg_mk)
  end
  fftsa.sg_buf, fftsa.sg_mk = nil, nil
  collectgarbage()
end


-- Bin index range covering the visible window, clamped into 1..nbins. Shared by
-- the plot and the peak search, so the table describes what is on screen.
function fftsa.sg_window_bins(nbins, binhz)
  if binhz == nil or binhz <= 0 then return 1, nbins end
  local floor, ceil = math.floor, math.ceil
  -- ceil, not floor, for the low edge: floor() maps every start below one bin
  -- width (195 Hz at 100 kS/s) back to bin 1, the DC bin.
  local kmin = ceil(fftsa.sg_flo_hz / binhz) + 1
  local kmax = floor(fftsa.sg_fhi_hz / binhz) + 1
  if kmin < 1 then kmin = 1 end
  if kmin > nbins then kmin = nbins end
  if kmax > nbins then kmax = nbins end
  if kmax < kmin then kmax = kmin end
  return kmin, kmax
end

-- Refill the trace from fftsa.fft_pwr: every column is staged into sg_st_db and sg_st_hz
-- first, then the buffer is cleared and written. Only the writes are inside the window
-- where the buffer holds less than a full trace, which is what keeps a paint landing
-- mid-refill from drawing a short one.
--
-- The display task shares this core with the interpreter and runs only while Lua is
-- blocked, so the delay at the end is what gets the new trace painted; too short and the
-- firmware posts 1706, "Message dropped from display queue".
function fftsa.sg_update(nbins, binhz)
  if binhz == nil or binhz <= 0 then return end   -- no usable frequency scale yet
  local g     = fftsa.sg_graph
  local pwr   = fftsa.fft_pwr
  local wr    = buffer.write.reading
  local log10 = math.log10
  local vfl   = fftsa.sg_vfloor * fftsa.sg_vfloor   -- squared: the bins are power
  local dbmin = fftsa.sg_dbmin
  local dbmax = fftsa.sg_dbmax
  local floor = math.floor
  local kmin, kmax = fftsa.sg_window_bins(nbins, binhz)
  local npts = kmax - kmin + 1
  local buf = fftsa.sg_buf
  if buf == nil then return end
  -- Points this frame writes, CLAMPED TO CAPACITY: one write past it is event 4915, a
  -- modal dialog, and sg_ncol is settable while the app runs. Writing fewer than capacity
  -- is fine because the buffer is FILL_ONCE and cleared -- n follows the writes, so the
  -- trace simply has that many points. That is what makes sg_ncol a live knob without
  -- reallocating anything: the buffer stays at the 680 it was made with.
  local ncol = fftsa.sg_ncol
  local cap  = buf.capacity
  if cap ~= nil and ncol > cap then ncol = cap end
  if ncol == nil or ncol < 2 then ncol = 2 end
  local nwrote = 0
  -- STAGE EVERYTHING FIRST, THEN CLEAR AND WRITE. The buffer is at n = 0 from the clear
  -- until the last write, and a paint landing in that window draws a blank or partial
  -- trace -- that is the flicker. So the window is made as narrow as the firmware allows:
  -- every value is computed into the two preallocated arrays while the buffer still
  -- holds the PREVIOUS complete trace, and the only thing between the clear and a full
  -- buffer is a tight loop of buffer.write.reading.
  --
  -- A point costs about 109 us to produce and 51.6 of that is the write itself, so this
  -- moves the better half of the work out of the window: measured at 255 points, 20.3 ms
  -- inside it against 30 ms interleaved, with 7.6 ms of staging outside
  -- (docs/PERFORMANCE.md).
  local st_db, st_hz = fftsa.sg_st_db, fftsa.sg_st_hz
  -- Hoisted out of the loop: the column's frequency advances by a constant, so the
  -- per-point divide and two multiplies become one add.
  local fstep = (npts / ncol) * binhz
  local f0    = (kmin - 1) * binhz
  local c
  for c = 0, ncol - 1 do
    -- The column's bin range. One bin wide at the default, where capacity equals the
    -- bins in the span; wider when the span holds more bins than the cap allows.
    local a = kmin + floor(c * npts / ncol)
    local b = kmin + floor((c + 1) * npts / ncol) - 1
    if b < a then b = a end
    if b > kmax then b = kmax end
    local hi, hik = nil, a
    local k
    for k = a, b do
      local v = pwr[k]
      if v ~= nil and (hi == nil or v > hi) then hi = v; hik = k end
    end
    -- nil (sparse power array) and anything at or below the floor plot at the floor,
    -- so log10 is never handed a zero. The range tests are positives because every
    -- comparison with a NaN is false, so `db < dbmin` would pass one through to
    -- buffer.write.reading and a refused parameter is event 1131 again.
    local db = dbmin
    if hi ~= nil and hi > vfl then
      db = 10 * log10(hi)
      if not (db > dbmin) then db = dbmin
      elseif not (db < dbmax) then db = dbmax end
    end
    -- The COLUMN's frequency, not the winning bin's. Columns can be narrower than a
    -- bin, and several would then share one, so a column's own frequency is strictly
    -- increasing by construction where the winning bin's is not. The cost is that a peak
    -- is drawn at its column rather than its bin -- within one column, 2.7 px of the
    -- 680 px plot, whatever the size or span; the peak table still carries the
    -- interpolated frequency.
    nwrote = nwrote + 1
    st_db[nwrote], st_hz[nwrote] = db, f0 + c * fstep
  end
  fftsa.sg_nwrote = nwrote                   -- segments the widget was actually handed
  -- THE WINDOW. Everything above this line ran against the previous frame's trace, which
  -- was complete and on screen the whole time. From here the buffer is empty until the
  -- loop ends, so there is nothing in it but the writes.
  -- Declared out here on purpose: nothing but the clear and the writes belongs inside
  -- the window, not even a local slot.
  local i
  buf.clear()
  for i = 1, nwrote do
    wr(buf, st_db[i], st_hz[i], i, 0)
  end
  -- No graph call. The clear above is the notify, and the trace stays bound to the
  -- same buffer for the life of the app -- so nothing here can repaint the axes.
  -- The paint. The bound buffer is complete and the next fill has not begun, so this is
  -- the window in which a copy is correct by construction.
  delay(fftsa.sg_yield)
end

-- The one place a zoom touches: it stores the window, rewrites the settings line and
-- re-pins the axis, which is what makes the firmware relabel.
function fftsa.sg_set_xrange(flo_hz, fhi_hz)
  fftsa.sg_flo_hz = flo_hz
  fftsa.sg_fhi_hz = fhi_hz
  if fftsa.sg_xunit ~= nil then
    display.settext(fftsa.sg_xunit, fftsa.sg_xunit_text())
  end
  fftsa.sg_pin_x()
end

-- Bind the traces: the spectrum always, the markers when they are switched on. The one
-- place that decides, so the build and a rebind cannot disagree about what is bound.
--
-- removeall() first, or add() stacks a duplicate trace.
function fftsa.sg_bind()
  local g = fftsa.sg_graph
  if g == nil then return false end
  display.graph.removeall(g)
  display.graph.add(g, fftsa.sg_buf, display.ELEMENT_DATA,
                    fftsa.sg_buf, display.ELEMENT_EXTRA)
  if fftsa.sg_markers and fftsa.sg_mk ~= nil then
    display.graph.add(g, fftsa.sg_mk, display.ELEMENT_DATA,
                      fftsa.sg_mk, display.ELEMENT_EXTRA)
    -- ONE SCALE FOR EVERY TRACE. A custom graph starts at TRACE_ACTIVE, where a scale
    -- call reaches only the selected trace -- so the second trace keeps auto-scaling and
    -- its points are stretched across the whole plot, landing nowhere near the spectrum.
    -- TRACE_ALL syncs them: "as scale settings for X and Y change they will get applied
    -- to all traces". Documented to work only on a custom-created graph, which this is.
    display.graph.scaletrace(g, display.TRACE_ALL)
  end
  -- Always a line. See sg_mk_per: markers are per graph, so the peak trace draws needles
  -- rather than asking for a marker the spectrum would get too.
  display.graph.drawstyle(g, display.STYLE_LINE)
  fftsa.sg_pin_y(g)
  fftsa.sg_pin_x()
  return true
end

-- The dB axis, pinned. Its own function because sg_bind() has to call it once per trace.
function fftsa.sg_pin_y(g)
  if g == nil then g = fftsa.sg_graph end
  if g == nil then return false end
  display.graph.scaley(g, display.YSCALE_OFF, display.AXIS_NORMAL,
                       fftsa.sg_dbmin, fftsa.sg_dbmax)
  return true
end

-- The recovery path after a failed frame, and the same binding as the build.
function fftsa.sg_rebind()
  return fftsa.sg_bind()
end

-- Detach and re-add the trace. Not called by the app; tools/test_tsp.lua exercises it.
function fftsa.sg_bind_min()
  display.graph.removeall(fftsa.sg_graph)
  display.graph.add(fftsa.sg_graph, fftsa.sg_buf, display.ELEMENT_DATA,
                    fftsa.sg_buf, display.ELEMENT_EXTRA)
end

-- Seconds the frame stays blocked after the refill so the display task can paint it.
-- 1706 events mean it is too short. Small because the timer period already leaves 20 % of
-- every frame idle with Lua blocked on the timer, so the task is scheduled in proportion
-- to the frame; this delay only insures against a frame whose work fills its whole
-- period. Measured at 2048 samples, 10 ms and 5 ms both posted no 1706.
--
-- The one owner of this constant: the frame reads it every refill, and nothing else sets
-- it.
fftsa.sg_yield = 0.010

fftsa.sg_pk_period = 1.0        -- seconds between refreshes
fftsa.sg_pk_ftol   = 0.002      -- fractional frequency move worth a redraw
fftsa.sg_pk_vtol   = 0.01       -- fractional amplitude move worth a redraw
fftsa.sg_pk_last   = nil        -- nil means never drawn, so the first call draws
fftsa.sg_pk_lf     = {}
fftsa.sg_pk_lv     = {}

fftsa.sg_peaks_off = false      -- disables the peak table, to attribute display traffic

-- Refill the marker trace from the peak list: one point a peak, at the frequency and
-- amplitude the peak table reports rather than the column the trace drew. Nothing when
-- markers are off, so the buffer keeps its seed and the trace it is not bound to costs
-- nothing.
--
-- SORTED BY FREQUENCY. The peaks arrive strongest-first, and drawstyle is per graph, so
-- the marker trace is drawn with a line through it as well: in amplitude order that line
-- zigzags across the plot. Six points, so an insertion sort is the whole cost.
--
-- Filled BEFORE the spectrum refill. The clear is a notify, and the frame's yield comes
-- after the spectrum's writes, so the paint at the yield sees both buffers complete.
function fftsa.sg_update_markers(bi, bv, count, binhz)
  local mk = fftsa.sg_mk
  if mk == nil or not fftsa.sg_markers then return 0 end
  local log10, sqrt = math.log10, math.sqrt
  local hz, db = fftsa.sg_mk_hz, fftsa.sg_mk_db
  local n = 0
  local p
  for p = 1, count do
    local k = bi[p]
    if k ~= nil and k > 0 and bv[p] > 0 then
      local dk, iv = fftsa.peak_interp(k, fftsa.sg_nbins)
      if iv == nil then dk, iv = 0, sqrt(bv[p]) end
      local f = (k - 1 + dk) * binhz
      local d = 20 * log10(iv)
      if not (d > fftsa.sg_dbmin) then d = fftsa.sg_dbmin end
      if not (d < fftsa.sg_dbmax) then d = fftsa.sg_dbmax end
      -- Insertion by frequency, so the slots come out increasing in x.
      local j = n
      while j > 0 and hz[j] > f do
        hz[j + 1], db[j + 1] = hz[j], db[j]
        j = j - 1
      end
      hz[j + 1], db[j + 1] = f, d
      n = n + 1
    end
  end
  if n == 0 then return 0 end
  -- A needle a peak: the floor a pixel below the peak frequency, the peak, the floor a
  -- pixel above. The x values have to stay increasing or the line doubles back, so each
  -- foot is held at or above the previous needle's -- two peaks within two pixels then
  -- read as one slightly wider needle, which is what they look like anyway.
  local span = fftsa.sg_fhi_hz - fftsa.sg_flo_hz
  local dx = span / fftsa.sg_plotpx
  if not (dx > 0) then dx = binhz end
  local floordb = fftsa.sg_dbmin
  local wr = buffer.write.reading
  local cap = mk.capacity
  local i, slot, prev = nil, 0, nil
  mk.clear()
  for i = 1, n do
    local f = hz[i]
    local l, r = f - dx, f + dx
    if prev ~= nil and l < prev then l = prev end
    if f < l then f = l end
    if r < f then r = f end
    if slot + fftsa.sg_mk_per <= cap then
      slot = slot + 1; wr(mk, floordb, l, slot, 0)
      slot = slot + 1; wr(mk, db[i],   f, slot, 0)
      slot = slot + 1; wr(mk, floordb, r, slot, 0)
      prev = r
    end
  end
  return slot
end

-- Gated at fftsa.sg_pk_period and skipped when no peak moved beyond the tolerances,
-- so a dithering last digit does not redraw the block on a steady signal.
function fftsa.sg_show_peaks(bi, bv, count, binhz)
  if fftsa.sg_peaks_off then return false end
  local now = os.clock()
  if fftsa.sg_pk_last ~= nil
     and (now - fftsa.sg_pk_last) < fftsa.sg_pk_period then
    return false
  end
  local abs, sqrt = math.abs, math.sqrt
  local moved = false
  for p = 1, count do
    local k = bi[p]
    local f, v = -1, -1
    if k ~= nil and k > 0 and bv[p] > 0 then
      local dk, iv = fftsa.peak_interp(k, fftsa.sg_nbins)
      if iv == nil then dk, iv = 0, sqrt(bv[p]) end     -- bv is power; iv is volts either way
      f, v = (k - 1 + dk) * binhz, iv
    end
    local lf, lv = fftsa.sg_pk_lf[p], fftsa.sg_pk_lv[p]
    if lf == nil then
      moved = true
    elseif (f < 0) ~= (lf < 0) then
      moved = true                      -- a peak appeared or went away
    elseif f >= 0 then
      local df = fftsa.sg_pk_ftol * lf
      if df <= 0 then df = 1 end
      local dv = fftsa.sg_pk_vtol * lv
      if dv <= 0 then dv = 1e-12 end
      if abs(f - lf) > df or abs(v - lv) > dv then moved = true end
    end
    fftsa.sg_pk_lf[p], fftsa.sg_pk_lv[p] = f, v
  end
  if not moved then return false end
  fftsa.sg_pk_last = now
  return fftsa.sg_show_peaks_now(bi, bv, count, binhz)
end

-- The unconditional draw; the gate above is the only thing deciding when it runs.
function fftsa.sg_show_peaks_now(bi, bv, count, binhz)
  local log10, settext, sqrt = math.log10, display.settext, math.sqrt
  local nb = fftsa.sg_nbins
  for p = 1, count do
    local k = bi[p]
    if k ~= nil and k > 0 and bv[p] > 0 then
      local dk, iv = fftsa.peak_interp(k, nb)
      if iv == nil then dk, iv = 0, sqrt(bv[p]) end     -- no estimate: root of the power bin
      local f, v = (k - 1 + dk) * binhz, iv
      local ftxt
      if f >= 1000 then ftxt = string.format("%d  %.3f kHz", p, f / 1000)
      else ftxt = string.format("%d  %.1f Hz", p, f) end
      local vtxt
      if v >= 1 then vtxt = string.format("%.4f V", v)
      elseif v >= 1e-3 then vtxt = string.format("%.2f mV", v * 1e3)
      else vtxt = string.format("%.0f uV", v * 1e6) end
      -- Floored at the plot's own floor: a 1e-26 power bin reads -260 dBV against
      -- a -120 dBV axis, which the trace cannot show and the column has no room for.
      local dbv = 20 * log10(v)
      if not (dbv > fftsa.sg_dbmin) then dbv = fftsa.sg_dbmin end
      settext(fftsa.sg_pk_f[p], ftxt)
      settext(fftsa.sg_pk_v[p], vtxt)
      settext(fftsa.sg_pk_d[p], string.format("%.1f dBV", dbv))
    else
      settext(fftsa.sg_pk_f[p], string.format("%d  ---", p))
      settext(fftsa.sg_pk_v[p], "")
      settext(fftsa.sg_pk_d[p], "")
    end
  end
  return true
end

function fftsa.sg_status(txt)
  if fftsa.sg_stat ~= nil then display.settext(fftsa.sg_stat, txt) end
end


-- ================= tsp/spectrum_app.tsp =================
-- spectrum_app.tsp -- interactive standalone spectrum analyser for the DMM6500
--
-- The touch options form and the on-instrument run loop, over fft_core.tsp (the
-- transform and the windows), spectrum_ui.tsp (the loading cover, fftsa.find_peaks)
-- and spectrum_graph.tsp (fftsa.sg_*). The stop frequency sets the sample rate
-- (smallest exact rate >= 2*stop, with a 100 kS/s floor),
-- the start frequency only windows the display, the input range is
-- dmm.digitize.range, and the window and its beta pick the analysis window.
--
-- Every screen and field is created once in fftsa.start(), behind the loading cover,
-- and deleted once by fftsa.stop(). A press only ever switches screens: a create/delete
-- cycle risks part of the 463-object pool for the rest of the power cycle, because a
-- refused display.delete raises nothing. The capture buffer and the frame timer are the
-- two exceptions, replaced on a settings change or a measured change of period.

fftsa = fftsa or {}   -- the single global this app exposes

-- Every table, window and twiddle is sized from the selected power-of-two count.
-- 512 remains the default; larger records trade update speed for finer bins.
fftsa.n       = 512
fftsa.sample_counts = {512, 1024, 2048, 4096, 8192, 16384}
fftsa.sample_labels = {"512", "1024", "2048", "4096", "8192", "16384"}

-- Floor for the start frequency. A start of 0 would admit bin 1, which is DC and,
-- with the mean removed by fftsa.fft_load(), holds only window leakage.
fftsa.flomin  = 10          -- floor for the start frequency (Hz)
fftsa.flo     = 10          -- display start frequency (Hz)
fftsa.fhi     = 50000       -- display stop frequency (Hz)
-- Nyquist at the fastest rate, so this is the widest view the hardware can give.
-- The low end is not a hardware limit: zooming in does not change the bin width, so
-- 2 kHz is already down to about ten bins across the plot and narrower is a handful
-- of points.
fftsa.fhi_max = 500000
fftsa.fhi_min = 2000
fftsa.range   = 10          -- digitizer input range (V): 0.1 / 1 / 10
fftsa.fs      = 100000      -- sample rate (picked from fftsa.fhi, then measured)
fftsa.binhz   = 0           -- true bin width, from measured fs
fftsa.busy    = false       -- reentrancy guard (never preserved across a reload)
fftsa.stop_pending = false  -- a teardown deferred until the running frame ends
fftsa.halted  = false       -- frames suppressed after repeated failures
fftsa.lasterr = nil         -- last frame error, nil if none
fftsa.errcount = 0          -- count of dropped frames
fftsa.errrun  = 0           -- consecutive dropped frames
fftsa.errmax  = 20          -- give up (and say so) after this many in a row
fftsa.shortreads = 0        -- captures rejected for returning fewer than n samples

-- Firmware handles, initialised only on the first load: opening the App again in
-- one power session re-runs this body, and clearing a live handle would strand the
-- previous launch's objects. fftsa.start()'s opening fftsa.stop() reclaims them.
if fftsa.handles_inited == nil then
  fftsa.cap      = nil      -- acquisition buffer
  fftsa.cap_n    = nil      -- the fftsa.n it was sized for
  fftsa.optbtn   = nil      -- Options button on the spectrum screen
  fftsa.timer    = nil      -- periodic timer driving frames
  fftsa.errscr   = nil      -- error screen shown if startup fails
  fftsa.optscr   = nil      -- options form screen
  fftsa.opt_flo  = nil      -- Start Frequency edit field
  fftsa.opt_fhi  = nil      -- Stop Frequency edit field
  fftsa.opt_rng  = nil      -- Input Range edit-option field
  fftsa.opt_win  = nil      -- Window edit-option field
  fftsa.opt_beta = nil      -- Kaiser Beta edit-option field
  fftsa.opt_n    = nil      -- FFT sample-count edit-option field
  fftsa.opt_info = nil      -- read-back info line on the options screen
  fftsa.handles_inited = true
end

-- SAMPLE RATE: THE SPAN MAY RAISE IT, NEVER LOWER IT BELOW THE FLOOR.
--
-- There is no anti-alias filter in front of the digitizer, so a rate whose Nyquist falls
-- below what is on the wire folds that content in as peaks that are not there, at full
-- amplitude and with nothing on the glass to say so.
--
-- The direction is what matters. RAISING the rate can only remove aliases; lowering it is
-- what creates them. So zooming in never drops the rate: the span selects which bins are
-- drawn, and below the floor it stops affecting acquisition at all. Widening the span
-- past the floor's Nyquist does raise the rate, because showing 200 kHz honestly requires
-- sampling for it.
--
-- The floor is 100 kS/s, which gives 195.3 Hz bins at the default 512 samples. A higher
-- sample count makes bins finer; a higher rate coarsens them in proportion, which is the
-- price of the wider view. Content above the chosen Nyquist still folds: that is the
-- missing filter, not the rate, and no setting here removes it.
-- BAND-PASS, off by default. Low-pass the capture at the stop frequency and decimate to
-- match, so the transform sees only the band on screen. What that buys is bin width: the
-- effective rate becomes fs/D, so the bin is fs/(D*N) and a narrow span reaches a
-- resolution that would otherwise need a transform D times longer. The filter is what
-- makes the decimation safe -- without it everything above the new Nyquist folds in.
--
-- It cannot undo the folding that happens at the ADC. The rate floor is fs_min, so
-- content above fs_min/2 is already folded before any of this runs.
fftsa.bp_on = false

fftsa.fs_min = 100000
-- Exact, achievable rates only; the hardware cannot produce 102400 S/s.
fftsa.rates  = {100000, 200000, 500000, 1000000}

-- ONE RATE UP, which is what the band-pass is given. A digital filter can only remove
-- what the ADC did not already fold: at 100 kS/s everything above 50 kHz is in the record
-- as an alias before any of this runs, and no filter afterwards can separate it. Sampling
-- faster raises that Nyquist, and the filter then removes the band that used to fold.
--
-- The next rate in fftsa.rates rather than literally twice: the hardware has 100k, 200k,
-- 500k and 1M and nothing between, and 1 MS/s is the ceiling.
--
-- The cost is read budget. The bin is fs_acq/M, so holding the resolution means doubling
-- M with the rate -- and where bp_maxm already caps the decimation, at the narrowest
-- spans, the bin comes out coarser instead. Alias rejection is bought with resolution
-- there, which is the trade this makes deliberately.
function fftsa.bp_rate(fs)
  local r = fftsa.rates
  local n = table.getn(r)
  local i
  for i = 1, n do
    if r[i] > fs then return r[i] end
  end
  return r[n]
end

-- The rate and the decimation CHOSEN TOGETHER, by the bin width they produce. Stepping the
-- rate up is a gain only where the decimation can absorb it: at a 50 kHz span the
-- decimation is 1 either way, and stepping up there doubles the bin for nothing --
-- 390.63 Hz against 195.31 measured on the glass, with the filter not even in the path.
--
-- The finer bin wins. On a tie the higher rate wins, because its Nyquist is further from
-- the span and the filter then removes a band that would otherwise have folded at the ADC.
-- Where the read budget caps the decimation -- the narrowest spans -- the base rate wins
-- and keeps the resolution.
function fftsa.bp_plan(fhi, n)
  local base = fftsa.pick_fs(fhi)
  -- ONE STEP UP AT MOST. Searching every rate the hardware has finds a plan for a 50 kHz
  -- span -- 500 kS/s at /3 -- but 51 taps over 512 outputs is around 135 ms of
  -- multiply-accumulate, and the frame goes from 0.08 s to a quarter of a second for a
  -- bin COARSER than the unfiltered one. Not worth it: at a span that wide the filter is
  -- left out and the line says so.
  local cand = {base, fftsa.bp_rate(base)}
  local bestfs, bestd = nil, nil
  local i
  for i = 1, 2 do
    local fs = cand[i]
    if fs >= base then
      local d = fftsa.bp_pick_d(fs, fhi, n)
      -- A decimation of 1 is the filter bypassed, so only plans that can actually run
      -- are candidates; among those the finest bin wins.
      if d > 1 and (bestfs == nil or (fs / d) < (bestfs / bestd)) then
        bestfs, bestd = fs, d
      end
    end
  end
  -- Neither rate could decimate: run at the rate the span needs and leave the filter out.
  if bestfs == nil then return base, 1 end
  return bestfs, bestd
end

-- Smallest rate whose Nyquist covers the stop frequency, never below the floor.
function fftsa.pick_fs(fhi)
  local r = fftsa.rates
  local n = table.getn(r)
  for i = 1, n do
    if r[i] >= fftsa.fs_min and r[i] / 2 >= fhi then return r[i] end
  end
  return r[n]
end

-- Boolean fields are an EDIT_OPTION of two, because the firmware has no checkbox. Index
-- 1 is off, so a field the pool refused reads as off through fftsa.getval's fallback.
fftsa.onoff_labels = {"Off", "On"}

function fftsa.onoff_to_idx(v)
  if v then return 2 end
  return 1
end

fftsa.ranges       = {0.1, 1, 10}
fftsa.range_labels = {"0.1 V", "1 V", "10 V"}

function fftsa.range_to_idx(r)
  for i = 1, table.getn(fftsa.ranges) do
    if fftsa.ranges[i] == r then return i end
  end
  return 3
end

-- getvalue() on an OBJ_EDIT_OPTION returns the 1-based index, but it can also come
-- back as the option's own label, so both are read. Anything outside the list
-- clamps: an index used raw would otherwise fetch a nil option.
function fftsa.opt_index(v, labels, fallback)
  local n = table.getn(labels)
  if type(v) == "string" then
    for j = 1, n do
      if v == labels[j] then return j end
    end
    v = tonumber(v)
  end
  if v == nil then return fallback end
  v = math.floor(v + 0.5)
  if v < 1 then v = 1 end
  if v > n then v = n end
  return v
end

function fftsa.idx_to_range(v)
  local i = fftsa.opt_index(v, fftsa.range_labels, fftsa.range_to_idx(fftsa.range))
  return fftsa.ranges[i]
end

-- Falls back rather than raising. A count off the list can only arrive from a host
-- assignment, and raising here took Options and Apply down together with no way back
-- but End App: both paths call this before they can show anything.
function fftsa.sample_to_idx(n)
  for i = 1, table.getn(fftsa.sample_counts) do
    if fftsa.sample_counts[i] == n then return i end
  end
  return 1
end

function fftsa.options_samples()
  local i = fftsa.opt_index(fftsa.getval(fftsa.opt_n), fftsa.sample_labels,
                           fftsa.sample_to_idx(fftsa.n))
  return fftsa.sample_counts[i]
end

-- The DIGITIZER's rate, from the capture's own timestamps. The fallback is fs_acq, not
-- fftsa.fs: fftsa.fs is the decimated rate and returning it here would divide it twice.
function fftsa.measure_fs(buf)
  local back = fftsa.fs_acq or fftsa.fs
  local n = buf.n
  if n < 4 then return back end
  local t1, tN = buf.relativetimestamps[1], buf.relativetimestamps[n]
  if tN <= t1 then return back end
  return (n - 1) / (tN - t1)
end

-- Apply the current settings to the hardware and the graph. Safe to repeat: the
-- capture buffer is resized when needed; the graph keeps its original buffer.
-- fftsa.fft_init() rebuilds the window and its interpolation tables, which
-- is the slow part of a press -- about 0.3 s for Kaiser -- hence the cover.
function fftsa.apply()
  -- TWO RATES from here on. fs_acq is what the digitizer runs at; fftsa.fs is what the
  -- transform sees, which is fs_acq/bp_d once the band-pass is decimating. Everything
  -- downstream reads fftsa.fs -- binhz, the settings line, the span arithmetic -- so the
  -- decimation is invisible to it, which is the point.
  fftsa.fs_acq = fftsa.pick_fs(fftsa.fhi)
  local d = 1
  if fftsa.bp_on then
    fftsa.fs_acq, d = fftsa.bp_plan(fftsa.fhi, fftsa.n)
  end
  fftsa.bp_build(fftsa.fs_acq, fftsa.fhi, fftsa.n, d)
  local need = fftsa.bp_m
  fftsa.fs = fftsa.fs_acq / fftsa.bp_d
  fftsa.fft_init(fftsa.n)
  -- Before the sg_set_xrange() below, which reads it: the settings line counts the bins
  -- inside the span, and that count is computed from sg_nbins.
  fftsa.sg_nbins = fftsa.n / 2
  dmm.digitize.func       = dmm.FUNC_DIGITIZE_VOLTAGE
  dmm.digitize.range      = fftsa.range
  dmm.digitize.samplerate = fftsa.fs_acq
  -- The bin width commits with the rate, not after the capture: a capture that fails
  -- between the two -- a trigger timeout is the obvious one -- would otherwise leave the
  -- hardware at the new rate and fftsa.binhz at the old one. The measurement below
  -- refines it by about 0.01 %.
  fftsa.binhz = fftsa.fs / fftsa.n
  -- The span is fftsa.flo/fhi, committed by options_apply(), so the axis is pinned before
  -- the capture rather than after it.
  fftsa.sg_set_xrange(fftsa.flo, fftsa.fhi)
  dmm.digitize.aperture   = 1e-6
  -- The capture is bp_m long, which is fftsa.n unless the filter is decimating.
  dmm.digitize.count      = need
  if fftsa.cap ~= nil and fftsa.cap_n ~= need then
    fftsa.del_buf(fftsa.cap)
    fftsa.cap = nil
  end
  if fftsa.cap == nil then
    fftsa.cap   = buffer.make(need * 4, buffer.STYLE_STANDARD)
    fftsa.cap_n = need
  end
  fftsa.cap.clear()
  dmm.digitize.read(fftsa.cap)
  -- Measured from the timestamps, which are the DIGITIZER's: the readback is unreliable,
  -- and the decimation is arithmetic afterwards, so it divides the measured rate.
  fftsa.fs_acq = fftsa.measure_fs(fftsa.cap)
  fftsa.fs     = fftsa.fs_acq / fftsa.bp_d
  fftsa.binhz  = fftsa.fs / fftsa.n
  -- Large transforms outrun the 2 s default, so the guard follows the measured frame
  -- cost with margin rather than a multiple of the sample count.
  fftsa.busy_max = math.max(2.0, 3.0 * fftsa.frame_estimate(fftsa.n))
  -- Re-armed here, not at startup: the period depends on the sample count, and this is
  -- the one place the count changes. The timer object is replaced, which is a create and
  -- a delete; frame() does the same when the measured tick count changes, which is the
  -- only other place it happens.
  --
  -- This arm is from the model. frame() replaces it with one measured from real frames
  -- as soon as it has eight of them, so the peak is cleared here with the count.
  fftsa.work_peak, fftsa.work_seen = nil, 0
  if fftsa.timer ~= nil then
    fftsa.period = fftsa.frame_period(fftsa.n)
    fftsa.arm(fftsa.period)
  end
  fftsa.sg_pk_last, fftsa.sg_pk_lf, fftsa.sg_pk_lv = nil, {}, {}
  -- Again with the measured rate, which refines binhz and so the bin count the
  -- legend reports for a narrow span.
  fftsa.sg_set_xrange(fftsa.flo, fftsa.fhi)
end

-- One frame: acquire, transform, plot. Runs under pcall from fftsa.frame().
-- docs/PERFORMANCE.md has the measured phase costs.
function fftsa.frame_body()
  -- A frame can be dispatched while the app is half-built (a failed startup) or
  -- half-torn-down (End App, a host reload); bail out rather than index a nil.
  if fftsa.cap == nil or fftsa.sg_buf == nil or fftsa.sg_graph == nil
     or fftsa.sg_pk_f == nil then
    return
  end
  fftsa.cap.clear()
  dmm.digitize.read(fftsa.cap)
  -- A short capture is rejected, not transformed: zero-padding the tail would give
  -- a convincing but false broadband spectrum. The previous frame stays on screen.
  -- The length needed is bp_m, which is fftsa.n unless the filter is decimating -- and
  -- the filter's inner loop has no nil test, so this is what makes that safe.
  if fftsa.cap.n < fftsa.bp_m then
    fftsa.shortreads = (fftsa.shortreads or 0) + 1
    return
  end
  if fftsa.bp_d > 1 then
    fftsa.fft_load_rd(fftsa.bp_filter(fftsa.cap.readings))
  else
    fftsa.fft_load(fftsa.cap)
  end
  fftsa.fft_run()
  fftsa.fft_power()
  local nb = fftsa.fft_m
  -- Peaks are searched in the window the graph plots, so the table matches the trace.
  local kmin, kmax = fftsa.sg_window_bins(nb, fftsa.binhz)
  local bi, bv = fftsa.find_peaks(nb, fftsa.sg_npeak, kmin, kmax)
  -- Before the spectrum refill, so the yield at the end of that refill is the first
  -- paint either buffer sees after both are complete.
  fftsa.sg_update_markers(bi, bv, fftsa.sg_npeak, fftsa.binhz)
  fftsa.sg_update(nb, fftsa.binhz)
  fftsa.sg_show_peaks(bi, bv, fftsa.sg_npeak, fftsa.binhz)
end

-- Reentrancy-guarded frame. The body runs under pcall so an error cannot leave
-- fftsa.busy set, which would make every later frame return at the top. A host
-- abort (event 1409) mid-frame is not covered by the pcall and does leave it set,
-- so a guard held longer than fftsa.busy_max is broken and the break counted.
fftsa.busy_since = nil
fftsa.busy_max   = 2.0      -- seconds a guard may be held before it is judged stuck


-- Seconds one frame costs at a given sample count, from costs measured on the
-- instrument on 2026-10-24 (docs/PERFORMANCE.md): 10.9 us a sample to acquire, 32.0
-- to load and window, 3.593e-6 per butterfly-equivalent for the transform and its
-- power, 3.7 us a sample for the peak search, and a fill fixed at sg_ncol points.
-- Predicts 0.080 s at 512 against 0.079 measured and 1.63 s at 16384 against 1.686.
--
-- busy_max exists to break a guard a host abort left set, and until it expires the app
-- looks dead -- so it has to clear a legitimate frame and not much more. Three times the
-- model does that at every count; a multiple of the sample count does not.
function fftsa.frame_estimate(n)
  if n == nil or n < 2 then n = 512 end
  local log2n = math.log(n) / 0.69314718055995
  local est = n * 46.6e-6 + 3.593e-6 * n * log2n + 0.04
  -- The band-pass adds the reads it does not share with the plain path and one
  -- multiply-accumulate per tap per output. Derived from the documented per-operation
  -- costs -- 22 us a buffer reading, and two table reads plus a multiply and an add at
  -- 1.4 and 1.2 us -- not measured on this loop, so it is a starting point: frame()
  -- replaces the period with one measured from real frames after eight of them.
  if fftsa.bp_d ~= nil and fftsa.bp_d > 1 then
    est = est + (fftsa.bp_m - n) * 22e-6 + n * fftsa.bp_l * 5.2e-6
  end
  return est
end
fftsa.busy_stuck = 0        -- how many times the guard had to be broken

function fftsa.frame()
  if fftsa.halted then return end
  if fftsa.busy then
    local since = fftsa.busy_since
    if since == nil or (os.clock() - since) < (fftsa.busy_max or 2.0) then return end
    fftsa.busy_stuck = (fftsa.busy_stuck or 0) + 1
  end
  fftsa.busy_since = os.clock()
  fftsa.busy = true
  -- Timed, because the timer period is set from what a frame actually costs.
  local entry = os.clock()
  local ok, err = pcall(fftsa.frame_body)
  fftsa.frame_work = os.clock() - entry
  -- RE-ARM FROM MEASURED WORK. frame_estimate() is a model fitted at one point count and
  -- one draw path -- 80.4 ms against 79 measured at 512, 216 against 212 at 2048 -- and
  -- divided by the occupancy target an error of that size can land either side of a tick
  -- boundary, which is a 50 % swing in displayed rate. The period follows real frames.
  --
  -- The peak over a window of frames, not the mean: the period has to cover the slowest
  -- frame or ticks are dropped and the rate halves. It is only ever raised by a whole
  -- tick and only re-armed when the tick count actually changes, so a frame that runs
  -- long once does not re-arm the timer every frame afterwards.
  if ok then
    if fftsa.work_peak == nil or fftsa.frame_work > fftsa.work_peak then
      fftsa.work_peak = fftsa.frame_work
    end
    fftsa.work_seen = (fftsa.work_seen or 0) + 1
    if fftsa.work_seen >= 8 and fftsa.timer ~= nil then
      local want = fftsa.tick_period(fftsa.work_peak)
      if want ~= fftsa.period then
        fftsa.period = want
        fftsa.arm(want)
      end
      -- Decay the peak so a size change downwards is noticed: it is re-earned over the
      -- next window rather than remembered for the life of the app.
      fftsa.work_peak = fftsa.frame_work
      fftsa.work_seen = 0
    end
  end
  if not ok then
    -- Re-bind the trace after a failure so the graph is never left without one, and only
    -- while the bound buffer still holds points: adding over an empty one binds nothing
    -- and never draws again.
    if fftsa.sg_graph ~= nil and fftsa.sg_buf ~= nil and fftsa.sg_buf.n > 0 then
      fftsa.sg_rebind()
    end
    fftsa.lasterr  = tostring(err)
    fftsa.errcount = (fftsa.errcount or 0) + 1
    fftsa.errrun   = (fftsa.errrun or 0) + 1
    -- After a run of failures stop retrying and say so on screen: a trace that
    -- stopped updating looks like a working analyser on a dead signal.
    if fftsa.errrun >= (fftsa.errmax or 20) then
      fftsa.halted = true
      display.settext(fftsa.sg_xunit,
        "HALTED after " .. fftsa.errrun .. " failed frames: " ..
        string.sub(tostring(fftsa.lasterr), 1, 60))
    end
  else
    fftsa.errrun = 0
  end
  fftsa.busy = false
  -- A teardown that arrived mid-frame waits here, where nothing is in flight.
  if fftsa.stop_pending then
    fftsa.stop_pending = false
    fftsa.stop()
  end
end

-- The firmware frees the fields with their screen; the Lua handles still need clearing.
function fftsa.destroy_options()
  if fftsa.optscr ~= nil then
    -- Never delete the screen currently on show: leave it first.
    fftsa.show_main()
    fftsa.del_obj(fftsa.optscr)
  end
  fftsa.optscr, fftsa.opt_flo, fftsa.opt_fhi, fftsa.opt_rng, fftsa.opt_info =
    nil, nil, nil, nil, nil
  fftsa.opt_win, fftsa.opt_beta, fftsa.opt_n = nil, nil, nil
  fftsa.opt_mk, fftsa.opt_bp = nil, nil
  fftsa.opt_info_last = nil
end

-- Form geometry, two columns like the decode app's: six fields become three rows,
-- and the gap that buys is what makes each box a touch target. display.create takes
-- no width for an OBJ_EDIT_*, so the second column's x is the one number to check on
-- the glass. Labels are right-aligned and end at the column x.
-- Six: Peak Markers and Band-Pass are both withheld. See fftsa.opt_mk and fftsa.opt_bp.
fftsa.opt_nf      = 6
fftsa.opt_cols    = 2
fftsa.opt_x       = 185
fftsa.opt_x_c2    = 552
fftsa.opt_y0      = 8
fftsa.opt_dy      = 100     -- preferred pitch; clamped to what fits
fftsa.opt_edit_h  = 50      -- box height, measured
fftsa.opt_edit_dy = 4       -- offset of the box inside the object
fftsa.opt_y_adj   = 0       -- nudge of the centred block, negative being up
fftsa.opt_btn_y   = 360
fftsa.opt_info_y  = 323     -- readback line BASELINE; an OBJ_TEXT y is its baseline
fftsa.opt_info_h  = 20      -- its height above that baseline, so the fields clear it

-- Rows, pitch and top for the field block. The pitch is the preferred one, clamped if a
-- field count ever needs it: the last box has to end above the button row. At the six
-- fields the form carries, three rows at the preferred 100 leave the clamp inert.
function fftsa.opt_layout()
  local nrows = math.ceil(fftsa.opt_nf / fftsa.opt_cols)
  local eh, edy = fftsa.opt_edit_h, fftsa.opt_edit_dy
  local y0, dy  = fftsa.opt_y0, fftsa.opt_dy
  -- The last box has to end above the READBACK LINE, which sits above the buttons: at
  -- seven fields the button row alone leaves the bottom box over the top of it.
  local floor_y = fftsa.opt_info_y - fftsa.opt_info_h
  if nrows > 1 then
    local maxdy = math.floor((floor_y - y0 - edy - eh) / (nrows - 1))
    if dy > maxdy then dy = maxdy end
  end
  -- Centred, because three rows do not fill the form, then nudged. Only ever down,
  -- and only by what is spare; the nudge is separate from y0 because the centring
  -- divides the leftover space and would give back half of a move asked for there.
  local spare = floor_y - ((nrows - 1) * dy + eh + edy) - y0
  if spare > 0 then y0 = y0 + math.floor(spare / 2) end
  if y0 + fftsa.opt_y_adj >= 0 then y0 = y0 + fftsa.opt_y_adj end
  fftsa.opt_nrows, fftsa.opt_dy_used, fftsa.opt_y0_used = nrows, dy, y0
  return nrows, dy, y0
end

function fftsa.build_options()
  fftsa.destroy_options()

  local create = display.create
  -- A screen title over 31 characters is truncated by the firmware (event 1707).
  fftsa.optscr = create(display.ROOT, display.OBJ_SCREEN, "FFT ANALYSER OPTIONS")
  if fftsa.optscr == nil then
    fftsa.lasterr = "display object pool exhausted building the options screen -- "
                    .. "power cycle the instrument."
    return false, fftsa.lasterr
  end
  fftsa.loading_front()

  -- Columns fill top to bottom, left column first. No instructions on the form:
  -- the fields label themselves.
  local nrows, dy, y0 = fftsa.opt_layout()
  local row = 0
  local function nextpos()
    local c = math.floor(row / nrows)
    if c > fftsa.opt_cols - 1 then c = fftsa.opt_cols - 1 end
    local fx = fftsa.opt_x
    if c > 0 then fx = fftsa.opt_x_c2 end
    local fy = y0 + (row - c * nrows) * dy
    row = row + 1
    return fx, fy
  end

  local x1, y1 = nextpos()
  fftsa.opt_flo = create(fftsa.optscr, display.OBJ_EDIT_NUMBER, x1, y1,
                       "Start Freq", "low edge",
                       display.NFORMAT_PREFIX, fftsa.flo, fftsa.flomin, fftsa.fhi_max - 1000, "Hz")
  local x2, y2 = nextpos()
  fftsa.opt_fhi = create(fftsa.optscr, display.OBJ_EDIT_NUMBER, x2, y2,
                       "Stop Freq", "display top",
                       display.NFORMAT_PREFIX, fftsa.fhi, fftsa.fhi_min, fftsa.fhi_max, "Hz")
  local x3, y3 = nextpos()
  fftsa.opt_rng = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x3, y3,
                       "Input Range", "full-scale",
                       fftsa.range_labels[1], fftsa.range_labels[2], fftsa.range_labels[3])
  -- Spelled out rather than built from the table: display.create takes the options
  -- as separate arguments and Lua 5.0.2 has no unpack() worth using here.
  -- BAND-PASS IS NOT OFFERED, so fftsa.opt_bp stays nil and the read falls back to
  -- whatever fftsa.bp_on already is -- which leaves it settable over the socket without
  -- putting it on the form.
  --
  -- It works and it is measured flat to 0.02 dB across the span with 61 dB of rejection
  -- above the Nyquist. What it is not is worth the frame: the filter is one
  -- multiply-accumulate per tap per output, 51 taps over 512 outputs, and the frame goes
  -- from 0.08 s to around a quarter of a second. On the glass that buys nothing an
  -- operator can see at the spans where it can run at all, and at 4096 samples and up the
  -- read budget leaves no room for it whatever the span.
  local x5, y5 = nextpos()
  fftsa.opt_win = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x5, y5,
                       "Window", "lobe vs sidelobe",
                       fftsa.win_names[1], fftsa.win_names[2], fftsa.win_names[3],
                       fftsa.win_names[4])
  -- Always built, not only when Kaiser is selected: a field created on a press is a
  -- create on a visible screen, and this one is inert for the other three windows.
  local x6, y6 = nextpos()
  fftsa.opt_beta = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x6, y6,
                       "Kaiser Beta", "sidelobe level",
                       fftsa.kbeta_labels[1], fftsa.kbeta_labels[2], fftsa.kbeta_labels[3],
                       fftsa.kbeta_labels[4], fftsa.kbeta_labels[5], fftsa.kbeta_labels[6])
  local x7, y7 = nextpos()
  fftsa.opt_n = create(fftsa.optscr, display.OBJ_EDIT_OPTION, x7, y7,
                       "FFT Samples", "resolution vs speed",
                       fftsa.sample_labels[1], fftsa.sample_labels[2], fftsa.sample_labels[3],
                       fftsa.sample_labels[4], fftsa.sample_labels[5], fftsa.sample_labels[6])
  -- PEAK MARKERS IS NOT OFFERED YET, so the eighth field is not created and fftsa.opt_mk
  -- stays nil. The field reads through fftsa.getval, which answers the fallback for a nil
  -- handle, so options_apply() sees "off" and nothing binds the marker trace.
  --
  -- What is missing is the second trace's scaling. The firmware does not honour a pin
  -- applied with that trace selected, so its six points are auto-scaled across the whole
  -- plot and land nowhere near the spectrum. The machinery below it -- the buffer, the
  -- refill, the binding -- is all in place and tested; only the axes are wrong.
  --
  -- The marker form is also settled: NOT dots. drawstyle is per graph, so markers on the
  -- peak trace put markers on the spectrum too, which is not wanted. The peaks will be
  -- needles drawn with STYLE_LINE -- floor, peak, floor at a pixel either side.

  fftsa.opt_info = create(fftsa.optscr, display.OBJ_TEXT, 400, fftsa.opt_info_y, "",
                        56575, display.FONT_SMALL, display.JUST_CENTER)   -- cyan 00DCFF
  -- A timer on the options screen previews edits without configuring acquisition.
  local preview = create(fftsa.optscr, display.OBJ_TIMER, 0.2, display.TIMER_FOREVER)
  display.setevent(preview, display.EVENT_PRESS,
                  "if fftsa ~= nil then fftsa.guard(fftsa.options_preview) end")

  local b_apply = create(fftsa.optscr, display.OBJ_BUTTON, 470, fftsa.opt_btn_y, "Apply", 140)
  display.setevent(b_apply, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.options_apply) end")
  local b_cancel = create(fftsa.optscr, display.OBJ_BUTTON, 630, fftsa.opt_btn_y, "Cancel", 140)
  display.setevent(b_cancel, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.options_cancel) end")
  local b_about = create(fftsa.optscr, display.OBJ_BUTTON, 8, fftsa.opt_btn_y, "About", 140)
  display.setevent(b_about, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.about) end")
  -- End App is hooked on this screen too: the firmware may deliver EVENT_ENDAPP to
  -- the visible screen, and leaving from the form must still tear down.
  display.setevent(fftsa.optscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  return fftsa.optscr
end

-- ==================== About ====================
-- An OBJ_TEXT y is the text's BASELINE, not the top of its box, which is why these sit
-- lower than a button's y for the same apparent position.
fftsa.about_x        = 12
fftsa.about_title_x  = 400        -- centred, so the x is the screen's middle
fftsa.about_title_y  = 30
fftsa.about_body_y   = 70
-- FONT_1's line pitch, measured on the panel: the numbered fonts are in the firmware's
-- registration table but not in the display API reference, and FONT_1 draws about 17 px
-- tall. Eleven rows at this pitch end clear of the button row at opt_btn_y.
fftsa.about_body_dy  = 20
-- Rows a page. 14 splits the licence after the blank line that follows the copyright
-- notice, so the first page carries everything up to it and the second starts flush with
-- the warranty block instead of with a blank row.
fftsa.about_rows     = 14
fftsa.about_page     = 1
fftsa.about_c_title  = 56575      -- cyan 00DCFF
fftsa.about_c_body   = 16777215   -- white

-- The licence, verbatim from LICENSE and wrapped there: OBJ_TEXT does not wrap, so one
-- line is one row, and a blank line is a row of its own.
fftsa.about_text = {
  "MIT License",
  "",
  "Copyright (c) 2026 Ian Ameline",
  "",
  "Permission is hereby granted, free of charge, to any person obtaining a copy",
  'of this software and associated documentation files (the "Software"), to deal',
  "in the Software without restriction, including without limitation the rights",
  "to use, copy, modify, merge, publish, distribute, sublicense, and/or sell",
  "copies of the Software, and to permit persons to whom the Software is",
  "furnished to do so, subject to the following conditions:",
  "",
  "The above copyright notice and this permission notice shall be included in",
  "all copies or substantial portions of the Software.",
  "",
  'THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR',
  "IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,",
  "FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE",
  "AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER",
  "LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,",
  "OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE",
  "SOFTWARE.",
}

function fftsa.destroy_about()
  if fftsa.aboutscr ~= nil then
    -- Never delete the screen currently on show: leave it first.
    fftsa.show_main()
    fftsa.del_obj(fftsa.aboutscr)
  end
  fftsa.aboutscr, fftsa.about_name, fftsa.about_lines = nil, nil, nil
  fftsa.about_pageno, fftsa.about_page = nil, 1
end

function fftsa.about_pages()
  local rows = fftsa.about_rows
  return math.ceil(table.getn(fftsa.about_text) / rows)
end

-- Page p into the row objects, which are made once and rewritten. A row past the end of
-- the licence is blanked rather than left holding the previous page.
function fftsa.about_show_page(p)
  if fftsa.about_lines == nil then return false end
  local last = fftsa.about_pages()
  if p < 1 then p = 1 end
  if p > last then p = last end
  fftsa.about_page = p
  local base, i = (p - 1) * fftsa.about_rows, nil
  for i = 1, fftsa.about_rows do
    local s = fftsa.about_text[base + i]
    if s == nil then s = "" end
    fftsa.settxt(fftsa.about_lines[i], s)
  end
  fftsa.settxt(fftsa.about_pageno, string.format("page %d of %d", p, last))
  return true
end

function fftsa.about_pgup()
  return fftsa.about_show_page(fftsa.about_page - 1)
end

function fftsa.about_pgdn()
  return fftsa.about_show_page(fftsa.about_page + 1)
end

-- Built at launch with every other screen. A create on a visible screen is what strands
-- objects, and the only screen visible during a build is the loading cover.
function fftsa.build_about()
  fftsa.destroy_about()
  local create = display.create
  fftsa.aboutscr = create(display.ROOT, display.OBJ_SCREEN, "FFT Analyser - About")
  if fftsa.aboutscr == nil then
    fftsa.lasterr = "display object pool exhausted building the about screen -- "
                    .. "power cycle the instrument."
    return false, fftsa.lasterr
  end
  fftsa.loading_front()
  -- Outside the paged rows, so it stays put whichever page is showing.
  fftsa.about_name = create(fftsa.aboutscr, display.OBJ_TEXT, fftsa.about_title_x,
                            fftsa.about_title_y, "Author: Ian Ameline",
                            fftsa.about_c_title, display.FONT_4, display.JUST_CENTER)
  fftsa.about_lines = {}
  local y, i = fftsa.about_body_y, nil
  for i = 1, fftsa.about_rows do
    fftsa.about_lines[i] = create(fftsa.aboutscr, display.OBJ_TEXT, fftsa.about_x, y, "",
                                  fftsa.about_c_body, display.FONT_1, display.JUST_LEFT)
    y = y + fftsa.about_body_dy
  end
  fftsa.about_pageno = create(fftsa.aboutscr, display.OBJ_TEXT, fftsa.about_title_x,
                              fftsa.opt_btn_y - 8, "", fftsa.about_c_title,
                              display.FONT_SMALL, display.JUST_CENTER)
  local b_up = create(fftsa.aboutscr, display.OBJ_BUTTON, 8, fftsa.opt_btn_y, "PgUp", 140)
  display.setevent(b_up, display.EVENT_PRESS,
                   "if fftsa ~= nil then fftsa.guard(fftsa.about_pgup) end")
  local b_dn = create(fftsa.aboutscr, display.OBJ_BUTTON, 168, fftsa.opt_btn_y,
                      "PgDn", 140)
  display.setevent(b_dn, display.EVENT_PRESS,
                   "if fftsa ~= nil then fftsa.guard(fftsa.about_pgdn) end")
  local b_back = create(fftsa.aboutscr, display.OBJ_BUTTON, 630, fftsa.opt_btn_y,
                        "Back", 140)
  display.setevent(b_back, display.EVENT_PRESS,
                   "if fftsa ~= nil then fftsa.guard(fftsa.about_back) end")
  -- End App is delivered to the visible screen, and this one can be it.
  display.setevent(fftsa.aboutscr, display.EVENT_ENDAPP,
                   "if fftsa ~= nil then fftsa.cleanup() end")
  fftsa.about_show_page(1)
  return fftsa.aboutscr
end

-- A press only switches, like Options: a nil handle means the pool refused at build.
-- Always from the first page, so the screen reads the same every time it is opened.
function fftsa.about()
  if fftsa.aboutscr == nil then return false end
  fftsa.about_show_page(1)
  display.changescreen(fftsa.aboutscr)
  return true
end

-- Back to the form it was opened from, or to the spectrum if the form is gone.
function fftsa.about_back()
  if fftsa.optscr == nil then return fftsa.show_main() end
  display.changescreen(fftsa.optscr)
  return true
end

function fftsa.sample_rate_text(fs)
  if fs >= 1000000 then return string.format("%g MS/s", fs / 1000000) end
  if fs >= 1000 then return string.format("%g kS/s", fs / 1000) end
  return string.format("%g S/s", fs)
end

-- Acquisition duration is N/fs, not the first-to-last timestamp interval (N-1)/fs -- and
-- with the band-pass decimating, fs is the rate the TRANSFORM sees, so N/fs is still the
-- record length in time. The decimation is named rather than left implicit: at /4 the
-- digitizer is running four times faster than the rate on the line.
-- The band-pass, always stated, on or off. When it is on the decimation is what says
-- whether the filter is actually in the path: no decimation means the span is too wide
-- for any, and the capture reaches the transform untouched.
--
-- Its own function because the two readback lines want it in different places -- last on
-- the spectrum screen, after the input range, and last on the Options line too, where
-- there is no range to come after.
function fftsa.bp_text(d, on)
  if d == nil then d = fftsa.bp_d end
  if on == nil then on = fftsa.bp_on end
  if not on then return "BP:Off" end
  if d ~= nil and d > 1 then return string.format("BP:On /%d", d) end
  return "BP:On (" .. fftsa.bp_why(fftsa.fs_acq, fftsa.fhi, fftsa.n) .. ")"
end

-- fs IS THE DIGITIZER'S RATE, never the decimated one. The decimated rate is a derived
-- figure -- 200 kS/s over /3 is 66.667 -- and printing that as "fs" reads as the hardware
-- running below its own 100 kS/s floor, which it never does. The bin and the record
-- length are computed from the decimated rate, where they belong: the bin is fs_eff/N, and
-- N/fs_eff is the same record duration as N*D/fs_acq.
function fftsa.opt_info_text(fs, n, wi, bi, acq)
  fs, n = fs or fftsa.fs, n or fftsa.n
  if acq == nil then acq = fftsa.fs_acq or fs end
  return string.format("fs %s   bin %.2f Hz   acq %.2f ms   %s",
                       fftsa.sample_rate_text(acq), fs / n, 1000 * n / fs,
                       fftsa.win_label(wi, bi))
end

-- Read a field, or answer the fallback if the handle was never built. The firmware
-- returns nil from display.create when the object pool is exhausted, so a field handle
-- can legitimately be nil, and getvalue on nil is a raise in OUR code -- not a firmware
-- refusal. Testing for nil here is what keeps a missing field from taking Options and
-- Apply down with it.
function fftsa.getval(h, fallback)
  if h == nil then return fallback end
  return display.getvalue(h)
end

-- Set a field, or do nothing if the handle was never built. See fftsa.options().
function fftsa.setval(h, v)
  if h == nil then return false end
  display.setvalue(h, v)
  return true
end

-- Set a text, or do nothing if the handle was never built.
function fftsa.settxt(h, t)
  if h == nil then return false end
  display.settext(h, t)
  return true
end

function fftsa.options_preview()
  local lo, hi = fftsa.options_span()
  local n = fftsa.options_samples()
  local fs = fftsa.pick_fs(hi)
  -- Reuse the timestamp-measured rate when previewing the active acquisition rate.
  if fs == fftsa.pick_fs(fftsa.fhi) then fs = fftsa.fs_acq or fftsa.fs end
  -- The decimation the pending fields would get, so the previewed bin width is the one
  -- Apply will actually produce rather than the undecimated one.
  local d = 1
  local bp = (fftsa.opt_index(fftsa.getval(fftsa.opt_bp), fftsa.onoff_labels,
                              fftsa.onoff_to_idx(fftsa.bp_on)) == 2)
  if bp then
    -- The same plan Apply will make, or the preview promises a bin width it cannot
    -- produce: the rate and the decimation are chosen together.
    fs, d = fftsa.bp_plan(hi, n)
  end
  local acq = fs
  fs = fs / d
  -- The window comes from the fields too, or three quarters of the line would track
  -- the edit and the fourth would silently show the applied window.
  local wi = fftsa.opt_index(fftsa.getval(fftsa.opt_win), fftsa.win_names, fftsa.win_i)
  local bi = fftsa.opt_index(fftsa.getval(fftsa.opt_beta), fftsa.kbeta_labels,
                             fftsa.kbeta_i)
  local text = fftsa.opt_info_text(fs, n, wi, bi, acq) .. "   " .. fftsa.bp_text(d, bp)
  if text ~= fftsa.opt_info_last then
    fftsa.settxt(fftsa.opt_info, text)
    fftsa.opt_info_last = text
  end
end

-- Every button press goes through here. A press is dispatched by the firmware
-- evaluating the command string setevent was given, and an error raised inside that
-- string arrives as a dialog over the app, not as a return value anyone can read --
-- so the handler is the last place that can catch it.
function fftsa.guard(f)
  if f == nil then return false end
  local ok, err = pcall(f)
  if not ok then
    fftsa.lasterr = "button handler failed: " .. tostring(err)
    fftsa.say(fftsa.lasterr)
  end
  return ok
end

-- Put a line on the glass, on the settings line under the peak rows. Failures that are
-- only recorded in fftsa.lasterr are invisible to the operator, who sees a press that did
-- nothing and a previous spectrum still running. The settings line is rewritten by the
-- next fftsa.sg_set_xrange(), so this is not sticky.
function fftsa.say(msg)
  if fftsa.sg_xunit ~= nil then
    display.settext(fftsa.sg_xunit, string.sub(tostring(msg), 1, 70))
  end
end

-- Back to the spectrum screen, which is also what lets the frame timer run again.
function fftsa.show_main()
  if fftsa.sg_scr ~= nil then
    display.changescreen(fftsa.sg_scr)
    return true
  end
  display.changescreen(display.SCREEN_HOME)
  return false
end

-- A press only switches. Everything is built in fftsa.start(), so a nil handle
-- means the object pool refused and building it now would fail the same way.
function fftsa.options()
  if fftsa.optscr == nil then return false end
  -- A nil handle is what an exhausted pool leaves, so every field goes through the
  -- nil-testing setters: the cost is then the fields the pool refused, not the Options
  -- button and Apply together.
  fftsa.setval(fftsa.opt_flo, fftsa.flo)
  fftsa.setval(fftsa.opt_fhi, fftsa.fhi)
  fftsa.setval(fftsa.opt_rng, fftsa.range_to_idx(fftsa.range))
  fftsa.setval(fftsa.opt_win, fftsa.win_i)
  fftsa.setval(fftsa.opt_beta, fftsa.kbeta_i)
  fftsa.setval(fftsa.opt_n, fftsa.sample_to_idx(fftsa.n))
  -- Guarded like its neighbours: five field reads on handles the pool may have refused,
  -- and changescreen is the next line. Unguarded, a refusal at the end of the create list
  -- leaves the Options button dead for the life of the app.
  fftsa.options_preview()
  display.changescreen(fftsa.optscr)
  return true
end

function fftsa.options_span()
  local lo = fftsa.getval(fftsa.opt_flo, fftsa.flo)
  local hi = fftsa.getval(fftsa.opt_fhi, fftsa.fhi)
  -- Clamp each end to what the fixed rate can show, then order the pair: a stop at
  -- or below the start is a window with no bins in it. One repair is enough and
  -- provably so -- the stop lands in fhi_min..fhi_max and fhi_min is above flomin,
  -- so dropping the start to its floor always leaves start < stop. Repairing the
  -- start without re-testing the stop does NOT, which is why the order matters.
  local nlo, nhi = fftsa.flo, fftsa.fhi
  if hi ~= nil and hi > 0 then nhi = hi end
  if lo ~= nil and lo >= 0 then nlo = lo end
  if nhi > fftsa.fhi_max then nhi = fftsa.fhi_max end
  if nhi < fftsa.fhi_min then nhi = fftsa.fhi_min end
  if nlo < fftsa.flomin then nlo = fftsa.flomin end
  if nlo >= nhi then nlo = fftsa.flomin end
  return nlo, nhi
end

function fftsa.options_apply()
  -- Every field is read before anything is committed: a raise in here leaves the
  -- applied state untouched, where a raise after the first commit would leave the
  -- span changed with the axis, the cover and the message all still describing the
  -- old one -- and say() writes the spectrum screen, which is not on show yet.
  local ri = fftsa.getval(fftsa.opt_rng)
  local wi = fftsa.getval(fftsa.opt_win)
  local bi = fftsa.getval(fftsa.opt_beta)
  local mki = fftsa.opt_index(fftsa.getval(fftsa.opt_mk),
                              fftsa.onoff_labels,
                              fftsa.onoff_to_idx(fftsa.sg_markers))
  local bpi = fftsa.opt_index(fftsa.getval(fftsa.opt_bp),
                              fftsa.onoff_labels,
                              fftsa.onoff_to_idx(fftsa.bp_on))
  local nnew = fftsa.options_samples()
  local nlo, nhi = fftsa.options_span()
  fftsa.flo, fftsa.fhi = nlo, nhi
  local nold    = fftsa.n
  fftsa.n       = nnew
  fftsa.range   = fftsa.idx_to_range(ri)
  fftsa.win_i   = fftsa.opt_index(wi, fftsa.win_names, fftsa.win_i)
  fftsa.kbeta_i = fftsa.opt_index(bi, fftsa.kbeta_labels, fftsa.kbeta_i)
  -- Rebound only on a change: sg_bind() calls removeall, which repaints the whole widget
  -- including its axis labels, and this is the one moment that is already a repaint.
  local mknew = (mki == 2)
  local mkchanged = (mknew ~= fftsa.sg_markers)
  fftsa.sg_markers = mknew
  fftsa.bp_on = (bpi == 2)
  -- Under the cover: fftsa.apply() rebuilds the window tables and takes a capture,
  -- and the frame timer does not run while its screen is off show, so no frame can
  -- meet half-rebuilt tables.
  fftsa.loading_front()
  -- A failed resize must not resume frames with mismatched FFT and buffer sizes.
  -- An unchanged size cannot desync them, and halting there would freeze the trace
  -- on any failed capture -- a trigger timeout leaves binhz describing the rate in
  -- force, which is exactly the case the frames should keep running through.
  fftsa.halted = (fftsa.n ~= nold)
  local ok, err = pcall(function() fftsa.apply() end)
  fftsa.show_main()
  if not ok then
    fftsa.lasterr = tostring(err)
    fftsa.say("APPLY FAILED: " .. tostring(err))
  else
    fftsa.halted, fftsa.errrun = false, 0
    if mkchanged then fftsa.sg_bind() end
    display.settext(fftsa.sg_xunit, fftsa.sg_xunit_text())
  end
  return ok
end

function fftsa.options_cancel()
  fftsa.show_main()
end

-- Everything the app ever displays, created here and nowhere else. The cover comes
-- first so that no screen is ever assembled in view.
function fftsa.build()
  fftsa.loading_build()
  fftsa.loading_front()
  -- The trace buffer at sg_maxpts, for the life of the app: allocated at the CEILING
  -- rather than at sg_ncol so the point count stays adjustable upwards while running
  -- without anything being resized or reallocated.
  local scr, why = fftsa.sg_build("FFT SPECTRUM ANALYSER", fftsa.n / 2, fftsa.sg_maxpts)
  if scr == nil then return false, why end
  -- The button died with the screen fftsa.sg_build() just destroyed: clear the
  -- stale handle, do not delete it.
  fftsa.optbtn = nil
  fftsa.optbtn = display.create(fftsa.sg_scr, display.OBJ_BUTTON, 645, 350, "Options", 145)
  display.setevent(fftsa.optbtn, display.EVENT_PRESS, "if fftsa ~= nil then fftsa.guard(fftsa.options) end")
  local optok, optwhy = fftsa.build_options()
  if optok == false then return false, optwhy end
  local aboutok, aboutwhy = fftsa.build_about()
  if aboutok == false then return false, aboutwhy end
  return fftsa.sg_scr
end

-- Seconds of timer period that leave a frame of this length about 20 % idle, rounded up
-- to the firmware's 0.05 s tick floor (arm(0.045) is refused with event 1131). The one
-- place the occupancy rule lives, so the modelled first arm and the measured re-arms
-- cannot disagree about it.
--
-- The idle is what dispatches a touch. delay() lets the display task PAINT -- that is C
-- -- but a press means evaluating Lua, and a tick landing during a frame is dropped, so
-- without the headroom the gap is whatever the quantisation happens to leave: at the
-- 0.05 s floor that was 12 ms of 500 at 4096 samples, and Options was unreachable there.
--
-- The slack matters as much as the 0.8 does. A tick is 50 ms, so holding the occupancy
-- target to the last millisecond buys a fiftieth of a tick of idle and costs a WHOLE tick
-- of rate: the worst frame at 512 samples is 80.1 ms, which over 0.8 is 100.1 ms -- a
-- tenth of a millisecond past two ticks -- and taking three would have been 6.67 fps
-- against the 10 that 80.1 % occupancy allows. A twentieth of a tick, 2.5 ms, can only
-- change the answer for a frame already that close to a boundary, and there it prefers
-- the rate.
function fftsa.tick_period(busy)
  if busy == nil or busy <= 0 then return 0.05 end
  local ticks = math.ceil((busy / 0.8) / 0.05 - 0.05)
  if ticks < 1 then ticks = 1 end
  return ticks * 0.05
end

-- The FIRST arm, before any frame has been timed. From here on frame() re-arms from the
-- work it actually measures.
function fftsa.frame_period(n)
  return fftsa.tick_period(fftsa.frame_estimate(n))
end

-- Arm the frame timer. It is active only while its parent screen is visible, which is
-- what stops frames while Options or About is on show. One frame per tick: back-to-back
-- frames keep the interpreter out of its event loop.
function fftsa.arm(period_s)
  if period_s == nil then period_s = 0.05 end
  if fftsa.timer ~= nil then
    fftsa.del_obj(fftsa.timer)
    fftsa.timer = nil
  end
  if fftsa.sg_scr == nil then return nil end
  fftsa.timer = display.create(fftsa.sg_scr, display.OBJ_TIMER, period_s, display.TIMER_FOREVER)
  display.setevent(fftsa.timer, display.EVENT_PRESS, "if fftsa ~= nil and fftsa.frame ~= nil then fftsa.frame() end")
  return fftsa.timer
end

function fftsa.cleanup()
  fftsa.stop()
end

-- Hooked as soon as the spectrum screen exists, so a later startup failure still
-- leaves a way out that cleans up.
function fftsa.install_cleanup()
  if fftsa.sg_scr == nil then return false end
  local ok, err = pcall(function()
    display.setevent(fftsa.sg_scr, display.EVENT_ENDAPP, "if fftsa ~= nil then fftsa.cleanup() end")
  end)
  if not ok then fftsa.lasterr = "ENDAPP hook failed: " .. tostring(err) end
  return ok
end

-- One cleanup path for a failed start, so the two ways of failing cannot drift apart.
function fftsa.start_failed(why)
  fftsa.lasterr = tostring(why)
  fftsa.stop()
  print("fftsa start FAILED (cleaned up): " .. tostring(why))
  -- No console as an installed App, so the failure goes on the panel.
  fftsa.show_error(tostring(why))
  return false
end

-- Startup, guarded end to end so a failure part-way leaves nothing without a teardown.
-- The opening fftsa.stop() reclaims a previous launch's handles: as an installed App the
-- script re-runs on every open, and an exit that skipped EVENT_ENDAPP (the Home screen,
-- another App) leaves them behind.
function fftsa.start()
  fftsa.stop()
  fftsa.halted, fftsa.errrun, fftsa.stop_pending = false, 0, false

  -- The display object pool running out is a RETURN, not a raise: display.create answers
  -- nil and posts one event, and build() passes that up as false and a reason. Handled
  -- here directly rather than raised into the boundary below, which would be reporting a
  -- condition to ourselves.
  local built, why = fftsa.build()
  if built == false then return fftsa.start_failed(why or "build failed") end

  local hooked = fftsa.install_cleanup()
  -- The boundary that remains, and what it is for: apply() is arithmetic over tables
  -- fft_init builds, so a defect in OUR code raises here. A raise escaping a timer or
  -- button callback on this firmware posts -286 and leaves the app on screen and dead,
  -- so one backstop per entry point stays until those paths are proved non-raising.
  local ok, err = pcall(function()
    fftsa.apply()
    -- With the computed period, not the 0.05 s floor: apply() re-arms on a size change
    -- but cannot do it here, because the timer is created after the first apply() runs.
    -- Left at the floor, the default size kept whatever idle the quantisation happened
    -- to leave -- which is the whole fault this period exists to remove.
    fftsa.period = fftsa.frame_period(fftsa.n)
    fftsa.arm(fftsa.period)
  end)
  if not ok then return fftsa.start_failed(tostring(err)) end
  if not hooked then
    print("fftsa WARNING: End App cleanup not hooked -- " .. tostring(fftsa.lasterr))
    display.settext(fftsa.sg_xunit, "WARNING: End App will not clean up")
  end
  print("fftsa started fs=" .. fftsa.fs .. " bin=" .. fftsa.binhz ..
        " range=" .. fftsa.range .. " window=" .. fftsa.win_label())
  -- Switching away from the cover is what starts the frames: the timer only runs
  -- while the screen it is parented to is the one on show. The cover itself stays
  -- allocated until fftsa.stop(), since Apply raises it again.
  fftsa.show_main()
  return true
end

function fftsa.stop()
  -- Not underneath a running frame, which would be left writing into a deleted
  -- buffer: defer once (fftsa.frame() runs the pending stop as it finishes), then
  -- proceed regardless, so a stuck guard cannot make the app impossible to stop.
  if fftsa.busy and not fftsa.stop_pending then
    fftsa.stop_pending = true
    return false
  end
  fftsa.stop_pending = false
  -- Timer first: stop frames before removing what the frames use.
  if fftsa.timer ~= nil then fftsa.del_obj(fftsa.timer) end
  fftsa.timer = nil
  fftsa.optbtn = nil                          -- child of the spectrum screen
  pcall(function() fftsa.sg_destroy() end)    -- screen, graph, texts, spectrum buffer
  fftsa.destroy_options()
  fftsa.destroy_about()
  fftsa.loading_destroy(display.SCREEN_HOME)
  if fftsa.errscr ~= nil then
    fftsa.del_obj(fftsa.errscr)
    fftsa.errscr = nil
  end
  if fftsa.cap ~= nil then
    fftsa.del_buf(fftsa.cap)
    fftsa.cap = nil
  end
  fftsa.busy, fftsa.halted, fftsa.errrun = false, false, 0
  return true
end

-- Startup failure on the panel. End App is hooked here too, and the handle is kept
-- so fftsa.stop() can delete the screen.
-- The commonest reason startup fails is an exhausted object pool, and then
-- display.create returns nil here too: without the guard below every child is built
-- against a nil parent and changescreen(nil) raises, so the operator gets a BLANK
-- PANEL in precisely the case this screen exists for. Nothing can be drawn with at
-- that point, so it says so on the console and leaves the home screen up.
--
-- These children are created on a visible screen, which nothing else in the app
-- does. Accepted: it runs once, after startup has already failed, and the cover is
-- gone by then because fftsa.stop() took it.
function fftsa.show_error(msg)
  local shown = pcall(function()
    if fftsa.errscr ~= nil then
      fftsa.del_obj(fftsa.errscr)
      fftsa.errscr = nil
    end
    fftsa.errscr = display.create(display.ROOT, display.OBJ_SCREEN, "FFT ANALYSER ERROR")
    if fftsa.errscr == nil then
      -- No screen to report on, so the console is all there is. Returning rather than
      -- raising: the caller is already handling a failure and has nothing better to do
      -- with a second one.
      print("fftsa: object pool exhausted; no error screen")
      return false
    end
    display.create(fftsa.errscr, display.OBJ_TEXT, 20, 80,
                   "The analyser could not start.", 16736352,   -- red FF6060
                   display.FONT_MEDIUM, display.JUST_LEFT)
    local m = tostring(msg)
    local y = 140
    local i = 1
    while i <= string.len(m) and y <= 400 do
      display.create(fftsa.errscr, display.OBJ_TEXT, 20, y, string.sub(m, i, i + 79),
                     14737632, display.FONT_SMALL, display.JUST_LEFT)   -- light grey E0E0E0
      i = i + 80
      y = y + 22
    end
    display.create(fftsa.errscr, display.OBJ_TEXT, 20, 420,
                   "Press End App to exit.", 9474192,   -- grey 909090
                   display.FONT_SMALL, display.JUST_LEFT)
    display.setevent(fftsa.errscr, display.EVENT_ENDAPP, "if fftsa ~= nil then fftsa.cleanup() end")
    display.changescreen(fftsa.errscr)
  end)
  if not shown or fftsa.errscr == nil then
    fftsa.errscr = nil
    display.changescreen(display.SCREEN_HOME)
    print("fftsa: could not build the error screen either -- " .. tostring(msg))
  end
  return fftsa.errscr
end


-- ==================== TTI App entry point ====================
-- fftsa.start() builds the screens, hooks End App (EVENT_ENDAPP -> fftsa.cleanup)
-- as soon as the spectrum screen exists, configures the hardware and arms the
-- frame timer -- all under pcall, so a failure part-way through tears its own
-- display objects back down instead of stranding them until the next power cycle.
fftsa.start()
endscript
