loadscript FFT_Spectrum
-- $Title: FFT Spectrum Analyser
-- $Product: DMM6500
-- $Tag: FFT, Spectrum, Digitize, Audio
-- $Description: On-instrument FFT spectrum analyser: digitize mode + FFT with a live graph, top-6 peaks, and a touch options form (start/stop frequency, input range).
-- $Version: 1
-- $Requires: 1.7.0
-- $Icon: fft_icon

-- ================= tsp/fft_core.tsp =================
-- fft_core.tsp -- real-input radix-2 FFT for the DMM6500's TSP (Lua 5.0.2)
--
-- Design notes (the reasons this is fast enough to be interactive):
--
--  * Everything loop-invariant is precomputed ONCE in fftsa.fft_init(): the Hann
--    window, the bit-reversal swap list, and every twiddle factor. A naive
--    implementation rebuilds these per frame, which on this hardware costs
--    more than the butterflies themselves.
--  * The input is REAL, so the imaginary array starts all-zero. That lets us
--    skip the imaginary half of the bit-reversal permutation entirely and
--    specialise stage 1 (len=2, twiddle == 1) into pure adds/subs with no
--    multiplies and no imaginary writes.
--  * Lua 5.0.2 table reads cost ~1.4 us and arithmetic ~1.2 us on the 400 MHz
--    in-order PPC, so the inner loop is table-access bound. Locals are cached
--    aggressively; that is not style, it is the optimisation.
--
-- Lua 5.0.2 constraints: no '#' operator (use table.getn), no bitwise
-- operators, math.mod for modulo.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.fft_n      = 0      -- transform size (power of two)
fftsa.fft_re     = nil    -- real working array, 1..N
fftsa.fft_im     = nil    -- imaginary working array, 1..N
fftsa.fft_win    = nil    -- Hann window, 1..N
fftsa.fft_mag    = nil    -- magnitude output, 1..N/2
fftsa.fft_swp_a  = nil    -- bit-reversal swap pairs
fftsa.fft_swp_b  = nil
fftsa.fft_nswp   = 0
fftsa.fft_twr    = nil    -- flattened twiddles, stage-major
fftsa.fft_twi    = nil
fftsa.fft_cg     = 0.5    -- Hann coherent gain; fftsa.fft_init() overwrites this
                          -- with the exact value for the window it built

-- Build all lookup tables for a given transform size.
function fftsa.fft_init(N)
  local floor, sin, cos, pi = math.floor, math.sin, math.cos, math.pi
  fftsa.fft_n   = N
  fftsa.fft_re  = {}
  fftsa.fft_im  = {}
  fftsa.fft_win = {}
  fftsa.fft_mag = {}

  -- Hann window, plus its EXACT coherent gain (the window's mean sample value),
  -- which fftsa.fft_magnitude() divides back out. This is the SYMMETRIC Hann, so
  -- that gain is (N-1)/(2N), NOT exactly 0.5: assuming 0.5 reads every amplitude
  -- ~0.2 % (0.017 dB) low at N = 512. Measuring it costs one add per bin, once
  -- per fftsa.apply().
  local twopi_over = 2*pi/(N-1)
  local wsum = 0
  for i = 1, N do
    local w = 0.5 - 0.5*cos(twopi_over*(i-1))
    fftsa.fft_win[i] = w
    wsum = wsum + w
  end
  fftsa.fft_cg = wsum / N

  -- Bit-reversal as an explicit swap list: cheaper per frame than recomputing
  -- the reversed index, and we only store pairs that actually move.
  fftsa.fft_swp_a = {}
  fftsa.fft_swp_b = {}
  local n = 0
  local j = 0
  for i = 0, N-2 do
    if i < j then
      n = n + 1
      fftsa.fft_swp_a[n] = i + 1
      fftsa.fft_swp_b[n] = j + 1
    end
    local k = floor(N/2)
    while k <= j do j = j - k; k = floor(k/2) end
    j = j + k
  end
  fftsa.fft_nswp = n

  -- Twiddles for every stage, flattened. Stage with half-length h occupies the
  -- next h entries, so stage strides are implicit and no per-stage trig is
  -- needed at run time.
  fftsa.fft_twr = {}
  fftsa.fft_twi = {}
  local idx = 0
  local len = 4                  -- stage 1 (len=2) needs no twiddles
  while len <= N do
    local half = floor(len/2)
    local ang  = -2*pi/len
    for m = 0, half-1 do
      idx = idx + 1
      fftsa.fft_twr[idx] = cos(ang*m)
      fftsa.fft_twi[idx] = sin(ang*m)
    end
    len = len * 2
  end
end

-- Load N samples from a reading buffer, remove DC, apply the window.
-- Returns the mean (DC level) and the raw peak-to-peak, both useful for the UI.
function fftsa.fft_load(buf)
  local N   = fftsa.fft_n
  local re  = fftsa.fft_re
  local im  = fftsa.fft_im
  local win = fftsa.fft_win
  local rd  = buf.readings

  local mean = 0
  for i = 1, N do
    local v = rd[i]
    -- Last-resort net ONLY. fftsa.frame_body() rejects a short capture before it
    -- reaches here, because zero-padding one does not just lose data: the step
    -- from real samples to zeros is broadband, so it fabricates a plausible but
    -- entirely WRONG spectrum, and the mean below would be divided by N rather
    -- than by the number of samples actually read. This guard exists so that a
    -- sparse buffer cannot put nils into the FFT, where a later comparison
    -- against nil would raise an error mid-frame.
    if v == nil then v = 0 end
    re[i] = v
    mean = mean + v
  end
  mean = mean / N

  local vmin, vmax = re[1], re[1]
  for i = 1, N do
    local v = re[i]
    if v < vmin then vmin = v end
    if v > vmax then vmax = v end
    re[i] = (v - mean) * win[i]
    im[i] = 0
  end
  return mean, vmax - vmin
end

-- In-place forward transform of the (already loaded and windowed) data.
function fftsa.fft_run()
  local N     = fftsa.fft_n
  local re    = fftsa.fft_re
  local im    = fftsa.fft_im
  local swp_a = fftsa.fft_swp_a
  local swp_b = fftsa.fft_swp_b
  local twr   = fftsa.fft_twr
  local twi   = fftsa.fft_twi
  local floor = math.floor

  -- Bit-reversal permutation. im[] is all zero here (real input), so only re[]
  -- needs permuting.
  for s = 1, fftsa.fft_nswp do
    local a, b = swp_a[s], swp_b[s]
    re[a], re[b] = re[b], re[a]
  end

  -- Stage 1: len = 2, twiddle == 1+0i. Pure add/sub, imaginary parts stay 0,
  -- so this whole stage costs no multiplies and no im[] writes.
  for i = 1, N, 2 do
    local a, b = re[i], re[i+1]
    re[i]   = a + b
    re[i+1] = a - b
  end

  -- Remaining stages.
  local len  = 4
  local base = 0
  while len <= N do
    local half = floor(len/2)
    for i = 0, N-1, len do
      local ti = base
      for m = 1, half do
        ti = ti + 1
        local a  = i + m
        local b  = a + half
        local wr, wi = twr[ti], twi[ti]
        local xr, xi = re[b], im[b]
        local vr = xr*wr - xi*wi
        local vi = xr*wi + xi*wr
        local ar, ai = re[a], im[a]
        re[b] = ar - vr
        im[b] = ai - vi
        re[a] = ar + vr
        im[a] = ai + vi
      end
    end
    base = base + half
    len  = len * 2
  end
end

-- Sub-bin peak estimate from the peak bin and its two neighbours.
--
-- A tone almost never lands on a bin centre, and a single-bin reading pays for
-- that twice: the frequency is quantised to the bin grid (+-binhz/2), and the
-- amplitude suffers SCALLOPING LOSS, which for a Hann window reaches -1.42 dB
-- (x0.849) at exactly half a bin. Both are recoverable in closed form, because
-- the Hann window's spectral response is known exactly:
--
--   D(x) = 0.5 * sinc(x) / (1 - x^2)
--
-- With the peak in bin k and the true tone at bin k+d, that kernel makes
--
--   d = 2*(R - L) / (L + 2*C + R)          (L, C, R = mag[k-1], mag[k], mag[k+1])
--
-- EXACT for a noiseless Hann-windowed tone, and the amplitude follows from
-- dividing out D(d)/D(0) = pi*d*(1-d^2)/sin(pi*d).
--
-- Verified against hardware: a 12.000 kHz 1.000 V source at 195.3 Hz bin width
-- read 11.914 kHz / 0.883 V from the peak bin alone; this returns 11999.8 Hz /
-- 1.0016 V from the same three bins.
--
-- Returns the fractional bin offset (-0.5..0.5) and the corrected amplitude, or
-- 0 and nil when the estimate is not available -- at the spectrum edges, where a
-- neighbour does not exist, and for a sparse magnitude array. Callers fall back
-- to the raw bin in that case.
function fftsa.peak_interp(k, nb)
  local mag = fftsa.fft_mag
  if k == nil or k < 2 then return 0, nil end
  if nb ~= nil and k >= nb then return 0, nil end
  local C = mag[k]
  local L = mag[k-1]
  local R = mag[k+1]
  if C == nil or L == nil or R == nil or C <= 0 then return 0, nil end
  local den = L + 2*C + R
  if den <= 0 then return 0, nil end
  local d = 2*(R - L) / den
  -- The kernel only places the true tone within half a bin of the peak; a wider
  -- value means the three bins are noise rather than one tone, so clamp.
  if d < -0.5 then d = -0.5 end
  if d > 0.5 then d = 0.5 end
  local ad = d
  if ad < 0 then ad = -ad end
  if ad < 1e-9 then return d, C end     -- removable singularity at d = 0
  local pd = math.pi * d
  local s  = math.sin(pd)
  if s == 0 then return d, C end
  return d, C * pd * (1 - d*d) / s
end

-- Magnitude spectrum in volts-peak, corrected for window coherent gain.
-- Only the first N/2 bins are meaningful for real input.
function fftsa.fft_magnitude()
  local N    = fftsa.fft_n
  local half = N/2
  local re   = fftsa.fft_re
  local im   = fftsa.fft_im
  local mag  = fftsa.fft_mag
  local sqrt = math.sqrt
  local k    = 2/(N*fftsa.fft_cg)
  for i = 1, half do
    local a, b = re[i], im[i]
    mag[i] = sqrt(a*a + b*b) * k
  end
  return half
end


-- ================= tsp/spectrum_ui.tsp =================
-- spectrum_ui.tsp -- peak finder used by the spectrum app.

fftsa = fftsa or {}   -- the single global this app exposes

-- Top `count` local maxima of fftsa.fft_mag, strongest first. O(nbins), negligible cost.
-- Returns two 1..count arrays: bin indices (bi) and their magnitudes (bv).
--
-- kmin/kmax (optional, default 2..nbins) restrict the search to the bins the
-- graph is actually DISPLAYING. Without them a strong tone outside the zoom
-- window is reported in the table while being absent from the trace, so the
-- numbers describe something other than the picture. fftsa.frame_body() passes
-- the same window fftsa.sg_update() plots.
--
-- Bin 1 is DC (removed before the transform) and is never a candidate, so the
-- search starts at bin 2 -- the first real frequency bin, and reportable.
function fftsa.find_peaks(nbins, count, kmin, kmax)
  local mag = fftsa.fft_mag
  local bi, bv = {}, {}
  for s = 1, count do bi[s] = 0; bv[s] = -1 end
  if kmin == nil or kmin < 2 then kmin = 2 end
  if kmax == nil or kmax > nbins then kmax = nbins end
  for k = kmin, kmax do
    local m = mag[k]
    -- nil-safe: a partial fftsa.fft_mag (e.g. after a short read) may hold nils,
    -- and comparing nils raises a runtime error -- guard against it.
    if m ~= nil then
      local ml = mag[k-1]
      local mr = mag[k+1]
      -- A missing neighbour means we are at the end of the spectrum, so treat it
      -- as lower than anything: that lets the final bin qualify. Inside a zoom
      -- window the neighbours are real bins even when they are off-screen, which
      -- is what stops the flank of an out-of-window tone reading as a peak.
      if ml == nil then ml = -1 end
      if mr == nil then mr = -1 end
      if m > ml and m >= mr then
        if m > bv[count] then
          local s = count
          while s > 1 and m > bv[s-1] do
            bv[s] = bv[s-1]; bi[s] = bi[s-1]; s = s - 1
          end
          bv[s] = m; bi[s] = k
        end
      end
    end
  end
  return bi, bv
end


-- ================= tsp/spectrum_graph.tsp =================
-- spectrum_graph.tsp -- spectrum-analyser UI built on the instrument's own graph
--
-- WHY THIS DESIGN (all figures measured, host wall-clock unless noted):
--
-- The built-in graph draws the whole trace as ONE object fed from a reading
-- buffer, so a frame is a buffer refill plus a single repaint (256 points in
-- ~20 ms). That beats N line objects or setpixel, which flood the display
-- processor's message queue and eventually panic the firmware.
--
-- FREQUENCY ON THE X AXIS (the "seconds trick"):
-- The DMM graph's X axis is hardwired to TIME formatting -- it renders the
-- timestamp as clock time and cannot print "Hz". For values under a minute it
-- renders a clean "SS.SSs" label, so each bin's frequency is written into the
-- TIMESTAMP (seconds field) divided by fftsa.sg_fscale. At the default scale of
-- 1000 Hz per label-second a 12.5 kHz bin gets timestamp 12.5 s and the graph
-- labels it "12.50s", which reads directly as 12.5 kHz. The graph draws its own
-- axis labels this way -- no overlay, no custom text.
--
-- Above 59 s the label rolls over into "MM:SS" and stops reading as a frequency
-- at all (500 kHz would render as "08:20"), so fftsa.sg_pick_fscale() steps the
-- scale by decades to keep the whole span under that limit, and the on-screen
-- legend (fftsa.sg_xunit) states the multiplier in force.
--
-- Y axis: amplitude in dBV on a LINEAR axis (the log is done in Lua). A LOG axis
-- mis-scales the fixed dB range, and buffer.UNIT_DECIBEL panics the firmware, so
-- the buffer is UNIT_VOLT carrying dB numbers on a fixed normal axis.
--
-- OBJECT LIFETIME: every display object and buffer this module creates is
-- deleted and its handle set to nil by fftsa.sg_destroy() BEFORE anything is
-- created again (fftsa.sg_build() calls it unconditionally). Creating over a live
-- handle would overwrite the only reference to the old object, leaving it alive
-- in the firmware with no way to delete it -- and accumulated display objects are
-- what walk this instrument toward a panic.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.sg_nbins   = 256
fftsa.sg_npeak   = 6       -- number of peaks reported (shown in a 2x3 grid)

-- FIRMWARE HANDLES -- initialised ONLY on the first load of this script.
--
-- Opening the App a second time in one power session re-runs this whole body.
-- `fftsa = fftsa or {}` keeps the table, so a plain `fftsa.sg_scr = nil` here
-- would CLEAR the only reference to the previous launch's screen, graph, text
-- objects and buffer -- stranding them in the firmware, alive and undeletable
-- until the next power cycle. That is precisely the accumulated display churn
-- that walks this instrument toward a panic. Letting the handles survive instead
-- means fftsa.stop() / fftsa.sg_destroy() can reclaim them on the next start.
if fftsa.sg_handles_inited == nil then
  fftsa.sg_buf   = nil     -- WRITABLE_FULL buffer holding the spectrum
  fftsa.sg_scr   = nil     -- custom screen
  fftsa.sg_graph = nil     -- OBJ_GRAPH object
  fftsa.sg_pk_f  = nil     -- per-peak frequency text (own field, fixed x)
  fftsa.sg_pk_v  = nil     -- per-peak voltage text  (own field, fixed x)
  fftsa.sg_pk_d  = nil     -- per-peak dB text       (own field, fixed x)
  fftsa.sg_xunit = nil     -- axis unit legend
  fftsa.sg_stat  = nil
  fftsa.sg_xlab  = nil     -- our own X tick labels, in kHz (table)
  fftsa.sg_handles_inited = true
end

-- Count of deletions the firmware REFUSED (see fftsa.del_obj). Preserved across a
-- reload: a non-zero value means objects may have been stranded, which is the one
-- number worth carrying between launches. Reported by tools/run_app.py.
fftsa.delfails = fftsa.delfails or 0
-- Visible frequency window (Hz). fftsa.sg_update() writes ONLY the FFT bins inside this
-- window, so the graph's own auto-range shows exactly [flo, fhi]; this is how the
-- start/stop zoom is done -- by windowing the data, not by the graph's X scale
-- (which the per-frame re-add resets). Defaults span everything until fftsa.apply()
-- narrows them.
fftsa.sg_flo_hz  = 0
fftsa.sg_fhi_hz  = 1e9
-- Hz per label-"second" for the seconds trick. 1000 => the label IS kHz.
fftsa.sg_fscale  = 1000

-- Geometry on the 800x480 panel. Y is limited to 0..420 on a custom screen.
-- The graph is made TALL: tight under the title bar and stretched down to just
-- above the peak table, which is a compact 2-columns-of-3 block at the bottom.
-- (The firmware draws the graph's own X-axis labels ~40 px below the plot box,
--  so the peak table starts below that.)
fftsa.sg_gx      = 8
fftsa.sg_gy      = 24
fftsa.sg_gw      = 784
fftsa.sg_gh      = 272

fftsa.sg_dbmin   = -100
fftsa.sg_dbmax   = 20
fftsa.sg_vfloor  = 1e-9

-- PLOT-AREA GEOMETRY -- calibration constants. The firmware offers no way to ask
-- where it drew the plot box, so these were MEASURED from hardware captures: with
-- X pinned by display.XSCALE_OFF and Y by display.YSCALE_OFF, the tick positions
-- solve to x 105..785 for the X range and y 265..44 for the Y range (axis
-- minimum..maximum). Only these four numbers need revisiting if a firmware update
-- moves the plot box.
--
-- ALL Y VALUES HERE ARE OBJECT COORDINATES, which start BELOW the 49-pixel title
-- bar: a child at y=350 lands on panel row 399. X needs no such correction. Mixing
-- the two frames puts every label 49 pixels low, which is exactly what a screenshot
-- measured naively will tell you to do.
fftsa.sg_px0     = 105     -- x of the X axis minimum
fftsa.sg_px1     = 785     -- x of the X axis maximum
--
-- WHY THE X TICKS SIT BELOW THE PLOT RATHER THAN ON THE FIRMWARE'S OWN LABEL ROW.
-- The graph object's rectangle is x 8..792, y 24..296, and the firmware writes its
-- labels inside that, in its own margins. Two things were measured on hardware:
--
--   * An object placed inside that rectangle is painted over by the graph's
--     per-frame repaint and never appears. Creation order does not help, and a
--     cover rectangle there does not hide the firmware's labels either.
--   * Re-issuing our objects after every repaint does make them appear, but it
--     flickers badly and saturates the display processor enough that the
--     instrument looks hung.
--
-- So our labels live BELOW y=296, outside the graph, drawn once and never touched
-- by a repaint -- which also means they cost nothing per frame. The firmware's own
-- row stays visible above ours; it cannot be hidden, and with the axis pinned it is
-- at least our window expressed in scaled seconds.
--
-- Only the X axis gets our labels. The firmware's Y numbers are already the correct
-- dBV values -- only the "V" suffix is wrong, which the legend states -- and a Y
-- tick has to sit on its gridline, which is inside the graph rectangle and so
-- unreachable.
fftsa.sg_xlab_y  = 314     -- baseline of our X ticks: below the graph, above the peaks
-- Every label is JUST_LEFT, the one justification this app has proven on hardware,
-- so an X tick is nudged left by roughly half the width of a label like "12.5 kHz"
-- to sit centred on its gridline. The end ticks are pulled further in, which keeps
-- the first against the axis and the last clear of the right edge of the panel.
fftsa.sg_xlab_hw = 26
fftsa.sg_nxlab   = 5       -- X ticks, endpoints included
fftsa.sg_axc     = 0xC0C0C0    -- axis label colour
-- fftsa.sg_fhi_hz starts at a sentinel meaning "every bin" until fftsa.apply()
-- sets a real window. A span that wide is not a plottable axis, so the pin and
-- the labels stay out of the way until it is narrowed.
fftsa.sg_fmax_real = 1e6

-- Peak table: 6 rows as TWO COLUMNS OF THREE. freq/volt/dB are each their OWN
-- text object at a FIXED x, which is what stops the volt and dB columns from
-- jittering left-right as the (variable-width, proportional-font) frequency
-- string changes width. The far bottom-right is left free for the Options button.
fftsa.sg_pky     = 350     -- first peak row baseline
fftsa.sg_pkdy    = 20      -- row pitch
fftsa.sg_pk_colx_f = {8,   360}   -- frequency field x, per column
fftsa.sg_pk_colx_v = {118, 470}   -- voltage field x,   per column
fftsa.sg_pk_colx_d = {200, 552}   -- dB field x,        per column
fftsa.sg_pk_cf   = 0xE0FFE0  -- freq colour (pale green)
fftsa.sg_pk_cv   = 0xC8E6FF  -- volt colour (pale blue)
fftsa.sg_pk_cd   = 0xFFE0A0  -- dB colour   (pale amber)
-- X-axis legend: clear of the three peak rows (350/370/390) and of the Options
-- button, so it never collides with the firmware's own axis labels.
fftsa.sg_xunit_x = 8
fftsa.sg_xunit_y = 410
fftsa.sg_xunit_c = 0x909090

-- Delete a display object / a buffer, and do NOT hide a refusal.
--
-- A bare pcall around a delete conflates the harmless failure (the handle is
-- already dead -- a child that went with its parent screen) with the dangerous
-- one (the firmware refused and the object is still alive and unreachable). The
-- handle is cleared either way, since nothing else could ever free it, but a
-- refusal is COUNTED in fftsa.delfails and recorded rather than swallowed.
--
-- Defined here because this is the first module that deletes anything; the app
-- module loads after it and uses them too.
function fftsa.del_obj(h)
  if h == nil then return true end
  local ok, err = pcall(function() display.delete(h) end)
  if not ok then
    fftsa.delfails = (fftsa.delfails or 0) + 1
    fftsa.lasterr = "display.delete refused: " .. tostring(err)
  end
  return ok
end

function fftsa.del_buf(b)
  if b == nil then return true end
  local ok, err = pcall(function() buffer.delete(b) end)
  if not ok then
    fftsa.delfails = (fftsa.delfails or 0) + 1
    fftsa.lasterr = "buffer.delete refused: " .. tostring(err)
  end
  return ok
end

-- Pin the X axis to the visible window instead of letting the graph auto-range.
--
-- Auto-range rounds OUTWARD to tidy tick values, so the data never reaches the
-- plot edges and the pixel position of a given frequency is unknowable -- which
-- would make our own labels point at the wrong places. Pinning makes the mapping
-- exact and linear between fftsa.sg_px0 and fftsa.sg_px1.
--
-- Measured on hardware: a PINNED scale survives the per-frame removeall+add,
-- while an auto scale does not (the re-add resets it). Re-asserting it per frame
-- is therefore not required for correctness -- it is one message that makes the
-- axis self-healing if anything else ever moves it.
function fftsa.sg_pin_x()
  if fftsa.sg_graph == nil then return false end
  local lo, hi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if hi > fftsa.sg_fmax_real or hi <= lo then return false end
  local s = fftsa.sg_fscale
  pcall(function()
    display.graph.scalex(fftsa.sg_graph, display.XSCALE_OFF, display.AXIS_NORMAL,
                         lo / s, hi / s)
  end)
  return true
end

-- Text for one X tick. The SPAN sets the precision: a 200 Hz zoom needs digits a
-- 50 kHz span does not, and two adjacent ticks reading the same number are worse
-- than no ticks at all.
-- Each tick carries its own unit, so the row reads correctly on its own -- the
-- firmware's row above it says "s" and there is no way to stop it.
function fftsa.sg_flabel(f, span)
  if span >= 1000 then return string.format("%.1f kHz", f / 1000) end
  return string.format("%.0f Hz", f)
end

-- Refresh the X tick text, and ONLY when it would actually change.
--
-- The tick PIXELS never move: the axis is pinned and the ticks sit at fixed
-- fractions of it, so a zoom changes the numbers and nothing else. That makes
-- display.settext the whole update -- no object is recreated or repositioned for
-- a new span. The span that is currently on screen is remembered so the frame
-- loop costs zero display messages here in the steady state; per-frame text
-- churn is exactly what floods this instrument's display processor.
function fftsa.sg_axis_update(force)
  if fftsa.sg_xlab == nil then return false end
  local lo, hi = fftsa.sg_flo_hz, fftsa.sg_fhi_hz
  if not force and fftsa.sg_lab_lo == lo and fftsa.sg_lab_hi == hi then return false end
  fftsa.sg_lab_lo, fftsa.sg_lab_hi = lo, hi
  local n = fftsa.sg_nxlab
  local blank = (hi > fftsa.sg_fmax_real or hi <= lo)
  fftsa.sg_xlab_txt = {}
  for i = 1, n do
    local txt = ""
    if not blank then
      txt = fftsa.sg_flabel(lo + (hi - lo) * (i - 1) / (n - 1), hi - lo)
    end
    fftsa.sg_xlab_txt[i] = txt
    local h = fftsa.sg_xlab[i]
    pcall(function() display.settext(h, txt) end)
  end
  return true
end

-- Hz per label-"second" that keeps a whole span inside the graph's clean
-- "SS.SSs" label format. Stepping by decades keeps the multiplier easy to read.
function fftsa.sg_pick_fscale(fhi_hz)
  local s = 1000                      -- default: label reads directly as kHz
  if fhi_hz == nil or fhi_hz <= 0 then return s end
  while fhi_hz / s >= 59 do s = s * 10 end
  return s
end

-- Legend naming the units our own tick labels are in. The graph's internal X
-- axis is still in scaled seconds, so when that multiplier is not 1 the legend
-- says so -- it is the one clue left if the label covers ever fail to paint.
function fftsa.sg_xunit_text()
  local s = fftsa.sg_fscale
  if s == 1000 then return "X: kHz   Y: dBV" end
  return string.format("X: kHz   Y: dBV   (graph x%g)", s / 1000)
end

-- Create the buffer that backs the trace. WRITABLE_FULL carries value + extra +
-- timestamp per point. Value unit VOLT (holds dB numbers), extra unit HERTZ.
--
-- Deletes any previous buffer first: buffer.make() into a live handle would
-- orphan the old buffer with no reference left to free it. The caller must
-- already have detached the graph (fftsa.sg_destroy() does), because deleting a
-- buffer a graph still references is asking for trouble.
function fftsa.sg_make_buffer(nbins)
  fftsa.sg_nbins = nbins
  if fftsa.sg_buf ~= nil then
    fftsa.del_buf(fftsa.sg_buf)
    fftsa.sg_buf = nil
  end
  fftsa.sg_buf = buffer.make(nbins + 16, buffer.STYLE_WRITABLE_FULL)
  -- DO NOT use buffer.UNIT_DECIBEL here: it panics the instrument during build.
  buffer.write.format(fftsa.sg_buf, buffer.UNIT_VOLT,  buffer.DIGITS_4_5,
                              buffer.UNIT_HERTZ, buffer.DIGITS_6_5)
  return fftsa.sg_buf
end

-- One point: value=dB, extra=Hz, timestamp=scaled frequency (the seconds trick).
function fftsa.sg_write_point(buf, db, f)
  local t = f / fftsa.sg_fscale
  buffer.write.reading(buf, db, f, math.floor(t), t - math.floor(t))
end

-- Create our own X tick labels, in real frequency units.
--
-- The graph's own labels cannot be relabelled or switched off: the X axis is
-- hardwired to TIME formatting, so it prints "12.00s" for what is really 12 kHz.
-- display.setabbrv() is no help -- it applies to option fields, not axes -- and
-- neither is covering them up (see the geometry notes above). So a second row of
-- ticks is written below the plot, stating the frequencies the trace actually
-- spans, and the axis is pinned so those numbers are exact.
function fftsa.sg_axis_build(create, small)
  -- X ticks, nudged so each reads as centred on its gridline and neither end one
  -- runs off the panel. Text is filled in by fftsa.sg_axis_update() once a real
  -- span exists.
  fftsa.sg_xlab = {}
  local nx, hw = fftsa.sg_nxlab, fftsa.sg_xlab_hw
  for i = 1, nx do
    local x = fftsa.sg_px0 + (fftsa.sg_px1 - fftsa.sg_px0) * (i - 1) / (nx - 1) - hw
    if i == 1  then x = x + hw end            -- first: start at the axis
    if i == nx then x = x - hw end            -- last: keep it fully on screen
    if x < 2 then x = 2 end
    fftsa.sg_xlab[i] = create(fftsa.sg_scr, display.OBJ_TEXT, math.floor(x),
                              fftsa.sg_xlab_y, "", fftsa.sg_axc, small, display.JUST_LEFT)
  end
  fftsa.sg_lab_lo, fftsa.sg_lab_hi = nil, nil   -- force the first text update
end

-- Build the screen: graph + split peak table. Created once; the frame loop only
-- refills the buffer and updates text.
function fftsa.sg_build(title, nbins)
  -- Destroy first, ALWAYS: guarantees no old screen/graph/text/buffer survives
  -- unreachable behind an overwritten handle. Safe when nothing exists yet.
  fftsa.sg_destroy()

  fftsa.sg_make_buffer(nbins)
  local create = display.create
  local small  = display.FONT_SMALL
  fftsa.sg_scr = create(display.ROOT, display.OBJ_SCREEN, title)
  display.changescreen(fftsa.sg_scr)

  -- Prime the buffer BEFORE attaching it: graph.add() on an EMPTY buffer binds
  -- nothing and later writes never draw. Fill a flat line at the dB floor first.
  fftsa.sg_buf.clear()
  for k = 1, nbins do
    fftsa.sg_write_point(fftsa.sg_buf, fftsa.sg_dbmin, (k - 1) * 1.0)
  end

  fftsa.sg_graph = create(fftsa.sg_scr, display.OBJ_GRAPH, fftsa.sg_gx, fftsa.sg_gy, fftsa.sg_gw, fftsa.sg_gh)
  -- X axis = TIME element (our scaled-frequency timestamps); Y = DATA (dB).
  display.graph.add(fftsa.sg_graph, fftsa.sg_buf, display.ELEMENT_DATA, fftsa.sg_buf, display.ELEMENT_TIME)
  display.graph.drawstyle(fftsa.sg_graph, display.STYLE_LINE)
  pcall(function()
    display.graph.scaley(fftsa.sg_graph, display.YSCALE_OFF, display.AXIS_NORMAL,
                         fftsa.sg_dbmin, fftsa.sg_dbmax)
  end)
  fftsa.sg_pin_x()
  fftsa.sg_axis_build(create, small)
  fftsa.sg_axis_update(true)

  -- Split peak table, 2 columns of 3: each field is its own fixed-x object so
  -- volt/dB never jitter. Peaks 1-3 fill the left column, 4-6 the right.
  fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d = {}, {}, {}
  for p = 1, fftsa.sg_npeak do
    local col, row = 1, p - 1
    if p > 3 then col = 2; row = p - 4 end
    local y = fftsa.sg_pky + row * fftsa.sg_pkdy
    if y > 418 then y = 418 end
    fftsa.sg_pk_f[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_f[col], y,
                        string.format("%d  ---", p), fftsa.sg_pk_cf, small, display.JUST_LEFT)
    fftsa.sg_pk_v[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_v[col], y, "", fftsa.sg_pk_cv, small, display.JUST_LEFT)
    fftsa.sg_pk_d[p] = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_pk_colx_d[col], y, "", fftsa.sg_pk_cd, small, display.JUST_LEFT)
  end

  -- X-axis unit legend: the graph's own labels carry an "s" suffix, so say what
  -- they mean. Updated by fftsa.sg_set_xrange() whenever the scale changes.
  fftsa.sg_xunit = create(fftsa.sg_scr, display.OBJ_TEXT, fftsa.sg_xunit_x, fftsa.sg_xunit_y,
                          fftsa.sg_xunit_text(), fftsa.sg_xunit_c, small, display.JUST_LEFT)

  fftsa.sg_stat = nil     -- no on-screen status object (kept off to preserve room)
  return fftsa.sg_scr
end

-- Tear everything down before any rebuild so objects never accumulate. Deletes
-- in dependency order -- detach the trace, then drop the screen (its children go
-- with it), then free the buffer -- and nils EVERY handle, including the child
-- text objects, so nothing is left pointing at a deleted object.
function fftsa.sg_destroy()
  if fftsa.sg_graph ~= nil then
    pcall(function() display.graph.removeall(fftsa.sg_graph) end)
  end
  if fftsa.sg_scr ~= nil then
    pcall(function() display.changescreen(display.SCREEN_HOME) end)
    fftsa.del_obj(fftsa.sg_scr)
  end
  fftsa.sg_scr, fftsa.sg_graph, fftsa.sg_pk_f, fftsa.sg_pk_v, fftsa.sg_pk_d,
    fftsa.sg_xunit, fftsa.sg_stat = nil, nil, nil, nil, nil, nil, nil
  fftsa.sg_xlab = nil
  -- The cached span and label text belong to objects that no longer exist.
  fftsa.sg_lab_lo, fftsa.sg_lab_hi, fftsa.sg_xlab_txt = nil, nil, nil
  -- The buffer goes last: the graph referencing it is gone by now.
  if fftsa.sg_buf ~= nil then
    fftsa.del_buf(fftsa.sg_buf)
  end
  fftsa.sg_buf = nil
  collectgarbage()
end

-- Bin index range covering the visible window, clamped into 1..nbins. Shared by
-- fftsa.sg_update() (what to plot) and the peak search (what to report), so the
-- table always describes what is on screen.
--
-- BOTH ends must be clamped. An inconsistent window -- flo above fhi, or a start
-- beyond Nyquist -- otherwise yields kmin past the end of fftsa.fft_mag, and the
-- resulting nil comparison raises an error that kills every single frame.
function fftsa.sg_window_bins(nbins, binhz)
  if binhz == nil or binhz <= 0 then return 1, nbins end
  local floor, ceil = math.floor, math.ceil
  -- The low edge rounds UP to the first bin centred at or above flo. Rounding
  -- down would silently re-admit the DC bin: at a 195 Hz bin width, floor() maps
  -- every start below one bin width -- including the 10 Hz floor -- back to bin 1.
  local kmin = ceil(fftsa.sg_flo_hz / binhz) + 1
  local kmax = floor(fftsa.sg_fhi_hz / binhz) + 1
  if kmin < 1 then kmin = 1 end
  if kmin > nbins then kmin = nbins end
  if kmax > nbins then kmax = nbins end
  if kmax < kmin then kmax = kmin end
  return kmin, kmax
end

-- Refill the trace from fftsa.fft_mag. One buffer pass, then the firmware repaints once.
-- `binhz` is the true bin width (from the measured sample rate).
function fftsa.sg_update(nbins, binhz)
  if binhz == nil or binhz <= 0 then return end   -- no usable frequency scale yet
  local buf   = fftsa.sg_buf
  local mag   = fftsa.fft_mag
  local wr    = buffer.write.reading
  local floor = math.floor
  local log10 = math.log10
  local vfl   = fftsa.sg_vfloor
  local dbmin = fftsa.sg_dbmin
  local dbmax = fftsa.sg_dbmax
  local fscl  = fftsa.sg_fscale
  -- Write only the bins inside the visible window so the graph auto-ranges to it.
  local kmin, kmax = fftsa.sg_window_bins(nbins, binhz)
  buf.clear()
  for k = kmin, kmax do
    local v = mag[k]
    local db
    -- nil (sparse magnitude array) and anything at or below the floor both plot
    -- at the floor; log10 is never handed a zero.
    if v == nil or v <= vfl then db = dbmin else db = 20 * log10(v) end
    if db < dbmin then db = dbmin end
    if db > dbmax then db = dbmax end
    local f = (k - 1) * binhz
    local t = f / fscl                       -- scaled frequency into the seconds field
    wr(buf, db, f, floor(t), t - floor(t))
  end
end

-- Set the visible frequency window (Hz). fftsa.sg_update() writes only the bins inside
-- it, so the graph's auto-range becomes exactly this window (see fftsa.sg_flo_hz note).
-- Also picks the X-axis scale that keeps the graph's own labels readable as a
-- frequency, and refreshes the legend that states it.
function fftsa.sg_set_xrange(flo_hz, fhi_hz)
  fftsa.sg_flo_hz = flo_hz
  fftsa.sg_fhi_hz = fhi_hz
  fftsa.sg_fscale = fftsa.sg_pick_fscale(fhi_hz)
  if fftsa.sg_xunit ~= nil then
    pcall(function() display.settext(fftsa.sg_xunit, fftsa.sg_xunit_text()) end)
  end
  -- Pin the graph to the new window and relabel it. This is the ONE place a zoom
  -- has to touch, because the tick pixels are fixed and only the numbers move.
  fftsa.sg_pin_x()
  fftsa.sg_axis_update()
end

-- Re-bind the trace to our buffer (X=TIME). Call ONCE after acquisition is
-- configured; removeall() first, or add() stacks duplicate traces.
function fftsa.sg_rebind()
  pcall(function() display.graph.removeall(fftsa.sg_graph) end)
  pcall(function() display.graph.add(fftsa.sg_graph, fftsa.sg_buf, display.ELEMENT_DATA,
                                     fftsa.sg_buf, display.ELEMENT_TIME) end)
  pcall(function() display.graph.drawstyle(fftsa.sg_graph, display.STYLE_LINE) end)
  pcall(function()
    display.graph.scaley(fftsa.sg_graph, display.YSCALE_OFF, display.AXIS_NORMAL,
                         fftsa.sg_dbmin, fftsa.sg_dbmax)
  end)
  fftsa.sg_pin_x()
end

-- Per-frame re-add. fftsa.sg_update() clears then refills the buffer; the clear alone
-- would async-repaint an empty graph (a visible flicker), so the atomic
-- removeall+add repaints the complete buffer in one step. X = TIME (see header).
function fftsa.sg_bind_min()
  pcall(function() display.graph.removeall(fftsa.sg_graph) end)
  pcall(function() display.graph.add(fftsa.sg_graph, fftsa.sg_buf, display.ELEMENT_DATA,
                                     fftsa.sg_buf, display.ELEMENT_TIME) end)
  -- NOTHING ELSE HAPPENS HERE, deliberately. Two things were tried and both cost
  -- more than they were worth, measured on hardware:
  --
  --   * Re-issuing our labels after each repaint. It does make objects inside the
  --     graph's rectangle visible, but it flickers heavily and saturates the
  --     display processor until the instrument looks hung. Our labels live outside
  --     that rectangle instead, so a repaint cannot touch them.
  --   * Re-asserting the X pin. A pinned scale already SURVIVES this removeall+add
  --     (two captures either side of one were pixel-identical), so the only effect
  --     of re-pinning was to make the firmware redraw its own axis labels every
  --     frame, which showed as an intermittent flicker in them.
  --
  -- The pin is set where the span is set -- fftsa.sg_set_xrange() -- which is the
  -- only thing that can invalidate it.
end

-- Update the split peak fields. Each field is set independently at its fixed x,
-- left-justified, so its origin never moves as the value's width changes.
--
-- The reported frequency and amplitude come from fftsa.peak_interp(), which
-- recovers the sub-bin position from the peak's two neighbours. Without it a
-- tone between bins reads up to half a bin off in frequency and up to 1.42 dB
-- low in amplitude, both of which are large next to this instrument's accuracy.
function fftsa.sg_show_peaks(bi, bv, count, binhz)
  local log10, settext = math.log10, display.settext
  local nb = fftsa.sg_nbins
  for p = 1, count do
    local k = bi[p]
    if k ~= nil and k > 0 and bv[p] > 0 then
      local dk, iv = fftsa.peak_interp(k, nb)
      if iv == nil then dk, iv = 0, bv[p] end     -- edge bin or sparse spectrum
      local f, v = (k - 1 + dk) * binhz, iv
      local ftxt
      if f >= 1000 then ftxt = string.format("%d  %.3f kHz", p, f / 1000)
      else ftxt = string.format("%d  %.1f Hz", p, f) end
      local vtxt
      if v >= 1 then vtxt = string.format("%.4f V", v)
      elseif v >= 1e-3 then vtxt = string.format("%.2f mV", v * 1e3)
      else vtxt = string.format("%.0f uV", v * 1e6) end
      settext(fftsa.sg_pk_f[p], ftxt)
      settext(fftsa.sg_pk_v[p], vtxt)
      settext(fftsa.sg_pk_d[p], string.format("%.1f dBV", 20 * log10(v)))
    else
      settext(fftsa.sg_pk_f[p], string.format("%d  ---", p))
      settext(fftsa.sg_pk_v[p], "")
      settext(fftsa.sg_pk_d[p], "")
    end
  end
end

function fftsa.sg_status(txt)
  if fftsa.sg_stat ~= nil then display.settext(fftsa.sg_stat, txt) end
end


-- ================= tsp/spectrum_app.tsp =================
-- spectrum_app.tsp -- interactive standalone spectrum analyser for the DMM6500
--
-- Uses the other modules:
--   fft_core.tsp       real-input FFT
--   spectrum_ui.tsp    fftsa.find_peaks()
--   spectrum_graph.tsp fftsa.sg_build / fftsa.sg_update / fftsa.sg_bind_min / fftsa.sg_show_peaks / etc.
--
-- Provides a touch OPTIONS FORM (a screen of editable fields, not a chain of
-- modal prompts) and an on-instrument run loop, so the app runs by itself.
--
-- OPTIONS SEMANTICS (like a real spectrum analyser):
--   Stop frequency  -> sets the sample rate: fs = smallest EXACT rate >= 2*stop.
--                      A narrower span therefore also gives finer resolution.
--                      Only exact decimal rates are used (102400 is NOT exact).
--   Start frequency -> restricts the displayed span to [start, stop]; the graph
--                      shows only the bins in that window (see fftsa.sg_set_xrange).
--   Input range     -> dmm.digitize.range, one of 0.1 / 1 / 10 V (fixed).
--
-- OBJECT LIFETIME: every display object and buffer is deleted and its handle set
-- to nil before a replacement is created (fftsa.sg_destroy / fftsa.destroy_options /
-- fftsa.arm / fftsa.apply). Creating over a live handle would overwrite the only
-- reference to the old object, stranding it in the firmware with no way to delete
-- it until the next power cycle -- and it is accumulated display churn, not any
-- single call, that walks this instrument toward a panic.

fftsa = fftsa or {}   -- the single global this app exposes

fftsa.n       = 512         -- FFT size (256 bins). Power of two.
-- Lowest start frequency the app will accept or display. Bin 1 is DC, and
-- fftsa.fft_load() subtracts the mean, so bin 1 carries only the residual the
-- window leaks -- never a signal. Including it puts a meaningless spike at the
-- left edge of every trace and lets it into the peak table, so the span starts
-- above DC. 10 Hz is below the lowest bin width the app can produce, so it costs
-- no real signal at any sample rate.
fftsa.flomin  = 10          -- floor for the start frequency (Hz)
fftsa.flo     = 10          -- display start frequency (Hz)
fftsa.fhi     = 50000       -- display stop frequency (Hz)
fftsa.range   = 10          -- digitizer input range (V): 0.1 / 1 / 10
fftsa.fs      = 100000      -- sample rate (derived from fftsa.fhi)
fftsa.binhz   = 0           -- true bin width, from measured fs
fftsa.busy    = false       -- reentrancy guard (never preserved across a reload)
fftsa.stop_pending = false  -- a teardown deferred until the running frame ends
fftsa.halted  = false       -- frames suppressed after repeated failures
fftsa.lasterr = nil         -- last frame error (nil if none) -- diagnosis
fftsa.errcount = 0          -- count of dropped frames
fftsa.errrun  = 0           -- CONSECUTIVE dropped frames
fftsa.errmax  = 20          -- give up (and say so) after this many in a row: 6 s
fftsa.shortreads = 0        -- captures rejected for returning fewer than n samples

-- FIRMWARE HANDLES -- initialised ONLY on the first load (see the same block in
-- spectrum_graph.tsp for the full reasoning). Opening the App a second time in one
-- power session re-runs this body; clearing a live handle here would strand the
-- previous launch's timer, screens and buffer in the firmware until a power cycle.
-- Keeping them lets fftsa.start()'s opening fftsa.stop() reclaim them properly.
if fftsa.handles_inited == nil then
  fftsa.cap      = nil      -- acquisition buffer
  fftsa.optbtn   = nil      -- Options button on the spectrum screen
  fftsa.timer    = nil      -- periodic timer driving frames
  fftsa.errscr   = nil      -- error screen shown if startup fails
  fftsa.optscr   = nil      -- options form screen
  fftsa.opt_flo  = nil      -- Start Frequency edit field
  fftsa.opt_fhi  = nil      -- Stop Frequency edit field
  fftsa.opt_rng  = nil      -- Input Range edit-option field
  fftsa.opt_info = nil      -- read-back info line on the options screen
  fftsa.handles_inited = true
end

-- Exact, achievable sample rates only; the hardware cannot produce 102400 S/s.
fftsa.rates = {1000, 10000, 20000, 50000, 100000, 200000, 500000, 1000000}

-- 1-based index <-> range for the OBJ_EDIT_OPTION field. getvalue() may hand back
-- a numeric index (0- OR 1-based, firmware-dependent) or the option label string,
-- so fftsa.idx_to_range() tolerates all three.
fftsa.ranges       = {0.1, 1, 10}
fftsa.range_labels = {"0.1 V", "1 V", "10 V"}

function fftsa.range_to_idx(r)
  for i = 1, table.getn(fftsa.ranges) do
    if fftsa.ranges[i] == r then return i end
  end
  return 3
end

function fftsa.idx_to_range(v)
  if type(v) == "string" then
    for j = 1, table.getn(fftsa.range_labels) do
      if v == fftsa.range_labels[j] then return fftsa.ranges[j] end
    end
    local n = tonumber(v)
    if n ~= nil then v = n else return fftsa.range end
  end
  local n = table.getn(fftsa.ranges)
  v = math.floor(v + 0.5)
  if v < 1 then v = v + 1 end       -- tolerate 0-based
  if v < 1 then v = 1 end
  if v > n then v = n end
  return fftsa.ranges[v]
end

-- Smallest exact rate whose Nyquist (fs/2) covers the requested stop frequency.
function fftsa.pick_fs(fhi)
  local r = fftsa.rates
  local n = table.getn(r)
  for i = 1, n do
    if r[i] / 2 >= fhi then return r[i] end
  end
  return r[n]
end

function fftsa.measure_fs(buf)
  local n = buf.n
  if n < 4 then return fftsa.fs end
  local t1, tN = buf.relativetimestamps[1], buf.relativetimestamps[n]
  if tN <= t1 then return fftsa.fs end
  return (n - 1) / (tN - t1)
end

-- Apply the current fftsa settings to the hardware and the graph. Safe to call
-- repeatedly (that is what the Options Apply button does).
function fftsa.apply()
  fftsa.fs = fftsa.pick_fs(fftsa.fhi)
  fftsa.fft_init(fftsa.n)
  dmm.digitize.func       = dmm.FUNC_DIGITIZE_VOLTAGE
  dmm.digitize.range      = fftsa.range
  dmm.digitize.samplerate = fftsa.fs
  dmm.digitize.aperture   = 1e-6
  dmm.digitize.count      = fftsa.n
  -- Acquisition buffer: delete the old one and clear the handle BEFORE making a
  -- new one, so re-applying can never strand a buffer behind an overwritten
  -- reference (and a changed fftsa.n always gets a correctly sized buffer).
  -- Apply is user-paced, so this costs nothing per frame.
  if fftsa.cap ~= nil then
    fftsa.del_buf(fftsa.cap)
    fftsa.cap = nil
  end
  fftsa.cap = buffer.make(fftsa.n * 4, buffer.STYLE_STANDARD)
  dmm.digitize.read(fftsa.cap)
  fftsa.fs    = fftsa.measure_fs(fftsa.cap)     -- the samplerate readback is unreliable
  fftsa.binhz = fftsa.fs / fftsa.n
  -- Restrict the displayed span to [start, stop]. fftsa.sg_update() then plots only the
  -- bins in that window, so the graph auto-ranges to it.
  fftsa.sg_set_xrange(fftsa.flo, fftsa.fhi)
  fftsa.sg_rebind()
end

-- The per-frame work (one acquisition + FFT + display), split out so fftsa.frame()
-- can run it under pcall. The frame rate is limited by display cost, not the FFT:
-- fftsa.sg_update() clears and refills the buffer, then fftsa.sg_bind_min() re-adds the trace
-- to repaint the complete buffer atomically (which avoids the flicker the bare
-- clear would cause -- see fftsa.sg_bind_min). That re-add is heavy, so fftsa.arm() paces
-- the timer at 0.3 s.
function fftsa.frame_body()
  -- Everything a frame touches must still exist. A frame can be dispatched while
  -- the app is half-built (a failed startup) or half-torn-down (End App, a host
  -- reload), and indexing a nil buffer or a nil peak-field table would raise on
  -- every tick, so bail out quietly instead.
  if fftsa.cap == nil or fftsa.sg_buf == nil or fftsa.sg_graph == nil
     or fftsa.sg_pk_f == nil then
    return
  end
  fftsa.cap.clear()
  dmm.digitize.read(fftsa.cap)
  -- Reject a short capture rather than transform it. fftsa.fft_load() would
  -- zero-pad the missing tail, and the step from real samples into zeros is
  -- broadband: the result is a convincing but completely FALSE spectrum. Holding
  -- the previous frame is honest; drawing a fabricated one is not.
  if fftsa.cap.n < fftsa.n then
    fftsa.shortreads = (fftsa.shortreads or 0) + 1
    return
  end
  fftsa.fft_load(fftsa.cap)
  fftsa.fft_run()
  fftsa.fft_magnitude()
  local nb = fftsa.n / 2
  -- Search for peaks in exactly the window the graph plots, so the table always
  -- describes the visible trace instead of reporting off-screen tones.
  local kmin, kmax = fftsa.sg_window_bins(nb, fftsa.binhz)
  local bi, bv = fftsa.find_peaks(nb, fftsa.sg_npeak, kmin, kmax)
  fftsa.sg_update(nb, fftsa.binhz)
  fftsa.sg_bind_min()
  fftsa.sg_show_peaks(bi, bv, fftsa.sg_npeak, fftsa.binhz)
end

-- Reentrancy-guarded frame. The body runs under pcall so an error can never skip
-- the fftsa.busy reset: were the guard left latched, every later frame would return
-- at the top and the display would freeze. A failed frame is simply dropped, and
-- fftsa.lasterr / fftsa.errcount record it for diagnosis.
function fftsa.frame()
  if fftsa.busy or fftsa.halted then return end
  fftsa.busy = true
  local ok, err = pcall(fftsa.frame_body)
  if not ok then
    fftsa.lasterr  = tostring(err)
    fftsa.errcount = (fftsa.errcount or 0) + 1
    fftsa.errrun   = (fftsa.errrun or 0) + 1
    -- A trace that stopped updating looks exactly like a working analyser looking
    -- at a dead signal, so after a run of failures stop retrying and SAY so on
    -- screen. The timer keeps ticking into a no-op, which is cheaper and safer
    -- than deleting a timer from inside its own callback.
    if fftsa.errrun >= (fftsa.errmax or 20) then
      fftsa.halted = true
      pcall(function()
        display.settext(fftsa.sg_xunit,
          "HALTED after " .. fftsa.errrun .. " failed frames: " ..
          string.sub(tostring(fftsa.lasterr), 1, 60))
      end)
    end
  else
    fftsa.errrun = 0
  end
  fftsa.busy = false
  -- A teardown that arrived mid-frame waits here, where nothing is in flight.
  if fftsa.stop_pending then
    fftsa.stop_pending = false
    pcall(function() fftsa.stop() end)
  end
end

-- Delete the options form and clear EVERY handle into it. The fields are children
-- of the screen, so the firmware frees them with it, but the Lua handles would
-- otherwise dangle at deleted objects and a later fftsa.options() would poke them.
function fftsa.destroy_options()
  if fftsa.optscr ~= nil then
    -- Never delete the screen currently on show: leave it first.
    if fftsa.sg_scr ~= nil then
      pcall(function() display.changescreen(fftsa.sg_scr) end)
    else
      pcall(function() display.changescreen(display.SCREEN_HOME) end)
    end
    fftsa.del_obj(fftsa.optscr)
  end
  fftsa.optscr, fftsa.opt_flo, fftsa.opt_fhi, fftsa.opt_rng, fftsa.opt_info =
    nil, nil, nil, nil, nil
end

-- Build the OPTIONS form: a screen of editable fields the user touches to edit,
-- plus Apply / Cancel. Created once, hidden until the Options button is pressed.
function fftsa.build_options()
  -- Destroy first, ALWAYS: a second create would overwrite fftsa.optscr and leave
  -- the first screen alive in the firmware with nothing able to reach it.
  fftsa.destroy_options()

  local create = display.create
  -- Screen title must be <= 31 chars or the firmware truncates it (error 1707).
  fftsa.optscr = create(display.ROOT, display.OBJ_SCREEN, "FFT ANALYSER OPTIONS")

  create(fftsa.optscr, display.OBJ_TEXT, 30, 62,
         "Touch a field to edit it, then Apply.", 0xB0B0B0, display.FONT_MEDIUM,
         display.JUST_LEFT)

  -- Edit objects render their label+description to the LEFT of the value box, so
  -- the box x must leave room for them; at x=270 the labels sit fully on-screen.
  -- Descriptions are kept short so they don't overrun the left edge.
  fftsa.opt_flo = create(fftsa.optscr, display.OBJ_EDIT_NUMBER, 270, 108,
                       "Start Frequency", "low edge (Hz)",
                       display.NFORMAT_PREFIX, fftsa.flo, fftsa.flomin, 499000, "Hz")
  fftsa.opt_fhi = create(fftsa.optscr, display.OBJ_EDIT_NUMBER, 270, 180,
                       "Stop Frequency", "sets sample rate",
                       display.NFORMAT_PREFIX, fftsa.fhi, 500, 500000, "Hz")
  fftsa.opt_rng = create(fftsa.optscr, display.OBJ_EDIT_OPTION, 270, 252,
                       "Input Range", "full-scale",
                       "0.1 V", "1 V", "10 V")

  fftsa.opt_info = create(fftsa.optscr, display.OBJ_TEXT, 30, 322, "",
                        0x00DCFF, display.FONT_SMALL, display.JUST_LEFT)

  local b_apply = create(fftsa.optscr, display.OBJ_BUTTON, 470, 362, "Apply", 140)
  display.setevent(b_apply, display.EVENT_PRESS, "fftsa.options_apply()")
  local b_cancel = create(fftsa.optscr, display.OBJ_BUTTON, 630, 362, "Cancel", 140)
  display.setevent(b_cancel, display.EVENT_PRESS, "fftsa.options_cancel()")
  -- Hook End App on THIS screen too. If the firmware delivers EVENT_ENDAPP to the
  -- screen that is currently visible, a user who exits from the options form would
  -- otherwise leave with no teardown at all -- both screens, the graph, the timer
  -- and both buffers stranded until the next power cycle.
  pcall(function()
    display.setevent(fftsa.optscr, display.EVENT_ENDAPP, "fftsa.cleanup()")
  end)
  return fftsa.optscr
end

-- Options button handler: seed the fields with the current settings, show a
-- read-back line, and switch to the form.
function fftsa.options()
  if fftsa.optscr == nil then fftsa.build_options() end
  pcall(function() display.setvalue(fftsa.opt_flo, fftsa.flo) end)
  pcall(function() display.setvalue(fftsa.opt_fhi, fftsa.fhi) end)
  pcall(function() display.setvalue(fftsa.opt_rng, fftsa.range_to_idx(fftsa.range)) end)
  pcall(function()
    display.settext(fftsa.opt_info, string.format(
      "Current:  %.0f - %.0f Hz    fs = %d S/s    bin = %.2f Hz    range = %g V",
      fftsa.flo, fftsa.fhi, fftsa.fs, fftsa.binhz, fftsa.range))
  end)
  display.changescreen(fftsa.optscr)
end

-- Apply the form: read every field, validate, then reconfigure and return.
function fftsa.options_apply()
  local lo = display.getvalue(fftsa.opt_flo)
  local hi = display.getvalue(fftsa.opt_fhi)
  local ri = display.getvalue(fftsa.opt_rng)
  -- Validate the span as a PAIR. Applying the two fields independently lets a new
  -- stop frequency land BELOW the surviving start (zoom to 8-16 kHz, then set stop
  -- to 5 kHz): the new start is rejected, the surviving one stays, and flo > fhi
  -- leaves an EMPTY window -- a span that describes no bins at all.
  local nlo, nhi = fftsa.flo, fftsa.fhi
  if hi ~= nil and hi > 0 then nhi = hi end
  if lo ~= nil and lo >= fftsa.flomin then nlo = lo end
  -- Inconsistent pair: widen back to the full span rather than leave an empty one.
  if nlo >= nhi then nlo = fftsa.flomin end
  fftsa.flo, fftsa.fhi = nlo, nhi
  if ri ~= nil then fftsa.range = fftsa.idx_to_range(ri) end
  display.changescreen(fftsa.sg_scr)
  fftsa.apply()
end

function fftsa.options_cancel()
  display.changescreen(fftsa.sg_scr)
end

-- Build the spectrum screen, add the Options button, and pre-build the form.
function fftsa.build()
  -- fftsa.sg_build() destroys any previous spectrum screen, its children and its
  -- buffer, and nils every handle, before creating the new one.
  fftsa.sg_build("FFT SPECTRUM ANALYSER", fftsa.n / 2)
  -- Options button: far bottom-right, clear of the right-hand peak column. The
  -- button is a child of the screen fftsa.sg_build() just destroyed, so clear the
  -- stale handle before creating its replacement.
  fftsa.optbtn = nil
  fftsa.optbtn = display.create(fftsa.sg_scr, display.OBJ_BUTTON, 645, 350, "Options", 145)
  display.setevent(fftsa.optbtn, display.EVENT_PRESS, "fftsa.options()")
  fftsa.build_options()
  -- Creating fftsa.optscr leaves it as the active screen, which would hide the
  -- spectrum and (since the frame timer only runs while its parent screen is
  -- visible) stop the display updating. Switch back to the spectrum explicitly.
  display.changescreen(fftsa.sg_scr)
  return fftsa.sg_scr
end

-- Arm the periodic frame timer (fires only while the spectrum screen is visible).
-- 0.3 s is deliberately conservative: the per-frame graph re-add that keeps the
-- trace flicker-free is heavy, and a faster rate floods the display processor and
-- hangs the box. If a frame runs long, the fftsa.busy guard skips the overlapping tick.
function fftsa.arm(period_s)
  if period_s == nil then period_s = 0.3 end
  -- NEVER stack timers. Two live timers would both fire fftsa.frame(), doubling
  -- the frame rate, and that extra display traffic is exactly what floods the
  -- display processor and hangs the instrument.
  if fftsa.timer ~= nil then
    fftsa.del_obj(fftsa.timer)
    fftsa.timer = nil
  end
  if fftsa.sg_scr == nil then return nil end
  fftsa.timer = display.create(fftsa.sg_scr, display.OBJ_TIMER, period_s, display.TIMER_FOREVER)
  display.setevent(fftsa.timer, display.EVENT_PRESS, "fftsa.frame()")
  return fftsa.timer
end

-- End App (the system button) fires EVENT_ENDAPP -> tear everything down so the
-- instrument is handed back clean.
function fftsa.cleanup()
  pcall(function() fftsa.stop() end)
end

-- Hook End App as soon as the spectrum screen exists, so that even a failure
-- later in startup leaves the user a working way out that cleans up.
-- pcall'd, because a wrong EVENT_ENDAPP constant must not abort startup -- but
-- the failure is RECORDED and reported: silently swallowing it would leave the
-- app with no teardown path and nothing to say so.
function fftsa.install_cleanup()
  if fftsa.sg_scr == nil then return false end
  local ok, err = pcall(function()
    display.setevent(fftsa.sg_scr, display.EVENT_ENDAPP, "fftsa.cleanup()")
  end)
  if not ok then fftsa.lasterr = "ENDAPP hook failed: " .. tostring(err) end
  return ok
end

-- One-call startup: build the screens, hook End App, apply settings, arm the
-- frame timer. Guarded end to end -- an unprotected failure part-way through
-- would abort the script with screens, a graph binding and buffers already
-- created and no teardown wired up, and those orphaned display objects then
-- survive until the next power cycle.
function fftsa.start()
  -- Reclaim anything a previous launch left behind, IN DEPENDENCY ORDER (timer,
  -- then screens, then buffers), before building. Installed as an App this is the
  -- normal case, not an edge case: opening the App re-runs the whole script, and
  -- if the last exit skipped EVENT_ENDAPP (HOME, another App) the handles from
  -- that launch are still here -- which is exactly why the declarations above no
  -- longer wipe them.
  pcall(function() fftsa.stop() end)
  fftsa.halted, fftsa.errrun, fftsa.stop_pending = false, 0, false

  local hooked = false
  local ok, err = pcall(function()
    fftsa.build()
    hooked = fftsa.install_cleanup()
    fftsa.apply()
    fftsa.arm(0.3)
  end)
  if not ok then
    fftsa.lasterr = tostring(err)
    pcall(function() fftsa.stop() end)
    print("fftsa start FAILED (cleaned up): " .. tostring(err))
    -- Running as an installed App there is no console: a print goes nowhere the
    -- user can see, and stop() has just removed the half-built screen, so without
    -- this they are dropped back to HOME with no idea whether the App is broken
    -- or the installation is.
    fftsa.show_error(tostring(err))
    return false
  end
  if not hooked then
    print("fftsa WARNING: End App cleanup not hooked -- " .. tostring(fftsa.lasterr))
    -- Same reasoning: say it on the panel, since this one costs the user a power
    -- cycle's worth of stranded objects every time they leave the App.
    pcall(function()
      display.settext(fftsa.sg_xunit, "WARNING: End App will not clean up")
    end)
  end
  print("fftsa started fs=" .. fftsa.fs .. " bin=" .. fftsa.binhz .. " range=" .. fftsa.range)
  return true
end

-- Tear down everything (timer, screens, buffers) and clear every handle. Called
-- on app exit via EVENT_ENDAPP, from the host when reloading, and by
-- fftsa.start() itself if startup fails part-way through.
function fftsa.stop()
  -- Never tear down underneath a frame that is mid-flight: it would be left
  -- writing into a deleted buffer or a deleted graph. Defer ONCE -- frame() runs
  -- the pending stop the moment it finishes -- and then proceed regardless, so a
  -- guard stuck set can never make the app impossible to shut down.
  if fftsa.busy and not fftsa.stop_pending then
    fftsa.stop_pending = true
    return false
  end
  fftsa.stop_pending = false
  -- Timer first: stop frames before removing what the frames use.
  if fftsa.timer ~= nil then fftsa.del_obj(fftsa.timer) end
  fftsa.timer = nil
  fftsa.optbtn = nil                          -- child of the spectrum screen
  pcall(function() fftsa.sg_destroy() end)    -- screen, graph, texts, spectrum buffer
  fftsa.destroy_options()
  if fftsa.errscr ~= nil then
    fftsa.del_obj(fftsa.errscr)
    fftsa.errscr = nil
  end
  if fftsa.cap ~= nil then
    fftsa.del_buf(fftsa.cap)
    fftsa.cap = nil
  end
  -- Leave no latched state behind for the next start().
  fftsa.busy, fftsa.halted, fftsa.errrun = false, false, 0
  return true
end

-- Report a startup failure ON THE PANEL. Uses only calls this app already relies
-- on elsewhere (screen + text + changescreen), rather than an untested modal
-- dialog, and keeps the handle so fftsa.stop() can delete it like anything else.
-- End App is hooked here too, so the user's way out still cleans up.
function fftsa.show_error(msg)
  pcall(function()
    if fftsa.errscr ~= nil then
      fftsa.del_obj(fftsa.errscr)
      fftsa.errscr = nil
    end
    fftsa.errscr = display.create(display.ROOT, display.OBJ_SCREEN, "FFT ANALYSER ERROR")
    display.create(fftsa.errscr, display.OBJ_TEXT, 20, 80,
                   "The analyser could not start.", 0xFF6060,
                   display.FONT_MEDIUM, display.JUST_LEFT)
    -- One long line runs off an 800 px panel, so break the message into chunks.
    local m = tostring(msg)
    local y = 140
    local i = 1
    while i <= string.len(m) and y <= 400 do
      display.create(fftsa.errscr, display.OBJ_TEXT, 20, y, string.sub(m, i, i + 79),
                     0xE0E0E0, display.FONT_SMALL, display.JUST_LEFT)
      i = i + 80
      y = y + 22
    end
    display.create(fftsa.errscr, display.OBJ_TEXT, 20, 420,
                   "Press End App to exit.", 0x909090,
                   display.FONT_SMALL, display.JUST_LEFT)
    display.setevent(fftsa.errscr, display.EVENT_ENDAPP, "fftsa.cleanup()")
    display.changescreen(fftsa.errscr)
  end)
  return fftsa.errscr
end


-- ==================== TTI App entry point ====================
-- fftsa.start() builds the screens, hooks End App (EVENT_ENDAPP -> fftsa.cleanup)
-- as soon as the spectrum screen exists, configures the hardware and arms the
-- frame timer -- all under pcall, so a failure part-way through tears its own
-- display objects back down instead of stranding them until the next power cycle.
fftsa.start()
endscript
